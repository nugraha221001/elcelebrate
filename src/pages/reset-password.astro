---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';
import Toast from '../components/ui/Toast.astro';
import { KeyRound } from 'lucide-astro';

export const prerender = false;

// 1. Read URL query parameters on server
const code = Astro.url.searchParams.get('code') || '';
const token_hash = Astro.url.searchParams.get('token_hash') || '';
const type = Astro.url.searchParams.get('type') || '';
const errorDescription =
  Astro.url.searchParams.get('error_description') ||
  Astro.url.searchParams.get('error') ||
  '';

// 2. Active server session from cookies (if any)
const user = Astro.locals.user;

// CRITICAL: DO NOT consume token_hash or code during the initial GET request.
// (This prevents email link scanners / antivirus prefetchers from invalidating the single-use OTP).
// If token_hash, code, or active session is present on server, display form immediately!
const hasServerRecovery = Boolean(token_hash || code || user);
---

<BaseLayout
  title="Buat Kata Sandi Baru — ElCelebrate"
  description="Masukkan kata sandi baru untuk mengamankan akun ElCelebrate Anda."
>
  <Navbar />
  <Toast />

  <main class="flex min-h-[calc(100dvh-4rem)] items-center justify-center px-4 py-16">
    <!-- Ambient Background Lighting -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -left-32 -top-32 h-96 w-96 rounded-full bg-primary/5 blur-3xl"></div>
      <div class="absolute -bottom-32 -right-32 h-96 w-96 rounded-full bg-secondary/5 blur-3xl"></div>
    </div>

    <div class="relative w-full max-w-md" style="animation: fade-in-up 0.5s var(--ease-smooth) forwards;">
      <!-- Header -->
      <div class="mb-8 text-center">
        <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-[#f5c563]/25 bg-[#f5c563]/10 text-[#f5c563] shadow-md">
          <KeyRound class="h-7 w-7 text-[#f5c563]" stroke-width="1.5" />
        </div>
        <h1 class="text-2xl font-bold text-surface-50">Buat Kata Sandi Baru</h1>
        <p class="mt-2 text-sm text-surface-400 leading-relaxed">
          Masukkan kata sandi baru untuk mengamankan akun ElCelebrate Anda
        </p>
      </div>

      <!-- Auth State Container -->
      <div
        id="reset-card-container"
        data-has-session={hasServerRecovery ? "true" : "false"}
        data-server-token-hash={token_hash}
        data-server-code={code}
        data-server-type={type}
        data-server-error={errorDescription}
        class="rounded-2xl border border-white/8 bg-surface-900/60 backdrop-blur-md p-6 sm:p-8 shadow-elevated"
      >
        <!-- Form View (immediately displayed whenever token_hash, code, active session, or recovery hash is present) -->
        <div id="form-container" class={hasServerRecovery ? "block" : "hidden"}>
          <form id="reset-password-form" class="flex flex-col gap-5">
            <!-- Hidden inputs to pass stateless token_hash and code -->
            <input type="hidden" id="recovery-token-hash" name="token_hash" value={token_hash} />
            <input type="hidden" id="recovery-code" name="code" value={code} />

            <!-- New Password -->
            <div class="flex flex-col gap-1.5">
              <label for="new-password" class="text-sm font-medium text-surface-200">
                Kata Sandi Baru <span class="text-confetti-pink">*</span>
              </label>
              <div class="relative">
                <input
                  type="password"
                  id="new-password"
                  name="password"
                  placeholder="Minimal 6 karakter"
                  minlength="6"
                  required
                  class="form-input w-full rounded-xl border bg-surface-800/50 px-4 py-2.5 pr-11 text-sm transition-all duration-200 focus-ring"
                />
                <button
                  type="button"
                  id="toggle-new-pw"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-surface-400 hover:text-surface-200 transition-colors cursor-pointer"
                  aria-label="Tampilkan kata sandi baru"
                  tabindex="-1"
                >
                  <svg id="eye-icon-new" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <svg id="eye-off-icon-new" class="h-4.5 w-4.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                  </svg>
                </button>
              </div>

              <!-- Password Strength Meter -->
              <div id="pw-strength-container" class="mt-1.5 hidden">
                <div class="flex gap-1.5">
                  <div id="pw-bar-1" class="h-1 flex-1 rounded-full bg-surface-700 transition-colors duration-300"></div>
                  <div id="pw-bar-2" class="h-1 flex-1 rounded-full bg-surface-700 transition-colors duration-300"></div>
                  <div id="pw-bar-3" class="h-1 flex-1 rounded-full bg-surface-700 transition-colors duration-300"></div>
                </div>
                <p id="pw-strength-label" class="mt-1 text-xs text-surface-500 transition-colors duration-300"></p>
              </div>
            </div>

            <!-- Confirm New Password -->
            <div class="flex flex-col gap-1.5">
              <label for="confirm-password" class="text-sm font-medium text-surface-200">
                Konfirmasi Kata Sandi Baru <span class="text-confetti-pink">*</span>
              </label>
              <div class="relative">
                <input
                  type="password"
                  id="confirm-password"
                  name="confirm_password"
                  placeholder="Ulangi kata sandi baru"
                  minlength="6"
                  required
                  class="form-input w-full rounded-xl border bg-surface-800/50 px-4 py-2.5 pr-11 text-sm transition-all duration-200 focus-ring"
                />
                <button
                  type="button"
                  id="toggle-confirm-pw"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-surface-400 hover:text-surface-200 transition-colors cursor-pointer"
                  aria-label="Tampilkan konfirmasi kata sandi"
                  tabindex="-1"
                >
                  <svg id="eye-icon-confirm" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <svg id="eye-off-icon-confirm" class="h-4.5 w-4.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                  </svg>
                </button>
              </div>
              <p id="confirm-pw-error" class="hidden mt-0.5 text-xs text-error"></p>
            </div>

            <Button type="submit" variant="primary" size="lg" fullWidth={true} id="reset-submit-btn">
              <span id="reset-btn-text">Simpan Kata Sandi Baru</span>
              <svg id="reset-spinner" class="hidden h-4.5 w-4.5 animate-spin text-[#0f0d15]" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </Button>
          </form>
        </div>

        <!-- Loading State (checking client tokens if server had no credentials) -->
        <div id="session-loading" class={hasServerRecovery ? "hidden" : "block py-8 text-center space-y-3"}>
          <svg class="mx-auto h-8 w-8 animate-spin text-[#f5c563]" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <p class="text-sm text-surface-300">Memverifikasi tautan pemulihan kata sandi...</p>
        </div>

        <!-- Invalid / Missing Session State -->
        <div id="session-invalid" class="hidden text-center py-4 space-y-4">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-amber-500/10 text-amber-400 border border-amber-500/20">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
            </svg>
          </div>
          <div>
            <h2 class="text-lg font-bold text-surface-100">Sesi Tidak Ditemukan atau Kedaluwarsa</h2>
            <p class="mt-1.5 text-xs sm:text-sm text-surface-400 leading-relaxed">
              Tautan atur ulang kata sandi tidak valid atau telah kedaluwarsa. Silakan minta tautan pemulihan baru melalui halaman masuk.
            </p>
          </div>
          <div class="pt-2">
            <Button href="/signin" variant="secondary" size="md" fullWidth={true}>
              Kembali ke Halaman Masuk
            </Button>
          </div>
        </div>
      </div>

      <p class="mt-6 text-center text-sm text-surface-400">
        Ingat kata sandi Anda?
        <a href="/signin" class="font-medium text-primary hover:text-primary-light transition-colors ml-1">
          Masuk ke akun
        </a>
      </p>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  let clientAccessToken = '';
  let clientRefreshToken = '';
  let clientTokenHash = '';
  let clientCode = '';

  // DOM Elements
  const container = document.getElementById('reset-card-container');
  const formContainer = document.getElementById('form-container');
  const loadingContainer = document.getElementById('session-loading');
  const invalidContainer = document.getElementById('session-invalid');
  const resetForm = document.getElementById('reset-password-form');
  const tokenHashInput = document.getElementById('recovery-token-hash') as HTMLInputElement | null;
  const codeInput = document.getElementById('recovery-code') as HTMLInputElement | null;
  const newPwInput = document.getElementById('new-password') as HTMLInputElement | null;
  const confirmPwInput = document.getElementById('confirm-password') as HTMLInputElement | null;
  const confirmPwError = document.getElementById('confirm-pw-error');
  const submitBtn = document.getElementById('reset-submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('reset-btn-text');
  const spinner = document.getElementById('reset-spinner');

  function showForm() {
    loadingContainer?.classList.add('hidden');
    invalidContainer?.classList.add('hidden');
    formContainer?.classList.remove('hidden');
    formContainer?.classList.add('block');
  }

  function showInvalid() {
    loadingContainer?.classList.add('hidden');
    formContainer?.classList.add('hidden');
    invalidContainer?.classList.remove('hidden');
    invalidContainer?.classList.add('block');
  }

  // ── Session & Recovery Token Resolution ───────────────────────
  function resolveRecoverySession() {
    // 1. Check server-provided attributes
    const hasServer = container?.getAttribute('data-has-session') === 'true';
    const serverTokenHash = container?.getAttribute('data-server-token-hash') || '';
    const serverCode = container?.getAttribute('data-server-code') || '';
    const serverError = container?.getAttribute('data-server-error') || '';

    if (serverError) {
      showInvalid();
      (window as any).showToast?.({ message: serverError, type: 'error' });
      return;
    }

    if (serverTokenHash) {
      clientTokenHash = serverTokenHash;
      showForm();
      return;
    }

    if (serverCode) {
      clientCode = serverCode;
      showForm();
      return;
    }

    if (hasServer) {
      showForm();
      return;
    }

    // 2. Check URL search parameters on client (in case of client routing)
    const searchParams = new URLSearchParams(window.location.search);
    const searchTokenHash = searchParams.get('token_hash');
    const searchCode = searchParams.get('code');
    const searchError = searchParams.get('error_description') || searchParams.get('error');

    if (searchError) {
      showInvalid();
      (window as any).showToast?.({ message: searchError, type: 'error' });
      return;
    }

    if (searchTokenHash) {
      clientTokenHash = searchTokenHash;
      if (tokenHashInput) tokenHashInput.value = searchTokenHash;
      showForm();
      return;
    }

    if (searchCode) {
      clientCode = searchCode;
      if (codeInput) codeInput.value = searchCode;
      showForm();
      return;
    }

    // 3. Check URL hash fragment (access_token or type=recovery)
    const hash = window.location.hash.startsWith('#')
      ? window.location.hash.substring(1)
      : window.location.hash;

    if (hash) {
      const hashParams = new URLSearchParams(hash);
      const hashError = hashParams.get('error_description') || hashParams.get('error');
      if (hashError) {
        showInvalid();
        (window as any).showToast?.({ message: hashError, type: 'error' });
        return;
      }

      const accessToken = hashParams.get('access_token');
      const refreshToken = hashParams.get('refresh_token');
      const hashType = hashParams.get('type');

      if (accessToken || hashType === 'recovery') {
        if (accessToken) {
          clientAccessToken = accessToken;
          clientRefreshToken = refreshToken || '';
        }
        showForm();
        return;
      }
    }

    // 4. Fallback: check browser session
    import('../lib/supabase-browser')
      .then(({ supabaseBrowser }) => supabaseBrowser.auth.getSession())
      .then(({ data }) => {
        if (data?.session) {
          clientAccessToken = data.session.access_token;
          clientRefreshToken = data.session.refresh_token || '';
          showForm();
        } else {
          showInvalid();
        }
      })
      .catch(() => {
        showInvalid();
      });
  }

  resolveRecoverySession();

  // ── Password Visibility Toggles ───────────────────────────────
  function setupToggle(btnId: string, inputId: string, eyeId: string, eyeOffId: string) {
    const btn = document.getElementById(btnId);
    const input = document.getElementById(inputId) as HTMLInputElement | null;
    const eye = document.getElementById(eyeId);
    const eyeOff = document.getElementById(eyeOffId);
    btn?.addEventListener('click', () => {
      if (!input) return;
      const isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';
      eye?.classList.toggle('hidden', isPassword);
      eyeOff?.classList.toggle('hidden', !isPassword);
      btn.setAttribute('aria-label', isPassword ? 'Sembunyikan kata sandi' : 'Tampilkan kata sandi');
    });
  }

  setupToggle('toggle-new-pw', 'new-password', 'eye-icon-new', 'eye-off-icon-new');
  setupToggle('toggle-confirm-pw', 'confirm-password', 'eye-icon-confirm', 'eye-off-icon-confirm');

  // ── Password Strength Meter ───────────────────────────────────
  function updatePasswordStrength(val: string) {
    const strengthContainer = document.getElementById('pw-strength-container');
    const b1 = document.getElementById('pw-bar-1');
    const b2 = document.getElementById('pw-bar-2');
    const b3 = document.getElementById('pw-bar-3');
    const label = document.getElementById('pw-strength-label');
    if (!strengthContainer || !b1 || !b2 || !b3 || !label) return;

    if (!val) {
      strengthContainer.classList.add('hidden');
      return;
    }
    strengthContainer.classList.remove('hidden');

    let score = 0;
    if (val.length >= 6) score++;
    if (val.length >= 10 || (/[A-Z]/.test(val) && /[0-9]/.test(val))) score++;
    if (/[^A-Za-z0-9]/.test(val) && val.length >= 8) score++;

    b1.className = 'h-1 flex-1 rounded-full transition-colors duration-300';
    b2.className = 'h-1 flex-1 rounded-full transition-colors duration-300';
    b3.className = 'h-1 flex-1 rounded-full transition-colors duration-300';

    if (score === 1) {
      b1.classList.add('bg-error');
      b2.classList.add('bg-surface-700');
      b3.classList.add('bg-surface-700');
      label.textContent = 'Kata sandi lemah (minimal 6 karakter)';
      label.className = 'mt-1 text-xs text-error transition-colors duration-300';
    } else if (score === 2) {
      b1.classList.add('bg-warning');
      b2.classList.add('bg-warning');
      b3.classList.add('bg-surface-700');
      label.textContent = 'Kata sandi sedang';
      label.className = 'mt-1 text-xs text-warning transition-colors duration-300';
    } else {
      b1.classList.add('bg-success');
      b2.classList.add('bg-success');
      b3.classList.add('bg-success');
      label.textContent = 'Kata sandi kuat';
      label.className = 'mt-1 text-xs text-success transition-colors duration-300';
    }
  }

  newPwInput?.addEventListener('input', () => {
    updatePasswordStrength(newPwInput.value);
    if (confirmPwInput?.value) validateMatch();
  });

  function validateMatch() {
    if (!newPwInput || !confirmPwInput || !confirmPwError) return true;
    if (confirmPwInput.value && newPwInput.value !== confirmPwInput.value) {
      confirmPwError.textContent = 'Konfirmasi kata sandi tidak cocok.';
      confirmPwError.classList.remove('hidden');
      confirmPwInput.classList.add('border-red-500');
      return false;
    }
    confirmPwError.classList.add('hidden');
    confirmPwInput.classList.remove('border-red-500');
    return true;
  }

  confirmPwInput?.addEventListener('input', validateMatch);

  // ── Reset Password Form Submission ────────────────────────────
  resetForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const newPassword = newPwInput?.value || '';
    const confirmPassword = confirmPwInput?.value || '';

    if (newPassword.length < 6) {
      (window as any).showToast?.({
        message: 'Kata sandi minimal harus 6 karakter.',
        type: 'error',
      });
      newPwInput?.focus();
      return;
    }

    if (newPassword !== confirmPassword) {
      (window as any).showToast?.({
        message: 'Konfirmasi kata sandi tidak cocok. Silakan periksa kembali.',
        type: 'error',
      });
      confirmPwInput?.focus();
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    if (btnText) btnText.textContent = 'Menyimpan...';
    spinner?.classList.remove('hidden');

    const tokenHashVal = clientTokenHash || tokenHashInput?.value || '';
    const codeVal = clientCode || codeInput?.value || '';

    try {
      const res = await fetch('/api/auth/update-password', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          ...(clientAccessToken ? { 'Authorization': `Bearer ${clientAccessToken}` } : {})
        },
        body: JSON.stringify({
          password: newPassword,
          confirm_password: confirmPassword,
          token_hash: tokenHashVal || undefined,
          code: codeVal || undefined,
          access_token: clientAccessToken || undefined,
          refresh_token: clientRefreshToken || undefined,
        }),
      });

      const data = await res.json();

      if (res.ok) {
        // Sign out browser recovery session cleanly
        try {
          const { supabaseBrowser } = await import('../lib/supabase-browser');
          await supabaseBrowser.auth.signOut();
        } catch {
          // ignore
        }

        (window as any).showToast?.({
          message: 'Kata sandi berhasil diperbarui! Mengalihkan ke halaman masuk...',
          type: 'success',
        });

        setTimeout(() => {
          window.location.href = '/signin?reset=success';
        }, 1000);
      } else {
        (window as any).showToast?.({
          message: data.error || 'Gagal mengatur ulang kata sandi.',
          type: 'error',
        });
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Simpan Kata Sandi Baru';
        spinner?.classList.add('hidden');
      }
    } catch {
      (window as any).showToast?.({
        message: 'Kesalahan jaringan. Silakan coba lagi.',
        type: 'error',
      });
      if (submitBtn) submitBtn.disabled = false;
      if (btnText) btnText.textContent = 'Simpan Kata Sandi Baru';
      spinner?.classList.add('hidden');
    }
  });
</script>
