---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Toast from '../components/ui/Toast.astro';
import Modal from '../components/ui/Modal.astro';
import { Sparkles } from 'lucide-astro';

export const prerender = false;

const user = Astro.locals.user;
if (user) {
  return Astro.redirect('/dashboard');
}
---

<BaseLayout title="Masuk — ElCelebrate" description="Masuk untuk melanjutkan dan mengelola kartu perayaanmu di ElCelebrate.">
  <Navbar />
  <Toast />

  <main class="flex min-h-[calc(100dvh-4rem)] items-center justify-center px-4 py-16">
    <!-- Background decoration -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -left-32 -top-32 h-96 w-96 rounded-full bg-primary/5 blur-3xl"></div>
      <div class="absolute -bottom-32 -right-32 h-96 w-96 rounded-full bg-secondary/5 blur-3xl"></div>
    </div>

    <div class="relative w-full max-w-md" style="animation: fade-in-up 0.5s var(--ease-smooth) forwards;">
      <!-- Header -->
      <div class="mb-8 text-center">
        <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-[#f5c563]/25 bg-[#f5c563]/10 text-[#f5c563] shadow-md">
          <Sparkles class="h-7 w-7 text-[#f5c563]" stroke-width="1.5" />
        </div>
        <h1 class="text-2xl font-bold text-surface-50">Selamat Datang Kembali</h1>
        <p class="mt-2 text-sm text-surface-400 leading-relaxed">Masuk untuk melanjutkan dan mengelola kartu perayaanmu di ElCelebrate</p>
      </div>

      <!-- Sign In Form Card -->
      <div class="rounded-2xl border border-white/8 bg-surface-900/60 backdrop-blur-md p-6 sm:p-8 shadow-elevated">
        <form id="login-form" class="flex flex-col gap-5">
          <Input
            label="Email"
            name="email"
            type="email"
            placeholder="nama@email.com"
            required={true}
          />

          <!-- Password field with visibility toggle -->
          <div class="flex flex-col gap-1.5">
            <div class="flex items-center justify-between">
              <label for="input-password" class="text-sm font-medium text-surface-200">
                Kata Sandi <span class="text-confetti-pink">*</span>
              </label>
              <button
                type="button"
                id="open-forgot-modal"
                class="text-xs font-medium text-primary hover:text-primary-light transition-colors cursor-pointer"
              >
                Lupa kata sandi?
              </button>
            </div>
            <div class="relative">
              <input
                type="password"
                name="password"
                id="input-password"
                placeholder="Masukkan kata sandi"
                required
                class="form-input w-full rounded-xl border bg-surface-800/50 px-4 py-2.5 pr-11 text-sm transition-all duration-200 focus-ring"
              />
              <button
                type="button"
                id="toggle-password"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-surface-400 hover:text-surface-200 transition-colors cursor-pointer"
                aria-label="Tampilkan kata sandi"
                tabindex="-1"
              >
                <!-- Eye icon (visible when password is hidden) -->
                <svg id="eye-icon" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <!-- Eye-off icon (visible when password is shown) -->
                <svg id="eye-off-icon" class="h-4.5 w-4.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                </svg>
              </button>
            </div>
          </div>

          <Button type="submit" variant="primary" size="lg" fullWidth={true} id="login-submit-btn">
            <span id="login-btn-text">Masuk</span>
            <svg id="login-spinner" class="hidden h-4.5 w-4.5 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </Button>
        </form>
      </div>

      <p class="mt-6 text-center text-sm text-surface-400">
        Belum punya akun?
        <a href="/signup" class="font-medium text-primary hover:text-primary-light transition-colors">
          Daftar sekarang
        </a>
      </p>
    </div>
  </main>

  <!-- Forgot Password Modal -->
  <Modal id="forgot-password-modal" title="Atur Ulang Kata Sandi" size="sm">
    <form id="forgot-password-form" class="flex flex-col gap-4">
      <p class="text-xs text-surface-300 leading-relaxed">
        Masukkan alamat email terdaftar Anda. Kami akan mengirimkan tautan untuk mengatur ulang kata sandi ke kotak masuk email Anda.
      </p>

      <Input
        label="Alamat Email"
        name="forgot_email"
        type="email"
        placeholder="nama@email.com"
        required={true}
      />

      <div class="mt-2 flex items-center justify-end gap-2.5">
        <button
          type="button"
          class="rounded-xl px-4 py-2 text-xs font-medium text-surface-400 hover:text-white transition-colors cursor-pointer"
          data-modal-close="forgot-password-modal"
        >
          Batal
        </button>
        <Button type="submit" variant="primary" size="sm" id="forgot-submit-btn">
          <span id="forgot-btn-text">Kirim Tautan Atur Ulang</span>
          <svg id="forgot-spinner" class="hidden h-3.5 w-3.5 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </Button>
      </div>
    </form>
  </Modal>

  <Footer />
</BaseLayout>

<script>
  // ── Password Visibility Toggle ────────────────────────────────
  const togglePasswordBtn = document.getElementById('toggle-password');
  const passwordInput = document.getElementById('input-password') as HTMLInputElement | null;
  const eyeIcon = document.getElementById('eye-icon');
  const eyeOffIcon = document.getElementById('eye-off-icon');

  togglePasswordBtn?.addEventListener('click', () => {
    if (!passwordInput) return;
    const isPassword = passwordInput.type === 'password';
    passwordInput.type = isPassword ? 'text' : 'password';
    eyeIcon?.classList.toggle('hidden', isPassword);
    eyeOffIcon?.classList.toggle('hidden', !isPassword);
    togglePasswordBtn.setAttribute('aria-label', isPassword ? 'Sembunyikan kata sandi' : 'Tampilkan kata sandi');
  });

  // ── Login Form Submission ─────────────────────────────────────
  document.getElementById('login-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);
    const btn = document.getElementById('login-submit-btn') as HTMLButtonElement;
    const btnText = document.getElementById('login-btn-text');
    const spinner = document.getElementById('login-spinner');

    btn.disabled = true;
    if (btnText) btnText.textContent = 'Memproses...';
    spinner?.classList.remove('hidden');

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: formData.get('email'),
          password: formData.get('password'),
        }),
      });

      const data = await res.json();

      if (res.ok) {
        if (data.session) {
          try {
            const { supabaseBrowser } = await import('../lib/supabase-browser');
            await supabaseBrowser.auth.setSession({
              access_token: data.session.access_token,
              refresh_token: data.session.refresh_token,
            });
          } catch {
            // Ignore client sync errors
          }
        }
        window.location.href = '/dashboard';
      } else {
        (window as any).showToast({
          message: data.error?.includes('Invalid login')
            ? 'Email atau kata sandi tidak sesuai. Silakan coba lagi.'
            : (data.error || 'Gagal masuk. Silakan coba lagi.'),
          type: 'error',
        });
      }
    } catch {
      (window as any).showToast({ message: 'Kesalahan jaringan. Silakan coba lagi.', type: 'error' });
    } finally {
      btn.disabled = false;
      if (btnText) btnText.textContent = 'Masuk';
      spinner?.classList.add('hidden');
    }
  });

  // ── Forgot Password Modal & Form Submission ───────────────────
  const openForgotModalBtn = document.getElementById('open-forgot-modal');
  const forgotModal = document.getElementById('forgot-password-modal');
  const forgotForm = document.getElementById('forgot-password-form') as HTMLFormElement | null;
  const loginEmailInput = document.querySelector('input[name="email"]') as HTMLInputElement | null;
  const forgotEmailInput = document.querySelector('input[name="forgot_email"]') as HTMLInputElement | null;

  openForgotModalBtn?.addEventListener('click', () => {
    if (loginEmailInput?.value && forgotEmailInput && !forgotEmailInput.value) {
      forgotEmailInput.value = loginEmailInput.value.trim();
    }
    if (forgotModal) {
      forgotModal.classList.remove('hidden');
      forgotModal.classList.add('flex');
      setTimeout(() => forgotEmailInput?.focus(), 50);
    }
  });

  forgotForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(forgotForm);
    const email = (formData.get('forgot_email') as string || '').trim();

    if (!email) {
      (window as any).showToast({ message: 'Alamat email wajib diisi.', type: 'error' });
      return;
    }

    const btn = document.getElementById('forgot-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('forgot-btn-text');
    const spinner = document.getElementById('forgot-spinner');

    if (btn) btn.disabled = true;
    if (btnText) btnText.textContent = 'Mengirim...';
    spinner?.classList.remove('hidden');

    try {
      const res = await fetch('/api/auth/forgot-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });

      const data = await res.json();

      if (res.ok) {
        if (forgotModal) {
          forgotModal.classList.add('hidden');
          forgotModal.classList.remove('flex');
        }
        (window as any).showToast({
          message: data.message || 'Tautan atur ulang kata sandi telah dikirim ke email Anda.',
          type: 'success',
        });
        forgotForm.reset();
      } else {
        (window as any).showToast({
          message: data.error || 'Gagal mengirim tautan atur ulang kata sandi.',
          type: 'error',
        });
      }
    } catch {
      (window as any).showToast({
        message: 'Kesalahan jaringan. Silakan coba lagi.',
        type: 'error',
      });
    } finally {
      if (btn) btn.disabled = false;
      if (btnText) btnText.textContent = 'Kirim Tautan Atur Ulang';
      spinner?.classList.add('hidden');
    }
  });
</script>
