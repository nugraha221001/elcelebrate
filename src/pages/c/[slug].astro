    size: '60px 60px',
  },
  truntum: {
    image: `url("data:image/svg+xml,%3Csvg width='48' height='48' viewBox='0 0 48 48' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='24' cy='24' r='2.2' fill='%23${primaryHex}' fill-opacity='0.06' stroke='%23${primaryHex}' stroke-opacity='0.07' stroke-width='0.8'/%3E%3Ccircle cx='24' cy='24' r='0.8' fill='%23${primaryHex}' fill-opacity='0.07'/%3E%3Cpath d='M24 16c-1.5 2-1.5 4 0 6 1.5-2 1.5-4 0-6zM24 32c-1.5-2-1.5-4 0-6 1.5 2 1.5 4 0 6zM16 24c2-1.5 4-1.5 6 0-2 1.5-4 1.5-6 0zM32 24c-2-1.5-4-1.5-6 0 2 1.5 4 1.5 6 0z' fill='%23${primaryHex}' fill-opacity='0.05' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='0.6'/%3E%3Cpath d='M18 18l3 3M30 18l-3 3M18 30l3-3M30 30l-3-3' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='0.8'/%3E%3Ccircle cx='24' cy='15' r='1.2' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Ccircle cx='24' cy='33' r='1.2' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Ccircle cx='15' cy='24' r='1.2' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Ccircle cx='33' cy='24' r='1.2' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Ccircle cx='17' cy='17' r='1' fill='%23${primaryHex}' fill-opacity='0.05'/%3E%3Ccircle cx='31' cy='17' r='1' fill='%23${primaryHex}' fill-opacity='0.05'/%3E%3Ccircle cx='17' cy='31' r='1' fill='%23${primaryHex}' fill-opacity='0.05'/%3E%3Ccircle cx='31' cy='31' r='1' fill='%23${primaryHex}' fill-opacity='0.05'/%3E%3Ccircle cx='0' cy='0' r='2.2' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Ccircle cx='48' cy='0' r='2.2' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Ccircle cx='0' cy='48' r='2.2' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Ccircle cx='48' cy='48' r='2.2' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Cpath d='M0 0l4 4M48 0l-4 4M0 48l4-4M48 48l-4-4' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='0.8'/%3E%3Cpath d='M24 0l1.5 2-1.5 2-1.5-2zM24 44l1.5 2-1.5 2-1.5-2zM0 24l2 1.5 2-1.5-2-1.5zM44 24l2 1.5 2-1.5-2-1.5z' fill='%23${primaryHex}' fill-opacity='0.05'/%3E%3C/svg%3E")`,
    size: '48px 48px',
  },
  megamendung: {
    image: `url("data:image/svg+xml,%3Csvg width='80' height='40' viewBox='0 0 80 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 30c8-6 16-6 24 0s16 6 24 0 16-6 24 0 8 4 8 4' fill='none' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.5'/%3E%3Cpath d='M-5 24c8-6 16-6 24 0s16 6 24 0 16-6 24 0 8 4 8 4' fill='none' stroke='%23${primaryHex}' stroke-opacity='0.05' stroke-width='1.2'/%3E%3Cpath d='M-10 18c8-6 16-6 24 0s16 6 24 0 16-6 24 0 8 4 8 4' fill='none' stroke='%23${secondaryHex}' stroke-opacity='0.04' stroke-width='1'/%3E%3Cpath d='M-15 12c8-6 16-6 24 0s16 6 24 0 16-6 24 0 8 4 8 4' fill='none' stroke='%23${secondaryHex}' stroke-opacity='0.04' stroke-width='0.8'/%3E%3Ccircle cx='24' cy='28' r='1.5' fill='%23${primaryHex}' fill-opacity='0.05'/%3E%3Ccircle cx='64' cy='28' r='1.5' fill='%23${primaryHex}' fill-opacity='0.05'/%3E%3C/svg%3E")`,
    size: '80px 40px',
  },
  songket: {
    image: `url("data:image/svg+xml,%3Csvg width='48' height='48' viewBox='0 0 48 48' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M24 0L48 24 24 48 0 24Z' fill='none' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.2'/%3E%3Cpath d='M24 6L42 24 24 42 6 24Z' fill='none' stroke='%23${primaryHex}' stroke-opacity='0.05' stroke-width='0.8'/%3E%3Cpath d='M24 12L36 24 24 36 12 24Z' fill='none' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='0.8'/%3E%3Cpath d='M24 18L30 24 24 30 18 24Z' fill='%23${primaryHex}' fill-opacity='0.06' stroke='%23${primaryHex}' stroke-opacity='0.07' stroke-width='0.8'/%3E%3Cpath d='M20 15h8M17 18h14M15 21h18M15 27h18M17 30h14M20 33h8' stroke='%23${primaryHex}' stroke-opacity='0.05' stroke-width='0.7'/%3E%3Cpath d='M0 0l8 8M48 0L40 8M0 48l8-8M48 48L40 40M0 12l12-12M36 0l12 12M0 36l12 12M36 48l12-12' stroke='%23${primaryHex}' stroke-opacity='0.05' stroke-width='0.8'/%3E%3Ccircle cx='24' cy='24' r='1.5' fill='%23${primaryHex}' fill-opacity='0.07'/%3E%3Ccircle cx='0' cy='24' r='1.2' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Ccircle cx='48' cy='24' r='1.2' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Ccircle cx='24' cy='0' r='1.2' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Ccircle cx='24' cy='48' r='1.2' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3C/svg%3E")`,
    size: '48px 48px',
  },
  pucukrebung: {
    image: `url("data:image/svg+xml,%3Csvg width='48' height='48' viewBox='0 0 48 48' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M24 2L46 44H2Z' fill='none' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.2'/%3E%3Cpath d='M24 12L40 42H8Z' fill='none' stroke='%23${primaryHex}' stroke-opacity='0.05' stroke-width='0.8'/%3E%3Cpath d='M24 2v42' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='0.8'/%3E%3Cpath d='M16 26l8-6 8 6M12 34l12-8 12 8M8 42l16-10 16 10' fill='none' stroke='%23${primaryHex}' stroke-opacity='0.05' stroke-width='0.7'/%3E%3Ccircle cx='24' cy='2' r='1.5' fill='%23${primaryHex}' fill-opacity='0.07'/%3E%3Ccircle cx='24' cy='7' r='1' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Cpath d='M0 0l22 22M48 0L26 22' stroke='%23${primaryHex}' stroke-opacity='0.05' stroke-width='0.8'/%3E%3Cpath d='M0 0v10l12 12M48 0v10l-12 12' stroke='%23${primaryHex}' stroke-opacity='0.04' stroke-width='0.6'/%3E%3C/svg%3E")`,
    size: '48px 48px',
  },
  parang: {
    image: `url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M-10 70C5 55 15 45 30 30S55 5 70 -10' fill='none' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.5'/%3E%3Cpath d='M-10 30C5 15 15 5 30 -10' fill='none' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.5'/%3E%3Cpath d='M30 70C45 55 55 45 70 30' fill='none' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.5'/%3E%3Cpath d='M15 45c3-3 6-2 7 0s-2 5-7 0zM45 15c3-3 6-2 7 0s-2 5-7 0z' fill='%23${primaryHex}' fill-opacity='0.05' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='0.8'/%3E%3Cpath d='M-5 25c3-3 6-2 7 0s-2 5-7 0zM35 55c3-3 6-2 7 0s-2 5-7 0z' fill='%23${primaryHex}' fill-opacity='0.05' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='0.8'/%3E%3Ccircle cx='30' cy='30' r='1.5' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Ccircle cx='0' cy='0' r='1.5' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Ccircle cx='60' cy='60' r='1.5' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Ccircle cx='0' cy='60' r='1.5' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Ccircle cx='60' cy='0' r='1.5' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3C/svg%3E")`,
    size: '60px 60px',
  },
  tenun: {
    image: `url("data:image/svg+xml,%3Csvg width='48' height='32' viewBox='0 0 48 32' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 8l12-6 12 6 12-6 12 6M0 24l12 6 12-6 12 6 12-6' fill='none' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.2'/%3E%3Cpath d='M0 12l12-4 12 4 12-4 12 4M0 20l12 4 12-4 12 4 12-4' fill='none' stroke='%23${secondaryHex}' stroke-opacity='0.05' stroke-width='0.8'/%3E%3Cpath d='M12 16h4M24 16h4M36 16h4' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1'/%3E%3Ccircle cx='12' cy='16' r='1.2' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Ccircle cx='36' cy='16' r='1.2' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3C/svg%3E")`,
    size: '48px 32px',
  },
  damask: {
    image: `url("data:image/svg+xml,%3Csvg width='56' height='56' viewBox='0 0 56 56' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M28 8c5 5 5 14 0 18s-5 14 0 18M28 8c-5 5-5 14 0 18s5 14 0 18' fill='none' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.2'/%3E%3Cpath d='M28 14c2 3 2 8 0 10s-2 8 0 10M28 14c-2 3-2 8 0 10s2 8 0 10' fill='none' stroke='%23${secondaryHex}' stroke-opacity='0.04' stroke-width='0.8'/%3E%3Ccircle cx='28' cy='27' r='2' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Ccircle cx='14' cy='27' r='1.2' fill='%23${primaryHex}' fill-opacity='0.05'/%3E%3Ccircle cx='42' cy='27' r='1.2' fill='%23${primaryHex}' fill-opacity='0.05'/%3E%3Cpath d='M0 27c4-4 10-4 14 0s-4 10 0 14M56 27c-4-4-10-4-14 0s4 10 0 14' fill='none' stroke='%23${primaryHex}' stroke-opacity='0.05' stroke-width='0.8'/%3E%3C/svg%3E")`,
    size: '56px 56px',
  },
  arabesque: {
    image: `url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Crect x='21' y='21' width='18' height='18' fill='none' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1'/%3E%3Crect x='21' y='21' width='18' height='18' transform='rotate(45 30 30)' fill='none' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1'/%3E%3Cpath d='M30 0v17M30 43v17M0 30h17M43 30h17' stroke='%23${primaryHex}' stroke-opacity='0.05' stroke-width='0.8'/%3E%3Cpath d='M0 0l18 18M60 0L42 18M0 60l18-18M60 60L42 42' stroke='%23${primaryHex}' stroke-opacity='0.05' stroke-width='0.8'/%3E%3Ccircle cx='30' cy='30' r='1.5' fill='%23${primaryHex}' fill-opacity='0.07'/%3E%3C/svg%3E")`,
    size: '60px 60px',
  },
  constellation: {
    image: `url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='20' cy='20' r='1.5' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Ccircle cx='60' cy='15' r='1' fill='%23${primaryHex}' fill-opacity='0.05'/%3E%3Ccircle cx='45' cy='50' r='1.5' fill='%23${primaryHex}' fill-opacity='0.06'/%3E%3Ccircle cx='10' cy='65' r='1' fill='%23${secondaryHex}' fill-opacity='0.05'/%3E%3Ccircle cx='70' cy='60' r='1.2' fill='%23${primaryHex}' fill-opacity='0.05'/%3E%3Cline x1='20' y1='20' x2='60' y2='15' stroke='%23${primaryHex}' stroke-opacity='0.05' stroke-width='0.5'/%3E%3Cline x1='60' y1='15' x2='45' y2='50' stroke='%23${primaryHex}' stroke-opacity='0.05' stroke-width='0.5'/%3E%3Cline x1='45' y1='50' x2='10' y2='65' stroke='%23${primaryHex}' stroke-opacity='0.04' stroke-width='0.5'/%3E%3C/svg%3E")`,
    size: '80px 80px',
  },
};
const patternEntry = patternMap[theme.backgroundPattern as string];
const bgPattern = patternEntry ? patternEntry.image : 'none';
const bgPatternSize = patternEntry ? patternEntry.size : 'auto';
const ogImage = typedCard.media_urls.length > 0
  ? resolveMediaUrl(typedCard.media_urls[0])
  : '/og-default.png';

// Ambient effect resolution with smart defaults for love & greetings
const resolvedAmbientEffect = (theme as any).ambientEffect && (theme as any).ambientEffect !== 'none'
  ? (theme as any).ambientEffect
  : (typedCard.category === 'love'
      ? 'hearts-petals'
      : (typedCard.category === 'greetings'
          ? (theme.occasion === 'natal-tahun-baru' ? 'snowfall' : 'lanterns')
          : 'none'));

const hasPasscode = Boolean(typedCard.category === 'love' && theme.passcode && theme.passcode.trim().length === 4);
---

<BaseLayout
  title={isWedding && weddingData ? `Wedding of ${weddingData.bride.nickname || weddingData.bride.fullName} & ${weddingData.groom.nickname || weddingData.groom.fullName}` : `${meta?.label || 'Card'} for ${recipientName}`}
  description={typedCard.message.slice(0, 155)}
  ogImage={ogImage}
>
  <!-- Data bridge for client script -->
  <div
    id="card-data"
    data-card-id={typedCard.id}
    data-audio-url={audioUrl || ''}
    data-track-id={trackId}
    data-has-audio={hasAudio ? 'true' : 'false'}
    data-unbox-style={theme.unboxStyle}
    data-is-wedding={isWedding ? 'true' : 'false'}
    data-category={typedCard.category}
    data-passcode={theme.passcode || ''}
    data-has-passcode={hasPasscode ? 'true' : 'false'}
    class="hidden"
  ></div>

  {isWedding && weddingData ? (
    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- WEDDING LUXURY LONG-SCROLL LAYOUT                        -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- Wedding Cover (scroll-locked, 100dvh gatekeeper) -->
    <div
      id="wedding-cover"
      class="fixed inset-0 z-50 flex flex-col items-center justify-center overflow-hidden h-dvh"
      style={`background: linear-gradient(180deg, ${theme.backgroundColor}, ${theme.primaryColor}15, ${theme.secondaryColor}10, ${theme.backgroundColor}); font-family: ${fontFamily}; transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);`}
    >
      <!-- Decorative particles -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-10 left-10 w-2 h-2 rounded-full animate-pulse" style={`background: ${theme.primaryColor}40;`}></div>
        <div class="absolute top-20 right-16 w-1.5 h-1.5 rounded-full animate-pulse" style={`background: ${theme.secondaryColor}50; animation-delay: 0.5s;`}></div>
        <div class="absolute bottom-32 left-20 w-1 h-1 rounded-full animate-pulse" style={`background: ${theme.primaryColor}30; animation-delay: 1s;`}></div>
        <div class="absolute top-1/3 right-8 w-2.5 h-2.5 rounded-full animate-pulse" style={`background: ${theme.secondaryColor}25; animation-delay: 1.5s;`}></div>
      </div>

      <div class="text-center px-6 relative z-10">
        <!-- Wedding ornament -->
        <div class="text-5xl mb-6 animate-bounce" style="animation-duration: 3s;">💍</div>

        <p class="text-xs uppercase tracking-[0.3em] text-surface-400 mb-2" style={`font-family: ${fontFamily};`}>The Wedding of</p>

        <h1 class="text-3xl sm:text-4xl font-bold mb-1 wrap-anywhere max-w-full" style={`color: ${theme.primaryColor}; font-family: ${fontFamily};`}>
          {weddingData.bride.nickname || weddingData.bride.fullName}
        </h1>
        <p class="text-2xl sm:text-3xl font-light text-surface-300 my-1" style={`font-family: ${fontFamily};`}>&</p>
        <h1 class="text-3xl sm:text-4xl font-bold mb-6 wrap-anywhere max-w-full" style={`color: ${theme.secondaryColor}; font-family: ${fontFamily};`}>
          {weddingData.groom.nickname || weddingData.groom.fullName}
        </h1>

        <!-- Always show guest greeting -->
        <div class="mb-6 animate-fade-in-up max-w-full" style="animation-delay: 400ms; opacity: 0; animation-fill-mode: forwards;">
          <p class="text-xs text-surface-500 mb-1">Kepada Yth. Bapak/Ibu/Saudara/i:</p>
          <p class="text-lg font-semibold text-surface-100 wrap-anywhere max-w-full">{guestName}</p>
        </div>

        {weddingData.akadEvent.date && (
          <p class="text-sm text-surface-400 mb-8" style={`font-family: ${fontFamily};`}>
            {new Date(weddingData.akadEvent.date + 'T00:00:00').toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}
          </p>
        )}

        <button
          id="wedding-cover-btn"
          class="group inline-flex items-center gap-2.5 rounded-full px-8 py-3.5 text-sm font-semibold text-white shadow-xl transition-all duration-300 hover:scale-105 hover:shadow-2xl active:scale-[0.98] cursor-pointer"
          style={`background: linear-gradient(135deg, ${theme.primaryColor}, ${theme.secondaryColor}); box-shadow: 0 8px 32px ${theme.primaryColor}40;`}
        >
          <span>Buka Undangan</span>
          <span class="text-lg transition-transform duration-300 group-hover:translate-x-0.5">💌</span>
        </button>
      </div>

      <!-- Scroll hint -->
      <div class="absolute bottom-8 animate-bounce text-surface-500" style="animation-duration: 2s;">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </div>

    <!-- Wedding Content (hidden until cover is dismissed) -->
    <main
      id="wedding-content"
      class="hidden min-h-dvh"
      style={`--primary: ${theme.primaryColor}; --secondary: ${theme.secondaryColor}; background: ${theme.backgroundColor}; background-image: ${bgPattern}; background-size: ${bgPatternSize}; font-family: ${fontFamily};`}
    >
      <!-- Confetti Canvas -->
      <canvas id="confetti-canvas" class="pointer-events-none fixed inset-0 z-(--z-confetti)" style="width:100%;height:100%;"></canvas>

      <!-- Ambient Effect -->
      <AmbientEffect effect={(theme as any).ambientEffect ?? 'none'} />

      <!-- Rotating Music Disc -->
      {hasAudio && (
        <button
          id="audio-toggle"
          class="music-disc"
          style={`background: linear-gradient(135deg, ${theme.primaryColor}, ${theme.secondaryColor});`}
          aria-label="Toggle music"
        >
          <div class="disc-inner">
            <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path id="audio-icon-path" stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
            </svg>
          </div>
        </button>
      )}
      {audioUrl && (
        <audio id="bg-audio" src={audioUrl} loop preload="none">
          <source src={audioUrl} />
        </audio>
      )}

      <!-- Floating Bottom Dock -->
      <nav id="floating-dock" class="floating-dock" aria-label="Section navigation">
        <a href="#couple" title="Mempelai">💑</a>
        <a href="#event" title="Acara">📅</a>
        <a href="#countdown" title="Hitung Mundur">⏳</a>
        <a href="#gallery" title="Galeri">🖼️</a>
        <a href="#gift" title="Amplop Digital">🎁</a>
        <a href="#wishes" title="Ucapan">💬</a>
      </nav>

      <div class="mx-auto max-w-4xl px-4">

        <!-- ── Couple Profile Section ── -->
        <section id="couple" class="py-16 sm:py-20 max-w-2xl mx-auto" data-reveal="fade-up">
        {weddingData.openingGreeting ? (
          <div class="text-center mb-8">
            <p class="text-slate-100 font-normal leading-relaxed text-center max-w-lg mx-auto drop-shadow-xs italic whitespace-pre-line text-sm sm:text-base" style={`font-family: ${fontFamily};`}>
              {weddingData.openingGreeting}
            </p>
          </div>
        ) : (
          <p class="text-center text-xs md:text-sm font-semibold tracking-[0.25em] text-slate-300 uppercase mb-8" style={`font-family: ${fontFamily};`}>
            Bismillahirrahmanirrahim
          </p>
        )}

          <div class="flex flex-col items-center gap-8 sm:flex-row sm:justify-center sm:gap-12">
            <!-- Bride -->
            <div class="text-center flex-1 max-w-50" data-reveal="fade-right" data-reveal-delay="100">
              {typedCard.media_urls.length > 0 && (
                <div class="mx-auto mb-4 h-36 w-36 overflow-hidden rounded-full border-4 shadow-lg" style={`border-color: ${theme.primaryColor}40;`}>
                  <img src={resolveMediaUrl(typedCard.media_urls[0])} alt={weddingData.bride.fullName} class="h-full w-full object-cover" />
                </div>
              )}
              <h2 class="text-xl font-bold" style={`color: ${theme.primaryColor}; font-family: ${fontFamily};`}>
                {weddingData.bride.fullName}
              </h2>
              {weddingData.bride.parents && (
                <p class="text-slate-200 font-normal text-xs md:text-sm mt-1 tracking-wide">Putri dari {weddingData.bride.parents}</p>
              )}
            </div>

            <!-- Separator -->
            <div class="text-4xl font-light" style={`color: ${theme.secondaryColor}60; font-family: ${fontFamily};`} data-reveal="zoom-in" data-reveal-delay="200">&</div>

            <!-- Groom -->
            <div class="text-center flex-1 max-w-50" data-reveal="fade-left" data-reveal-delay="300">
              {typedCard.media_urls.length > 1 && (
                <div class="mx-auto mb-4 h-36 w-36 overflow-hidden rounded-full border-4 shadow-lg" style={`border-color: ${theme.secondaryColor}40;`}>
                  <img src={resolveMediaUrl(typedCard.media_urls[1])} alt={weddingData.groom.fullName} class="h-full w-full object-cover" />
                </div>
              )}
              <h2 class="text-xl font-bold" style={`color: ${theme.secondaryColor}; font-family: ${fontFamily};`}>
                {weddingData.groom.fullName}
              </h2>
              {weddingData.groom.parents && (
                <p class="text-slate-200 font-normal text-xs md:text-sm mt-1 tracking-wide">Putra dari {weddingData.groom.parents}</p>
              )}
            </div>
          </div>
        </section>

        <!-- ── Invitation Message ── -->
        <section class="pb-12 max-w-2xl mx-auto overflow-hidden" data-reveal="fade-up">
          <div
            class="rounded-2xl p-6 sm:p-8 text-center max-w-full overflow-hidden"
            style={`background: ${theme.primaryColor}08; border: 1px solid ${theme.primaryColor}15;`}
          >
            <p class="wrap-anywhere whitespace-pre-wrap max-w-full overflow-hidden text-slate-100 text-sm md:text-base font-medium leading-relaxed" style={`font-family: ${fontFamily};`}>
              {typedCard.message}
            </p>
          </div>
        </section>

        <!-- ── Love Story / Quote ── -->
        {weddingData.loveStory && (
          <section class="pb-12 max-w-2xl mx-auto overflow-hidden" data-reveal="fade-up">
            <div class="text-center w-full max-w-lg mx-auto overflow-hidden">
              <div class="text-4xl mb-4" style={`color: ${theme.primaryColor}30;`}>❝</div>
              <p class="text-slate-100 font-normal leading-relaxed text-center max-w-lg mx-auto drop-shadow-xs italic wrap-anywhere whitespace-pre-wrap overflow-hidden text-sm md:text-base" style={`font-family: ${fontFamily};`}>
                {weddingData.loveStory}
              </p>
              <div class="text-4xl mt-4" style={`color: ${theme.primaryColor}30;`}>❞</div>
            </div>
          </section>
        )}

        <!-- ── Countdown Timer ── -->
        {weddingData.akadEvent.date && (
          <section id="countdown" class="pb-12 max-w-2xl mx-auto" data-reveal="fade-up">
            <div class="text-center">
              <h2 class="mb-4 text-center text-xs md:text-sm font-semibold tracking-[0.25em] text-slate-300 uppercase">Menghitung Hari</h2>
              <div class="countdown-timer flex justify-center gap-3 sm:gap-5" data-target-date={weddingData.akadEvent.date || typedCard.event_date || ''}>
                {['Hari', 'Jam', 'Mnt', 'Dtk'].map((unit, idx) => (
                  <div class="flex flex-col items-center">
                    <div
                      class="flex h-16 w-16 items-center justify-center rounded-xl text-2xl font-bold text-white sm:h-20 sm:w-20 sm:text-3xl"
                      style={`background: linear-gradient(135deg, ${theme.primaryColor}40, ${theme.secondaryColor}30);`}
                      data-countdown={['days', 'hours', 'minutes', 'seconds'][idx]}
                    >
                      --
                    </div>
                    <span class="mt-1.5 text-slate-200 text-xs font-medium tracking-wider">{unit}</span>
                  </div>
                ))}
              </div>
            </div>
          </section>
        )}

        <!-- ── Event Schedule ── -->
        <section id="event" class="pb-12 max-w-2xl mx-auto" data-reveal="fade-up">
          <h2 class="mb-6 text-center text-xs md:text-sm font-semibold tracking-[0.25em] text-slate-300 uppercase">Jadwal Acara</h2>

          <div class="space-y-4">
            <!-- Akad -->
            <div class="rounded-2xl p-5 sm:p-6" style={`background: ${theme.primaryColor}08; border: 1px solid ${theme.primaryColor}15;`}>
              <div class="flex items-center gap-2 mb-3">
                <span class="text-lg">🕌</span>
                <h3 class="text-base font-semibold" style={`color: ${theme.primaryColor};`}>Akad Nikah</h3>
              </div>
              <div class="space-y-1.5 text-sm">
                {weddingData.akadEvent.date && (
                  <p class="text-slate-100 font-medium">📅 {new Date(weddingData.akadEvent.date + 'T00:00:00').toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</p>
                )}
                {(weddingData.akadEvent.timeStart || weddingData.akadEvent.timeEnd) && (
                  <p class="text-slate-100 font-medium">🕐 {weddingData.akadEvent.timeStart || '--:--'} — {weddingData.akadEvent.timeEnd || 'Selesai'}</p>
                )}
                {weddingData.akadEvent.venue && (
                  <p class="font-medium text-slate-100">📍 {weddingData.akadEvent.venue}</p>
                )}
                {weddingData.akadEvent.address && (
                  <p class="text-slate-200 text-xs md:text-sm leading-normal mt-0.5">{weddingData.akadEvent.address}</p>
                )}
              </div>
              {weddingData.akadEvent.mapsUrl && (
                <a
                  href={weddingData.akadEvent.mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-xs font-medium text-white transition-all hover:brightness-110"
                  style={`background: ${theme.primaryColor};`}
                >
                  <span>📍</span> Buka Google Maps
                </a>
              )}
            </div>

            <!-- Resepsi -->
            {(weddingData.receptionEvent.date || weddingData.receptionEvent.venue) && (
              <div class="rounded-2xl p-5 sm:p-6" style={`background: ${theme.secondaryColor}08; border: 1px solid ${theme.secondaryColor}15;`}>
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-lg">🎉</span>
                  <h3 class="text-base font-semibold" style={`color: ${theme.secondaryColor};`}>Resepsi</h3>
                </div>
                <div class="space-y-1.5 text-sm">
                  {weddingData.receptionEvent.date && (
                    <p class="text-slate-100 font-medium">📅 {new Date(weddingData.receptionEvent.date + 'T00:00:00').toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</p>
                  )}
                  {(weddingData.receptionEvent.timeStart || weddingData.receptionEvent.timeEnd) && (
                    <p class="text-slate-100 font-medium">🕐 {weddingData.receptionEvent.timeStart || '--:--'} — {weddingData.receptionEvent.timeEnd || 'Selesai'}</p>
                  )}
                  {weddingData.receptionEvent.venue && (
                    <p class="font-medium text-slate-100">📍 {weddingData.receptionEvent.venue}</p>
                  )}
                  {weddingData.receptionEvent.address && (
                    <p class="text-slate-200 text-xs md:text-sm leading-normal mt-0.5">{weddingData.receptionEvent.address}</p>
                  )}
                </div>
                {weddingData.receptionEvent.mapsUrl && (
                  <a
                    href={weddingData.receptionEvent.mapsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-3 inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-xs font-medium text-white transition-all hover:brightness-110"
                    style={`background: ${theme.secondaryColor};`}
                  >
                    <span>📍</span> Buka Google Maps
                  </a>
                )}
              </div>
            )}

            <!-- Unduh Mantu -->
            {weddingData.unduhMantu?.enabled && (
              <div
                class="border border-white/15 bg-white/5 backdrop-blur-xs rounded-3xl p-5 sm:p-6"
                data-reveal="fade-up"
              >
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-lg">🏡</span>
                  <h3 class="text-base font-semibold" style={`color: ${theme.primaryColor};`}>
                    {weddingData.unduhMantu.title || 'Unduh Mantu'}
                  </h3>
                </div>
                <div class="space-y-1.5 text-sm">
                  {weddingData.unduhMantu.date && (
                    <p class="text-slate-100 font-medium">📅 {new Date(weddingData.unduhMantu.date + 'T00:00:00').toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</p>
                  )}
                  {weddingData.unduhMantu.time && (
                    <p class="text-slate-100 font-medium">🕐 {weddingData.unduhMantu.time}</p>
                  )}
                  {weddingData.unduhMantu.locationName && (
                    <p class="font-medium text-slate-100">📍 {weddingData.unduhMantu.locationName}</p>
                  )}
                  {weddingData.unduhMantu.address && (
                    <p class="text-slate-200 text-xs md:text-sm leading-normal mt-0.5">{weddingData.unduhMantu.address}</p>
                  )}
                </div>
                {weddingData.unduhMantu.mapUrl && (
                  <a
                    href={weddingData.unduhMantu.mapUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-3 inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-xs font-medium text-white transition-all hover:brightness-110"
                    style={`background: ${theme.primaryColor};`}
                  >
                    <span>📍</span> Buka Google Maps
                  </a>
                )}
              </div>
            )}
          </div>
        </section>

        <!-- ── Photo Gallery ── -->
        {typedCard.media_urls.length > 2 && (
          <section id="gallery" class="pb-12" data-reveal="fade-up">
            <div class="text-center mb-8">
              <p class="text-xs uppercase tracking-[0.3em] font-semibold text-slate-300 mb-1">OUR SWEET MOMENTS</p>
              <h2 class="text-3xl md:text-4xl font-serif font-bold tracking-tight bg-linear-to-r from-(--primary) to-(--secondary) bg-clip-text text-transparent inline-block">
                Galeri Foto
              </h2>
              <p class="text-xs md:text-sm text-slate-200/90 font-light max-w-md mx-auto leading-relaxed mt-2 text-center">
                Setiap potret mengabadikan tawa dan cerita, mengiringi langkah kami menuju ikatan suci yang abadi.
              </p>
            </div>
            <div class="w-full max-w-md md:max-w-lg mx-auto flex flex-col gap-8 md:gap-12 px-4 mt-6">
              {typedCard.media_urls.slice(2).map((url, index) => (
                <div class="romantic-photo-wrapper">
                  <div
                    class="border border-white/25 rounded-3xl overflow-hidden shadow-2xl bg-white/5 backdrop-blur-xs relative group gallery-item cursor-pointer"
                    data-gallery-src={resolveMediaUrl(url)}
                  >
                    <!-- Milestone Badge -->
                    <span class="absolute top-4 left-4 z-30 px-3 py-1 rounded-full bg-black/40 backdrop-blur-md border border-white/20 text-[11px] font-medium tracking-widest text-slate-100 uppercase">
                      Momen {index + 1} ✨
                    </span>
                    <!-- Photo -->
                    <img
                      src={resolveMediaUrl(url)}
                      alt={`Galeri Foto ${index + 1}`}
                      loading="lazy"
                      decoding="async"
                      class="w-full aspect-4/5 object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    />
                    <!-- Bottom Gradient CTA -->
                    <div class="absolute inset-x-0 bottom-0 h-24 bg-linear-to-t from-black/50 via-black/20 to-transparent pointer-events-none flex items-end justify-center pb-4 opacity-0 group-hover:opacity-100 transition-opacity duration-400">
                      <span class="text-[11px] text-white/80 tracking-wide font-light">Ketuk untuk perbesar</span>
                    </div>
                  </div>
                  <!-- Dreamy Cloud Veil -->
                  <div class="cloud-veil rounded-3xl"></div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- ── Digital Envelope (Amplop Digital) ── -->
        {(weddingData.digitalEnvelope.bankName || weddingData.digitalEnvelope.accountNumber) && (
          <section id="gift" class="pb-12 max-w-2xl mx-auto" data-reveal="fade-up">
            <h2 class="mb-4 text-center text-xs md:text-sm font-semibold tracking-[0.25em] text-slate-300 uppercase">💰 Amplop Digital</h2>
            <div
              class="rounded-2xl p-5 sm:p-6 text-center"
              style={`background: linear-gradient(135deg, ${theme.primaryColor}10, ${theme.secondaryColor}08); border: 1px solid ${theme.primaryColor}20;`}
            >
              {weddingData.digitalEnvelope.bankName && (
                <p class="text-sm font-semibold text-slate-100 mb-1">{weddingData.digitalEnvelope.bankName}</p>
              )}
              {weddingData.digitalEnvelope.accountNumber && (
                <p class="text-xl font-mono font-bold tracking-wider text-surface-100 mb-1" id="wedding-account-number">
                  {weddingData.digitalEnvelope.accountNumber}
                </p>
              )}
              {weddingData.digitalEnvelope.accountHolder && (
                <p class="text-slate-200 text-xs md:text-sm font-medium mb-4">a.n. {weddingData.digitalEnvelope.accountHolder}</p>
              )}
              <button
                id="copy-account-btn"
                class="inline-flex items-center gap-2 rounded-xl px-5 py-2.5 text-sm font-semibold text-white transition-all hover:brightness-110 active:scale-[0.97] cursor-pointer"
                style={`background: linear-gradient(135deg, ${theme.primaryColor}, ${theme.secondaryColor});`}
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span id="copy-btn-text">Salin Nomor Rekening</span>
              </button>
            </div>
          </section>
        )}

        <!-- ── RSVP & Wish Wall ── -->
        <section id="wishes" class="pb-12 max-w-2xl mx-auto" data-reveal="fade-up">
          <h2 class="mb-6 text-center text-xs md:text-sm font-semibold tracking-[0.25em] text-slate-300 uppercase">
            💬 Ucapan & Doa
          </h2>

          <!-- Submit Wish Form with RSVP -->
          <form id="wish-form" class="mb-8">
            <div class="rounded-2xl p-5" style={`background: ${theme.primaryColor}08; border: 1px solid ${theme.primaryColor}15;`}>
              <input
                type="text"
                id="wish-sender"
                placeholder="Nama Anda"
                required
                class="form-text mb-3 w-full rounded-xl border bg-white/5 px-4 py-2.5 text-sm focus-ring placeholder:text-slate-300 placeholder:opacity-80 focus:border-(--primary) focus:ring-1 focus:ring-(--primary)"
                style={`border-color: ${theme.primaryColor}20;`}
              />

              <!-- Attendance Selector -->
              <div class="mb-3 flex gap-2">
                <label class="flex-1">
                  <input type="radio" name="attendance" value="hadir" class="peer sr-only" />
                  <div class="cursor-pointer rounded-xl border px-4 py-2.5 text-center text-sm transition-all peer-checked:border-emerald-500 peer-checked:bg-emerald-500/10! peer-checked:text-emerald-400 peer-checked:font-medium" style={`background: rgba(255, 255, 255, 0.05); border-color: ${theme.primaryColor}20;`}>
                    ✅ Hadir
                  </div>
                </label>
                <label class="flex-1">
                  <input type="radio" name="attendance" value="berhalangan" class="peer sr-only" />
                  <div class="cursor-pointer rounded-xl border px-4 py-2.5 text-center text-sm transition-all peer-checked:border-amber-500 peer-checked:bg-amber-500/10! peer-checked:text-amber-400 peer-checked:font-medium" style={`background: rgba(255, 255, 255, 0.05); border-color: ${theme.primaryColor}20;`}>
                    🙏 Berhalangan
                  </div>
                </label>
              </div>

              <textarea
                id="wish-message"
                placeholder="Tulis ucapan & doa untuk kedua mempelai..."
                required
                rows="3"
                class="form-text mb-3 w-full resize-none rounded-xl border bg-white/5 px-4 py-3 text-sm focus-ring placeholder:text-slate-300 placeholder:opacity-80 focus:border-(--primary) focus:ring-1 focus:ring-(--primary)"
                style={`border-color: ${theme.primaryColor}20;`}
              ></textarea>
              <button
                type="submit"
                id="wish-submit-btn"
                class="text-white font-semibold shadow-lg shadow-primary/25 hover:brightness-110 active:scale-95 transition-all duration-200 px-6 py-2.5 rounded-full flex items-center justify-center gap-2 cursor-pointer border-0"
                style={`background: linear-gradient(135deg, ${theme.primaryColor}, ${theme.secondaryColor});`}
              >
                <span>Kirim Ucapan</span>
                <span>✨</span>
              </button>
            </div>
          </form>

          <!-- Wishes List -->
          <div id="wishes-container" class="space-y-3 max-w-full overflow-hidden">
            {typedWishes.map((wish) => (
              <div class="rounded-xl p-4 max-w-full overflow-hidden" style={`background: ${theme.primaryColor}06; border: 1px solid ${theme.primaryColor}10;`}>
                <div class="flex items-baseline justify-between gap-2 max-w-full">
                  <span class="text-sm font-semibold text-white wrap-anywhere min-w-0">{wish.sender_name}</span>
                  <span class="text-xs text-surface-500 shrink-0">
                    {new Date(wish.created_at).toLocaleDateString()}
                  </span>
                </div>
                <p class="mt-1.5 text-sm text-slate-200 leading-relaxed wrap-anywhere whitespace-pre-wrap max-w-full overflow-hidden">{wish.message}</p>
              </div>
            ))}
            {typedWishes.length === 0 && (
              <p class="text-slate-200 text-sm font-medium tracking-wide text-center py-4 drop-shadow-xs">
                Jadilah yang pertama mengirim ucapan! 🎉
              </p>
            )}
          </div>
        </section>

        <!-- Footer -->
        <footer class="pb-24 text-center">
          <a
            href="/"
            class="group inline-flex items-center gap-2 rounded-full border border-white/8 bg-surface-900/60 backdrop-blur-md px-4 py-2 text-xs font-medium text-surface-400 transition-all duration-300 hover:border-purple-500/30 hover:bg-surface-800/80 hover:shadow-glow-sm"
          >
            <span>Created with</span>
            <span class="inline-flex items-center gap-1">
              <span class="bg-linear-to-r from-amber-300 via-pink-400 to-purple-400 bg-clip-text text-transparent font-extrabold tracking-tight">El</span><span class="text-white font-bold tracking-tight">Celebrate</span>
              <span class="text-xs transition-transform duration-300 group-hover:scale-125">✨</span>
            </span>
          </a>
        </footer>
      </div>
    </main>
  ) : (
    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- STANDARD CARD LAYOUT (non-wedding)                        -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    {hasPasscode && (
      <!-- Passcode Gate (Enforced before unboxing) -->
      <div
        id="passcode-gate"
        class="fixed inset-0 z-60 flex items-center justify-center p-4 bg-surface-900/90 backdrop-blur-xl transition-all duration-500"
        style={`font-family: ${fontFamily};`}
      >
        <div class="relative w-full max-w-sm rounded-3xl border border-pink-500/30 bg-surface-900/95 p-6 text-center shadow-2xl backdrop-blur-md" style={`box-shadow: 0 10px 40px ${theme.primaryColor}25;`}>
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-pink-500/10 border border-pink-500/20 text-3xl animate-bounce" style="animation-duration: 3s;">
            🔐
          </div>
          <h2 class="text-xl font-bold text-white mb-1" style={`color: ${theme.primaryColor};`}>
            Surat Cinta Terkunci
          </h2>
          <p class="text-xs text-surface-300 mb-6">
            Masukkan 4 digit PIN rahasia untuk membuka pesan ini 💕
          </p>

          <!-- 4 Visual PIN Boxes -->
          <div class="flex justify-center gap-3 mb-4" id="pin-boxes-container">
            <div class="pin-box flex h-14 w-12 items-center justify-center rounded-2xl border-2 border-white/15 bg-surface-800/80 text-2xl font-bold text-white shadow-inner transition-all duration-200" data-pin-idx="0"></div>
            <div class="pin-box flex h-14 w-12 items-center justify-center rounded-2xl border-2 border-white/15 bg-surface-800/80 text-2xl font-bold text-white shadow-inner transition-all duration-200" data-pin-idx="1"></div>
            <div class="pin-box flex h-14 w-12 items-center justify-center rounded-2xl border-2 border-white/15 bg-surface-800/80 text-2xl font-bold text-white shadow-inner transition-all duration-200" data-pin-idx="2"></div>
            <div class="pin-box flex h-14 w-12 items-center justify-center rounded-2xl border-2 border-white/15 bg-surface-800/80 text-2xl font-bold text-white shadow-inner transition-all duration-200" data-pin-idx="3"></div>
          </div>

          <!-- Hidden Input to capture keyboard -->
          <input
            type="password"
            id="pin-hidden-input"
            maxlength="4"
            pattern="[0-9]*"
            inputmode="numeric"
            class="opacity-0 absolute -z-10"
            autocomplete="off"
            autofocus
          />

          <!-- Error Alert -->
          <div id="pin-error-msg" class="hidden text-xs font-semibold text-rose-400 mb-4 transition-all">
            Kode PIN salah, silakan coba lagi! 💔
          </div>

          <!-- Touch Numpad for mobile convenience -->
          <div class="grid grid-cols-3 gap-2.5 max-w-xs mx-auto">
            {['1', '2', '3', '4', '5', '6', '7', '8', '9', '', '0', '⌫'].map((num) => {
              if (!num) return <div class="h-12"></div>;
              return (
                <button
                  type="button"
                  class="numpad-key flex h-12 items-center justify-center rounded-xl border border-white/10 bg-surface-800/60 text-base font-semibold text-surface-200 transition-all duration-150 hover:bg-white/10 active:scale-95 cursor-pointer select-none"
                  data-num={num}
                >
                  {num}
                </button>
              );
            })}
          </div>

          <p class="mt-5 text-[11px] text-surface-400">
            Dibuat dengan cinta untuk <span class="text-pink-300 font-medium">{recipientName}</span>
          </p>
        </div>
      </div>
    )}

    <!-- Envelope Unboxing Overlay -->
    <div
      id="unbox-overlay"
      class="fixed inset-0 z-50 flex items-center justify-center"
      style={`background: linear-gradient(135deg, ${theme.primaryColor}30, ${theme.secondaryColor}20, ${theme.backgroundColor});`}
    >
      <div class="text-center">
        {theme.unboxStyle === 'envelope' && (
          <div id="envelope-container" class="relative cursor-pointer mx-auto" style="width: 280px; height: 200px;">
            <div class="absolute inset-0 rounded-2xl shadow-elevated" style={`background: linear-gradient(135deg, ${theme.primaryColor}80, ${theme.secondaryColor}60);`}>
              <div class="flex h-full items-center justify-center">
                <span class="text-6xl">{meta?.emoji || '🎉'}</span>
              </div>
            </div>
            <div
              id="envelope-flap"
              class="absolute left-0 right-0 top-0 h-1/2 origin-top rounded-t-2xl"
              style={`background: linear-gradient(180deg, ${theme.primaryColor}90, ${theme.primaryColor}70); clip-path: polygon(0 0, 50% 100%, 100% 0);`}
            ></div>
          </div>
        )}

        {theme.unboxStyle === 'giftbox' && (
          <div id="giftbox-container" class="relative cursor-pointer mx-auto" style="width: 220px; height: 240px;">
            <div class="absolute bottom-0 left-2.5 right-2.5 h-40 rounded-xl" style={`background: linear-gradient(135deg, ${theme.primaryColor}80, ${theme.secondaryColor}60);`}>
              <div class="absolute left-1/2 top-0 h-full w-6 -translate-x-1/2" style={`background: ${theme.secondaryColor}90;`}></div>
              <div class="flex h-full items-center justify-center relative z-10">
                <span class="text-5xl">{meta?.emoji || '🎉'}</span>
              </div>
            </div>
            <div
              id="gift-lid"
              class="absolute left-0 right-0 top-15 h-12.5 rounded-xl origin-bottom"
              style={`background: linear-gradient(135deg, ${theme.primaryColor}, ${theme.secondaryColor});`}
            >
              <div class="absolute left-1/2 top-0 h-full w-6 -translate-x-1/2" style={`background: ${theme.secondaryColor};`}></div>
              <div class="absolute left-1/2 -top-5 -translate-x-1/2 text-3xl">🎀</div>
            </div>
          </div>
        )}

        {theme.unboxStyle === 'ribbon' && (
          <div id="ribbon-container" class="relative cursor-pointer mx-auto" style="width: 260px; height: 260px;">
            <div class="absolute inset-0 rounded-2xl shadow-elevated overflow-hidden" style={`background: linear-gradient(135deg, ${theme.primaryColor}80, ${theme.secondaryColor}60);`}>
              <div class="flex h-full items-center justify-center">
                <span class="text-6xl">{meta?.emoji || '🎉'}</span>
              </div>
            </div>
            <div id="ribbon-v" class="absolute left-1/2 top-0 h-full w-8 -translate-x-1/2 origin-top" style={`background: ${theme.secondaryColor}90;`}></div>
            <div id="ribbon-h" class="absolute left-0 top-1/2 h-8 w-full -translate-y-1/2 origin-left" style={`background: ${theme.secondaryColor}90;`}></div>
            <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-4xl z-10">🎀</div>
          </div>
        )}

        <p class="mt-8 text-base font-medium text-surface-200 animate-pulse">
          Tap to open
        </p>
      </div>
    </div>

    <!-- Card Content (hidden until unboxed) -->
    <main
      id="card-content"
      class="hidden min-h-dvh"
      style={`--primary: ${theme.primaryColor}; --secondary: ${theme.secondaryColor}; background: linear-gradient(180deg, ${theme.backgroundColor}, ${theme.primaryColor}10); background-image: ${bgPattern}; background-size: ${bgPatternSize}; font-family: ${fontFamily};`}
    >
      <!-- Confetti Canvas -->
      <canvas id="confetti-canvas" class="pointer-events-none fixed inset-0 z-(--z-confetti)" style="width:100%;height:100%;"></canvas>

      <!-- Ambient Effect -->
      <AmbientEffect effect={resolvedAmbientEffect} />

      <!-- Audio Player (hidden, autoplay-compliant) -->
      {hasAudio && (
        <div id="audio-bar" class="fixed bottom-4 right-4 z-40">
          <button
            id="audio-toggle"
            class="flex h-12 w-12 items-center justify-center rounded-full shadow-lg transition-all hover:scale-110 cursor-pointer"
            style={`background: linear-gradient(135deg, ${theme.primaryColor}, ${theme.secondaryColor});`}
            aria-label="Toggle music"
          >
            <svg id="audio-icon-play" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z" />
            </svg>
            <svg id="audio-icon-mute" class="hidden h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 9.75L19.5 12m0 0l2.25 2.25M19.5 12l2.25-2.25M19.5 12l-2.25 2.25m-10.5-6l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z" />
            </svg>
          </button>
          {audioUrl && (
            <audio id="bg-audio" src={audioUrl} loop preload="none">
              <source src={audioUrl} />
            </audio>
          )}
        </div>
      )}

      <div class="mx-auto w-full max-w-2xl px-4 py-12 sm:py-16 overflow-hidden">
        <!-- Greeting Header -->
        <header class="text-center max-w-full overflow-hidden" data-reveal="fade-up">
          <div class="mb-4 text-6xl sm:text-7xl" data-reveal="zoom-in" data-reveal-delay="100">{meta?.emoji || '🎉'}</div>
          {meta?.label && (
            <div class="mb-3" data-reveal="zoom-in" data-reveal-delay="200">
              <span class="inline-block px-3.5 py-1 rounded-full text-xs font-semibold uppercase tracking-widest bg-white/10 text-white/90 border border-white/15 backdrop-blur-sm">
                {meta.label} ✨
              </span>
            </div>
          )}
          <h1
            class="font-display text-3xl font-bold sm:text-4xl wrap-anywhere max-w-full"
            style={`color: ${theme.primaryColor}; font-size: var(--text-hero);`}
          >
            Happy {meta?.label || 'Celebration'}!
          </h1>
          <p class="mt-2 text-xl text-surface-200 sm:text-2xl wrap-anywhere max-w-full" style="font-family: inherit;">
            Dear <span class="font-semibold wrap-anywhere" style={`color: ${theme.secondaryColor};`}>{recipientName}</span>
          </p>
        </header>

        {/* Category-Specific Milestone / Event Chips */}
        {typedCard.category === 'birthday' && theme.ageMilestone && (
          <div class="mt-4 flex justify-center" data-reveal="zoom-in" data-reveal-delay="250">
            <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold bg-pink-500/15 border border-pink-500/30 text-pink-300 shadow-sm backdrop-blur-sm">
              <span>🎂</span>
              <span>Milestone: {theme.ageMilestone}</span>
            </span>
          </div>
        )}

        {typedCard.category === 'anniversary' && theme.anniversaryMilestone && (
          <div class="mt-4 flex justify-center" data-reveal="zoom-in" data-reveal-delay="250">
            <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold bg-rose-500/15 border border-rose-500/30 text-rose-300 shadow-sm backdrop-blur-sm">
              <span>💍</span>
              <span>{theme.anniversaryMilestone}</span>
            </span>
          </div>
        )}

        {typedCard.category === 'graduation' && (theme.degreeMajor || theme.schoolCampus) && (
          <div class="mt-4 flex flex-col items-center gap-1" data-reveal="zoom-in" data-reveal-delay="250">
            {theme.degreeMajor && (
              <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold bg-blue-500/15 border border-blue-500/30 text-blue-300 shadow-sm backdrop-blur-sm">
                <span>🎓</span>
                <span>{theme.degreeMajor}</span>
              </span>
            )}
            {theme.schoolCampus && (
              <span class="text-xs text-surface-400 font-medium">
                🏛️ {theme.schoolCampus}
              </span>
            )}
          </div>
        )}

        {typedCard.category === 'invitation' && (theme.invitationEventType || theme.invitationTime || theme.invitationVenue) && (
          <div class="mt-6 mx-auto max-w-md rounded-2xl p-4 text-center border backdrop-blur-sm" style={`background: ${theme.primaryColor}0d; border-color: ${theme.primaryColor}25;`} data-reveal="fade-up" data-reveal-delay="250">
            {theme.invitationEventType && (
              <div class="text-sm font-bold text-surface-100 flex items-center justify-center gap-1.5">
                <span>✉️</span> <span>{theme.invitationEventType}</span>
              </div>
            )}
            {theme.invitationTime && (
              <div class="mt-1 text-xs text-surface-300">
                ⏰ {theme.invitationTime}
              </div>
            )}
            {theme.invitationVenue && (
              <div class="mt-1 text-xs text-surface-400">
                📍 {theme.invitationVenue}
              </div>
            )}
          </div>
        )}

        {typedCard.category === 'greetings' && theme.occasion && (
          <div class="mt-4 flex justify-center" data-reveal="zoom-in" data-reveal-delay="250">
            <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold bg-amber-500/15 border border-amber-500/30 text-amber-300 shadow-sm backdrop-blur-sm capitalize">
              <span>🌙</span>
              <span>{theme.occasion.replace(/-/g, ' ')}</span>
            </span>
          </div>
        )}

        <!-- Message -->
        <section class="mt-10 max-w-full overflow-hidden" data-reveal="fade-up">
          <div
            class="rounded-2xl p-6 sm:p-8 max-w-full overflow-hidden"
            style={`background: ${theme.primaryColor}10; border: 1px solid ${theme.primaryColor}20;`}
          >
            <p class="wrap-anywhere whitespace-pre-wrap max-w-full overflow-hidden text-base leading-relaxed text-surface-200 sm:text-lg">
              {typedCard.message}
            </p>
            {typedCard.sender_name && (
              <p class="mt-6 text-right text-sm italic text-surface-400 wrap-anywhere max-w-full">
                With love, <span class="font-medium text-surface-300 wrap-anywhere">{typedCard.sender_name}</span>
              </p>
            )}
            {theme.signature && (
              <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-end gap-2 text-surface-300">
                <span class="text-[11px] uppercase tracking-wider text-surface-400">Salam hangat:</span>
                <span class="font-serif italic text-base sm:text-lg font-medium" style={`color: ${theme.primaryColor}; font-family: ${fontFamily};`}>
                  {theme.signature}
                </span>
              </div>
            )}
          </div>
        </section>

        <!-- Interactive Confession Section (Love Category) -->
        {typedCard.category === 'love' && theme.interactiveConfession?.enabled && (
          <section class="mt-10 max-w-full overflow-hidden" data-reveal="fade-up" id="confession-section">
            <div
              id="confession-card"
              class="relative overflow-hidden rounded-3xl p-6 sm:p-8 text-center backdrop-blur-md shadow-2xl transition-all duration-500"
              style={`background: linear-gradient(135deg, ${theme.primaryColor}15, ${theme.secondaryColor}20, ${theme.backgroundColor}); border: 1px solid ${theme.primaryColor}40; box-shadow: 0 10px 40px ${theme.primaryColor}20;`}
            >
              <div id="confession-question-state">
                <div class="text-4xl sm:text-5xl mb-3 animate-bounce" style="animation-duration: 2.5s;">💘</div>
                <h2 class="text-xl sm:text-2xl font-bold mb-2 text-white" style={`font-family: ${fontFamily};`}>
                  {theme.interactiveConfession.prompt || 'Maukah kamu jadi pasanganku? 💕'}
                </h2>
                <p class="text-xs sm:text-sm text-surface-300 mb-6">Pilih jawabanmu dengan sepenuh hati 💖</p>

                <!-- Button Area for Runaway No and Celebratory Yes -->
                <div id="confession-buttons-container" class="relative flex items-center justify-center gap-4 min-h-24 sm:min-h-28 px-4">
                  <button
                    type="button"
                    id="confession-yes-btn"
                    class="group relative inline-flex items-center gap-2 rounded-full px-7 py-3 text-sm font-bold text-white shadow-lg transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer z-10"
                    style={`background: linear-gradient(135deg, ${theme.primaryColor}, ${theme.secondaryColor}); box-shadow: 0 4px 20px ${theme.primaryColor}50;`}
                  >
                    <span>{theme.interactiveConfession.yesText || 'Iya, Aku Mau! 💖'}</span>
                    <span class="text-base group-hover:scale-125 transition-transform">🥰</span>
                  </button>

                  <button
                    type="button"
                    id="confession-no-btn"
                    class="relative inline-flex items-center gap-1.5 rounded-full px-5 py-2.5 text-xs font-semibold text-surface-300 border border-white/20 bg-surface-800/80 shadow-md transition-all duration-150 cursor-pointer select-none"
                  >
                    <span>{theme.interactiveConfession.noText || 'Nggak Mau 😜'}</span>
                  </button>
                </div>
              </div>

              <!-- Celebratory Accepted State -->
              <div id="confession-celebration-state" class="hidden py-4 animate-fade-in-up">
                <div class="text-5xl sm:text-6xl mb-3 animate-bounce">💍✨🥰</div>
                <h2 class="text-2xl sm:text-3xl font-bold mb-2 text-transparent bg-clip-text" style={`background-image: linear-gradient(135deg, #fff, ${theme.primaryColor}, ${theme.secondaryColor}); font-family: ${fontFamily};`}>
                  She / He Said YES! ❤️
                </h2>
                <p class="text-sm sm:text-base text-surface-200 mt-2 max-w-md mx-auto">
                  Ini adalah awal dari kisah terindah kita. Terima kasih telah memilihku untuk menemani setiap langkahmu! 🌹
                </p>
                <div class="mt-4 inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-pink-500/20 border border-pink-500/30 text-xs font-semibold text-pink-300">
                  <span>🎉 Disahkan dengan cinta abadi</span>
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- Countdown Timer -->
        {typedCard.event_date && (
          <section class="mt-10" data-reveal="fade-up">
            <div class="text-center">
              <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-surface-400">Countdown</h2>
              <div class="countdown-timer flex justify-center gap-3 sm:gap-5" data-target-date={typedCard.event_date}>
                {['Days', 'Hours', 'Min', 'Sec'].map((unit) => (
                  <div class="flex flex-col items-center">
                    <div
                      class="flex h-16 w-16 items-center justify-center rounded-xl text-2xl font-bold text-white sm:h-20 sm:w-20 sm:text-3xl"
                      style={`background: linear-gradient(135deg, ${theme.primaryColor}40, ${theme.secondaryColor}30);`}
                      data-countdown={unit.toLowerCase().replace('min', 'minutes').replace('sec', 'seconds')}
                    >
                      --
                    </div>
                    <span class="mt-1.5 text-xs text-surface-400">{unit}</span>
                  </div>
                ))}
              </div>
            </div>
          </section>
        )}

        <!-- Photo Gallery -->
        {typedCard.media_urls.length > 0 && (
          <section class="mt-10" data-reveal="fade-up">
            <h2 class="mb-4 text-center text-sm font-semibold uppercase tracking-wider text-surface-400">Memories</h2>
            <div class:list={[
              'grid gap-3',
              typedCard.media_urls.length === 1 ? 'grid-cols-1' : 'grid-cols-2',
            ]}>
              {typedCard.media_urls.map((url, i) => (
                <div
                  class="group overflow-hidden rounded-2xl bg-surface-800 cursor-pointer gallery-item"
                  style={`border: 1px solid ${theme.primaryColor}20;`}
                  data-gallery-src={resolveMediaUrl(url)}
                  data-reveal="zoom-in"
                  data-reveal-delay={`${(i % 4) * 100}`}
                >
                  <img
                    src={resolveMediaUrl(url)}
                    alt={`Photo ${i + 1}`}
                    loading="lazy"
                    decoding="async"
                    class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Wish Wall / Guestbook -->
        <section class="mt-12" data-reveal="fade-up">
          <h2 class="mb-6 text-center text-xs md:text-sm font-semibold tracking-[0.25em] text-slate-300 uppercase">
            💬 Wish Wall
          </h2>

          <!-- Submit Wish Form -->
          <form id="wish-form" class="mb-8" data-reveal="fade-up">
            <div class="rounded-2xl p-5" style={`background: ${theme.primaryColor}08; border: 1px solid ${theme.primaryColor}15;`}>
              <input
                type="text"
                id="wish-sender"
                placeholder="Your name"
                required
                class="form-text mb-3 w-full rounded-xl border bg-white/5 px-4 py-2.5 text-sm focus-ring placeholder:text-slate-300 placeholder:opacity-80 focus:border-(--primary) focus:ring-1 focus:ring-(--primary)"
                style={`border-color: ${theme.primaryColor}20;`}
              />
              <textarea
                id="wish-message"
                placeholder="Write your congratulations..."
                required
                rows="3"
                class="form-text mb-3 w-full resize-none rounded-xl border bg-white/5 px-4 py-3 text-sm focus-ring placeholder:text-slate-300 placeholder:opacity-80 focus:border-(--primary) focus:ring-1 focus:ring-(--primary)"
                style={`border-color: ${theme.primaryColor}20;`}
              ></textarea>
              <button
                type="submit"
                id="wish-submit-btn"
                class="text-white font-semibold shadow-lg shadow-primary/25 hover:brightness-110 active:scale-95 transition-all duration-200 px-6 py-2.5 rounded-full flex items-center justify-center gap-2 cursor-pointer border-0"
                style={`background: linear-gradient(135deg, ${theme.primaryColor}, ${theme.secondaryColor});`}
              >
                <span>Send Wishes</span>
                <span>✨</span>
              </button>
            </div>
          </form>

          <!-- Wishes List -->
          <div id="wishes-container" class="space-y-3 max-w-full overflow-hidden">
            {typedWishes.map((wish, idx) => (
              <div class="rounded-xl p-4 max-w-full overflow-hidden" style={`background: ${theme.primaryColor}06; border: 1px solid ${theme.primaryColor}10;`} data-reveal="fade-up" data-reveal-delay={`${Math.min((idx % 5) * 100, 400)}`}>
                <div class="flex items-baseline justify-between gap-2 max-w-full">
                  <span class="text-sm font-semibold text-white wrap-anywhere min-w-0">{wish.sender_name}</span>
                  <span class="text-xs text-surface-500 shrink-0">
                    {new Date(wish.created_at).toLocaleDateString()}
                  </span>
                </div>
                <p class="mt-1.5 text-sm text-slate-200 leading-relaxed wrap-anywhere whitespace-pre-wrap max-w-full overflow-hidden">{wish.message}</p>
              </div>
            ))}
            {typedWishes.length === 0 && (
              <p class="text-slate-200 text-sm font-medium tracking-wide text-center py-4 drop-shadow-xs">
                Be the first to send your wishes! 🎉
              </p>
            )}
          </div>
        </section>

        <!-- Footer -->
        <footer class="mt-16 text-center">
          <a
            href="/"
            class="group inline-flex items-center gap-2 rounded-full border border-white/8 bg-surface-900/60 backdrop-blur-md px-4 py-2 text-xs font-medium text-surface-400 transition-all duration-300 hover:border-purple-500/30 hover:bg-surface-800/80 hover:shadow-glow-sm"
          >
            <span>Created with</span>
            <span class="inline-flex items-center gap-1">
              <span class="bg-linear-to-r from-amber-300 via-pink-400 to-purple-400 bg-clip-text text-transparent font-extrabold tracking-tight">El</span><span class="text-white font-bold tracking-tight">Celebrate</span>
              <span class="text-xs transition-transform duration-300 group-hover:scale-125">✨</span>
            </span>
          </a>
        </footer>
      </div>
    </main>
  )}

  <!-- Fullscreen Image Lightbox Modal -->
  <div
    id="gallery-lightbox"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 backdrop-blur-md p-4 transition-all duration-300 opacity-0"
    role="dialog"
    aria-modal="true"
    aria-label="Preview Foto"
  >
    <button
      id="lightbox-close"
      type="button"
      class="absolute top-5 right-5 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition-all hover:bg-white/20 active:scale-95 cursor-pointer"
      aria-label="Tutup preview"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <div class="relative max-h-[90vh] max-w-[90vw] overflow-hidden flex items-center justify-center" id="lightbox-content">
      <img
        id="lightbox-img"
        src=""
        alt="Preview Foto"
        class="max-h-[90vh] max-w-full rounded-xl object-contain shadow-2xl transition-transform duration-300 scale-95"
      />
    </div>
  </div>
</BaseLayout>

<script>
  import { startSynth, stopSynth } from '../../lib/synth-audio';

  // ═══════════════════════════════════════════════════════
  // Recipient Route — Interactions
  // ═══════════════════════════════════════════════════════

  const dataEl = document.getElementById('card-data') as HTMLElement;
  const cardId = dataEl?.dataset.cardId || '';
  const audioUrl = dataEl?.dataset.audioUrl || '';
  const trackId = dataEl?.dataset.trackId || 'warm-piano';
  const hasAudio = dataEl?.dataset.hasAudio === 'true';
  const unboxStyle = dataEl?.dataset.unboxStyle || 'envelope';
  const isWedding = dataEl?.dataset.isWedding === 'true';
  const cardPasscode = dataEl?.dataset.passcode || '';
  const hasPasscode = dataEl?.dataset.hasPasscode === 'true';

  const passcodeGate = document.getElementById('passcode-gate');
  const overlay = document.getElementById('unbox-overlay');
  const content = document.getElementById('card-content');
  const weddingCover = document.getElementById('wedding-cover');
  const weddingContent = document.getElementById('wedding-content');

  // ═══════════════════════════════════════════════════════
  // Wedding Cover Unlock
  // ═══════════════════════════════════════════════════════
  if (isWedding && weddingCover && weddingContent) {
    document.body.style.overflow = 'hidden';

    document.getElementById('wedding-cover-btn')?.addEventListener('click', () => {
      // Slide cover up and fade out
      weddingCover.style.transform = 'translateY(-100%)';
      weddingCover.style.opacity = '0';
      weddingCover.style.pointerEvents = 'none';

      setTimeout(() => {
        weddingCover.style.display = 'none';
        weddingContent.classList.remove('hidden');
        document.body.style.overflow = '';

        // Smooth scroll to top of content
        window.scrollTo({ top: 0, behavior: 'smooth' });

        // Reveal floating dock & music disc
        const dock = document.getElementById('floating-dock');
        const disc = document.querySelector('.music-disc');
        if (dock) dock.classList.add('dock-visible');
        if (disc) disc.classList.add('disc-visible');

        // Trigger confetti
        triggerConfetti();

        // Start audio (autoplay-compliant: user has interacted)
        if (hasAudio) startAudio();

        // Observe scroll-reveal elements
        setTimeout(() => {
          observeRevealElements();
        }, 100);
      }, 1000);
    });
  }

  // ═══════════════════════════════════════════════════════
  // Copy Account Number (Digital Envelope)
  // ═══════════════════════════════════════════════════════
  // Helper: show invitation toast
  function showInvitationToast(message: string) {
    // Remove any existing toast
    document.querySelectorAll('.invitation-toast').forEach(t => t.remove());
    const toast = document.createElement('div');
    toast.className = 'invitation-toast';
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => {
      toast.classList.add('toast-exit');
      setTimeout(() => toast.remove(), 300);
    }, 2500);
  }

  document.getElementById('copy-account-btn')?.addEventListener('click', async () => {
    const accountEl = document.getElementById('wedding-account-number');
    const btnText = document.getElementById('copy-btn-text');
    if (!accountEl) return;

    try {
      await navigator.clipboard.writeText(accountEl.textContent?.trim() || '');
      if (btnText) {
        btnText.textContent = 'Tersalin! ✅';
        setTimeout(() => { btnText.textContent = 'Salin Nomor Rekening'; }, 2000);
      }
      showInvitationToast('Nomor rekening disalin! ✨');
    } catch {
      // Fallback for older browsers
      const textArea = document.createElement('textarea');
      textArea.value = accountEl.textContent?.trim() || '';
      document.body.appendChild(textArea);
      textArea.select();
      document.execCommand('copy');
      document.body.removeChild(textArea);
      if (btnText) {
        btnText.textContent = 'Tersalin! ✅';
        setTimeout(() => { btnText.textContent = 'Salin Nomor Rekening'; }, 2000);
      }
      showInvitationToast('Nomor rekening disalin! ✨');
    }
  });

  // Standard Unboxing Animation (non-wedding)
  function triggerUnbox() {
    if (!overlay || !content) return;
    if (hasPasscode && passcodeGate && passcodeGate.style.display !== 'none') return;

    if (unboxStyle === 'envelope') {
      const flap = document.getElementById('envelope-flap');
      if (flap) {
        flap.style.transition = 'transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1)';
        flap.style.transform = 'perspective(800px) rotateX(-180deg)';
      }
    } else if (unboxStyle === 'giftbox') {
      const lid = document.getElementById('gift-lid');
      if (lid) {
        lid.style.transition = 'all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1)';
        lid.style.transform = 'perspective(600px) rotateX(-110deg) translateY(-60px)';
        lid.style.opacity = '0';
      }
    } else if (unboxStyle === 'ribbon') {
      const rv = document.getElementById('ribbon-v');
      const rh = document.getElementById('ribbon-h');
      if (rv) {
        rv.style.transition = 'all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1)';
        rv.style.transform = 'translateX(-50%) scaleY(0) translateY(-40px)';
        rv.style.opacity = '0';
      }
      if (rh) {
        rh.style.transition = 'all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s';
        rh.style.transform = 'translateY(-50%) scaleX(0)';
        rh.style.opacity = '0';
      }
    }

    // Fade out overlay and show card
    setTimeout(() => {
      overlay.style.transition = 'opacity 0.5s ease';
      overlay.style.opacity = '0';

      setTimeout(() => {
        overlay.style.display = 'none';
        content.classList.remove('hidden');

        // Trigger confetti
        triggerConfetti();

        // Start audio (autoplay-compliant: user has interacted)
        if (hasAudio) startAudio();

        // Observe scroll-reveal elements
        setTimeout(() => {
          observeRevealElements();
        }, 100);
      }, 500);
    }, 900);
  }

  overlay?.addEventListener('click', triggerUnbox);

  // ═══════════════════════════════════════════════════════
  // Passcode Verification Gate
  // ═══════════════════════════════════════════════════════
  if (hasPasscode && passcodeGate && cardPasscode) {
    let currentPin = '';
    const pinBoxes = document.querySelectorAll<HTMLElement>('.pin-box');
    const pinErrorMsg = document.getElementById('pin-error-msg');
    const pinHiddenInput = document.getElementById('pin-hidden-input') as HTMLInputElement | null;
    const pinBoxesContainer = document.getElementById('pin-boxes-container');

    function updatePinDisplay() {
      pinBoxes.forEach((box, idx) => {
        if (idx < currentPin.length) {
          box.textContent = '•';
          box.classList.add('border-pink-500', 'bg-pink-500/20', 'scale-105');
          box.classList.remove('border-white/15');
        } else {
          box.textContent = '';
          box.classList.remove('border-pink-500', 'bg-pink-500/20', 'scale-105', 'border-emerald-400', 'bg-emerald-500/20', 'text-emerald-300');
          box.classList.add('border-white/15');
        }
      });
    }

    function checkPin() {
      if (currentPin.length !== 4) return;

      if (currentPin === cardPasscode) {
        // Success!
        if (pinErrorMsg) pinErrorMsg.classList.add('hidden');
        pinBoxes.forEach((box) => {
          box.classList.remove('border-pink-500', 'bg-pink-500/20');
          box.classList.add('border-emerald-400', 'bg-emerald-500/20', 'text-emerald-300');
        });

        // Trigger pleasant chime audio
        playChimeAudio();

        const gateEl = passcodeGate;
        setTimeout(() => {
          if (gateEl) {
            gateEl.style.transition = 'opacity 0.5s ease';
            gateEl.style.opacity = '0';
            gateEl.style.pointerEvents = 'none';
            setTimeout(() => {
              gateEl.style.display = 'none';
            }, 500);
          }
        }, 400);
      } else {
        // Error
        if (pinErrorMsg) pinErrorMsg.classList.remove('hidden');
        if (pinBoxesContainer) {
          pinBoxesContainer.classList.add('shake');
          setTimeout(() => {
            pinBoxesContainer.classList.remove('shake');
          }, 450);
        }

        setTimeout(() => {
          currentPin = '';
          if (pinHiddenInput) pinHiddenInput.value = '';
          updatePinDisplay();
        }, 600);
      }
    }

    function handlePinInput(char: string) {
      if (char === '⌫' || char === 'Backspace') {
        if (currentPin.length > 0) {
          currentPin = currentPin.slice(0, -1);
          if (pinHiddenInput) pinHiddenInput.value = currentPin;
          if (pinErrorMsg) pinErrorMsg.classList.add('hidden');
          updatePinDisplay();
        }
      } else if (/^[0-9]$/.test(char)) {
        if (currentPin.length < 4) {
          currentPin += char;
          if (pinHiddenInput) pinHiddenInput.value = currentPin;
          if (pinErrorMsg) pinErrorMsg.classList.add('hidden');
          updatePinDisplay();
          if (currentPin.length === 4) {
            checkPin();
          }
        }
      }
    }

    // Touch Numpad buttons
    document.querySelectorAll('.numpad-key').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const num = (btn as HTMLElement).dataset.num;
        if (num) handlePinInput(num);
      });
    });

    // Hidden input / Physical Keyboard
    pinHiddenInput?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value.replace(/\D/g, '').slice(0, 4);
      currentPin = val;
      updatePinDisplay();
      if (currentPin.length === 4) {
        checkPin();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (!passcodeGate || passcodeGate.style.display === 'none') return;
      if (e.key === 'Backspace') {
        handlePinInput('Backspace');
      } else if (/^[0-9]$/.test(e.key)) {
        handlePinInput(e.key);
      }
    });

    // Keep hidden input focused for desktop typing convenience
    passcodeGate.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.numpad-key')) {
        pinHiddenInput?.focus();
      }
    });
  }

  // ═══════════════════════════════════════════════════════
  // Interactive Confession Logic (Love Category)
  // ═══════════════════════════════════════════════════════
  const confessionYesBtn = document.getElementById('confession-yes-btn');
  const confessionNoBtn = document.getElementById('confession-no-btn');
  const confessionQuestionState = document.getElementById('confession-question-state');
  const confessionCelebrationState = document.getElementById('confession-celebration-state');
  const confessionContainer = document.getElementById('confession-buttons-container');

  if (confessionNoBtn && confessionContainer) {
    const playfulNoTexts = [
      'Nggak Mau 😜',
      'Yakin? 🥺',
      'Coba lagi! 🏃‍♂️',
      'Gak kena! 😝',
      'Pikir dulu~ 🥰',
      'Eits meleset! 💨',
      'Harus mau! 💖',
      'Jangan dong 😭',
    ];
    let runawayCount = 0;

    function runawayNoBtn(e?: Event) {
      if (e) {
        e.preventDefault();
      }
      runawayCount++;

      // Cycle playful text
      const nextText = playfulNoTexts[runawayCount % playfulNoTexts.length];
      const span = confessionNoBtn?.querySelector('span');
      if (span) span.textContent = nextText;

      // Calculate container bounds
      const containerRect = confessionContainer?.getBoundingClientRect();
      const btnRect = confessionNoBtn?.getBoundingClientRect();

      if (containerRect && btnRect && confessionNoBtn) {
        const maxX = Math.max((containerRect.width - btnRect.width) / 2, 40);
        const maxY = 35;

        // Random position inside container
        const randomX = (Math.random() - 0.5) * (maxX * 1.8);
        const randomY = (Math.random() - 0.5) * (maxY * 2);

        confessionNoBtn.style.transition = 'transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1)';
        confessionNoBtn.style.transform = `translate(${randomX}px, ${randomY}px) scale(${Math.max(0.75, 1 - runawayCount * 0.04)})`;
      }

      // Slightly expand Yes button to invite click!
      if (confessionYesBtn) {
        confessionYesBtn.style.transform = `scale(${Math.min(1.25, 1 + runawayCount * 0.05)})`;
      }
    }

    // Trigger on hover and touch attempts
    confessionNoBtn.addEventListener('pointerover', runawayNoBtn);
    confessionNoBtn.addEventListener('mouseenter', runawayNoBtn);
    confessionNoBtn.addEventListener('touchstart', (e) => {
      e.preventDefault();
      runawayNoBtn(e);
    }, { passive: false });
    confessionNoBtn.addEventListener('click', (e) => {
      e.preventDefault();
      runawayNoBtn(e);
    });
  }

  if (confessionYesBtn && confessionQuestionState && confessionCelebrationState) {
    confessionYesBtn.addEventListener('click', () => {
      // Hide question state and reveal celebration state
      confessionQuestionState.style.display = 'none';
      confessionCelebrationState.classList.remove('hidden');

      // Double confetti explosion!
      triggerConfetti();
      setTimeout(triggerConfetti, 400);

      // Play joyful fanfare audio
      playFanfareAudio();
    });
  }

  // ═══════════════════════════════════════════════════════
  // Web Audio Synthesizers for PIN Chime & Celebration Fanfare
  // ═══════════════════════════════════════════════════════
  function getAudioCtx(): AudioContext | null {
    try {
      const AudioCtxClass = window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioCtxClass) return null;
      return new AudioCtxClass();
    } catch {
      return null;
    }
  }

  function playChimeAudio() {
    const ctx = getAudioCtx();
    if (!ctx) return;
    try {
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();

      osc.type = 'sine';
      osc.frequency.setValueAtTime(1318.51, now); // E6
      osc.frequency.setValueAtTime(1975.53, now + 0.12); // B6

      gain.gain.setValueAtTime(0.2, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.5);

      osc.connect(gain);
      gain.connect(ctx.destination);

      osc.start(now);
      osc.stop(now + 0.55);
    } catch {
      // Non-critical audio
    }
  }

  function playFanfareAudio() {
    const ctx = getAudioCtx();
    if (!ctx) return;
    try {
      const now = ctx.currentTime;
      // Joyful celebratory fanfare: C5, E5, G5, C6
      const notes = [
        { freq: 523.25, time: 0, duration: 0.12 },
        { freq: 659.25, time: 0.12, duration: 0.12 },
        { freq: 783.99, time: 0.24, duration: 0.15 },
        { freq: 1046.50, time: 0.40, duration: 0.7 },
      ];

      notes.forEach(({ freq, time, duration }) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();

        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freq, now + time);

        gain.gain.setValueAtTime(0.25, now + time);
        gain.gain.exponentialRampToValueAtTime(0.001, now + time + duration);

        osc.connect(gain);
        gain.connect(ctx.destination);

        osc.start(now + time);
        osc.stop(now + time + duration + 0.05);
      });

      // Supporting harmony chord at climax (E5 + G5 with C6)
      [659.25, 783.99].forEach((freq) => {
        const chordOsc = ctx.createOscillator();
        const chordGain = ctx.createGain();

        chordOsc.type = 'sine';
        chordOsc.frequency.setValueAtTime(freq, now + 0.40);

        chordGain.gain.setValueAtTime(0.15, now + 0.40);
        chordGain.gain.exponentialRampToValueAtTime(0.001, now + 1.1);

        chordOsc.connect(chordGain);
        chordGain.connect(ctx.destination);

        chordOsc.start(now + 0.40);
        chordOsc.stop(now + 1.15);
      });
    } catch {
      // Non-critical audio
    }
  }

  // Confetti
  async function triggerConfetti() {
    try {
      const confetti = (await import('canvas-confetti')).default;
      const canvas = document.getElementById('confetti-canvas') as HTMLCanvasElement | null;
      if (!canvas) return;

      const myConfetti = confetti.create(canvas, { resize: true, useWorker: true });

      // Initial burst
      myConfetti({
        particleCount: 100,
        spread: 70,
        origin: { y: 0.6 },
        colors: ['#c084fc', '#f472b6', '#818cf8', '#ffc75f', '#ff6f91'],
      });

      // Secondary burst
      setTimeout(() => {
        myConfetti({
          particleCount: 50,
          angle: 60,
          spread: 55,
          origin: { x: 0 },
          colors: ['#c084fc', '#f472b6', '#818cf8'],
        });
        myConfetti({
          particleCount: 50,
          angle: 120,
          spread: 55,
          origin: { x: 1 },
          colors: ['#ffc75f', '#ff6f91', '#a3de83'],
        });
      }, 300);
    } catch {
      // Graceful fallback — confetti is non-critical
    }
  }

  // ═══════════════════════════════════════════════════════
  // Resilient Audio Controller & Fallback Management
  // ═══════════════════════════════════════════════════════

  let activeSource: 'none' | 'html5' | 'synth' = 'none';
  let isPlaying = false;
  let audioInitialized = false;

  function updateAudioUI(playing: boolean) {
    const disc = document.querySelector('.music-disc');
    const iconPath = document.getElementById('audio-icon-path');
    if (disc) {
      if (playing) {
        disc.classList.add('is-playing');
      } else {
        disc.classList.remove('is-playing');
      }
    }
    // Update icon: music note when playing, muted icon when paused
    if (iconPath) {
      iconPath.setAttribute('d', playing
        ? 'M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3'
        : 'M17.25 9.75L19.5 12m0 0l2.25 2.25M19.5 12l2.25-2.25M19.5 12l-2.25 2.25m-10.5-6l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z'
      );
    }
  }

  async function fallbackToSynth() {
    if (activeSource === 'synth' && isPlaying) return;

    // Clean up HTML5 audio if active or pending
    const audio = document.getElementById('bg-audio') as HTMLAudioElement | null;
    if (audio) {
      audio.pause();
      // Remove src to stop browser network retries
      audio.removeAttribute('src');
    }

    activeSource = 'synth';
    const started = await startSynth(trackId, 0.35);
    if (started) {
      isPlaying = true;
      updateAudioUI(true);
    } else {
      isPlaying = false;
      updateAudioUI(false);
    }
  }

  function startAudio() {
    if (audioInitialized) return;
    audioInitialized = true;

    const audio = document.getElementById('bg-audio') as HTMLAudioElement | null;
    const toggle = document.getElementById('audio-toggle');

    if (!toggle) return;

    // Check if audioUrl is a direct streamable file URL
    // (excludes web pages like youtube.com, youtu.be, spotify.com which cannot be played by HTML5 <audio>)
    const isDirectAudioUrl =
      audioUrl &&
      !audioUrl.includes('youtube.com') &&
      !audioUrl.includes('youtu.be') &&
      !audioUrl.includes('spotify.com');

    if (audio && isDirectAudioUrl) {
      let fallbackTriggered = false;

      const onAudioError = () => {
        if (fallbackTriggered) return;
        fallbackTriggered = true;
        fallbackToSynth();
      };

      audio.addEventListener('error', onAudioError, { once: true });
      const sourceEl = audio.querySelector('source');
      if (sourceEl) {
        sourceEl.addEventListener('error', onAudioError, { once: true });
      }

      audio.volume = 0.4;
      audio
        .play()
        .then(() => {
          if (!fallbackTriggered) {
            activeSource = 'html5';
            isPlaying = true;
            updateAudioUI(true);
          }
        })
        .catch(() => {
          // Play rejected (e.g. 404, format decode error, network failure)
          onAudioError();
        });
    } else {
      // Missing audio URL, unsupported web link (e.g. YouTube), or no <audio> element:
      // Fallback straight to Web Audio synth
      fallbackToSynth();
    }

    // Floating Sound Control Button (Toggle Play / Pause / Mute)
    toggle.addEventListener('click', async () => {
      if (isPlaying) {
        if (activeSource === 'html5' && audio) {
          audio.pause();
        } else if (activeSource === 'synth') {
          stopSynth();
        }
        isPlaying = false;
        updateAudioUI(false);
      } else {
        if (activeSource === 'html5' && audio) {
          audio
            .play()
            .then(() => {
              isPlaying = true;
              updateAudioUI(true);
            })
            .catch(() => {
              fallbackToSynth();
            });
        } else {
          fallbackToSynth();
        }
      }
    });
  }

  // Countdown Timer
  const countdownEl = document.querySelector('[data-target-date]') as HTMLElement | null;
  if (countdownEl) {
    const rawDate = countdownEl.dataset.targetDate || '';
    const parseableStr = rawDate.length === 10 && !rawDate.includes('T') ? `${rawDate}T00:00:00` : rawDate;
    const target = new Date(parseableStr || countdownEl.dataset.targetDate || '').getTime();

    if (!target || isNaN(target)) {
      countdownEl.style.display = 'none';
      const parentSec = countdownEl.closest('section');
      if (parentSec) parentSec.style.display = 'none';
    } else {
      function updateCountdown() {
        const now = Date.now();
        const diff = target - now;

        if (diff <= 0) {
          countdownEl?.querySelectorAll('[data-countdown]').forEach((el) => {
            el.textContent = '🎉';
          });
          return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        const daysEl = countdownEl?.querySelector('[data-countdown="days"]');
        const hoursEl = countdownEl?.querySelector('[data-countdown="hours"]');
        const minutesEl = countdownEl?.querySelector('[data-countdown="minutes"]');
        const secondsEl = countdownEl?.querySelector('[data-countdown="seconds"]');

        if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
        if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0');
        if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, '0');
      }

      updateCountdown();
      setInterval(updateCountdown, 1000);
    }
  }

  // Wish Form
  document.getElementById('wish-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const sender = document.getElementById('wish-sender') as HTMLInputElement | null;
    const message = document.getElementById('wish-message') as HTMLTextAreaElement | null;
    
    function escapeHtml(str: string): string {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    const btn = document.getElementById('wish-submit-btn') as HTMLButtonElement | null;
    if (!sender || !message || !btn) return;

    const originalBtnHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span>Sending...</span>';

    const sender_name = sender.value;
    let wish_message = message.value;

    // For wedding cards, prepend attendance status
    if (isWedding) {
      const attendance = (document.querySelector('input[name="attendance"]:checked') as HTMLInputElement | null)?.value;
      if (attendance) {
        wish_message = `[${attendance === 'hadir' ? '✅ Hadir' : '🙏 Berhalangan'}] ${wish_message}`;
      }
    }

    try {
      const res = await fetch(`/api/wishes/${cardId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          sender_name,
          message: wish_message,
        }),
      });

      if (!res.ok) throw new Error('Failed to send wish');

      await res.json();

      // Add wish to the list dynamically
      const container = document.getElementById('wishes-container');
      if (container) {
        // Remove "be the first" placeholder
        const placeholder = container.querySelector('p.text-center');
        if (placeholder) placeholder.remove();

        const wishEl = document.createElement('div');
        wishEl.className = 'rounded-xl p-4 animate-fade-in-up max-w-full overflow-hidden';
        wishEl.style.cssText = `background: ${getComputedStyle(document.documentElement).getPropertyValue('--color-primary') || '#c084fc'}06; border: 1px solid ${getComputedStyle(document.documentElement).getPropertyValue('--color-primary') || '#c084fc'}10;`;
        wishEl.innerHTML = `
          <div class="flex items-baseline justify-between gap-2 max-w-full">
            <span class="text-sm font-semibold text-white wrap-anywhere min-w-0">${escapeHtml(sender.value)}</span>
            <span class="text-xs text-surface-500 shrink-0">Just now</span>
          </div>
          <p class="mt-1.5 text-sm text-slate-200 leading-relaxed wrap-anywhere whitespace-pre-wrap max-w-full overflow-hidden">${escapeHtml(wish_message)}</p>
        `;
        container.prepend(wishEl);
      }

      sender.value = '';
      message.value = '';
    } catch {
      alert('Failed to send wish. Please try again.');
    } finally {
      (btn as HTMLButtonElement).disabled = false;
      btn.innerHTML = originalBtnHtml;
    }
  });

  // ═══════════════════════════════════════════════════════
  // Gallery Fullscreen Lightbox
  // ═══════════════════════════════════════════════════════
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxClose = document.getElementById('lightbox-close');

  function openLightbox(src: string) {
    if (!lightbox || !lightboxImg) return;
    lightboxImg.src = src;
    lightbox.classList.remove('hidden');
    void lightbox.offsetHeight; // Force layout recalculation for opacity transition
    lightbox.classList.remove('opacity-0');
    lightbox.classList.add('flex', 'opacity-100');
    lightboxImg.classList.remove('scale-95');
    lightboxImg.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox || !lightboxImg) return;
    lightbox.classList.remove('opacity-100');
    lightbox.classList.add('opacity-0');
    lightboxImg.classList.remove('scale-100');
    lightboxImg.classList.add('scale-95');
    setTimeout(() => {
      lightbox.classList.remove('flex');
      lightbox.classList.add('hidden');
      lightboxImg.src = '';
      document.body.style.overflow = '';
    }, 250);
  }

  document.querySelectorAll('.gallery-item').forEach((item) => {
    item.addEventListener('click', () => {
      const src = (item as HTMLElement).dataset.gallerySrc;
      if (src) openLightbox(src);
    });
  });

  lightboxClose?.addEventListener('click', closeLightbox);

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox || (e.target as HTMLElement).id === 'lightbox-content') {
      closeLightbox();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox && !lightbox.classList.contains('hidden')) {
      closeLightbox();
    }
  });

  // ═════════════════════════════════════════════════════════
  // Romantic Photo Scroll Reveal (IntersectionObserver)
  // ═════════════════════════════════════════════════════════
  const romanticObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          romanticObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll('.romantic-photo-wrapper').forEach((el) => {
    romanticObserver.observe(el);
  });

  // ═════════════════════════════════════════════════════════
  // Lightweight Scroll-Reveal Engine (data-reveal driven)
  // ═════════════════════════════════════════════════════════
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
  );

  function observeRevealElements() {
    document.querySelectorAll('[data-reveal]:not(.revealed)').forEach((el) => {
      revealObserver.observe(el);
    });
  }

  observeRevealElements();
</script>

<style define:vars={{ primary: theme.primaryColor, secondary: theme.secondaryColor }}>
  :root {
    --primary: var(--primary);
    --secondary: var(--secondary);
  }

  /* ── Romantic Cloud Mist & Soft Reveal ── */
  .romantic-photo-wrapper {
    opacity: 0;
    transform: translateY(35px) scale(0.95);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }
  .romantic-photo-wrapper.in-view {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* Dreamy mist veil that dissolves away upon entering view */
  .romantic-photo-wrapper .cloud-veil {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.45) 0%, rgba(255, 235, 240, 0.2) 50%, transparent 80%);
    backdrop-filter: blur(12px);
    pointer-events: none;
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s ease-out;
    opacity: 1;
    transform: scale(1.05);
    z-index: 20;
  }
  .romantic-photo-wrapper.in-view .cloud-veil {
    opacity: 0;
    transform: scale(1.15);
  }

  /* ── Legacy gallery support (non-wedding) ── */
  @keyframes photoReveal {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .gallery-card-reveal {
    animation: photoReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  .group:hover .group-hover\:scale-108 {
    transform: scale(1.08);
  }

  /* ── Form styling ── */
  #wish-sender,
  #wish-message {
    color: #ffffff;
  }

  #wish-sender:focus,
  #wish-message:focus {
    border-color: var(--primary) !important;
  }

  /* ── Shake animation for Passcode error ── */
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-8px); }
    40%, 80% { transform: translateX(8px); }
  }
  .shake {
    animation: shake 0.4s ease-in-out;
  }
</style>
