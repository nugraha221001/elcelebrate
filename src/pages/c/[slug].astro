  let activeSource: 'none' | 'html5' | 'synth' = 'none';
  let isPlaying = false;
  let audioInitialized = false;

  let musicNotesInterval: number | null = null;

  function startMusicNotes() {
    if (musicNotesInterval || !isWedding) return;
    const container = document.getElementById('music-notes-container');
    if (!container) return;

    const notes = ['♪', '♫', '♩', '♬'];

