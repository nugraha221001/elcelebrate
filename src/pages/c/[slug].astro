---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import AmbientEffect from '../../components/ui/AmbientEffect.astro';
import CornerOrnaments from '../../components/ui/CornerOrnaments.astro';
import type { Card, Wish, ThemeConfig } from '../../lib/types';
import { CATEGORY_META, resolveUnboxingStyle } from '../../lib/types';
import { getTrackById, getTrackUrl } from '../../lib/audio-tracks';
import { resolveMediaUrl } from '../../lib/r2';

export const prerender = false;

const { slug } = Astro.params;
const supabase = Astro.locals.supabase;

// Fetch card by slug
const { data: card, error: cardError } = await supabase
  .from('cards')
  .select('*')
  .eq('slug', slug)
  .eq('is_published', true)
  .single();

if (cardError || !card) {
  return new Response(null, { status: 404, statusText: 'Card not found' });
}

// Fetch wishes
const { data: wishes } = await supabase
  .from('wishes')
  .select('*')
  .eq('card_id', card.id)
  .order('created_at', { ascending: false });

const typedCard = card as Card;
const typedWishes = (wishes || []) as Wish[];
const theme = typedCard.theme_config as ThemeConfig;
const meta = CATEGORY_META[typedCard.category as keyof typeof CATEGORY_META];
const customAudioUrl = theme.customAudioUrl ? resolveMediaUrl(theme.customAudioUrl) : null;
const audioTrack = theme.audioTrackId ? getTrackById(theme.audioTrackId) : null;
const defaultTrack = getTrackById(typedCard.category) || null;
const resolvedTrack = audioTrack || defaultTrack;
const audioUrl = customAudioUrl || (resolvedTrack ? getTrackUrl(resolvedTrack.filename) : (theme.externalAudioUrl || `/audio/${typedCard.category}.opus`));
const trackId = customAudioUrl ? 'custom' : (resolvedTrack ? resolvedTrack.id : typedCard.category);
const hasAudio = Boolean(customAudioUrl || audioUrl || theme.externalAudioUrl || resolvedTrack);
const audioStartTime = typeof theme.audioStartTime === 'number' && theme.audioStartTime > 0 ? theme.audioStartTime : 0;

const fontMap: Record<string, string> = {
  sans: "'Inter', sans-serif",
  serif: "'Georgia', serif",
  handwritten: 'cursive',
  display: "'Outfit', sans-serif",
};
const fontFamily = fontMap[theme.fontFamily] || fontMap.sans;

// Wedding-specific data
const isWedding = typedCard.category === 'wedding';
const weddingData = theme.weddingData || null;
const recipientParam = Astro.url.searchParams.get('to');
const recipientName = recipientParam || typedCard.recipient_name;
const guestName = recipientParam || 'Tamu Undangan';
const unboxingStyle = (theme as any).unboxingStyle || theme.unboxStyle || 'gate-split';
const currentUnboxStyle = resolveUnboxingStyle(typedCard.category, (theme as any).unboxingStyle, theme.unboxStyle);
const weddingHeaderTitle = (theme as any).weddingHeaderTitle || "Walimatul 'Urs";
const cornerOrnament = (theme as any).cornerOrnament || (isWedding ? 'botanical' : 'none');

// Anniversary relationship time computation
let anniversaryTime: { years: number; months: number; days: number; isTogether: boolean } | null = null;
if (typedCard.category === 'anniversary' && typedCard.event_date) {
  const start = new Date(typedCard.event_date + (typedCard.event_date.includes('T') ? '' : 'T00:00:00'));
  if (!isNaN(start.getTime())) {
    const now = new Date();
    let y = now.getFullYear() - start.getFullYear();
    let m = now.getMonth() - start.getMonth();
    let d = now.getDate() - start.getDate();
    if (d < 0) {
      m -= 1;
      const prev = new Date(now.getFullYear(), now.getMonth(), 0).getDate();
      d += prev;
    }
    if (m < 0) {
      y -= 1;
      m += 12;
    }
    anniversaryTime = {
      years: Math.max(0, y),
      months: Math.max(0, m),
      days: Math.max(0, d),
      isTogether: start.getTime() <= now.getTime(),
    };
  }
}

function formatGoogleCalendarUrl(event: {
  title: string;
  date?: string;
  timeStart?: string;
  timeEnd?: string;
  venue?: string;
  address?: string;
  description?: string;
}): string {
  if (!event.date) return '#';
  const rawDate = event.date.replace(/-/g, '');
  let startStr = rawDate;
  let endStr = rawDate;

  if (event.timeStart) {
    const sTime = event.timeStart.replace(/:/g, '').padEnd(4, '0') + '00';
    startStr = `${rawDate}T${sTime}`;
    if (event.timeEnd) {
      const eTime = event.timeEnd.replace(/:/g, '').padEnd(4, '0') + '00';
      endStr = `${rawDate}T${eTime}`;
    } else {
      const [sh, sm] = event.timeStart.split(':').map(Number);
      const eh = String(((sh || 0) + 2) % 24).padStart(2, '0');
      const em = String(sm || 0).padStart(2, '0');
      endStr = `${rawDate}T${eh}${em}00`;
    }
  }

  const location = [event.venue, event.address].filter(Boolean).join(', ');
  const query = new URLSearchParams({
    action: 'TEMPLATE',
    text: event.title,
    dates: `${startStr}/${endStr}`,
    ...(location ? { location } : {}),
    ...(event.description ? { details: event.description } : {}),
  });

  return `https://calendar.google.com/calendar/render?${query.toString()}`;
}

