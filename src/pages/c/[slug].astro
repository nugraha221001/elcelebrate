      const randomRotate = (Math.random() - 0.5) * 35;
      const randomScale = 0.85 + Math.random() * 0.35;

      note.style.setProperty('--note-x', `${randomX}px`);
      note.style.setProperty('--note-rot', `${randomRotate}deg`);
      note.style.setProperty('--note-scale', `${randomScale}`);

      container.appendChild(note);

      setTimeout(() => {
        note.remove();
      }, 2000);
    }, 850);
