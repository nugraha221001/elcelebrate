  'imlek': { emoji: '🧧', label: 'Tahun Baru Imlek' },
  'waisak': { emoji: '☸️', label: 'Hari Raya Waisak' },
  'nyepi': { emoji: '🛕', label: 'Hari Raya Nyepi' },
  'kemerdekaan': { emoji: '🇮🇩', label: 'Hari Kemerdekaan RI' },
  'hari-ibu-ayah': { emoji: '💐', label: 'Hari Ibu & Ayah' },
  'get-well-soon': { emoji: '🕊️', label: 'Lekas Sembuh & Doa' },
  'general': { emoji: '✨', label: 'Special Greetings' },
};

// Ambient effect resolution with smart defaults for love & greetings
const resolvedAmbientEffect = (theme as any).ambientEffect && (theme as any).ambientEffect !== 'none'
  ? (theme as any).ambientEffect
  : (typedCard.category === 'love'
      ? 'hearts-petals'
      : (typedCard.category === 'greetings'
          ? (occasionAmbientDefaults[theme.occasion || ''] || 'lanterns')
          : 'none'));

const hasPasscode = Boolean(typedCard.category === 'love' && theme.passcode && theme.passcode.trim().length === 4);

// Birthday milestone – sanitize to pure numeric age (strip suffixes like "th", "Tahun", etc.)
const rawMilestone = (theme.ageMilestone || '') as string;
const birthdayAgeNum = parseInt(rawMilestone.replace(/[^0-9]/g, ''), 10);
const birthdayAge = isNaN(birthdayAgeNum) ? rawMilestone.trim() : String(birthdayAgeNum);
const hasBirthdayAge = birthdayAge.length > 0;
---

<BaseLayout
  title={isWedding && weddingData ? `Wedding of ${weddingData.bride.nickname || weddingData.bride.fullName} & ${weddingData.groom.nickname || weddingData.groom.fullName}` : `${meta?.label || 'Card'} for ${recipientName}`}
  description={typedCard.message.slice(0, 155)}
  ogImage={ogImage}
>
  <!-- Data bridge for client script -->
  <div
    id="card-data"
    data-card-id={typedCard.id}
    data-audio-url={audioUrl || ''}
    data-track-id={trackId}
    data-has-audio={hasAudio ? 'true' : 'false'}
    data-unbox-style={isWedding ? unboxingStyle : currentUnboxStyle}
    data-is-wedding={isWedding ? 'true' : 'false'}
    data-category={typedCard.category}
    data-passcode={theme.passcode || ''}
    data-has-passcode={hasPasscode ? 'true' : 'false'}
    data-audio-start-time={audioStartTime.toString()}
    class="hidden"
  ></div>

  {isWedding && weddingData ? (
    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- WEDDING LUXURY LONG-SCROLL LAYOUT                        -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- Wedding Cover (scroll-locked, 100dvh gatekeeper with grand cinematic unboxing) -->
    <div
      id="wedding-cover"
      data-unboxing-style={unboxingStyle}
      class={`fixed inset-0 z-50 flex items-center justify-center overflow-hidden h-dvh ${unboxingStyle === 'curtain-lift' ? 'curtain-lift-mode' : ''}`}
      style={`font-family: ${fontFamily};`}
    >
      <!-- Center Seam Gold Glow Line (Visual Depth & Seam Detailing - Gate Split Only) -->
      {unboxingStyle !== 'wax-seal' && (
        <div
          id="cover-seam-glow"
          class="cover-seam-glow pointer-events-none absolute inset-y-0 left-1/2 -translate-x-1/2 z-20 w-0.5"
        ></div>
      )}

      <!-- Grand Split Gate Panels with Physical Door Thickness -->
      <div
        id="cover-gate-left"
        class={`cover-gate cover-gate-left absolute inset-y-0 left-0 w-1/2 overflow-hidden pointer-events-none ${unboxingStyle === 'wax-seal' ? 'shadow-none border-none' : 'border-r border-[#f5c563]/40'}`}
        style={`background: linear-gradient(135deg, ${theme.backgroundColor}, ${theme.primaryColor}22, ${theme.backgroundColor});`}
      >
        {unboxingStyle !== 'wax-seal' && (
          <div class="absolute inset-y-0 right-0 w-24 opacity-25 pointer-events-none bg-linear-to-l from-[#f5c563]/30 via-amber-300/10 to-transparent"></div>
        )}
      </div>

      <div
        id="cover-gate-right"
        class={`cover-gate cover-gate-right absolute inset-y-0 right-0 w-1/2 overflow-hidden pointer-events-none ${unboxingStyle === 'wax-seal' ? 'shadow-none border-none' : 'border-l border-[#f5c563]/40'}`}
        style={`background: linear-gradient(225deg, ${theme.backgroundColor}, ${theme.secondaryColor}22, ${theme.backgroundColor});`}
      >
        {unboxingStyle !== 'wax-seal' && (
          <div class="absolute inset-y-0 left-0 w-24 opacity-25 pointer-events-none bg-linear-to-r from-[#f5c563]/30 via-amber-300/10 to-transparent"></div>
        )}
      </div>

      {unboxingStyle === 'wax-seal' && (
        <!-- 3D Perspective Wax Seal Envelope Flap (Decorative Top Edge behind content) -->
        <div class="wax-envelope-perspective absolute top-0 inset-x-0 h-24 sm:h-32 pointer-events-none z-5 flex justify-center overflow-visible">
          <div
            id="envelope-flap"
            class="wax-seal-flap w-full max-w-xl h-full relative"
          >
            <svg class="w-full h-full drop-shadow-md" viewBox="0 0 600 120" preserveAspectRatio="none">
              <defs>
                <linearGradient id="flap-grad" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color={theme.backgroundColor} stop-opacity="0.95" />
                  <stop offset="60%" stop-color={theme.primaryColor} stop-opacity="0.25" />
                  <stop offset="100%" stop-color={theme.primaryColor} stop-opacity="0.45" />
                </linearGradient>
              </defs>
              <polygon points="0,0 600,0 300,115" fill="url(#flap-grad)" stroke="#f5c563" stroke-opacity="0.35" stroke-width="1.2" />
              <line x1="0" y1="0" x2="300" y2="115" stroke="#f5c563" stroke-opacity="0.45" stroke-width="1.2" />
              <line x1="600" y1="0" x2="300" y2="115" stroke="#f5c563" stroke-opacity="0.45" stroke-width="1.2" />
            </svg>
          </div>
        </div>
      )}

      <!-- Backdrop Overlay for smooth fading -->
      <div
        id="cover-backdrop"
        class="absolute inset-0 pointer-events-none transition-opacity duration-1000"
        style={`background: radial-gradient(circle at center, transparent 30%, ${theme.backgroundColor} 90%);`}
      ></div>

      <!-- Decorative particles -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-10 left-10 w-2 h-2 rounded-full animate-pulse" style={`background: ${theme.primaryColor}40;`}></div>
        <div class="absolute top-20 right-16 w-1.5 h-1.5 rounded-full animate-pulse" style={`background: ${theme.secondaryColor}50; animation-delay: 0.5s;`}></div>
        <div class="absolute bottom-32 left-20 w-1 h-1 rounded-full animate-pulse" style={`background: ${theme.primaryColor}30; animation-delay: 1s;`}></div>
        <div class="absolute top-1/3 right-8 w-2.5 h-2.5 rounded-full animate-pulse" style={`background: ${theme.secondaryColor}25; animation-delay: 1.5s;`}></div>
      </div>

      <div id="wedding-cover-content" class="text-center px-6 relative z-20 max-w-lg transition-all duration-700">
        <!-- Hero couple portrait on cover or ornament -->
        {typedCard.media_urls.length > 0 ? (
          <div class="relative mx-auto mb-4 h-36 w-28 sm:h-44 sm:w-34 overflow-hidden rounded-t-full border-2 border-amber-300/40 shadow-2xl shadow-amber-500/10 ring-4 ring-white/10 bg-black/20">
            <img
              id="cover-hero-img"
              src={resolveMediaUrl(typedCard.media_urls[0])}
              alt="Mempelai"
              class="hero-couple-photo h-full w-full object-cover will-change-transform"
            />
            <div class="absolute inset-0 bg-linear-to-t from-black/50 via-transparent to-transparent pointer-events-none"></div>
          </div>
        ) : (
          <div class="text-5xl mb-4 animate-bounce" style="animation-duration: 3s;">💍</div>
        )}

        <p class="text-xs uppercase tracking-[0.3em] text-surface-400 mb-2" style={`font-family: ${fontFamily};`}>{weddingHeaderTitle}</p>

        <h1 class="text-3xl sm:text-4xl font-bold mb-1 wrap-anywhere max-w-full" style={`color: ${theme.primaryColor}; font-family: ${fontFamily};`}>
          {weddingData.bride.nickname || weddingData.bride.fullName}
        </h1>
        <p class="text-2xl sm:text-3xl font-light text-surface-300 my-0.5" style={`font-family: ${fontFamily};`}>&</p>
        <h1 class="text-3xl sm:text-4xl font-bold mb-4 wrap-anywhere max-w-full" style={`color: ${theme.secondaryColor}; font-family: ${fontFamily};`}>
          {weddingData.groom.nickname || weddingData.groom.fullName}
        </h1>

        <!-- Always show guest greeting -->
        <div class="mb-4 animate-fade-in-up max-w-full" style="animation-delay: 400ms; opacity: 0; animation-fill-mode: forwards;">
          <p class="text-xs text-surface-400 mb-1">Kepada Yth. Bapak/Ibu/Saudara/i:</p>
          <p class="text-lg font-semibold text-surface-100 wrap-anywhere max-w-full">{guestName}</p>
        </div>

        {weddingData.akadEvent.date && (
          <p class="text-sm text-surface-400 mb-4" style={`font-family: ${fontFamily};`}>
            {new Date(weddingData.akadEvent.date + 'T00:00:00').toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}
          </p>
        )}

        {unboxingStyle === 'wax-seal' ? (
          <div id="wedding-wax-seal-container" class="relative z-30 mt-3 mb-2 flex flex-col items-center">
            <button
              type="button"
              id="wedding-wax-seal-btn"
              role="button"
              aria-label="Ketuk Segel untuk Membuka Undangan"
              class="wax-seal-medallion wax-seal-pulse group relative flex h-20 w-20 sm:h-22 sm:w-22 items-center justify-center rounded-full shadow-2xl cursor-pointer transition-transform duration-300 hover:scale-105 active:scale-95"
              title="Ketuk Segel untuk Membuka"
            >
              <div class="wax-seal-inner absolute inset-1.5 rounded-full border-2 border-amber-200/50"></div>
              <span class="text-2xl select-none">👑</span>
              <div class="absolute -inset-1.5 rounded-full border border-amber-300/40 animate-ping opacity-25 pointer-events-none"></div>
            </button>
            <span class="mt-2 text-xs font-medium tracking-widest uppercase text-amber-200/90 drop-shadow-xs">Ketuk Segel untuk Membuka</span>
          </div>
        ) : (
          <button
            id="wedding-cover-btn"
            class="group inline-flex items-center gap-2.5 rounded-full px-8 py-3.5 text-sm font-semibold text-white shadow-xl transition-all duration-300 hover:scale-105 hover:shadow-2xl active:scale-[0.98] cursor-pointer"
            style={`background: linear-gradient(135deg, ${theme.primaryColor}, ${theme.secondaryColor}); box-shadow: 0 8px 32px ${theme.primaryColor}40;`}
          >
            <span>Buka Undangan</span>
            <span class="text-lg transition-transform duration-300 group-hover:translate-x-0.5">{unboxingStyle === 'curtain-lift' ? '✨' : '🏛️'}</span>
          </button>
        )}
      </div>

      <!-- Scroll hint -->
      <div id="wedding-cover-hint" class="absolute bottom-8 animate-bounce text-surface-500 transition-opacity duration-500" style="animation-duration: 2s;">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </div>

    <!-- Wedding Content (hidden until cover is dismissed) -->
    <main
      id="wedding-content"
      class="hidden min-h-dvh relative"
      style={`--primary: ${theme.primaryColor}; --secondary: ${theme.secondaryColor}; background: ${theme.backgroundColor}; background-image: ${bgPattern}; background-size: ${bgPatternSize}; font-family: ${fontFamily};`}
    >
      <!-- Confetti Canvas -->
      <canvas id="confetti-canvas" class="pointer-events-none fixed inset-0 z-(--z-confetti)" style="width:100%;height:100%;"></canvas>

      <!-- Ambient Effect -->
      <AmbientEffect effect={resolvedAmbientEffect} />

      <!-- ── Customizable Corner Ornaments (Indonesian Luxury Standard) ── -->
      <CornerOrnaments
        ornament={cornerOrnament}
        primaryColor={theme.primaryColor}
        secondaryColor={theme.secondaryColor}
      />

      <!-- ── Dynamic Vinyl Music Widget ── -->
      {hasAudio && (
        <>
          <!-- Rising Floating Notes Container -->
          <div id="music-notes-container" class="pointer-events-none fixed z-47" style="bottom: 4.25rem; right: 1.25rem; width: 3rem; height: 5rem; overflow: visible;" aria-hidden="true"></div>
          <button
            id="audio-toggle"
            class="music-disc"
            style={`background: linear-gradient(135deg, ${theme.primaryColor}, ${theme.secondaryColor});`}
            aria-label="Toggle music"
          >
            <div class="disc-inner">
              <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path id="audio-icon-path" stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
              </svg>
            </div>
          </button>
        </>
      )}
      {audioUrl && (
        <audio id="bg-audio" src={audioUrl} preload="none">
          <source src={audioUrl} />
        </audio>
      )}

      <!-- Floating Bottom Dock -->
      <nav id="floating-dock" class="floating-dock" aria-label="Section navigation">
        <a href="#mempelai" title="Mempelai">💑</a>
        <a href="#acara" title="Acara">📅</a>
        <a href="#countdown" title="Hitung Mundur">⏳</a>
        <a href="#galeri" title="Galeri">🖼️</a>
        <a href="#amplop" title="Kirim Tanda Kasih">🎁</a>
        <a href="#doa" title="Buku Tamu & Doa Restu">💬</a>
      </nav>

      <div class="mx-auto max-w-4xl px-4">

        <!-- ── Hero Couple Banner with Ken Burns Zoom ── -->
        {typedCard.media_urls.length > 0 && (
          <div class="wedding-reveal reveal-hero pt-10 sm:pt-14 pb-4 text-center">
            <div class="relative mx-auto max-w-sm sm:max-w-md overflow-hidden rounded-t-[120px] rounded-b-3xl border-2 border-amber-300/40 shadow-2xl shadow-amber-500/10 bg-white/5 backdrop-blur-xs ring-4 ring-white/10">
              <div class="aspect-4/5 sm:aspect-3/4 w-full overflow-hidden">
                <img
                  id="hero-couple-img"
                  src={resolveMediaUrl(typedCard.media_urls[0])}
                  alt={`The Wedding of ${weddingData.bride.nickname || weddingData.bride.fullName} & ${weddingData.groom.nickname || weddingData.groom.fullName}`}
                  class="hero-couple-photo hero-photo-init w-full h-full object-cover will-change-transform"
                />
              </div>
              <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/20 to-transparent pointer-events-none"></div>
              <div class="absolute bottom-4 inset-x-0 text-center pointer-events-none px-4">
                <p id="hero-header-badge" class="hero-stagger-text text-xs uppercase tracking-[0.25em] text-amber-200/90 font-medium mb-1">{weddingHeaderTitle}</p>
                <h3 id="hero-couple-names" class="hero-stagger-text text-xl sm:text-2xl font-serif font-bold text-white tracking-wide">
                  {weddingData.bride.nickname || weddingData.bride.fullName} & {weddingData.groom.nickname || weddingData.groom.fullName}
                </h3>
              </div>
            </div>
          </div>
        )}

        <!-- ── Couple Profile Section ── -->
        <section id="mempelai" class="py-10 sm:py-16 pb-28 sm:pb-32 max-w-2xl mx-auto scroll-mt-24">
          <span id="couple" class="sr-only"></span>
        {weddingData.openingGreeting ? (
          <div class="wedding-reveal reveal-heading text-center mb-8">
            <p class="text-slate-100 font-normal leading-relaxed text-center max-w-lg mx-auto drop-shadow-xs italic whitespace-pre-line text-sm sm:text-base" style={`font-family: ${fontFamily};`}>
              {weddingData.openingGreeting}
            </p>
            <div class="champagne-divider"></div>
          </div>
        ) : (
          <div class="wedding-reveal reveal-heading text-center mb-8">
            <p class="text-xs md:text-sm font-semibold tracking-[0.25em] text-slate-300 uppercase" style={`font-family: ${fontFamily};`}>
              Bismillahirrahmanirrahim
            </p>
            <div class="champagne-divider"></div>
          </div>
        )}

          <div class="flex flex-col items-center gap-8 sm:flex-row sm:justify-center sm:gap-12">
            <!-- Bride -->
            <div class="wedding-reveal reveal-portrait portrait-bride text-center flex-1 max-w-50">
              {(typedCard.media_urls[1] || typedCard.media_urls[0]) && (
                <div class="mx-auto mb-4 h-36 w-36 overflow-hidden rounded-full border-4 shadow-lg ring-2 ring-amber-300/30" style={`border-color: ${theme.primaryColor}40;`}>
                  <img src={resolveMediaUrl(typedCard.media_urls[1] || typedCard.media_urls[0])} alt={weddingData.bride.fullName} class="h-full w-full object-cover" />
                </div>
              )}
              <h2 class="text-xl font-bold" style={`color: ${theme.primaryColor}; font-family: ${fontFamily};`}>
                {weddingData.bride.fullName}
              </h2>
              {weddingData.bride.parents && (
                <p class="text-slate-200 font-normal text-xs md:text-sm mt-1 tracking-wide">Putri dari {weddingData.bride.parents}</p>
              )}
            </div>

            <!-- Separator -->
            <div class="wedding-reveal reveal-portrait portrait-sep text-4xl font-light" style={`color: ${theme.secondaryColor}60; font-family: ${fontFamily};`}>&</div>

            <!-- Groom -->
            <div class="wedding-reveal reveal-portrait portrait-groom text-center flex-1 max-w-50">
              {typedCard.media_urls[2] && (
                <div class="mx-auto mb-4 h-36 w-36 overflow-hidden rounded-full border-4 shadow-lg ring-2 ring-amber-300/30" style={`border-color: ${theme.secondaryColor}40;`}>
                  <img src={resolveMediaUrl(typedCard.media_urls[2])} alt={weddingData.groom.fullName} class="h-full w-full object-cover" />
                </div>
              )}
              <h2 class="text-xl font-bold" style={`color: ${theme.secondaryColor}; font-family: ${fontFamily};`}>
                {weddingData.groom.fullName}
              </h2>
              {weddingData.groom.parents && (
                <p class="text-slate-200 font-normal text-xs md:text-sm mt-1 tracking-wide">Putra dari {weddingData.groom.parents}</p>
              )}
            </div>
          </div>
        </section>

        <!-- ── Sacred Quote / Ayat Suci ── -->
        {weddingData.sacredQuote?.quote && weddingData.sacredQuote?.enabled !== false && (
          <section class="py-8 sm:py-12 max-w-2xl mx-auto overflow-hidden px-4">
            <div
              class="wedding-reveal reveal-card rounded-2xl p-6 sm:p-8 text-center max-w-full overflow-hidden border border-white/10 backdrop-blur-md"
              style={`background: ${theme.primaryColor}08;`}
            >
              <p class="text-slate-100 font-serif italic text-sm md:text-base leading-relaxed max-w-lg mx-auto whitespace-pre-line" style={`font-family: ${fontFamily};`}>
                "{weddingData.sacredQuote.quote}"
              </p>
              <div class="champagne-divider my-3"></div>
              {weddingData.sacredQuote.source && (
                <p class="text-xs md:text-sm font-semibold tracking-wider text-amber-300 uppercase">
                  — {weddingData.sacredQuote.source}
                </p>
              )}
            </div>
          </section>
        )}

        <!-- ── Ornamental Golden Filigree Connector Divider (Above Message) ── -->
        <div class="wedding-reveal reveal-heading flex items-center justify-center gap-3 sm:gap-4 max-w-xs sm:max-w-sm mx-auto my-2 sm:my-3 px-4" aria-hidden="true">
          <div class="h-px flex-1 bg-linear-to-r from-transparent via-[#f5c563]/40 to-[#f5c563]/70"></div>
          <svg class="w-5 h-5 sm:w-6 sm:h-6 text-[#f5c563] shrink-0 drop-shadow-[0_0_8px_rgba(245,197,99,0.55)]" viewBox="0 0 24 24" fill="none">
            <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" fill="currentColor" fill-opacity="0.35" stroke="currentColor" stroke-width="1.2" />
            <circle cx="12" cy="12" r="2" fill="currentColor" />
            <circle cx="4" cy="12" r="1" fill="currentColor" fill-opacity="0.7" />
            <circle cx="20" cy="12" r="1" fill="currentColor" fill-opacity="0.7" />
          </svg>
          <div class="h-px flex-1 bg-linear-to-l from-transparent via-[#f5c563]/40 to-[#f5c563]/70"></div>
        </div>

        <!-- ── Invitation Message (Untaian Harapan & Doa) ── -->
        <section class="py-8 sm:py-12 max-w-2xl mx-auto overflow-hidden px-4">
          <!-- Royal Double-Bordered Glass Card -->
          <div
            class="wedding-reveal reveal-card wedding-shimmer-card bg-linear-to-b from-[#1b1728]/90 to-[#120f1d]/90 border border-[#f5c563]/30 rounded-2xl p-6 sm:p-8 relative overflow-hidden backdrop-blur-md shadow-2xl"
          >
            <!-- Inner Decorative Inset Ring -->
            <div class="pointer-events-none absolute inset-2.5 sm:inset-3 rounded-xl ring-1 ring-inset ring-[#f5c563]/15 z-0" aria-hidden="true"></div>

            <!-- Subtle Oversized Watermark Quotation Mark SVG -->
            <div class="pointer-events-none absolute -top-3 -left-2 sm:-top-2 sm:left-2 select-none opacity-10 text-[#f5c563] z-0" aria-hidden="true">
              <svg class="w-24 h-24 sm:w-32 sm:h-32 fill-current" viewBox="0 0 24 24">
                <path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.57-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z"/>
              </svg>
            </div>

            <!-- Formal Section Header Inside Card -->
            <div class="relative z-10 text-center mb-5 sm:mb-6">
              <h2 class="font-serif text-lg sm:text-xl font-bold tracking-wider text-[#f5c563] drop-shadow-[0_0_12px_rgba(245,197,99,0.35)]">
                Untaian Harapan & Doa
              </h2>
              <div class="champagne-divider mt-2"></div>
            </div>

            <!-- Message Typography -->
            <div class="relative z-10">
              <p
                class="wrap-anywhere whitespace-pre-wrap max-w-full overflow-hidden font-serif italic text-sm md:text-base leading-relaxed font-light text-white/90 text-center tracking-wide"
                style={`font-family: ${fontFamily};`}
              >
                {typedCard.message}
              </p>
            </div>
          </div>
        </section>

        <!-- ── Ornamental Golden Filigree Connector Divider (After Message) ── -->
        <div class="wedding-reveal reveal-heading flex items-center justify-center gap-3 sm:gap-4 max-w-xs sm:max-w-sm mx-auto my-2 sm:my-3 px-4" aria-hidden="true">
          <div class="h-px flex-1 bg-linear-to-r from-transparent via-[#f5c563]/40 to-[#f5c563]/70"></div>
