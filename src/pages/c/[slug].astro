---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import AmbientEffect from '../../components/ui/AmbientEffect.astro';
import type { Card, Wish, ThemeConfig } from '../../lib/types';
import { CATEGORY_META } from '../../lib/types';
import { getTrackById, getTrackUrl } from '../../lib/audio-tracks';
import { resolveMediaUrl } from '../../lib/r2';

export const prerender = false;

const { slug } = Astro.params;
const supabase = Astro.locals.supabase;

// Fetch card by slug
const { data: card, error: cardError } = await supabase
  .from('cards')
  .select('*')
  .eq('slug', slug)
  .eq('is_published', true)
  .single();

if (cardError || !card) {
  return new Response(null, { status: 404, statusText: 'Card not found' });
}

// Fetch wishes
const { data: wishes } = await supabase
  .from('wishes')
  .select('*')
  .eq('card_id', card.id)
  .order('created_at', { ascending: false });

const typedCard = card as Card;
const typedWishes = (wishes || []) as Wish[];
const theme = typedCard.theme_config as ThemeConfig;
const meta = CATEGORY_META[typedCard.category as keyof typeof CATEGORY_META];
const customAudioUrl = theme.customAudioUrl ? resolveMediaUrl(theme.customAudioUrl) : null;
const audioTrack = theme.audioTrackId ? getTrackById(theme.audioTrackId) : null;
const audioUrl = customAudioUrl || (audioTrack ? getTrackUrl(audioTrack.filename) : (theme.externalAudioUrl || null));
const trackId = customAudioUrl ? 'custom' : (theme.audioTrackId || (audioTrack ? audioTrack.id : 'warm-piano'));
const hasAudio = Boolean(customAudioUrl || theme.audioTrackId || theme.externalAudioUrl || audioTrack);

const fontMap: Record<string, string> = {
  sans: "'Inter', sans-serif",
  serif: "'Georgia', serif",
  handwritten: 'cursive',
  display: "'Outfit', sans-serif",
};
const fontFamily = fontMap[theme.fontFamily] || fontMap.sans;

// Wedding-specific data
const isWedding = typedCard.category === 'wedding';
const weddingData = theme.weddingData || null;
const recipientParam = Astro.url.searchParams.get('to');
const recipientName = recipientParam || typedCard.recipient_name;
const guestName = recipientParam || 'Tamu Undangan';

// Pattern SVGs
const primaryHex = theme.primaryColor.slice(1);
const secondaryHex = theme.secondaryColor.slice(1);
const patternMap: Record<string, { image: string; size: string }> = {
  kawung: {
    image: `url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cellipse cx='30' cy='20' rx='6' ry='10' fill='%23${primaryHex}' fill-opacity='0.04' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.2'/%3E%3Cellipse cx='30' cy='40' rx='6' ry='10' fill='%23${primaryHex}' fill-opacity='0.04' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.2'/%3E%3Cellipse cx='20' cy='30' rx='10' ry='6' fill='%23${primaryHex}' fill-opacity='0.04' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.2'/%3E%3Cellipse cx='40' cy='30' rx='10' ry='6' fill='%23${primaryHex}' fill-opacity='0.04' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.2'/%3E%3Cellipse cx='0' cy='10' rx='6' ry='10' fill='%23${primaryHex}' fill-opacity='0.04' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.2'/%3E%3Cellipse cx='60' cy='10' rx='6' ry='10' fill='%23${primaryHex}' fill-opacity='0.04' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.2'/%3E%3Cellipse cx='0' cy='50' rx='6' ry='10' fill='%23${primaryHex}' fill-opacity='0.04' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.2'/%3E%3Cellipse cx='60' cy='50' rx='6' ry='10' fill='%23${primaryHex}' fill-opacity='0.04' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.2'/%3E%3Cellipse cx='10' cy='0' rx='10' ry='6' fill='%23${primaryHex}' fill-opacity='0.04' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.2'/%3E%3Cellipse cx='50' cy='0' rx='10' ry='6' fill='%23${primaryHex}' fill-opacity='0.04' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.2'/%3E%3Cellipse cx='10' cy='60' rx='10' ry='6' fill='%23${primaryHex}' fill-opacity='0.04' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.2'/%3E%3Cellipse cx='50' cy='60' rx='10' ry='6' fill='%23${primaryHex}' fill-opacity='0.04' stroke='%23${primaryHex}' stroke-opacity='0.06' stroke-width='1.2'/%3E%3Cpath d