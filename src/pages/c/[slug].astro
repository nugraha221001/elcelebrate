                class="wedding-reveal reveal-card wedding-shimmer-card bg-linear-to-b from-[#1b1728]/90 to-[#120f1d]/90 border border-[#f5c563]/30 rounded-2xl p-6 sm:p-8 text-center relative overflow-hidden backdrop-blur-md shadow-2xl"
              >
                <!-- Inner Decorative Inset Ring -->
                <div class="pointer-events-none absolute inset-2.5 sm:inset-3 rounded-xl ring-1 ring-inset ring-[#f5c563]/15 z-0" aria-hidden="true"></div>

                <!-- Corner Bracket Flourishes -->
                <div class="pointer-events-none absolute top-3 left-3 sm:top-4 sm:left-4 z-0 text-[#f5c563]/60" aria-hidden="true">
                  <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 20 20" fill="none" stroke="currentColor">
                    <path d="M2 18V6a4 4 0 0 1 4-4h12" stroke-width="1.5" stroke-linecap="round" />
                    <circle cx="5" cy="5" r="1.5" fill="currentColor" />
                  </svg>
                </div>
                <div class="pointer-events-none absolute top-3 right-3 sm:top-4 sm:right-4 z-0 text-[#f5c563]/60" aria-hidden="true">
                  <svg class="w-4 h-4 sm:w-5 sm:h-5 rotate-90" viewBox="0 0 20 20" fill="none" stroke="currentColor">
                    <path d="M2 18V6a4 4 0 0 1 4-4h12" stroke-width="1.5" stroke-linecap="round" />
                    <circle cx="5" cy="5" r="1.5" fill="currentColor" />
                  </svg>
                </div>
                <div class="pointer-events-none absolute bottom-3 left-3 sm:bottom-4 sm:left-4 z-0 text-[#f5c563]/60" aria-hidden="true">
                  <svg class="w-4 h-4 sm:w-5 sm:h-5 -rotate-90" viewBox="0 0 20 20" fill="none" stroke="currentColor">
                    <path d="M2 18V6a4 4 0 0 1 4-4h12" stroke-width="1.5" stroke-linecap="round" />
                    <circle cx="5" cy="5" r="1.5" fill="currentColor" />
                  </svg>
                </div>
                <div class="pointer-events-none absolute bottom-3 right-3 sm:bottom-4 sm:right-4 z-0 text-[#f5c563]/60" aria-hidden="true">
                  <svg class="w-4 h-4 sm:w-5 sm:h-5 rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor">
                    <path d="M2 18V6a4 4 0 0 1 4-4h12" stroke-width="1.5" stroke-linecap="round" />
                    <circle cx="5" cy="5" r="1.5" fill="currentColor" />
                  </svg>
                </div>

                <!-- Royal Golden Cultural Insignia (Keraton Floral Crest) -->
                <div class="mx-auto mb-3 flex items-center justify-center relative z-10" aria-hidden="true">
                  <svg class="w-8 h-8 sm:w-9 sm:h-9 text-[#f5c563] drop-shadow-[0_0_10px_rgba(245,197,99,0.5)]" viewBox="0 0 48 48" fill="none" stroke="currentColor">
                    <path d="M24 4C24 4 28 10 28 14C28 16.5 26.2 18 24 18C21.8 18 20 16.5 20 14C20 10 24 4 24 4Z" fill="currentColor" fill-opacity="0.3" stroke="currentColor" stroke-width="1.5" />
                    <path d="M24 44C24 44 28 38 28 34C28 31.5 26.2 30 24 30C21.8 30 20 31.5 20 34C20 38 24 44 24 44Z" fill="currentColor" fill-opacity="0.3" stroke="currentColor" stroke-width="1.5" />
                    <path d="M4 24C4 24 10 28 14 28C16.5 28 18 26.2 18 24C18 21.8 16.5 20 14 20C10 20 4 24 4 24Z" fill="currentColor" fill-opacity="0.3" stroke="currentColor" stroke-width="1.5" />
                    <path d="M44 24C44 24 38 28 34 28C31.5 28 30 26.2 30 24C30 21.8 31.5 20 34 20C38 20 44 24 44 24Z" fill="currentColor" fill-opacity="0.3" stroke="currentColor" stroke-width="1.5" />
                    <circle cx="24" cy="24" r="3.5" fill="currentColor" stroke="currentColor" stroke-width="1.2" />
                    <circle cx="24" cy="24" r="7.5" stroke="currentColor" stroke-width="1" stroke-dasharray="2 2" />
                    <path d="M13 13L16 16M35 13L32 16M13 35L16 32M35 35L32 32" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  </svg>
                </div>

                <!-- Header Styling -->
                <h2 class="relative z-10 text-xs sm:text-sm font-semibold tracking-[0.25em] text-[#f5c563] uppercase drop-shadow-[0_0_12px_rgba(245,197,99,0.45)]">
                  TURUT MENGUNDANG
                </h2>
                <div class="champagne-divider mb-5 sm:mb-6"></div>

                <!-- Family List Layout -->
                <div class="relative z-10 space-y-3 sm:space-y-4 max-w-lg mx-auto">
                  {weddingData.turutMengundang
                    .split(/\r?\n/)
                    .map((l: string) => l.trim())
                    .filter(Boolean)
                    .map((line: string, idx: number) => (
                      <div>
                        {idx > 0 && (
                          <div class="flex items-center justify-center gap-2.5 py-1.5 opacity-70" aria-hidden="true">
                            <div class="h-px w-10 sm:w-16 bg-linear-to-r from-transparent to-[#f5c563]/40"></div>
                            <span class="text-[9px] text-[#f5c563] drop-shadow-[0_0_4px_rgba(245,197,99,0.6)]">✦</span>
                            <div class="h-px w-10 sm:w-16 bg-linear-to-l from-transparent to-[#f5c563]/40"></div>
                          </div>
                        )}
                        <p class="font-serif text-sm sm:text-base text-white/80 leading-relaxed text-center tracking-wide">
                          {line}
                        </p>
                      </div>
                    ))}
                </div>
              </div>
            </section>

            <!-- Ornamental Golden Filigree Connector Divider (Leading to Doa/RSVP) -->
            <div class="wedding-reveal reveal-heading flex items-center justify-center gap-3 sm:gap-4 max-w-xs sm:max-w-sm mx-auto my-2 sm:my-3 px-4" aria-hidden="true">
              <div class="h-px flex-1 bg-linear-to-r from-transparent via-[#f5c563]/40 to-[#f5c563]/70"></div>
              <svg class="w-5 h-5 sm:w-6 sm:h-6 text-[#f5c563] shrink-0 drop-shadow-[0_0_8px_rgba(245,197,99,0.55)]" viewBox="0 0 24 24" fill="none">
                <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" fill="currentColor" fill-opacity="0.35" stroke="currentColor" stroke-width="1.2" />
                <circle cx="12" cy="12" r="2" fill="currentColor" />
                <circle cx="4" cy="12" r="1" fill="currentColor" fill-opacity="0.7" />
                <circle cx="20" cy="12" r="1" fill="currentColor" fill-opacity="0.7" />
              </svg>
              <div class="h-px flex-1 bg-linear-to-l from-transparent via-[#f5c563]/40 to-[#f5c563]/70"></div>
            </div>
          </>
        )}

        <!-- ── RSVP & Wish Wall ── -->
        <section id="doa" class="pb-28 sm:pb-32 max-w-2xl mx-auto px-4 scroll-mt-24">
          <span id="wishes" class="sr-only"></span>
          <div class="wedding-reveal reveal-heading text-center mb-6">
            <h2 class="text-xs md:text-sm font-semibold tracking-[0.25em] text-slate-300 uppercase">
              💬 Buku Tamu & Doa Restu
            </h2>
            <div class="champagne-divider"></div>
          </div>

          <!-- Submit Wish Form with RSVP -->
          <form
            id="wish-form"
            class="wedding-reveal reveal-card reveal-blur-card space-y-3.5 p-5 sm:p-6 rounded-2xl bg-[#181522]/80 border border-white/10 backdrop-blur-md overflow-hidden mb-8"
          >
            <input
              type="text"
              id="wish-sender"
              placeholder="Nama Anda"
              required
              autocomplete="name"
              spellcheck="false"
              class="wish-input"
            />

            <!-- Attendance Selector -->
            <div class="grid grid-cols-2 gap-3 w-full">
              <label class="cursor-pointer">
                <input type="radio" name="attendance" value="hadir" class="sr-only" checked />
                <div class="rsvp-toggle-btn">
                  <span>✅</span>
                  <span>Hadir</span>
                </div>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="attendance" value="berhalangan" class="sr-only" />
                <div class="rsvp-toggle-btn">
                  <span>🙏</span>
                  <span>Berhalangan</span>
                </div>
              </label>
            </div>

            <textarea
              id="wish-message"
              placeholder="Tuliskan untaian doa & restu untuk kedua mempelai..."
              required
              rows="3"
              spellcheck="false"
              autocomplete="off"
              class="wish-input resize-none"
            ></textarea>

            <button
              type="submit"
              id="wish-submit-btn"
              class="w-full py-3.5 px-6 rounded-xl font-semibold flex items-center justify-center gap-2 text-[#0f0d15] bg-linear-to-r from-[#f5c563] to-[#e07a93] hover:brightness-110 active:scale-[0.99] transition-transform shadow-lg shadow-black/20 cursor-pointer"
            >
              <span>Kirim Doa & Restu</span>
              <span>✨</span>
            </button>
          </form>

          <!-- Wishes List -->
          <div id="wishes-container" class="space-y-3 max-w-full overflow-hidden">
            {typedWishes.map((wish, index) => (
              <div
                class="wedding-reveal reveal-card reveal-blur-card rounded-2xl border border-white/10 backdrop-blur-md overflow-hidden p-4 sm:p-5 max-w-full"
                style={`background: ${theme.primaryColor}06; transition-delay: calc(${index % 5} * 80ms);`}
              >
                <div class="flex items-baseline justify-between gap-2 max-w-full">
                  <span class="text-sm font-semibold text-white wrap-anywhere min-w-0">{wish.sender_name}</span>
                  <span class="text-xs text-surface-500 shrink-0">
                    {new Date(wish.created_at).toLocaleDateString()}
                  </span>
                </div>
                <p class="mt-1.5 text-sm text-slate-200 leading-relaxed wrap-anywhere whitespace-pre-wrap max-w-full overflow-hidden">{wish.message}</p>
              </div>
            ))}
            {typedWishes.length === 0 && (
              <p class="text-slate-200 text-sm font-medium tracking-wide text-center py-4 drop-shadow-xs">
                Jadilah yang pertama mengirimkan doa restu! ✨
              </p>
            )}
          </div>
        </section>

        <!-- Footer -->
        <footer class="pb-36 sm:pb-40 text-center">
          <a
            href="/"
            class="group inline-flex items-center gap-2 rounded-full border border-white/8 bg-surface-900/60 backdrop-blur-md px-4 py-2 text-xs font-medium text-surface-400 transition-all duration-300 hover:border-purple-500/30 hover:bg-surface-800/80 hover:shadow-glow-sm"
          >
            <span>Created with</span>
            <span class="inline-flex items-center gap-1">
              <span class="bg-linear-to-r from-amber-300 via-pink-400 to-purple-400 bg-clip-text text-transparent font-extrabold tracking-tight">El</span><span class="text-white font-bold tracking-tight">Celebrate</span>
              <span class="text-xs transition-transform duration-300 group-hover:scale-125">✨</span>
            </span>
          </a>
        </footer>
      </div>
    </main>
  ) : (
    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- STANDARD CARD LAYOUT (non-wedding)                        -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    {hasPasscode && (
      <!-- Passcode Gate (Enforced before unboxing) -->
      <div
        id="passcode-gate"
        class="fixed inset-0 z-60 flex items-center justify-center p-4 bg-surface-900/90 backdrop-blur-xl transition-all duration-500"
        style={`font-family: ${fontFamily};`}
      >
        <div class="relative w-full max-w-sm rounded-3xl border border-pink-500/30 bg-surface-900/95 p-6 text-center shadow-2xl backdrop-blur-md" style={`box-shadow: 0 10px 40px ${theme.primaryColor}25;`}>
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-pink-500/10 border border-pink-500/20 text-3xl animate-bounce" style="animation-duration: 3s;">
            🔐
          </div>
          <h2 class="text-xl font-bold text-white mb-1" style={`color: ${theme.primaryColor};`}>
            Surat Cinta Terkunci
          </h2>
          <p class="text-xs text-surface-300 mb-6">
            Masukkan 4 digit PIN rahasia untuk membuka pesan ini 💕
          </p>

          <!-- 4 Visual PIN Boxes -->
          <div class="flex justify-center gap-3 mb-4" id="pin-boxes-container">
            <div class="pin-box flex h-14 w-12 items-center justify-center rounded-2xl border-2 border-white/15 bg-surface-800/80 text-2xl font-bold text-white shadow-inner transition-all duration-200" data-pin-idx="0"></div>
            <div class="pin-box flex h-14 w-12 items-center justify-center rounded-2xl border-2 border-white/15 bg-surface-800/80 text-2xl font-bold text-white shadow-inner transition-all duration-200" data-pin-idx="1"></div>
            <div class="pin-box flex h-14 w-12 items-center justify-center rounded-2xl border-2 border-white/15 bg-surface-800/80 text-2xl font-bold text-white shadow-inner transition-all duration-200" data-pin-idx="2"></div>
            <div class="pin-box flex h-14 w-12 items-center justify-center rounded-2xl border-2 border-white/15 bg-surface-800/80 text-2xl font-bold text-white shadow-inner transition-all duration-200" data-pin-idx="3"></div>
          </div>

          <!-- Hidden Input to capture keyboard -->
          <input
            type="password"
            id="pin-hidden-input"
            maxlength="4"
            pattern="[0-9]*"
            inputmode="numeric"
            class="opacity-0 absolute -z-10"
            autocomplete="off"
            autofocus
          />

          <!-- Error Alert -->
          <div id="pin-error-msg" class="hidden text-xs font-semibold text-rose-400 mb-4 transition-all">
            Kode PIN salah, silakan coba lagi! 💔
          </div>

          <!-- Touch Numpad for mobile convenience -->
          <div class="grid grid-cols-3 gap-2.5 max-w-xs mx-auto">
            {['1', '2', '3', '4', '5', '6', '7', '8', '9', '', '0', '⌫'].map((num) => {
              if (!num) return <div class="h-12"></div>;
              return (
                <button
                  type="button"
                  class="numpad-key flex h-12 items-center justify-center rounded-xl border border-white/10 bg-surface-800/60 text-base font-semibold text-surface-200 transition-all duration-150 hover:bg-white/10 active:scale-95 cursor-pointer select-none"
                  data-num={num}
                >
                  {num}
                </button>
              );
            })}
          </div>

          <p class="mt-5 text-[11px] text-surface-400">
            Dibuat dengan cinta untuk <span class="text-pink-300 font-medium">{recipientName}</span>
          </p>
        </div>
      </div>
    )}

    <!-- Envelope Unboxing Overlay (Thematic Category Interactions) -->
    <div
      id="unbox-overlay"
      data-unboxing-style={currentUnboxStyle}
      class="fixed inset-0 z-50 flex items-center justify-center p-4 select-none cursor-pointer"
      style={`background: linear-gradient(135deg, ${theme.primaryColor}30, ${theme.secondaryColor}20, ${theme.backgroundColor}); font-family: ${fontFamily};`}
    >
      <div class="text-center max-w-sm w-full mx-auto">
        <!-- 1. Luxury Gift Box Pop (Birthday) -->
        {currentUnboxStyle === 'giftbox-pop' && (
          <div id="giftbox-pop-container" class="relative mx-auto unboxing-perspective-800" style="width: 260px; height: 260px;">
            <div class="absolute inset-0 rounded-3xl border border-white/15 shadow-2xl flex flex-col items-center justify-center overflow-visible" style={`background: linear-gradient(135deg, ${theme.primaryColor}35, ${theme.secondaryColor}25, ${theme.backgroundColor});`}>
              <div id="giftbox-ribbon-v" class="absolute top-0 bottom-0 left-1/2 -translate-x-1/2 w-6 shadow-sm pointer-events-none" style={`background: linear-gradient(180deg, ${theme.secondaryColor}, ${theme.primaryColor});`}></div>
              <div id="giftbox-ribbon-h" class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-6 shadow-sm pointer-events-none" style={`background: linear-gradient(90deg, ${theme.secondaryColor}, ${theme.primaryColor});`}></div>
              
              <!-- 3D Lid Pop Element -->
              <div id="giftbox-lid" class="absolute -top-4 -inset-x-2 h-20 rounded-2xl border border-[#f5c563]/60 shadow-2xl flex items-center justify-center z-10 transition-transform duration-700" style={`background: linear-gradient(135deg, #2a243c, #1a1726);`}>
                <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-5 bg-linear-to-r from-[#f5c563] via-[#ffd885] to-[#f5c563]"></div>
                <!-- Unified Center Medallion Clasp -->
                <div id="giftbox-medallion" class="thematic-medallion thematic-medallion-pulse relative z-10 flex h-18 w-18 items-center justify-center rounded-full border border-[#f5c563]/70 bg-linear-to-br from-[#f5c563]/25 to-[#1b1728] shadow-xl ring-2 ring-[#f5c563]/30">
                  <div class="absolute inset-1 rounded-full border border-[#f5c563]/30 pointer-events-none"></div>
                  <span class="text-3xl filter drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)]">{meta?.emoji || '🎂'}</span>
                </div>
              </div>

              <div class="relative z-5 mt-14 px-3 text-center pointer-events-none">
                <span class="text-[10px] text-[#f5c563] tracking-widest uppercase font-semibold">Special Gift</span>
                <p class="text-xs font-bold text-white truncate max-w-44 mt-0.5">{recipientName || 'Kamu'}</p>
              </div>
            </div>
          </div>
        )}

        <!-- 2. Satin Ribbon Untie (Birthday / Anniversary) -->
        {currentUnboxStyle === 'ribbon-untie' && (
          <div id="ribbon-untie-container" class="relative mx-auto" style="width: 270px; height: 270px;">
            <div class="absolute inset-0 rounded-3xl border border-[#f5c563]/40 shadow-2xl p-6 flex flex-col justify-center items-center overflow-hidden" style={`background: linear-gradient(135deg, ${theme.primaryColor}40, ${theme.secondaryColor}25, ${theme.backgroundColor});`}>
              <div id="ribbon-band-v" class="absolute top-0 bottom-0 left-1/2 -translate-x-1/2 w-9 origin-center shadow-lg" style={`background: linear-gradient(180deg, ${theme.secondaryColor}, #ffd885, ${theme.secondaryColor});`}></div>
              <div id="ribbon-band-h" class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-9 origin-center shadow-lg" style={`background: linear-gradient(90deg, ${theme.secondaryColor}, #ffd885, ${theme.secondaryColor});`}></div>
              <!-- Unified Center Medallion Clasp -->
              <div id="ribbon-medallion" class="thematic-medallion thematic-medallion-pulse relative z-10 flex h-20 w-20 items-center justify-center rounded-full border border-[#f5c563]/80 bg-linear-to-br from-[#f5c563]/30 to-[#1b1728] shadow-2xl ring-2 ring-[#f5c563]/30">
                <div class="absolute inset-1 rounded-full border border-[#f5c563]/30 pointer-events-none"></div>
                <span class="text-3xl filter drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)]">{meta?.emoji || '🎀'}</span>
              </div>
              <p class="text-xs font-semibold text-white/95 relative z-10 mt-3 truncate max-w-44 drop-shadow-md">{recipientName || 'Someone Special'}</p>
            </div>
          </div>
        )}

        <!-- 3. Wax Seal Love Letter (Love) -->
        {currentUnboxStyle === 'wax-seal-letter' && (
          <div id="wax-seal-letter-container" class="relative mx-auto unboxing-perspective-1000" style="width: 290px; height: 210px;">
            <div class="absolute inset-0 rounded-3xl border border-rose-500/35 shadow-2xl p-4 flex flex-col justify-between overflow-visible" style={`background: linear-gradient(135deg, #251a2d, #17111e);`}>
              <!-- 3D Folding Flap -->
              <div id="envelope-flap" class="absolute top-0 inset-x-0 h-28 border-b border-rose-400/40 rounded-t-3xl origin-top z-10 transition-transform duration-800 flex items-end justify-center pb-1" style={`background: linear-gradient(180deg, #2f213b, #1e1526); clip-path: polygon(0 0, 100% 0, 50% 100%);`}>
                <div id="wax-seal-stamp" class="thematic-medallion thematic-medallion-pulse relative translate-y-10 z-20 flex h-18 w-18 items-center justify-center rounded-full border-2 border-[#f5c563]/90 bg-linear-to-br from-[#f5c563]/30 to-[#1b1728] shadow-2xl ring-2 ring-[#f5c563]/40">
                  <div class="absolute inset-1 rounded-full border border-[#f5c563]/40 pointer-events-none"></div>
                  <span class="text-3xl filter drop-shadow-[0_2px_4px_rgba(0,0,0,0.6)]">💌</span>
                </div>
              </div>
              <div id="inner-letter-preview" class="pt-12 text-center transition-transform duration-600">
                <p class="text-xs text-rose-300 font-serif italic">Surat Cinta Tersegel</p>
                <p class="text-sm font-bold text-white truncate mt-0.5">{recipientName || 'Kekasih Hati'}</p>
              </div>
              <div class="text-[10px] text-[#f5c563] italic text-right">{typedCard.sender_name ? `Dari: ${typedCard.sender_name}` : 'Dengan Cinta 💕'}</div>
            </div>
          </div>
        )}

        <!-- 4. Romantic Folded Note (Love) -->
        {currentUnboxStyle === 'folded-note' && (
          <div id="folded-note-container" class="relative mx-auto unboxing-perspective-800" style="width: 270px; height: 230px;">
            <div class="absolute inset-0 rounded-2xl border border-white/20 shadow-2xl p-6 flex flex-col justify-center items-center overflow-visible bg-linear-to-b from-[#fdfbf7] via-[#f7f3ea] to-[#efe9db] text-surface-900">
              <div id="folded-top-flap" class="absolute top-0 inset-x-0 h-1/2 bg-white/40 border-b border-amber-800/20 origin-top rounded-t-2xl transition-transform duration-700"></div>
              <div id="folded-note-seal" class="thematic-medallion thematic-medallion-pulse relative z-10 flex h-18 w-18 items-center justify-center rounded-full border border-[#f5c563]/80 bg-linear-to-br from-[#f5c563]/30 to-[#1b1728] shadow-xl">
                <span class="text-3xl">📜</span>
              </div>
              <p class="text-xs font-serif italic text-amber-950 font-bold mt-3 relative z-10">{recipientName || 'Untukmu'}</p>
            </div>
          </div>
        )}

        <!-- 5. Royal Diploma Scroll (Graduation) -->
        {currentUnboxStyle === 'diploma-scroll' && (
          <div id="diploma-scroll-container" class="relative mx-auto flex items-center justify-center" style="width: 290px; height: 210px;">
            <div id="diploma-scroll-body" class="relative w-64 h-32 rounded-xl border-y-2 border-[#f5c563] shadow-2xl flex flex-col items-center justify-center p-4 bg-linear-to-r from-[#d4af37]/35 via-[#fdfbf7] to-[#d4af37]/35 transition-transform duration-700">
              <div class="absolute inset-y-1.5 left-2.5 w-1.5 rounded bg-[#f5c563]/60"></div>
              <div class="absolute inset-y-1.5 right-2.5 w-1.5 rounded bg-[#f5c563]/60"></div>
              <span class="text-[10px] font-serif tracking-widest text-amber-900 uppercase font-semibold">Ijazah Kehormatan</span>
              <p class="text-sm font-bold text-amber-950 truncate max-w-44 mt-1">{recipientName || 'Wisudawan'}</p>
            </div>
            <div id="diploma-ribbon-ring" class="absolute inset-y-1 left-1/2 -translate-x-1/2 w-20 flex items-center justify-center z-10 transition-transform duration-700">
