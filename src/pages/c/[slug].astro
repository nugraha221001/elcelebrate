<script>
  import confetti from 'canvas-confetti';
  import { startSynth, stopSynth } from '../../lib/synth-audio';

  function triggerBirthdayCelebration(originX = 0.5, originY = 0.6) {
    try {
      confetti({
        particleCount: 90,
        spread: 75,
        origin: { x: originX, y: originY },
        colors: ['#f5c563', '#e07a93', '#b6e3a8', '#ffffff', '#ffd166'],
        disableForReducedMotion: true,
        zIndex: 9999,
      });
    } catch {
      // Confetti fallback
    }
  }

  // ═══════════════════════════════════════════════════════
  // Recipient Route — Interactions
  // ═══════════════════════════════════════════════════════

  const dataEl = document.getElementById('card-data') as HTMLElement;
  const cardId = dataEl?.dataset.cardId || '';
  const audioUrl = dataEl?.dataset.audioUrl || '';
  const trackId = dataEl?.dataset.trackId || dataEl?.dataset.category || 'wedding';
  const hasAudio = dataEl?.dataset.hasAudio === 'true';
  const unboxStyle = dataEl?.dataset.unboxStyle || 'envelope';
  const isWedding = dataEl?.dataset.isWedding === 'true';
  const cardPasscode = dataEl?.dataset.passcode || '';
  const hasPasscode = dataEl?.dataset.hasPasscode === 'true';

  const passcodeGate = document.getElementById('passcode-gate');
  const overlay = document.getElementById('unbox-overlay');
  const content = document.getElementById('card-content');
  const weddingCover = document.getElementById('wedding-cover');
  const weddingContent = document.getElementById('wedding-content');

  // ═══════════════════════════════════════════════════════
  // Wedding Cinematic Cover Unlock
  // ═══════════════════════════════════════════════════════
  if (isWedding && weddingCover && weddingContent) {
    document.body.style.overflow = 'hidden';

    let invitationOpened = false;

    const openInvitation = () => {
      if (invitationOpened) return;
      invitationOpened = true;

      const style = weddingCover.dataset.unboxingStyle || 'gate-split';
      const coverBtn = document.getElementById('wedding-cover-btn');
      const waxSealBtn = document.getElementById('wedding-wax-seal-btn');
      const seamGlow = document.getElementById('cover-seam-glow');
      const coverContent = document.getElementById('wedding-cover-content');
      const coverHint = document.getElementById('wedding-cover-hint');
      const gateLeft = document.getElementById('cover-gate-left');
      const gateRight = document.getElementById('cover-gate-right');
      const backdrop = document.getElementById('cover-backdrop');
      const envelopeFlap = document.getElementById('envelope-flap');
      const heroPhoto = document.getElementById('hero-couple-img');
      const heroBadge = document.getElementById('hero-header-badge');
      const heroNames = document.getElementById('hero-couple-names');
      const dock = document.getElementById('floating-dock');
      const disc = document.querySelector('.music-disc');

      // ─────────────────────────────────────────────────────────────
      // PHASE 1 (0.0s - 0.2s): Button press feedback & center seam gold glow pulse
      // ─────────────────────────────────────────────────────────────
      if (coverBtn) coverBtn.classList.add('cover-btn-pressed');
      if (waxSealBtn) waxSealBtn.classList.add('wax-seal-pressed');
      if (seamGlow) seamGlow.classList.add('seam-pulse-active');

      // ─────────────────────────────────────────────────────────────
      // PHASE 2 (0.2s - 1.2s / 1.5s): Gate parting / curtain lift / wax-seal opening
      // ─────────────────────────────────────────────────────────────
      setTimeout(() => {
        // 1. Reveal wedding content beneath the opening gates
        weddingContent.classList.remove('hidden');
        document.body.style.overflow = '';
        window.scrollTo({ top: 0, behavior: 'instant' });

        // 2. Audio Fade-in Coordination: starts smoothly as gates begin parting (Item 4)
        if (hasAudio) {
          startAudio(true);
        }

        // 3. Stately 1.5s luxury decelerating transition
        const luxuryEase = 'cubic-bezier(0.16, 1, 0.3, 1)';

        if (style === 'wax-seal') {
          // Wax Seal: 3D flap perspective rotation (rotateX(-180deg)) and seal separation
          if (waxSealBtn) waxSealBtn.classList.add('wax-seal-broken');
          if (envelopeFlap) envelopeFlap.classList.add('flap-opened');

          if (coverContent) {
            coverContent.style.transition = `opacity 0.8s ${luxuryEase}, transform 0.8s ${luxuryEase}`;
            coverContent.style.opacity = '0';
            coverContent.style.transform = 'translate3d(0, -30px, 0) scale(0.98)';
          }
          if (coverHint) coverHint.style.opacity = '0';
          if (backdrop) backdrop.style.opacity = '0';

          if (gateLeft) {
            gateLeft.style.transition = `transform 1.5s ${luxuryEase}`;
            gateLeft.style.transform = 'translate3d(-100%, 0, 0)';
          }
          if (gateRight) {
            gateRight.style.transition = `transform 1.5s ${luxuryEase}`;
            gateRight.style.transform = 'translate3d(100%, 0, 0)';
          }

          weddingCover.style.transition = `opacity 1.3s ${luxuryEase} 0.2s`;
          weddingCover.style.opacity = '0';
          weddingCover.style.pointerEvents = 'none';

        } else if (style === 'curtain-lift') {
          // Curtain Lift: backdrop blur dissolve and ease-out upward glide
          weddingCover.classList.add('curtain-lift-dissolve');
          if (coverHint) coverHint.style.opacity = '0';
          if (coverContent) {
            coverContent.style.transition = 'opacity 0.7s ease-out';
            coverContent.style.opacity = '0';
          }

          weddingCover.style.transition = `transform 1.5s ${luxuryEase}, opacity 1.5s ${luxuryEase}, backdrop-filter 1.5s ${luxuryEase}, -webkit-backdrop-filter 1.5s ${luxuryEase}`;
          weddingCover.style.transform = 'translate3d(0, -100%, 0)';
          weddingCover.style.opacity = '0';
          weddingCover.style.pointerEvents = 'none';

        } else {
          // Royal Gate Split: 1.5s lateral reveal with realistic depth shadows
          if (coverContent) {
            coverContent.style.transition = `opacity 0.7s ${luxuryEase}, transform 0.7s ${luxuryEase}`;
            coverContent.style.opacity = '0';
            coverContent.style.transform = 'translate3d(0, -35px, 0) scale(0.98)';
          }
          if (coverHint) coverHint.style.opacity = '0';
          if (backdrop) backdrop.style.opacity = '0';

          if (gateLeft) {
            gateLeft.style.transition = `transform 1.5s ${luxuryEase}`;
            gateLeft.style.transform = 'translate3d(-100%, 0, 0)';
          }
          if (gateRight) {
            gateRight.style.transition = `transform 1.5s ${luxuryEase}`;
            gateRight.style.transform = 'translate3d(100%, 0, 0)';
          }

          weddingCover.style.transition = `opacity 1.5s ${luxuryEase}`;
          weddingCover.style.opacity = '0';
          weddingCover.style.pointerEvents = 'none';
        }

        // Reveal dock & music disc
        if (dock) dock.classList.add('dock-visible');
        if (disc) disc.classList.add('disc-visible');
      }, 200);

      // ─────────────────────────────────────────────────────────────
      // PHASE 3 (0.3s - 1.6s): Hero settle, typography stagger, delayed seam confetti
      // ─────────────────────────────────────────────────────────────
      // Confetti burst delayed by 300ms from opening seam (Item 2)
      setTimeout(() => {
        triggerWeddingSeamConfetti();
      }, 300);

      // Hero background photo smooth scale settle (from scale(1.08) to scale(1.0))
      setTimeout(() => {
        if (heroPhoto) {
          heroPhoto.classList.remove('hero-photo-init');
          heroPhoto.classList.add('hero-photo-settling');
        }
      }, 300);

      // Staggered fade-in of header typography
      setTimeout(() => {
        if (heroBadge) heroBadge.classList.add('is-revealed');
      }, 380);

      setTimeout(() => {
        if (heroNames) heroNames.classList.add('is-revealed');
      }, 520);

      // Once settle finishes (~1.6s), engage continuous ambient Ken Burns loop
      setTimeout(() => {
        if (heroPhoto) {
          heroPhoto.classList.remove('hero-photo-settling');
          heroPhoto.classList.add('ken-burns-active');
        }
      }, 1600);

      // ─────────────────────────────────────────────────────────────
      // Final Staging & Cleanup
      // ─────────────────────────────────────────────────────────────
      setTimeout(() => {
        weddingCover.style.display = 'none';
      }, 1700);

      setTimeout(() => {
        observeWeddingReveals();
        observeRevealElements();
      }, 400);
    };

    document.getElementById('wedding-cover-btn')?.addEventListener('click', openInvitation);
    document.getElementById('wedding-wax-seal-btn')?.addEventListener('click', openInvitation);
  }

  // ═══════════════════════════════════════════════════════
  // Copy Account Number (Digital Envelope)
  // ═══════════════════════════════════════════════════════
  // Helper: show invitation toast
  function showInvitationToast(message: string) {
    // Remove any existing toast
    document.querySelectorAll('.invitation-toast').forEach(t => t.remove());
    const toast = document.createElement('div');
    toast.className = 'invitation-toast';
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => {
      toast.classList.add('toast-exit');
      setTimeout(() => toast.remove(), 300);
    }, 2500);
  }

  document.getElementById('copy-account-btn')?.addEventListener('click', async () => {
    const accountEl = document.getElementById('wedding-account-number');
    const btnText = document.getElementById('copy-btn-text');
    if (!accountEl) return;

    try {
      await navigator.clipboard.writeText(accountEl.textContent?.trim() || '');
      if (btnText) {
        btnText.textContent = 'Tersalin! ✅';
        setTimeout(() => { btnText.textContent = 'Salin Nomor Rekening'; }, 2000);
      }
      showInvitationToast('Nomor rekening disalin! ✨');
    } catch {
      // Fallback for older browsers
      const textArea = document.createElement('textarea');
      textArea.value = accountEl.textContent?.trim() || '';
      document.body.appendChild(textArea);
      textArea.select();
      document.execCommand('copy');
      document.body.removeChild(textArea);
      if (btnText) {
        btnText.textContent = 'Tersalin! ✅';
        setTimeout(() => { btnText.textContent = 'Salin Nomor Rekening'; }, 2000);
      }
      showInvitationToast('Nomor rekening disalin! ✨');
    }
  });

  // ═══════════════════════════════════════════════════════
  // Birthday Polaroid Stack Deck – Tap-to-Shuffle Engine
  // ═══════════════════════════════════════════════════════
  (function initPolaroidStack() {
    const stack = document.getElementById('polaroid-stack');
    if (!stack) return;

    const cards = Array.from(stack.querySelectorAll<HTMLElement>('.polaroid-card'));
    if (cards.length === 0) return;

    const counter = document.getElementById('polaroid-counter');
    const dotsEl = document.getElementById('polaroid-dots');
    const dots = dotsEl ? Array.from(dotsEl.querySelectorAll<HTMLElement>('.polaroid-dot')) : [];

    const rots = [-3, 4, -2, 2];
    const tzs = [30, 20, 10, 0];

    let topIndex = 0; // which card is currently on top
    let isAnimating = false;

    function updateDots(activeIdx: number) {
      dots.forEach((d, i) => {
        if (i === activeIdx) {
          d.classList.remove('w-2', 'h-2', 'bg-white/25');
          d.classList.add('w-3', 'h-2', 'bg-pink-400');
        } else {
          d.classList.remove('w-3', 'bg-pink-400');
          d.classList.add('w-2', 'h-2', 'bg-white/25');
        }
      });
      if (counter) counter.textContent = `${activeIdx + 1}/${cards.length}`;
    }

    function layoutCards() {
      cards.forEach((card, i) => {
        const posInStack = ((i - topIndex) + cards.length) % cards.length;
        const rot = rots[posInStack % 4];
        const tz = tzs[posInStack % 4];
        card.style.transform = `rotate(${rot}deg) translateZ(${tz}px)`;
        card.style.zIndex = String(cards.length - posInStack);
        card.style.opacity = '1';
      });
    }

    function shuffleTop(card: HTMLElement) {
      if (isAnimating) return;
      isAnimating = true;

      // Fling the top card off to the right
      card.style.transition = 'transform 0.42s cubic-bezier(0.55, 0, 1, 0.45), opacity 0.35s ease';
      card.style.transform = 'translateX(130%) rotate(18deg)';
      card.style.opacity = '0';

      setTimeout(() => {
        // Move top index forward
        topIndex = (topIndex + 1) % cards.length;
        updateDots(topIndex);

        // Instantly reset the flung card to bottom-of-stack position
        card.style.transition = 'none';
        const bottomRot = rots[(cards.length - 1) % 4];
        const bottomTz = tzs[(cards.length - 1) % 4];
        card.style.transform = `rotate(${bottomRot}deg) translateZ(${bottomTz}px) translateX(-30px)`;
        card.style.opacity = '0.6';
        card.style.zIndex = '1';

        // Force reflow then animate all cards into new positions
        void (card as HTMLElement).offsetWidth;
        requestAnimationFrame(() => {
          card.style.transition = 'transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.4s ease';
          layoutCards();
          isAnimating = false;
        });
      }, 380);
    }

    // Attach listener to top card (each card at its moment of being on top)
    stack.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.polaroid-card') as HTMLElement | null;
      if (!target) return;

      // Lightbox trigger (🔍 button)
      const lightboxBtn = target.querySelector('.polaroid-lightbox-btn');
      if (lightboxBtn && (e.target as HTMLElement).closest('.polaroid-lightbox-btn')) {
        const src = target.dataset.gallerySrc;
        if (src) {
          const lightbox = document.getElementById('gallery-lightbox');
          const img = lightbox?.querySelector<HTMLImageElement>('img');
          if (img && lightbox) {
            img.src = src;
            lightbox.classList.remove('hidden');
            lightbox.classList.add('flex');
            requestAnimationFrame(() => { lightbox.style.opacity = '1'; });
          }
        }
        return;
      }

      // Only shuffle the topmost card
      const topCard = cards.reduce((top, c) => {
        return parseInt(c.style.zIndex || '0') > parseInt(top.style.zIndex || '0') ? c : top;
      }, cards[0]);

      if (target === topCard) {
        shuffleTop(topCard);
      }
    });

    // Initial layout
    layoutCards();
    updateDots(topIndex);
  })();

  // Standard Unboxing Animation (Thematic Category Engine)

  let isUnboxingActive = false;
  function triggerUnbox() {
    if (!overlay || !content) return;
    if (isUnboxingActive) return;
    if (hasPasscode && passcodeGate && passcodeGate.style.display !== 'none') return;
    isUnboxingActive = true;

    // Autoplay-compliant audio start immediately on initial user gesture
    if (hasAudio) startAudio(true);

    // 1. Luxury Gift Box Pop: ribbons peel, 3D box lid lifts upward with rotation, delayed confetti
    if (unboxStyle === 'giftbox-pop' || unboxStyle === 'giftbox') {
      const lid = document.getElementById('giftbox-lid');
      const rv = document.getElementById('giftbox-ribbon-v');
      const rh = document.getElementById('giftbox-ribbon-h');
      if (rv) {
        rv.style.transition = 'transform 0.4s ease, opacity 0.4s ease';
        rv.style.transform = 'scaleY(0)';
        rv.style.opacity = '0';
      }
      if (rh) {
        rh.style.transition = 'transform 0.4s ease, opacity 0.4s ease';
        rh.style.transform = 'scaleX(0)';
        rh.style.opacity = '0';
      }
      if (lid) {
        lid.style.transition = 'transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.7s ease';
        lid.style.transform = 'translateY(-80px) rotate(-4deg)';
        lid.style.opacity = '0';
      }
      setTimeout(() => {
        triggerBirthdayCelebration(0.5, 0.45);
      }, 250);
    }

    // 2. Satin Ribbon Untie: center clasp twists & unbinds, ribbon bands contract
    else if (unboxStyle === 'ribbon-untie' || unboxStyle === 'ribbon') {
      const medallion = document.getElementById('ribbon-medallion');
      const rv = document.getElementById('ribbon-band-v');
      const rh = document.getElementById('ribbon-band-h');
      if (medallion) {
        medallion.style.transition = 'transform 0.4s ease, opacity 0.4s ease';
        medallion.style.transform = 'scale(1.15) rotate(15deg)';
        medallion.style.opacity = '0';
      }
      if (rv) {
        rv.style.transition = 'transform 0.5s ease 0.05s, opacity 0.5s ease';
        rv.style.transform = 'scaleY(0)';
        rv.style.opacity = '0';
      }
      if (rh) {
        rh.style.transition = 'transform 0.5s ease 0.15s, opacity 0.5s ease';
        rh.style.transform = 'scaleX(0)';
        rh.style.opacity = '0';
      }
    }

    // 3. Wax Seal Love Letter: seal breaks with golden radial flash, flap flips upward in 3D
    else if (unboxStyle === 'wax-seal-letter') {
      const stamp = document.getElementById('wax-seal-stamp');
      const flap = document.getElementById('envelope-flap');
      const letter = document.getElementById('inner-letter-preview');
      if (stamp) {
        stamp.classList.add('radial-gold-flash');
        stamp.style.transition = 'transform 0.5s ease, opacity 0.5s ease';
        stamp.style.transform = 'scale(1.35) rotate(20deg)';
        stamp.style.opacity = '0';
      }
      if (flap) {
        flap.style.transition = 'transform 0.85s cubic-bezier(0.34, 1.56, 0.64, 1)';
        flap.style.transform = 'perspective(1000px) rotateX(-180deg)';
      }
      if (letter) {
        letter.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.25s';
        letter.style.transform = 'translateY(-35px)';
      }
    }

    // 4. Romantic Folded Note: top fold opens in 3D perspective
    else if (unboxStyle === 'folded-note') {
      const seal = document.getElementById('folded-note-seal');
      const topFlap = document.getElementById('folded-top-flap');
      if (seal) {
        seal.style.transition = 'transform 0.4s ease, opacity 0.4s ease';
        seal.style.transform = 'scale(1.2) rotate(12deg)';
        seal.style.opacity = '0';
      }
      if (topFlap) {
        topFlap.style.transition = 'transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1)';
        topFlap.style.transform = 'perspective(900px) rotateX(180deg)';
      }
    }

    // 5. Royal Diploma Scroll: golden ribbon ring slides off, parchment unrolls
    else if (unboxStyle === 'diploma-scroll') {
      const ring = document.getElementById('diploma-ribbon-ring');
      const body = document.getElementById('diploma-scroll-body');
      if (ring) {
        ring.style.transition = 'transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease';
        ring.style.transform = 'translateX(200px) rotate(22deg)';
        ring.style.opacity = '0';
      }
      if (body) {
        body.style.transition = 'transform 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.15s, opacity 0.7s ease';
        body.style.transform = 'scale(1.15)';
        body.style.opacity = '0';
      }
    }

    // 6. Honor Folder Reveal: hinged diploma folder cover swings open to the left in 3D
    else if (unboxStyle === 'folder-reveal') {
      const flap = document.getElementById('folder-cover-flap');
      if (flap) {
        flap.style.transition = 'transform 0.9s cubic-bezier(0.16, 1, 0.3, 1)';
        flap.style.transform = 'perspective(1200px) rotateY(-130deg)';
      }
    }

    // 7. VIP Pass Sleeve: gold-trimmed VIP ticket slides smoothly upward out of velvet pocket
    else if (unboxStyle === 'vip-sleeve') {
      const ticket = document.getElementById('vip-ticket-card');
      const pocket = document.getElementById('vip-pocket-sleeve');
      if (ticket) {
        ticket.style.transition = 'transform 0.85s cubic-bezier(0.16, 1, 0.3, 1)';
        ticket.style.transform = 'translateY(-120px)';
      }
      if (pocket) {
        pocket.style.transition = 'opacity 0.6s ease 0.25s';
        pocket.style.opacity = '0.35';
      }
    }

    // 8. Black & Gold Envelope: flap flips upward in 3D perspective
    else if (unboxStyle === 'gold-envelope' || unboxStyle === 'envelope') {
      const seal = document.getElementById('gold-envelope-seal');
      const flap = document.getElementById('gold-envelope-flap') || document.getElementById('envelope-flap');
      if (seal) {
        seal.style.transition = 'transform 0.4s ease, opacity 0.4s ease';
        seal.style.transform = 'scale(1.2) rotate(15deg)';
        seal.style.opacity = '0';
      }
      if (flap) {
        flap.style.transition = 'transform 0.85s cubic-bezier(0.34, 1.56, 0.64, 1)';
        flap.style.transform = 'perspective(1000px) rotateX(-180deg)';
      }
    }

    // 9. Velvet Keepsake Box: upper hinged lid opens in 3D with specular jewel shine
    else if (unboxStyle === 'jewelry-box') {
      const lid = document.getElementById('jewelry-box-lid');
      const shine = document.getElementById('jewelry-shine-sweep');
      if (lid) {
        lid.style.transition = 'transform 0.85s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.8s ease';
        lid.style.transform = 'perspective(900px) rotateX(75deg)';
        lid.style.opacity = '0.15';
      }
      if (shine) {
        shine.style.opacity = '1';
        shine.classList.add('jewel-shine-sweeper');
      }
    }

    // 10. 3D Bifold Card Open: front cover card swings open to the left in 3D
    else if (unboxStyle === 'bifold-card') {
      const front = document.getElementById('bifold-front-cover');
      if (front) {
        front.style.transition = 'transform 0.9s cubic-bezier(0.16, 1, 0.3, 1)';
        front.style.transform = 'perspective(1200px) rotateY(-120deg)';
      }
    }

    // 11. Festive Envelope: festive flap flips upward in 3D
    else if (unboxStyle === 'festive-envelope') {
      const seal = document.getElementById('festive-envelope-seal');
      const flap = document.getElementById('festive-envelope-flap');
      if (seal) {
        seal.style.transition = 'transform 0.4s ease, opacity 0.4s ease';
        seal.style.transform = 'scale(1.2) rotate(15deg)';
        seal.style.opacity = '0';
      }
      if (flap) {
        flap.style.transition = 'transform 0.85s cubic-bezier(0.34, 1.56, 0.64, 1)';
        flap.style.transform = 'perspective(1000px) rotateX(-180deg)';
      }
    }

    // Fade out overlay and reveal card content
    setTimeout(() => {
      overlay.style.transition = 'opacity 0.5s ease';
      overlay.style.opacity = '0';

      setTimeout(() => {
        overlay.style.display = 'none';
        content.classList.remove('hidden');

        // Trigger confetti
        triggerConfetti();

        // Fade in ambient canvas smoothly
        const ambientCanvas = document.getElementById('ambient-canvas');
        if (ambientCanvas) {
          ambientCanvas.style.transition = 'opacity 1s ease-in';
          ambientCanvas.style.opacity = '1';
        }

        // Observe scroll-reveal elements
        setTimeout(() => {
          observeRevealElements();
        }, 100);
      }, 500);
    }, 800);
  }

  overlay?.addEventListener('click', triggerUnbox);
  document.getElementById('tap-to-open-btn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    triggerUnbox();
  });

  // ═══════════════════════════════════════════════════════
  // Passcode Verification Gate
  // ═══════════════════════════════════════════════════════
  if (hasPasscode && passcodeGate && cardPasscode) {
    let currentPin = '';
    const pinBoxes = document.querySelectorAll<HTMLElement>('.pin-box');
    const pinErrorMsg = document.getElementById('pin-error-msg');
    const pinHiddenInput = document.getElementById('pin-hidden-input') as HTMLInputElement | null;
    const pinBoxesContainer = document.getElementById('pin-boxes-container');

    function updatePinDisplay() {
      pinBoxes.forEach((box, idx) => {
        if (idx < currentPin.length) {
          box.textContent = '•';
          box.classList.add('border-pink-500', 'bg-pink-500/20', 'scale-105');
          box.classList.remove('border-white/15');
        } else {
          box.textContent = '';
          box.classList.remove('border-pink-500', 'bg-pink-500/20', 'scale-105', 'border-emerald-400', 'bg-emerald-500/20', 'text-emerald-300');
          box.classList.add('border-white/15');
        }
      });
    }

    function checkPin() {
      if (currentPin.length !== 4) return;

      if (currentPin === cardPasscode) {
        // Success!
        if (pinErrorMsg) pinErrorMsg.classList.add('hidden');
        pinBoxes.forEach((box) => {
          box.classList.remove('border-pink-500', 'bg-pink-500/20');
          box.classList.add('border-emerald-400', 'bg-emerald-500/20', 'text-emerald-300');
        });

        // Trigger pleasant chime audio
        playChimeAudio();

        const gateEl = passcodeGate;
        setTimeout(() => {
          if (gateEl) {
            gateEl.style.transition = 'opacity 0.5s ease';
            gateEl.style.opacity = '0';
            gateEl.style.pointerEvents = 'none';
            setTimeout(() => {
              gateEl.style.display = 'none';
            }, 500);
          }
        }, 400);
      } else {
        // Error
        if (pinErrorMsg) pinErrorMsg.classList.remove('hidden');
        if (pinBoxesContainer) {
          pinBoxesContainer.classList.add('shake');
          setTimeout(() => {
            pinBoxesContainer.classList.remove('shake');
          }, 450);
        }

        setTimeout(() => {
          currentPin = '';
          if (pinHiddenInput) pinHiddenInput.value = '';
          updatePinDisplay();
        }, 600);
      }
    }

    function handlePinInput(char: string) {
      if (char === '⌫' || char === 'Backspace') {
        if (currentPin.length > 0) {
          currentPin = currentPin.slice(0, -1);
          if (pinHiddenInput) pinHiddenInput.value = currentPin;
          if (pinErrorMsg) pinErrorMsg.classList.add('hidden');
          updatePinDisplay();
        }
      } else if (/^[0-9]$/.test(char)) {
        if (currentPin.length < 4) {
          currentPin += char;
          if (pinHiddenInput) pinHiddenInput.value = currentPin;
          if (pinErrorMsg) pinErrorMsg.classList.add('hidden');
          updatePinDisplay();
          if (currentPin.length === 4) {
            checkPin();
          }
        }
      }
    }

    // Touch Numpad buttons
    document.querySelectorAll('.numpad-key').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const num = (btn as HTMLElement).dataset.num;
        if (num) handlePinInput(num);
      });
    });

    // Hidden input / Physical Keyboard
    pinHiddenInput?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value.replace(/\D/g, '').slice(0, 4);
      currentPin = val;
      updatePinDisplay();
      if (currentPin.length === 4) {
        checkPin();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (!passcodeGate || passcodeGate.style.display === 'none') return;
      if (e.key === 'Backspace') {
        handlePinInput('Backspace');
      } else if (/^[0-9]$/.test(e.key)) {
        handlePinInput(e.key);
      }
    });

    // Keep hidden input focused for desktop typing convenience
    passcodeGate.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.numpad-key')) {
        pinHiddenInput?.focus();
      }
    });
  }

