---
import DashboardLayout from '../../components/layout/DashboardLayout.astro';
import Toast from '../../components/ui/Toast.astro';
import { CATEGORY_META } from '../../lib/types';
import { AUDIO_TRACKS } from '../../lib/audio-tracks';

export const prerender = false;

// Auth guard — must run before any HTML is emitted
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

const editId = Astro.url.searchParams.get('edit');
const isEdit = Boolean(editId);

const CORE_SWATCHES = [
  { hex: '#f5c563', name: 'Champagne Gold' },
  { hex: '#d4af37', name: 'Classic Gold' },
  { hex: '#e5c07b', name: 'Warm Sand' },
  { hex: '#e07a93', name: 'Muted Rose' },
  { hex: '#f4a261', name: 'Warm Terracotta' },
  { hex: '#e76f51', name: 'Burnt Sienna' },
  { hex: '#2a9d8f', name: 'Emerald Teal' },
  { hex: '#52b788', name: 'Sage Green' },
  { hex: '#9b51e0', name: 'Royal Velvet' },
  { hex: '#4a90e2', name: 'Ocean Blue' },
  { hex: '#c0a98c', name: 'Warm Taupe' },
  { hex: '#f7f6f9', name: 'Ivory White' },
];

const EXTENDED_SWATCHES = [
  { hex: '#eba0a0', name: 'Soft Coral' },
  { hex: '#edc999', name: 'Peach Glow' },
  { hex: '#b6e3a8', name: 'Pastel Mint' },
  { hex: '#84a98c', name: 'Earthy Olive' },
  { hex: '#7209b7', name: 'Deep Plum' },
  { hex: '#3f37c9', name: 'Midnight Indigo' },
  { hex: '#b5838d', name: 'Dusty Lilac' },
  { hex: '#6b705c', name: 'Moss Green' },
  { hex: '#cb997e', name: 'Warm Cinnamon' },
  { hex: '#ddbea9', name: 'Cashmere' },
  { hex: '#a59fad', name: 'Warm Slate' },
  { hex: '#2b2523', name: 'Charcoal Velvet' },
];
---

<DashboardLayout title={isEdit ? "Edit Card" : "Create Card"} description={isEdit ? "Update your digital greeting card" : "Design a beautiful digital greeting card"}>
  <Toast />

  <div class="mx-auto max-w-5xl w-full min-w-0 overflow-x-hidden">
    <!-- Step Indicator -->
    <div class="mb-10" id="step-indicator">
      <div class="flex items-center justify-between">
        {['Category', 'Theme', 'Media', 'Message', 'Preview'].map((label, i) => (
          <div class="flex flex-1 items-center">
            <div class="flex flex-col items-center gap-1.5">
              <div
                class="flex h-9 w-9 items-center justify-center rounded-full text-sm font-semibold transition-all duration-300"
                data-step-dot={i + 1}
              >
                {i + 1}
              </div>
              <span class="hidden text-xs font-medium text-surface-400 sm:block" data-step-label={i + 1}>
                {label}
              </span>
            </div>
            {i < 4 && (
              <div class="mx-2 h-0.5 flex-1 rounded bg-surface-700 transition-all duration-500" data-step-line={i + 1}></div>
            )}
          </div>
        ))}
      </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-5 w-full max-w-full min-w-0 overflow-x-hidden">
      <!-- Wizard Panel (3 cols) -->
      <div class="lg:col-span-3 w-full max-w-full min-w-0 overflow-x-hidden">
        <!-- Step 1: Category -->
        <div id="step-1" class="wizard-step pb-36 sm:pb-24 w-full max-w-full min-w-0 overflow-x-hidden">
          <div class="mb-4">
            <a
              href="/dashboard"
              class="inline-flex items-center gap-2 text-xs font-medium text-surface-400 transition-colors hover:text-[#f5c563]"
            >
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
              </svg>
              <span>Back to Dashboard</span>
            </a>
          </div>
          <h2 class="text-xl font-bold text-surface-50">Choose a Category</h2>
          <p class="mt-2 text-sm text-surface-400">What are we celebrating?</p>

          <div class="mt-6 grid grid-cols-2 gap-4">
            {Object.entries(CATEGORY_META).map(([key, meta]) => (
              <button
                type="button"
                class="group relative overflow-hidden rounded-2xl border border-white/8 hover:border-[#f5c563]/40 transition-all duration-300 bg-surface-900/60 backdrop-blur-md p-5 text-left hover:shadow-glow-sm cursor-pointer"
                data-category={key}
              >
                <div class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-110">
                  {meta.emoji}
                </div>
                <div class="text-base font-semibold text-surface-100">{meta.label}</div>
                <div class="mt-1 text-xs text-surface-400">{meta.description}</div>
                <!-- Selected indicator -->
                <div class="absolute right-3 top-3 hidden h-6 w-6 items-center justify-center rounded-full bg-[#f5c563] text-[#0f0d15]" data-check>
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                </div>
              </button>
            ))}
          </div>
        </div>

        <!-- Step 2: Theme Customizer -->
        <div id="step-2" class="wizard-step hidden pb-36 sm:pb-24 w-full max-w-full min-w-0 overflow-x-hidden">
          <h2 class="text-xl font-bold text-surface-50">Customize Theme</h2>
          <p class="mt-2 text-sm text-surface-400">Set the visual mood for your card</p>

          <div class="mt-6 space-y-6">
            <!-- Greetings Occasion Selector (Step 2) -->
            <div id="greetings-occasion-panel" class="hidden rounded-2xl border border-amber-500/20 bg-surface-900/60 p-4 space-y-3">
              <div class="flex items-center justify-between">
                <label class="block text-sm font-semibold text-surface-200">✨ Select Occasion / Perayaan</label>
                <span class="text-xs text-amber-400 bg-amber-500/10 border border-amber-500/20 px-2.5 py-0.5 rounded-full font-medium">Holiday & Greetings</span>
              </div>
              <p class="text-xs text-surface-400">Choose the occasion to tailor ambient effects and holiday presets:</p>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5" id="occasion-grid">
                {[
                  { id: 'idul-fitri', emoji: '🌙', label: 'Idul Fitri', effect: 'lanterns' },
                  { id: 'idul-adha', emoji: '🕌', label: 'Idul Adha', effect: 'lanterns' },
                  { id: 'natal-tahun-baru', emoji: '🎄', label: 'Natal & Tahun Baru', effect: 'snowfall' },
                  { id: 'imlek', emoji: '🧧', label: 'Tahun Baru Imlek', effect: 'lanterns' },
                  { id: 'waisak', emoji: '☸️', label: 'Hari Raya Waisak', effect: 'lanterns' },
                  { id: 'nyepi', emoji: '🛕', label: 'Hari Raya Nyepi', effect: 'starlight' },
                  { id: 'kemerdekaan', emoji: '🇮🇩', label: 'Hari Kemerdekaan RI', effect: 'sparklers' },
                  { id: 'hari-ibu-ayah', emoji: '💐', label: 'Hari Ibu / Ayah', effect: 'petals' },
                  { id: 'get-well-soon', emoji: '🕊️', label: 'Lekas Sembuh / Doa', effect: 'jasmine' },
                  { id: 'general', emoji: '✨', label: 'General / Lainnya', effect: 'golden-sparkles' },
                ].map((occ, idx) => (
                  <button
                    type="button"
                    class:list={[
                      'occasion-btn relative flex items-center gap-3 rounded-xl border p-3 text-left transition-all cursor-pointer',
                      idx === 0
                        ? 'border-[#f5c563] ring-2 ring-[#f5c563]/40 bg-[#f5c563]/15 text-white font-medium shadow-lg shadow-[#f5c563]/10'
                        : 'border-white/10 bg-surface-800/60 text-surface-400 hover:border-white/20 hover:text-surface-200',
                    ]}
                    data-occasion={occ.id}
                    data-effect={occ.effect}
                  >
                    <div class="flex h-6 w-6 shrink-0 items-center justify-center">
                      {occ.id === 'kemerdekaan' ? (
                        <svg class="h-6 w-6 drop-shadow-xs" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Bendera Merah Putih">
                          <path d="M2 7 A3 3 0 0 1 5 4 h14 A3 3 0 0 1 22 7 V12 H2 Z" fill="#e11d48" />
                          <path d="M2 12 H22 V17 A3 3 0 0 1 19 20 H5 A3 3 0 0 1 2 17 Z" fill="#ffffff" />
                          <rect x="2" y="4" width="20" height="16" rx="3" stroke="white" stroke-opacity="0.3" stroke-width="1" />
                          <line x1="2" y1="12" x2="22" y2="12" stroke="#e11d48" stroke-opacity="0.15" stroke-width="0.5" />
                        </svg>
                      ) : occ.id === 'waisak' ? (
                        <svg class="h-6 w-6 drop-shadow-xs" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Bunga Teratai Waisak">
                          <circle cx="12" cy="13" r="8" fill="#f59e0b" fill-opacity="0.2" />
                          <path d="M12 19 C6.5 19 3 14 4.5 10.5 C7 11.5 9.5 14.5 12 19 Z" fill="#f472b6" fill-opacity="0.9" />
                          <path d="M12 19 C17.5 19 21 14 19.5 10.5 C17 11.5 14.5 14.5 12 19 Z" fill="#f472b6" fill-opacity="0.9" />
                          <path d="M12 19 C8 17 6.5 11 8 7.5 C10 10.5 11 14.5 12 19 Z" fill="#f43f5e" />
                          <path d="M12 19 C16 17 17.5 11 16 7.5 C14 10.5 13 14.5 12 19 Z" fill="#f43f5e" />
                          <path d="M12 3.5 C10 7.5 9.5 13.5 12 19 C14.5 13.5 14 7.5 12 3.5 Z" fill="#fb7185" />
                          <path d="M12 7 C11 10 10.8 14 12 18 C13.2 14 13 10 12 7 Z" fill="#fbbf24" fill-opacity="0.85" />
                          <circle cx="12" cy="14" r="1.5" fill="#fef08a" />
                          <path d="M7 19.5 C9 20.8 15 20.8 17 19.5 C15.5 21 8.5 21 7 19.5 Z" fill="#f59e0b" />
                        </svg>
                      ) : occ.id === 'nyepi' ? (
                        <svg class="h-6 w-6 drop-shadow-xs" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Candi Hindu Bali">
                          <circle cx="12" cy="12" r="8.5" fill="#f59e0b" fill-opacity="0.15" />
                          <path d="M12 1.5 L13 4 H11 L12 1.5 Z" fill="#fef08a" />
                          <circle cx="12" cy="1.5" r="0.8" fill="#f59e0b" />
                          <path d="M7 7.5 C9.5 6.8 14.5 6.8 17 7.5 C15.8 6 13.8 4.8 12 4.8 C10.2 4.8 8.2 6 7 7.5 Z" fill="#d97706" />
                          <path d="M6.5 8 C9 7.3 15 7.3 17.5 8" stroke="#fde68a" stroke-width="0.8" stroke-linecap="round" />
                          <path d="M5 11.5 C8 10.7 16 10.7 19 11.5 C17.5 9.8 14.8 8.5 12 8.5 C9.2 8.5 6.5 9.8 5 11.5 Z" fill="#b45309" />
                          <path d="M4.5 12 C7.5 11.3 16.5 11.3 19.5 12" stroke="#fde68a" stroke-width="0.8" stroke-linecap="round" />
                          <path d="M3 15.5 C6.5 14.5 17.5 14.5 21 15.5 C19.2 13.3 15.8 12 12 12 C8.2 12 4.8 13.3 3 15.5 Z" fill="#92400e" />
                          <path d="M2.5 16 C6 15 18 15 21.5 16" stroke="#fde68a" stroke-width="0.8" stroke-linecap="round" />
                          <rect x="6.5" y="16" width="11" height="3" fill="#78350f" />
                          <rect x="10.5" y="16" width="3" height="3" rx="0.5" fill="#fef08a" />
                          <path d="M4 19 H20 V20 H4 Z" fill="#d97706" />
                          <path d="M2.5 20 H21.5 V21.5 H2.5 Z" fill="#b45309" />
                        </svg>
                      ) : (
                        <span class="text-xl leading-none">{occ.emoji}</span>
                      )}
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="text-xs font-semibold text-surface-200 truncate">{occ.label}</div>
                      <div class="text-[10px] text-surface-400">Ambience: {occ.effect}</div>
                    </div>
                    <span class:list={[
                      'occasion-active-check absolute top-2 right-2 h-4 w-4 items-center justify-center rounded-full bg-[#f5c563] text-[10px] font-bold text-[#0f0d15]',
                      idx === 0 ? 'flex' : 'hidden',
                    ]}>✓</span>
                  </button>
                ))}
              </div>
            </div>

            <!-- Colors -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <!-- Primary Color -->
              <div class="rounded-2xl border border-white/10 bg-surface-900/40 p-4">
                <div class="flex items-center justify-between mb-2.5">
                  <label for="theme-primary" class="block text-sm font-semibold text-surface-200">Primary Color</label>
                  <span class="text-xs font-mono text-surface-400 bg-surface-800/80 px-2 py-0.5 rounded-md border border-white/5" id="theme-primary-hex">#f5c563</span>
                </div>
                <div class="flex items-center gap-3">
                  <!-- Non-interactive preview chip displaying active color -->
                  <div
                    id="theme-primary-preview"
                    class="h-10 w-10 shrink-0 rounded-full border border-white/20 shadow-sm transition-colors duration-200 pointer-events-none select-none"
                    style="background-color: #f5c563;"
                    aria-hidden="true"
                  ></div>
                  <!-- Direct HEX text input -->
                  <div class="relative flex-1">
                    <input
                      type="text"
                      id="theme-primary"
                      value="#f5c563"
                      placeholder="#f5c563"
                      maxlength="7"
                      spellcheck="false"
                      autocomplete="off"
                      autocapitalize="off"
                      class="form-input w-full rounded-xl border border-white/10 bg-surface-800/80 px-3.5 py-2 font-mono text-sm uppercase transition-all focus:ring-1 focus:ring-[#f5c563]"
                      aria-label="Primary color HEX code"
                    />
                  </div>
                </div>
                <p class="mt-2 text-[11px] text-surface-400">Ketik kode HEX langsung atau sentuh pilihan warna di bawah</p>

                <!-- Curated Celebration Color Circles for Primary -->
                <div class="mt-3.5 pt-3 border-t border-white/5">
                  <div class="text-[11px] font-medium text-surface-400 mb-2 flex items-center justify-between">
                    <span>✨ Celebration Swatches</span>
                    <span class="text-[10px] text-surface-500">Tap to select</span>
                  </div>

                  <!-- Tier 1 (12 core celebration colors) -->
                  <div class="grid grid-cols-6 gap-2 justify-items-center" id="primary-swatches-tier1">
                    {CORE_SWATCHES.map((c) => (
                      <button
                        type="button"
                        class="color-swatch-circle relative flex h-8 w-8 items-center justify-center rounded-full border border-white/20 shadow-xs transition-all hover:scale-115 active:scale-95 cursor-pointer focus:outline-hidden"
                        style={`background-color: ${c.hex};`}
                        data-target="primary"
                        data-color={c.hex}
                        data-tier="1"
                        title={`${c.name} (${c.hex})`}
                        aria-label={`Select ${c.name} for Primary`}
                      >
                        <span class:list={['active-check hidden text-[11px] font-bold', c.hex === '#f7f6f9' ? 'text-surface-900' : 'text-white drop-shadow-[0_1px_2px_rgba(0,0,0,0.85)]']}>✓</span>
                      </button>
                    ))}
                  </div>

                  <!-- Tier 2 Toggle Button -->
                  <button
                    type="button"
                    class="more-colors-toggle mt-2.5 flex w-full items-center justify-center gap-1.5 py-1.5 px-2 text-[11px] font-medium text-surface-400 hover:text-[#f5c563] transition-colors cursor-pointer rounded-lg hover:bg-white/5 border border-transparent hover:border-white/5"
                    data-target="primary"
                    aria-expanded="false"
                  >
                    <span class="toggle-text">Tampilkan Lebih Banyak Warna ✨</span>
                    <svg class="toggle-icon h-3 w-3 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </button>

                  <!-- Tier 2 Collapsible Accordion (12 extended boutique shades) -->
                  <div
                    id="primary-tier2-accordion"
                    class="tier2-accordion"
                  >
                    <div>
                      <div class="pt-2">
                        <div class="text-[10px] font-medium text-surface-500 mb-1.5 uppercase tracking-wider">Boutique Shades</div>
                        <div class="grid grid-cols-6 gap-2 justify-items-center" id="primary-swatches-tier2">
                          {EXTENDED_SWATCHES.map((c) => (
                            <button
                              type="button"
                              class="color-swatch-circle relative flex h-8 w-8 items-center justify-center rounded-full border border-white/20 shadow-xs transition-all hover:scale-115 active:scale-95 cursor-pointer focus:outline-hidden"
                              style={`background-color: ${c.hex};`}
                              data-target="primary"
                              data-color={c.hex}
                              data-tier="2"
                              title={`${c.name} (${c.hex})`}
                              aria-label={`Select ${c.name} for Primary`}
                            >
                              <span class:list={['active-check hidden text-[11px] font-bold', c.hex === '#f7f6f9' ? 'text-surface-900' : 'text-white drop-shadow-[0_1px_2px_rgba(0,0,0,0.85)]']}>✓</span>
                            </button>
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Secondary Color -->
              <div class="rounded-2xl border border-white/10 bg-surface-900/40 p-4">
                <div class="flex items-center justify-between mb-2.5">
                  <label for="theme-secondary" class="block text-sm font-semibold text-surface-200">Secondary Color</label>
                  <span class="text-xs font-mono text-surface-400 bg-surface-800/80 px-2 py-0.5 rounded-md border border-white/5" id="theme-secondary-hex">#e07a93</span>
                </div>
                <div class="flex items-center gap-3">
                  <!-- Non-interactive preview chip displaying active color -->
                  <div
                    id="theme-secondary-preview"
                    class="h-10 w-10 shrink-0 rounded-full border border-white/20 shadow-sm transition-colors duration-200 pointer-events-none select-none"
                    style="background-color: #e07a93;"
                    aria-hidden="true"
                  ></div>
                  <!-- Direct HEX text input -->
                  <div class="relative flex-1">
                    <input
                      type="text"
                      id="theme-secondary"
                      value="#e07a93"
                      placeholder="#e07a93"
                      maxlength="7"
                      spellcheck="false"
                      autocomplete="off"
                      autocapitalize="off"
                      class="form-input w-full rounded-xl border border-white/10 bg-surface-800/80 px-3.5 py-2 font-mono text-sm uppercase transition-all focus:ring-1 focus:ring-[#f5c563]"
                      aria-label="Secondary color HEX code"
                    />
                  </div>
                </div>
                <p class="mt-2 text-[11px] text-surface-400">Ketik kode HEX langsung atau sentuh pilihan warna di bawah</p>

                <!-- Curated Celebration Color Circles for Secondary -->
                <div class="mt-3.5 pt-3 border-t border-white/5">
                  <div class="text-[11px] font-medium text-surface-400 mb-2 flex items-center justify-between">
                    <span>✨ Celebration Swatches</span>
                    <span class="text-[10px] text-surface-500">Tap to select</span>
                  </div>

                  <!-- Tier 1 (12 core celebration colors) -->
                  <div class="grid grid-cols-6 gap-2 justify-items-center" id="secondary-swatches-tier1">
                    {CORE_SWATCHES.map((c) => (
                      <button
                        type="button"
                        class="color-swatch-circle relative flex h-8 w-8 items-center justify-center rounded-full border border-white/20 shadow-xs transition-all hover:scale-115 active:scale-95 cursor-pointer focus:outline-hidden"
                        style={`background-color: ${c.hex};`}
                        data-target="secondary"
                        data-color={c.hex}
                        data-tier="1"
                        title={`${c.name} (${c.hex})`}
                        aria-label={`Select ${c.name} for Secondary`}
                      >
                        <span class:list={['active-check hidden text-[11px] font-bold', c.hex === '#f7f6f9' ? 'text-surface-900' : 'text-white drop-shadow-[0_1px_2px_rgba(0,0,0,0.85)]']}>✓</span>
                      </button>
                    ))}
                  </div>

                  <!-- Tier 2 Toggle Button -->
                  <button
                    type="button"
                    class="more-colors-toggle mt-2.5 flex w-full items-center justify-center gap-1.5 py-1.5 px-2 text-[11px] font-medium text-surface-400 hover:text-[#f5c563] transition-colors cursor-pointer rounded-lg hover:bg-white/5 border border-transparent hover:border-white/5"
                    data-target="secondary"
                    aria-expanded="false"
                  >
                    <span class="toggle-text">Tampilkan Lebih Banyak Warna ✨</span>
                    <svg class="toggle-icon h-3 w-3 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </button>

                  <!-- Tier 2 Collapsible Accordion (12 extended boutique shades) -->
                  <div
                    id="secondary-tier2-accordion"
                    class="tier2-accordion"
                  >
                    <div>
                      <div class="pt-2">
                        <div class="text-[10px] font-medium text-surface-500 mb-1.5 uppercase tracking-wider">Boutique Shades</div>
                        <div class="grid grid-cols-6 gap-2 justify-items-center" id="secondary-swatches-tier2">
                          {EXTENDED_SWATCHES.map((c) => (
                            <button
                              type="button"
                              class="color-swatch-circle relative flex h-8 w-8 items-center justify-center rounded-full border border-white/20 shadow-xs transition-all hover:scale-115 active:scale-95 cursor-pointer focus:outline-hidden"
                              style={`background-color: ${c.hex};`}
                              data-target="secondary"
                              data-color={c.hex}
                              data-tier="2"
                              title={`${c.name} (${c.hex})`}
                              aria-label={`Select ${c.name} for Secondary`}
                            >
                              <span class:list={['active-check hidden text-[11px] font-bold', c.hex === '#f7f6f9' ? 'text-surface-900' : 'text-white drop-shadow-[0_1px_2px_rgba(0,0,0,0.85)]']}>✓</span>
                            </button>
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Quick Palettes -->
            <div>
              <div class="mb-2 flex items-center justify-between">
                <label class="block text-xs font-semibold uppercase tracking-wider text-surface-300">
                  🎨 Quick Palettes
                </label>
                <span class="text-[11px] text-surface-400">Curated color pairings</span>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2" id="palette-swatches-grid">
                {[
                  { name: 'Midnight Gold', primary: '#f5c563', secondary: '#e07a93' },
                  { name: 'Romantic Rose', primary: '#e07a93', secondary: '#f4a261' },
                  { name: 'Emerald Luxury', primary: '#2a9d8f', secondary: '#e76f51' },
                  { name: 'Ocean Twilight', primary: '#4a90e2', secondary: '#9b51e0' },
