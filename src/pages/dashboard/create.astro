  let standardPhotosLoadingCount = 0;

  async function handleFiles(files: FileList) {
    const maxPhotos = state.category === 'wedding' ? 10 : 4;
    const remaining = maxPhotos - state.photos.length;
    if (remaining <= 0) {
      (window as any).showToast({ message: `Maximum ${maxPhotos} photos allowed`, type: 'warning' });
      return;
    }

    const toProcess = Array.from(files).slice(0, remaining);
    const statusEl = document.getElementById('upload-status');
    const progressEl = document.getElementById('upload-progress');
    const textEl = document.getElementById('upload-text');
    if (statusEl) statusEl.classList.remove('hidden');

    standardPhotosLoadingCount = toProcess.length;
    renderPhotoGrid();

    for (let i = 0; i < toProcess.length; i++) {
      if (textEl) textEl.textContent = `Compressing ${i + 1}/${toProcess.length}...`;
      if (progressEl) progressEl.style.width = `${((i + 1) / toProcess.length) * 100}%`;

      try {
        const result = await compressImage(toProcess[i]);
        // Output validation: size > 0 and <= 200KB
        if (!result || !result.file || result.file.size <= 0) {
          throw new Error('Hasil kompresi foto kosong.');
        }
        if (result.file.size > 200 * 1024) {
          throw new Error(`Ukuran foto (${Math.round(result.file.size / 1024)}KB) melebihi batas 200KB.`);
        }
        state.photos.push({ file: result.file, previewUrl: result.previewUrl });
      } catch (err: any) {
        (window as any).showToast({ message: err.message || 'Compression failed', type: 'error' });
      } finally {
        standardPhotosLoadingCount = Math.max(0, standardPhotosLoadingCount - 1);
        renderPhotoGrid();
      }
    }

    if (statusEl) statusEl.classList.add('hidden');
    standardPhotosLoadingCount = 0;
    renderPhotoGrid();
    updateLivePreview();
  }

  function renderPhotoGrid() {
    const grid = document.getElementById('photo-grid');
    if (!grid) return;
    let html = state.photos.map((p, i) => `
      <div class="group relative aspect-square overflow-hidden rounded-xl border border-white/10 bg-surface-800">
        <img src="${p.previewUrl}" alt="Photo ${i + 1}" class="h-full w-full object-cover" />
        <button
          type="button"
          class="absolute right-1.5 top-1.5 z-10 flex h-9 w-9 min-w-[36px] min-h-[36px] items-center justify-center rounded-full bg-red-600/90 text-white shadow-lg border border-white/30 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 hover:bg-red-700 active:scale-90 transition-all cursor-pointer"
          data-remove-photo="${i}"
          title="Hapus foto ini"
          aria-label="Hapus foto ini"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    `).join('');

    if (standardPhotosLoadingCount > 0) {
      for (let k = 0; k < standardPhotosLoadingCount; k++) {
        html += `
          <div class="relative aspect-square flex flex-col items-center justify-center rounded-xl border border-dashed border-primary/50 bg-surface-800/80 p-2">
            <div class="h-7 w-7 animate-spin rounded-full border-2 border-primary border-t-transparent mb-1.5"></div>
            <span class="text-[10px] text-surface-300 font-medium text-center">Compressing...</span>
          </div>
        `;
      }
    }

    grid.innerHTML = html;

    grid.querySelectorAll('[data-remove-photo]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt((btn as HTMLElement).dataset.removePhoto || '0');
        if (state.photos[idx]?.previewUrl?.startsWith('blob:')) {
          URL.revokeObjectURL(state.photos[idx].previewUrl);
        }
        state.photos.splice(idx, 1);
        renderPhotoGrid();
        updateLivePreview();
      });
    });
  }

