  // ═══════════════════════════════════════════════════════
  const primaryInput = document.getElementById('theme-primary') as HTMLInputElement | null;
  const secondaryInput = document.getElementById('theme-secondary') as HTMLInputElement | null;

  const userClosedAccordions: Record<'primary' | 'secondary', boolean> = {
    primary: false,
    secondary: false,
  };

  function toggleAccordion(target: 'primary' | 'secondary', forceOpen?: boolean) {
    const accordion = document.getElementById(`${target}-tier2-accordion`);
    const btn = document.querySelector<HTMLButtonElement>(`.more-colors-toggle[data-target="${target}"]`);
    if (!accordion || !btn) return;

    const isCurrentlyOpen = accordion.classList.contains('is-open');
    const shouldOpen = forceOpen !== undefined ? forceOpen : !isCurrentlyOpen;

    if (shouldOpen) {
      accordion.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
      const text = btn.querySelector('.toggle-text');
      const icon = btn.querySelector('.toggle-icon');
      if (text) text.textContent = 'Sembunyikan';
      if (icon) icon.classList.add('rotate-180');
      userClosedAccordions[target] = false;
    } else {
      accordion.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
      const text = btn.querySelector('.toggle-text');
      const icon = btn.querySelector('.toggle-icon');
      if (text) text.textContent = 'Tampilkan Lebih Banyak Warna ✨';
      if (icon) icon.classList.remove('rotate-180');
      userClosedAccordions[target] = true;
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.more-colors-toggle').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const target = btn.dataset.target as 'primary' | 'secondary';
      if (target) toggleAccordion(target);
    });
  });

  function syncColorSwatchActiveStates() {
    const currentPrimary = (state.themeConfig.primaryColor || primaryInput?.value || '').toLowerCase();
    const currentSecondary = (state.themeConfig.secondaryColor || secondaryInput?.value || '').toLowerCase();

    // Ensure preview chips match active background colors
    const primaryPreview = document.getElementById('theme-primary-preview');
    if (primaryPreview && currentPrimary) {
      primaryPreview.style.backgroundColor = currentPrimary;
    }
    const secondaryPreview = document.getElementById('theme-secondary-preview');
    if (secondaryPreview && currentSecondary) {
      secondaryPreview.style.backgroundColor = currentSecondary;
    }

    // Keep hex text inputs in sync if not actively focused by user
    if (primaryInput && document.activeElement !== primaryInput && currentPrimary) {
      primaryInput.value = currentPrimary;
    }
    if (secondaryInput && document.activeElement !== secondaryInput && currentSecondary) {
      secondaryInput.value = currentSecondary;
    }

    const primaryHexSpan = document.getElementById('theme-primary-hex');
    if (primaryHexSpan && currentPrimary) primaryHexSpan.textContent = currentPrimary;

    const secondaryHexSpan = document.getElementById('theme-secondary-hex');
    if (secondaryHexSpan && currentSecondary) secondaryHexSpan.textContent = currentSecondary;

    let primaryTier2Active = false;
    let secondaryTier2Active = false;

    document.querySelectorAll<HTMLElement>('.color-swatch-circle').forEach((btn) => {
      const target = btn.dataset.target;
      const color = (btn.dataset.color || '').toLowerCase();
      const isActive = (target === 'primary' && color === currentPrimary) ||
                       (target === 'secondary' && color === currentSecondary);
      const check = btn.querySelector('.active-check');

      if (isActive) {
        btn.classList.add('ring-2', 'ring-white', 'ring-offset-2', 'ring-offset-surface-900', 'scale-110');
        btn.setAttribute('aria-selected', 'true');
        if (check) check.classList.remove('hidden');
        if (btn.dataset.tier === '2') {
          if (target === 'primary') primaryTier2Active = true;
          if (target === 'secondary') secondaryTier2Active = true;
        }
      } else {
        btn.classList.remove('ring-2', 'ring-white', 'ring-offset-2', 'ring-offset-surface-900', 'scale-110');
        btn.setAttribute('aria-selected', 'false');
        if (check) check.classList.add('hidden');
      }
    });

    if (primaryTier2Active && !userClosedAccordions.primary) {
      toggleAccordion('primary', true);
    }
    if (secondaryTier2Active && !userClosedAccordions.secondary) {
      toggleAccordion('secondary', true);
    }
  }

  function applyColor(target: 'primary' | 'secondary', color: string) {
    if (!color) return;
    const normalized = color.toLowerCase();

    if (target === 'primary') {
      state.themeConfig.primaryColor = normalized;
      if (primaryInput) primaryInput.value = normalized;
      const preview = document.getElementById('theme-primary-preview');
      if (preview) preview.style.backgroundColor = normalized;
      const hexSpan = document.getElementById('theme-primary-hex');
      if (hexSpan) hexSpan.textContent = normalized;
    } else if (target === 'secondary') {
      state.themeConfig.secondaryColor = normalized;
      if (secondaryInput) secondaryInput.value = normalized;
      const preview = document.getElementById('theme-secondary-preview');
      if (preview) preview.style.backgroundColor = normalized;
      const hexSpan = document.getElementById('theme-secondary-hex');
      if (hexSpan) hexSpan.textContent = normalized;
    }

    syncColorSwatchActiveStates();
    updateLivePreview();
  }

  function sanitizeAndFormatHex(raw: string): string {
    let val = raw.trim();
    if (!val) return '';
    if (!val.startsWith('#')) {
      val = '#' + val;
    }
    const clean = val.slice(1).replace(/[^0-9a-fA-F]/g, '').slice(0, 6);
    return '#' + clean;
  }

  function isValidFullHex(hex: string): boolean {
    return /^#[0-9a-fA-F]{6}$/i.test(hex);
  }

  function handleHexInput(target: 'primary' | 'secondary') {
    const inputEl = target === 'primary' ? primaryInput : secondaryInput;
    if (!inputEl) return;

    const original = inputEl.value;
    const formatted = sanitizeAndFormatHex(original);
    if (inputEl.value !== formatted) {
      inputEl.value = formatted;
    }

    if (isValidFullHex(formatted)) {
      const colorLower = formatted.toLowerCase();
      if (target === 'primary') {
        state.themeConfig.primaryColor = colorLower;
        const preview = document.getElementById('theme-primary-preview');
        if (preview) preview.style.backgroundColor = colorLower;
        const hexSpan = document.getElementById('theme-primary-hex');
        if (hexSpan) hexSpan.textContent = colorLower;
      } else {
        state.themeConfig.secondaryColor = colorLower;
        const preview = document.getElementById('theme-secondary-preview');
        if (preview) preview.style.backgroundColor = colorLower;
        const hexSpan = document.getElementById('theme-secondary-hex');
        if (hexSpan) hexSpan.textContent = colorLower;
      }
      syncColorSwatchActiveStates();
      updateLivePreview();
    }
  }

  function handleHexBlur(target: 'primary' | 'secondary') {
    const inputEl = target === 'primary' ? primaryInput : secondaryInput;
    if (!inputEl) return;

    let val = inputEl.value.trim();
    if (val && !val.startsWith('#')) val = '#' + val;

    // Expand 3-digit shorthand if entered: #abc -> #aabbcc
    if (/^#[0-9a-fA-F]{3}$/i.test(val)) {
      val = '#' + val[1] + val[1] + val[2] + val[2] + val[3] + val[3];
      inputEl.value = val;
    }

    if (isValidFullHex(val)) {
      const colorLower = val.toLowerCase();
      applyColor(target, colorLower);
    } else {
      // Revert to last valid color in state
      const fallback = target === 'primary' ? state.themeConfig.primaryColor : state.themeConfig.secondaryColor;
      const validFallback = fallback || (target === 'primary' ? '#f5c563' : '#e07a93');
      inputEl.value = validFallback;
      const preview = document.getElementById(target === 'primary' ? 'theme-primary-preview' : 'theme-secondary-preview');
      if (preview) preview.style.backgroundColor = validFallback;
      const hexSpan = document.getElementById(target === 'primary' ? 'theme-primary-hex' : 'theme-secondary-hex');
      if (hexSpan) hexSpan.textContent = validFallback;
      syncColorSwatchActiveStates();
    }
  }

  primaryInput?.addEventListener('input', () => handleHexInput('primary'));
  primaryInput?.addEventListener('blur', () => handleHexBlur('primary'));
  primaryInput?.addEventListener('change', () => handleHexBlur('primary'));
  primaryInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      handleHexBlur('primary');
      primaryInput.blur();
    }
  });

  secondaryInput?.addEventListener('input', () => handleHexInput('secondary'));
  secondaryInput?.addEventListener('blur', () => handleHexBlur('secondary'));
  secondaryInput?.addEventListener('change', () => handleHexBlur('secondary'));
  secondaryInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      handleHexBlur('secondary');
      secondaryInput.blur();
    }
  });

