  }

  /* Preview Cloud Veil */
  .preview-cloud-veil {
    background: radial-gradient(circle at center, transparent 30%, rgba(15, 13, 21, 0.6) 100%);
  }

  /* Unboxing Hardware-accelerated Transitions */
  .preview-gate-left, .preview-gate-right {
    will-change: transform;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .preview-curtain {
    will-change: transform, opacity;
    transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease;
  }

  /* Stationary Corner Ornament Overlay in Studio Phone Preview */
  :global(.preview-corner-frame) {
    pointer-events: none;
    z-index: 20;
    overflow: hidden;
  }
  :global(.animate-corner-sway) {
    will-change: transform, opacity;
    animation: corner-sway 6s ease-in-out infinite, corner-glow 5s ease-in-out infinite;
  }
  :global(.preview-corner-frame [transform\:scaleX\(-1\)]),
  :global(.preview-corner-frame .\[transform\:scaleX\(-1\)\]) {
    transform: scaleX(-1);
