  .wax-seal-pulse {
    animation: wax-seal-pulse 2.2s infinite ease-in-out;
  }

  /* Preview Floating Bottom Pill Dock */
  .preview-floating-dock {
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .preview-dock-btn {
    transition: all 0.2s ease;
  }
  .preview-dock-btn:hover, .preview-dock-btn:active {
