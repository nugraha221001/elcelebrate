    if (audioTabCatalog) {
      audioTabCatalog.className = 'flex-1 rounded-lg py-2 text-xs font-medium text-surface-400 hover:text-surface-200 transition-all cursor-pointer';
    }
    audioCatalogPanel?.classList.add('hidden');
    audioCustomPanel?.classList.remove('hidden');

    if (isPlayingSynth()) {
      stopSynth();
      previewingTrackId = null;
      updateTrackSelectionUI();
