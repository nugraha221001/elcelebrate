  // ── Step 2 Theme Selectors Active State Management ─────────────────
  const INACTIVE_THEME_CLASSES = [
    'bg-surface-800/60',
    'border-white/10',
    'text-surface-400',
    'hover:border-white/20',
    'hover:text-surface-200'
  ];
  const ACTIVE_THEME_CLASSES = [
    'border-purple-500',
    'ring-2',
    'ring-purple-500/40',
    'bg-purple-500/15',
    'text-white',
    'font-medium',
    'shadow-lg',
    'shadow-purple-500/10'
  ];

  function syncThemeSelectorActiveStates() {
    // 1. Background Pattern
    const currentPattern = state.themeConfig.backgroundPattern || 'none';
    document.querySelectorAll('[data-pattern]').forEach((btn) => {
      const isSelected = (btn as HTMLElement).dataset.pattern === currentPattern;
      if (isSelected) {
        btn.classList.remove(...INACTIVE_THEME_CLASSES);
        btn.classList.add(...ACTIVE_THEME_CLASSES);
      } else {
        btn.classList.remove(...ACTIVE_THEME_CLASSES);
        btn.classList.add(...INACTIVE_THEME_CLASSES);
      }
    });

    // 2. Font Style
    const currentFont = state.themeConfig.fontFamily || 'sans';
    document.querySelectorAll('[data-font]').forEach((btn) => {
      const isSelected = (btn as HTMLElement).dataset.font === currentFont;
      const check = btn.querySelector('.font-active-check');
      if (isSelected) {
        btn.classList.remove(...INACTIVE_THEME_CLASSES);
        btn.classList.add(...ACTIVE_THEME_CLASSES);
        if (check) {
          check.classList.remove('hidden');
          check.classList.add('flex');
        }
      } else {
        btn.classList.remove(...ACTIVE_THEME_CLASSES);
        btn.classList.add(...INACTIVE_THEME_CLASSES);
        if (check) {
          check.classList.add('hidden');
          check.classList.remove('flex');
        }
      }
    });

    // 3. Unboxing Animation
    const currentUnbox = state.themeConfig.unboxStyle || 'envelope';
    document.querySelectorAll('[data-unbox]').forEach((btn) => {
      const isSelected = (btn as HTMLElement).dataset.unbox === currentUnbox;
      const check = btn.querySelector('.unbox-active-check');
      if (isSelected) {
        btn.classList.remove(...INACTIVE_THEME_CLASSES);
        btn.classList.add(...ACTIVE_THEME_CLASSES);
        if (check) {
          check.classList.remove('hidden');
          check.classList.add('flex');
        }
      } else {
        btn.classList.remove(...ACTIVE_THEME_CLASSES);
        btn.classList.add(...INACTIVE_THEME_CLASSES);
        if (check) {
          check.classList.add('hidden');
          check.classList.remove('flex');
        }
      }
    });

    // 4. Ambient Effect
    const currentAmbient = (state.themeConfig as any).ambientEffect || 'none';
    document.querySelectorAll('[data-ambient]').forEach((btn) => {
      const isSelected = (btn as HTMLElement).dataset.ambient === currentAmbient;
      const check = btn.querySelector('.ambient-active-check');
      if (isSelected) {
        btn.classList.remove(...INACTIVE_THEME_CLASSES);
        btn.classList.add(...ACTIVE_THEME_CLASSES);
        if (check) {
          check.classList.remove('hidden');
          check.classList.add('flex');
        }
      } else {
        btn.classList.remove(...ACTIVE_THEME_CLASSES);
        btn.classList.add(...INACTIVE_THEME_CLASSES);
        if (check) {
          check.classList.add('hidden');
          check.classList.remove('flex');
        }
      }
    });
  }

