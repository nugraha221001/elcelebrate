  }
  .tier2-accordion.is-open {
    grid-template-rows: 1fr;
  }
  .tier2-accordion > div {
    overflow: hidden;
  }

  .wizard-step {
    animation: fade-in-up 0.4s var(--ease-smooth) forwards;
  }

  /* Prevent CSS transform/filter ancestors from interfering with native datepicker positioning in Chromium/WebKit */
  #step-4 {
    animation: fade-in-step 0.3s ease-out forwards;
    transform: none !important;
    filter: none !important;
    perspective: none !important;
  }

  @keyframes fade-in-step {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Toggle switch */
  .toggle-switch {
    width: 2.75rem;
    height: 1.5rem;
    background-color: var(--color-surface-700, #1c1c28);
    border-radius: 9999px;
    position: relative;
    transition: background-color 0.2s ease;
  }
  .toggle-switch::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 1.25rem;
    height: 1.25rem;
    background-color: #ffffff;
    border-radius: 9999px;
    transition: transform 0.2s ease;
  }
  #w-unduh-mantu-toggle:checked + .toggle-switch {
    background-color: #14b8a6;
  }
  #w-unduh-mantu-toggle:checked + .toggle-switch::after {
    transform: translateX(1.25rem);
  }
  #w-sacred-quote-toggle:checked + .toggle-switch,
  #w-dresscode-toggle:checked + .toggle-switch {
    background-color: #f5c563;
  }
  #w-sacred-quote-toggle:checked + .toggle-switch::after,
  #w-dresscode-toggle:checked + .toggle-switch::after {
    transform: translateX(1.25rem);
  }
  #love-confession-toggle:checked + .toggle-switch {
    background-color: #ec4899;
  }
  #love-confession-toggle:checked + .toggle-switch::after {
    transform: translateX(1.25rem);
  }

  /* Form input, textarea, and select standardization across all categories */
  .form-input {
    border-radius: 0.75rem !important; /* rounded-xl */
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
  }
  .form-input:focus,
  .form-input:focus-visible {
    border-color: #f5c563 !important;
    box-shadow: 0 0 0 1px #f5c563 !important;
    outline: none !important;
  }
  .dresscode-slot-card .dresscode-hex-input {
    border: none !important;
    box-shadow: none !important;
    background: transparent !important;
    outline: none !important;
  }

  /* Desktop preview column — CSS media query for reliable breakpoint */
  @media (min-width: 1020px) {
    .desktop-preview-col {
      display: block !important;
      grid-column: span 2;
    }
  }

  /* Audio track active glow */
  .audio-track-item.ring-2 {
    box-shadow: 0 0 12px -2px oklch(0.7 0.15 300 / 0.35);
  }

  /* Theme customization active item glow */
  .pattern-btn.border-\[\#f5c563\],
  .font-btn.border-\[\#f5c563\],
  .unbox-btn.border-\[\#f5c563\],
  .ambient-btn.border-\[\#f5c563\] {
    box-shadow: 0 0 16px -2px rgba(245, 197, 99, 0.35);
  }

  /* Preview FAB subtle pulse animation */
  .preview-fab-btn {
    animation: fab-pulse 2.5s ease-in-out infinite;
  }
  @keyframes fab-pulse {
    0%, 100% { box-shadow: 0 4px 20px -4px rgba(245, 197, 99, 0.35); }
    50% { box-shadow: 0 6px 28px -2px rgba(245, 197, 99, 0.5); }
  }

  /* Mobile preview modal frame & smooth touch scrolling */
  #modal-preview-screen {
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }
  #preview-modal-backdrop {
    -webkit-overflow-scrolling: touch;
  }

  /* 1:1 WYSIWYG Phone Screen Simulation & Momentum Scrolling */
  .preview-phone-screen {
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    scroll-behavior: smooth;
  }
  .preview-phone-screen::-webkit-scrollbar {
    width: 4px;
  }
  .preview-phone-screen::-webkit-scrollbar-track {
    background: transparent;
  }
  .preview-phone-screen::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
  }

  /* Champagne Divider */
  .champagne-divider {
    display: block;
    height: 1.5px;
    width: 90px;
    margin: 0.5rem auto 0.75rem;
    background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.3), #e2c974, #fef08a, #e2c974, rgba(212, 175, 55, 0.3), transparent);
  }

  /* Ambient Ken Burns float */
  @keyframes wedding-kenburns {
    0% { transform: scale(1) translate(0, 0); }
    50% { transform: scale(1.08) translate(-1%, -1%); }
    100% { transform: scale(1) translate(0, 0); }
  }
  .ken-burns-active {
    animation: wedding-kenburns 16s ease-in-out infinite alternate;
  }

  /* Wax Seal Pulse Animation */
  @keyframes wax-seal-pulse {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 10px 25px -5px rgba(220, 38, 38, 0.5), inset 0 2px 4px rgba(255, 255, 255, 0.4);
    }
    50% {
      transform: scale(1.05);
      box-shadow: 0 15px 30px -3px rgba(220, 38, 38, 0.7), 0 0 20px rgba(239, 68, 68, 0.5), inset 0 2px 4px rgba(255, 255, 255, 0.6);
    }
