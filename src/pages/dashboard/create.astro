          <span class="text-sm text-surface-400 shrink-0">Schedule / Time</span>
          <span class="text-sm font-medium text-surface-200 break-words break-all [overflow-wrap:anywhere] sm:text-right">${state.themeConfig.invitationTime}</span>
        </div>` : ''}
        ${state.category === 'invitation' && state.themeConfig.invitationVenue ? `
