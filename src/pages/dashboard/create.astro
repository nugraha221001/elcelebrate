        </div>
        <div class="flex flex-col sm:flex-row sm:justify-between items-start gap-1 sm:gap-2 min-w-0">
          <span class="text-sm text-surface-400 shrink-0">Amplop Digital</span>
          <span class="text-sm font-medium text-surface-200 break-words break-all [overflow-wrap:anywhere] sm:text-right">💰 ${state.themeConfig.weddingData.digitalEnvelope.bankName ? `${state.themeConfig.weddingData.digitalEnvelope.bankName} (${state.themeConfig.weddingData.digitalEnvelope.accountNumber || '—'}) a/n ${state.themeConfig.weddingData.digitalEnvelope.accountHolder || '—'}` : '—'}</span>
        </div>` : ''}
        <hr class="border-white/5" />
        <div class="min-w-0 w-full">
          <span class="text-sm text-surface-400">Message Preview</span>
          <p class="mt-1 text-sm text-surface-300 leading-relaxed break-words break-all [overflow-wrap:anywhere]">${state.message ? state.message.slice(0, 200) + (state.message.length > 200 ? '...' : '') : '<span class="italic text-surface-500">No message</span>'}</p>
