                </div>
                <div class="flex justify-center py-2 bg-surface-900">
                  <div class="h-1 w-20 rounded-full bg-surface-600"></div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-6 rounded-2xl border border-white/8 bg-surface-900/60 backdrop-blur-md p-6 w-full max-w-full min-w-0 overflow-x-hidden">
            <div id="preview-summary" class="space-y-4 w-full max-w-full min-w-0">
