            <div class="p-1.5 rounded-lg bg-white/5 border border-white/10">
              <div class="text-base font-bold text-rose-300 font-mono">${annTime ? annTime.days : (state.eventDate ? '0' : '--')}</div>
              <div class="text-[8px] text-surface-400 uppercase">Hari</div>
            </div>
          </div>
          <p class="mt-2 text-[9px] text-rose-300/70 italic">"Setiap detik bersamamu adalah anugerah terindah"</p>
        </div>
      `;
    }

    // 3. Graduation: Royal Diploma Framing + Mortarboard Toss Animation
    if (state.category === 'graduation') {
      html += `
        <div class="relative my-3 mx-auto max-w-xs rounded-xl p-4 sm:p-5 bg-linear-to-b from-[#241e17] via-[#1a1612] to-[#221a14] border-2 border-[#d4af37] shadow-[0_0_20px_rgba(212,175,55,0.2)] text-center overflow-hidden">
          <!-- Gold corner accent flourishes -->
          <div class="absolute top-1.5 left-1.5 text-[#d4af37]/60 text-[10px] select-none">⚜️</div>
          <div class="absolute top-1.5 right-1.5 text-[#d4af37]/60 text-[10px] select-none">⚜️</div>
          <div class="absolute bottom-1.5 left-1.5 text-[#d4af37]/60 text-[10px] select-none">⚜️</div>
          <div class="absolute bottom-1.5 right-1.5 text-[#d4af37]/60 text-[10px] select-none">⚜️</div>

          <!-- Floating Mortarboard Toss Animation -->
          <div class="floating-mortarboards pointer-events-none absolute inset-0 overflow-hidden z-10" aria-hidden="true">
            <span class="mortarboard-particle absolute bottom-0 left-[15%] text-base animate-toss-1">🎓</span>
            <span class="mortarboard-particle absolute bottom-0 left-[48%] text-sm animate-toss-2">✨</span>
            <span class="mortarboard-particle absolute bottom-0 left-[78%] text-base animate-toss-3">🎓</span>
          </div>

          <!-- Diploma Content -->
          <div class="relative z-11">
            <div class="text-[8px] tracking-[0.25em] uppercase text-[#d4af37] font-semibold mb-1">
              ACADEMIC DEGREE & COMMENCEMENT
            </div>
            <div class="text-2xl my-1 animate-bounce" style="animation-duration: 2.5s;">🎓</div>
            ${state.themeConfig?.degreeMajor ? `
              <h4 class="text-sm font-serif font-bold text-[#fef08a] tracking-wide mt-0.5">
                ${state.themeConfig.degreeMajor}
              </h4>
            ` : ''}
            ${state.themeConfig?.schoolCampus ? `
              <p class="text-[11px] font-serif text-amber-200/80 mt-0.5 italic">
                ${state.themeConfig.schoolCampus}
              </p>
            ` : ''}
            <div class="my-2 mx-auto w-20 h-0.5 bg-linear-to-r from-transparent via-[#d4af37] to-transparent"></div>
            <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-[#d4af37]/15 border border-[#d4af37]/40 text-[#fef08a] text-[9px] font-medium">
              <span>🏆</span> <span>Honors & Distinction</span>
            </div>
          </div>
        </div>
      `;
    }

    // 4. Invitation: VIP Pass / Golden Ticket Format
    if (state.category === 'invitation') {
      html += `
        <div class="my-3 mx-auto max-w-xs rounded-xl border border-amber-400/40 bg-linear-to-b from-[#1c182a] to-[#120f1c] shadow-xl overflow-hidden relative text-center">
          <!-- Notch cutout at top -->
          <div class="absolute -top-2.5 left-1/2 -translate-x-1/2 w-5 h-5 rounded-full bg-[#181522] border-b border-amber-400/40"></div>
          <!-- Header Bar -->
          <div class="bg-linear-to-r from-amber-500/20 via-yellow-400/25 to-amber-500/20 border-b border-amber-400/30 px-3.5 py-1.5 flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <span class="text-xs">🎟️</span>
              <span class="text-[9px] font-bold uppercase tracking-widest text-amber-200">VIP ACCESS PASS</span>
            </div>
            <span class="text-[9px] font-mono px-1.5 py-0.2 rounded bg-black/40 border border-white/10 text-amber-300">#INV-VIP</span>
          </div>
          <!-- Ticket Body -->
          <div class="p-3.5 text-center space-y-2">
            ${state.themeConfig?.invitationEventType ? `
              <div class="text-sm font-bold text-white tracking-wide">
                ${state.themeConfig.invitationEventType}
              </div>
            ` : ''}
            ${state.themeConfig?.invitationTime ? `
              <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-white/5 border border-white/10 text-[10px] text-amber-300">
                <span>⏰</span> <span>${state.themeConfig.invitationTime}</span>
              </div>
            ` : ''}
            ${state.themeConfig?.invitationVenue ? `
              <p class="text-[10px] text-surface-300 flex items-center justify-center gap-1">
                <span>📍</span> <span>${state.themeConfig.invitationVenue}</span>
              </p>
            ` : ''}

            <!-- Perforated Coupon Divider Line with side notches -->
            <div class="relative my-2.5">
              <div class="border-b border-dashed border-white/20"></div>
              <div class="absolute -left-5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 rounded-full bg-[#181522] border-r border-amber-400/40"></div>
              <div class="absolute -right-5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 rounded-full bg-[#181522] border-l border-amber-400/40"></div>
            </div>

            <!-- Direct 1-tap Actions -->
            <div class="grid grid-cols-1 gap-1.5 pt-0.5">
              ${state.eventDate ? `
                <button
                  type="button"
                  class="w-full inline-flex items-center justify-center gap-1.5 py-1.5 px-2.5 rounded-lg text-[10px] font-semibold text-[#0f0d15] bg-[#f5c563] shadow-sm pointer-events-none"
                >
                  <span>🗓️</span> <span>Simpan ke Google Calendar</span>
                </button>
              ` : ''}
              ${state.themeConfig?.invitationVenue ? `
                <button
                  type="button"
                  class="w-full inline-flex items-center justify-center gap-1.5 py-1.5 px-2.5 rounded-lg text-[10px] font-semibold text-white bg-white/10 border border-white/15 shadow-sm pointer-events-none"
                >
                  <span>📍</span> <span>Buka Google Maps</span>
                </button>
              ` : ''}
            </div>

            <!-- Symmetrical RSVP Toggles inside Invitation Preview -->
            <div class="pt-2 border-t border-white/10">
              <div class="text-[9px] uppercase tracking-wider text-surface-400 mb-1.5">Konfirmasi Kehadiran (RSVP)</div>
              <div class="grid grid-cols-2 gap-2">
                <div class="preview-invitation-rsvp flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-lg text-[10px] font-medium border border-[#f5c563] text-[#f5c563] bg-[#f5c563]/10 cursor-pointer transition-all">
                  <span>✅</span> <span>Hadir</span>
                </div>
                <div class="preview-invitation-rsvp flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-lg text-[10px] font-medium border border-white/10 text-white/70 bg-white/5 cursor-pointer transition-all">
                  <span>🙏</span> <span>Berhalangan</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      `;
    }

    if (state.category === 'greetings' && state.themeConfig?.occasion) {
      const occLabel = occasionSummaryMap[state.themeConfig.occasion] || state.themeConfig.occasion.replace(/-/g, ' ');
      html += `<div><span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-[10px] font-semibold bg-amber-500/15 border border-amber-500/30 text-amber-300 shadow-xs">${occLabel}</span></div>`;
    }

    if (state.recipientName) {
      html += `<h3 class="text-base font-bold" style="color: ${primaryColor}">Happy ${state.category || 'Celebration'}!</h3>`;
      html += `<p class="text-xs text-surface-200">Dear <span class="font-semibold text-white">${state.recipientName}</span>,</p>`;
    } else {
      html += `<h3 class="text-base font-bold" style="color: ${primaryColor}">Happy ${state.category || 'Celebration'}!</h3>`;
      html += `<p class="text-xs text-surface-400">Dear Someone Special,</p>`;
    }

    // Message Card (with 3D bifold depth for greetings)
    html += `
      <div class="relative rounded-2xl p-4 text-left overflow-hidden ${state.category === 'greetings' ? 'shadow-2xl border border-white/15' : ''}" style="background: ${primaryColor}10; border: 1px solid ${primaryColor}20;">
        ${state.category === 'greetings' ? `
          <!-- 3D Bifold Card Center Crease Shadow -->
          <div class="pointer-events-none absolute inset-y-0 left-1/2 -translate-x-1/2 w-6 bg-linear-to-r from-black/0 via-black/40 to-black/0 z-10"></div>
        ` : ''}
        <div class="relative z-11">
    `;

    if (state.message) {
      html += `<p class="text-xs leading-relaxed text-surface-300 whitespace-pre-wrap">${state.message}</p>`;
    } else {
      html += `<p class="text-xs leading-relaxed text-surface-400 italic">Your heartfelt message will appear here...</p>`;
    }

    if (state.category === 'greetings' && state.themeConfig?.signature) {
      html += `<div class="mt-3 pt-2 border-t border-white/10 text-right text-[11px] text-surface-400">Salam hangat: <span class="font-medium text-[#f5c563]">${state.themeConfig.signature}</span></div>`;
    }

    if (state.senderName) {
      html += `<p class="text-xs text-surface-400 mt-2 italic text-right">— ${state.senderName}</p>`;
    }

    html += `
        </div>
      </div>
    `;

    // Interactive Confession for Love category
    if (state.category === 'love' && state.themeConfig?.interactiveConfession?.enabled) {
      const prompt = state.themeConfig.interactiveConfession.prompt || 'Maukah kamu jadi pacarku? 💕';
      const yesText = state.themeConfig.interactiveConfession.yesText || 'Iya, Aku Mau! 💖';
      const noText = state.themeConfig.interactiveConfession.noText || 'Nggak Mau 😜';

      html += `
        <div id="preview-confession-section" class="mt-4 p-3 rounded-xl bg-pink-500/10 border border-pink-500/20 text-center">
          <div id="preview-confession-question-state">
            <p class="text-xs font-bold text-pink-300 mb-2">💘 ${prompt}</p>
            <div id="preview-confession-container" class="relative flex items-center justify-center gap-3 min-h-14">
              <button
                type="button"
                id="preview-confession-yes-btn"
                class="px-3.5 py-1.5 rounded-full bg-pink-500 text-white text-xs font-bold shadow-md cursor-pointer transition-transform hover:scale-105 active:scale-95"
              >
                ${yesText}
              </button>
              <button
                type="button"
                id="preview-confession-no-btn"
                class="px-3 py-1.5 rounded-full bg-surface-700 text-surface-300 text-xs font-medium cursor-pointer transition-transform select-none"
              >
                ${noText}
              </button>
            </div>
          </div>
          <div id="preview-confession-celebration-state" class="hidden py-2 animate-fade-in-up">
            <div class="text-2xl mb-1">🎉💖✨</div>
            <p class="text-xs font-bold text-pink-200">Yeay! Kamu memilih untuk bersama!</p>
            <p class="text-[10px] text-pink-300/80 mt-1">Terima kasih atas jawaban manismu. I love you!</p>
          </div>
        </div>
      `;
    }

    // Photo Gallery by category
    if (state.photos.length > 0) {
      if (state.category === 'birthday') {
        html += `
          <div class="mt-3">
            <div class="text-[9px] uppercase tracking-[0.2em] font-semibold text-pink-300 mb-2">📸 Polaroid Memories</div>
            <div class="flex flex-wrap justify-center items-center gap-2 py-1">
              ${state.photos.slice(0, 4).map((p, i) => {
                const rots = ['-rotate-3', 'rotate-2', '-rotate-2', 'rotate-3'];
                const rot = rots[i % 4];
                return `
                  <div class="bg-white p-1.5 pb-4 rounded-xs shadow-md ${rot} w-20 transition-transform">
                    <div class="aspect-square w-full overflow-hidden rounded-xs bg-slate-100">
                      <img src="${p.previewUrl}" class="h-full w-full object-cover" />
                    </div>
                    <div class="mt-1 text-center text-[7px] text-slate-600 font-medium italic select-none">
                      #${i + 1} ✨
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
      } else if (state.category === 'anniversary') {
        html += `
          <div class="mt-3">
            <div class="text-[9px] uppercase tracking-[0.2em] font-semibold text-rose-300 mb-2">🎞️ Vintage Filmstrip</div>
            <div class="mx-auto max-w-[260px] rounded-xl bg-[#0c0a0f] border border-white/15 p-2 shadow-lg">
              <!-- Top Sprockets -->
              <div class="flex justify-between items-center gap-1 mb-1.5 px-0.5 overflow-hidden opacity-60">
                ${Array.from({ length: 10 }).map(() => '<span class="h-1.5 w-2 rounded-xs bg-white/25 shrink-0"></span>').join('')}
              </div>
              <!-- Photos -->
              <div class="grid grid-cols-2 gap-1.5">
                ${state.photos.slice(0, 4).map((p, i) => `
                  <div class="relative overflow-hidden rounded bg-black border border-white/20">
                    <div class="aspect-4/3 overflow-hidden">
                      <img src="${p.previewUrl}" class="h-full w-full object-cover sepia-[0.2] contrast-105" />
                    </div>
                    <div class="absolute bottom-0.5 right-1 text-[6px] font-mono text-amber-300/80">
                      EXP 0${i + 1}A
                    </div>
                  </div>
                `).join('')}
              </div>
              <!-- Bottom Sprockets -->
              <div class="flex justify-between items-center gap-1 mt-1.5 px-0.5 overflow-hidden opacity-60">
                ${Array.from({ length: 10 }).map(() => '<span class="h-1.5 w-2 rounded-xs bg-white/25 shrink-0"></span>').join('')}
              </div>
            </div>
          </div>
        `;
      } else {
        html += `<div class="grid grid-cols-2 gap-1.5 mt-3">`;
        state.photos.slice(0, 4).forEach((p) => {
          html += `<div class="aspect-square overflow-hidden rounded-lg"><img src="${p.previewUrl}" class="h-full w-full object-cover" /></div>`;
        });
        html += `</div>`;
      }
    }

    if (state.senderName) {
      html += `<p class="text-xs text-surface-400 mt-2 italic">— ${state.senderName}</p>`;
    }

    html += `</div>`;
    return html;
  }

