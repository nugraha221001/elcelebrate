  let customAudioPlayer: HTMLAudioElement | null = null;
  let isCustomAudioPlaying = false;

  function stopCustomAudioPreview() {
    if (customAudioPlayer && isCustomAudioPlaying) {
      customAudioPlayer.pause();
      isCustomAudioPlaying = false;
      updateCustomAudioPreviewUI();
    }
  }

  function updateCustomAudioPreviewUI() {
    const playIcon = document.getElementById('custom-audio-icon-play');
    const pauseIcon = document.getElementById('custom-audio-icon-pause');
    if (isCustomAudioPlaying) {
      playIcon?.classList.add('hidden');
      pauseIcon?.classList.remove('hidden');
    } else {
      playIcon?.classList.remove('hidden');
      pauseIcon?.classList.add('hidden');
    }
  }

  function showCustomAudioActiveCard(url: string, name?: string) {
    const dropzone = document.getElementById('custom-audio-dropzone');
    const activeCard = document.getElementById('custom-audio-active-card');
    const progressContainer = document.getElementById('custom-audio-progress-container');
    const nameEl = document.getElementById('custom-audio-card-name');

    dropzone?.classList.add('hidden');
    progressContainer?.classList.add('hidden');
    activeCard?.classList.remove('hidden');

    if (nameEl) {
      nameEl.textContent = name || url.split('/').pop() || 'custom-audio.mp3';
    }
  }

  function resetCustomAudioUploadUI() {
    const dropzone = document.getElementById('custom-audio-dropzone');
    const activeCard = document.getElementById('custom-audio-active-card');
    const progressContainer = document.getElementById('custom-audio-progress-container');
    const input = document.getElementById('custom-audio-input') as HTMLInputElement | null;

    stopCustomAudioPreview();
    if (customAudioPlayer) {
      customAudioPlayer = null;
    }
    if (input) input.value = '';

    activeCard?.classList.add('hidden');
