---
import DashboardLayout from '../../components/layout/DashboardLayout.astro';
import Toast from '../../components/ui/Toast.astro';
import { CATEGORY_META } from '../../lib/types';
import { AUDIO_TRACKS } from '../../lib/audio-tracks';

export const prerender = false;

// Auth guard — must run before any HTML is emitted
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

const editId = Astro.url.searchParams.get('edit');
const isEdit = Boolean(editId);
---

<DashboardLayout title={isEdit ? "Edit Card" : "Create Card"} description={isEdit ? "Update your digital greeting card" : "Design a beautiful digital greeting card"}>
  <Toast />

  <div class="mx-auto max-w-5xl">
    <!-- Step Indicator -->
    <div class="mb-10" id="step-indicator">
      <div class="flex items-center justify-between">
        {['Category', 'Theme', 'Media', 'Message', 'Preview'].map((label, i) => (
          <div class="flex flex-1 items-center">
            <div class="flex flex-col items-center gap-1.5">
              <div
                class="flex h-9 w-9 items-center justify-center rounded-full text-sm font-semibold transition-all duration-300"
                data-step-dot={i + 1}
              >
                {i + 1}
              </div>
              <span class="hidden text-xs font-medium text-surface-400 sm:block" data-step-label={i + 1}>
                {label}
              </span>
            </div>
            {i < 4 && (
              <div class="mx-2 h-0.5 flex-1 rounded bg-surface-700 transition-all duration-500" data-step-line={i + 1}></div>
            )}
          </div>
        ))}
      </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-5">
      <!-- Wizard Panel (3 cols) -->
      <div class="lg:col-span-3">
        <!-- Step 1: Category -->
        <div id="step-1" class="wizard-step">
          <h2 class="text-xl font-bold text-surface-50">Choose a Category</h2>
          <p class="mt-2 text-sm text-surface-400">What are we celebrating?</p>

          <div class="mt-6 grid grid-cols-2 gap-4">
            {Object.entries(CATEGORY_META).map(([key, meta]) => (
              <button
                type="button"
                class="group relative overflow-hidden rounded-2xl border border-white/8 hover:border-purple-500/30 transition-all duration-300 bg-surface-900/60 backdrop-blur-md p-5 text-left hover:shadow-glow-sm cursor-pointer"
                data-category={key}
              >
                <div class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-110">
                  {meta.emoji}
                </div>
                <div class="text-base font-semibold text-surface-100">{meta.label}</div>
                <div class="mt-1 text-xs text-surface-400">{meta.description}</div>
                <!-- Selected indicator -->
                <div class="absolute right-3 top-3 hidden h-6 w-6 items-center justify-center rounded-full bg-primary text-white" data-check>
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                </div>
              </button>
            ))}
          </div>
        </div>

        <!-- Step 2: Theme Customizer -->
        <div id="step-2" class="wizard-step hidden">
          <h2 class="text-xl font-bold text-surface-50">Customize Theme</h2>
          <p class="mt-2 text-sm text-surface-400">Set the visual mood for your card</p>

          <div class="mt-6 space-y-6">
            <!-- Colors -->
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="mb-1.5 block text-sm font-medium text-surface-200">Primary Color</label>
                <div class="flex items-center gap-3">
                  <input type="color" id="theme-primary" value="#c084fc" class="h-10 w-14 cursor-pointer rounded-lg border border-white/10 bg-transparent" />
                  <span class="text-xs text-surface-400" id="theme-primary-hex">#c084fc</span>
                </div>
              </div>
              <div>
                <label class="mb-1.5 block text-sm font-medium text-surface-200">Secondary Color</label>
                <div class="flex items-center gap-3">
                  <input type="color" id="theme-secondary" value="#f472b6" class="h-10 w-14 cursor-pointer rounded-lg border border-white/10 bg-transparent" />
                  <span class="text-xs text-surface-400" id="theme-secondary-hex">#f472b6</span>
                </div>
              </div>
            </div>

            <!-- Background Pattern -->
            <div>
              <label class="mb-2 block text-sm font-medium text-surface-200">Background Pattern</label>
              <div class="flex flex-wrap gap-2">
                {[
                  { id: 'none', label: '✕ None' },
                  { id: 'confetti', label: '🎊 Confetti' },
                  { id: 'hearts', label: '💕 Hearts' },
                  { id: 'stars', label: '⭐ Stars' },
                  { id: 'dots', label: '● Dots' },
                  { id: 'waves', label: '🌊 Waves' },
                ].map((p) => {
                  const isDefault = p.id === 'none';
                  return (
                    <button
                      type="button"
                      class:list={[
                        'pattern-btn rounded-lg border px-3 py-1.5 text-xs transition-all cursor-pointer',
                        isDefault
                          ? 'border-purple-500 ring-2 ring-purple-500/40 bg-purple-500/15 text-white font-medium shadow-lg shadow-purple-500/10'
                          : 'bg-surface-800/60 border-white/10 text-surface-400 hover:border-white/20 hover:text-surface-200',
                      ]}
                      data-pattern={p.id}
                    >
                      {p.label}
                    </button>
                  );
                })}
              </div>
            </div>

            <!-- Font Family -->
            <div>
              <label class="mb-2 block text-sm font-medium text-surface-200">Font Style</label>
              <div class="grid grid-cols-2 gap-3">
                {[
                  { id: 'sans', label: 'Modern Sans', sample: 'Aa', font: 'Inter' },
                  { id: 'serif', label: 'Classic Serif', sample: 'Aa', font: 'Georgia' },
                  { id: 'handwritten', label: 'Handwritten', sample: 'Aa', font: 'cursive' },
                  { id: 'display', label: 'Display', sample: 'Aa', font: 'Outfit' },
                ].map((f) => {
                  const isDefault = f.id === 'sans';
                  return (
                    <button
                      type="button"
                      class:list={[
                        'font-btn relative rounded-xl border p-3 text-left transition-all cursor-pointer',
                        isDefault
                          ? 'border-purple-500 ring-2 ring-purple-500/40 bg-purple-500/15 text-white font-medium shadow-lg shadow-purple-500/10'
                          : 'bg-surface-800/60 border-white/10 text-surface-400 hover:border-white/20 hover:text-surface-200',
                      ]}
                      data-font={f.id}
                    >
                      <span class:list={[
                        'font-active-check absolute top-2.5 right-2.5 h-4 w-4 items-center justify-center rounded-full bg-purple-500 text-[10px] font-bold text-white shadow-sm shadow-purple-500/50',
                        isDefault ? 'flex' : 'hidden',
                      ]}>✓</span>
                      <span class="text-2xl text-surface-200" style={`font-family: ${f.font}`}>{f.sample}</span>
                      <div class="mt-1 text-xs">{f.label}</div>
                    </button>
                  );
                })}
              </div>
            </div>

            <!-- Unbox Style -->
            <div>
              <label class="mb-2 block text-sm font-medium text-surface-200">Unboxing Animation</label>
              <div class="grid grid-cols-3 gap-3">
                {[
                  { id: 'envelope', emoji: '✉️', label: 'Envelope Flip' },
                  { id: 'giftbox', emoji: '🎁', label: 'Gift Box' },
                  { id: 'ribbon', emoji: '🎀', label: 'Ribbon Untie' },
                ].map((u) => {
                  const isDefault = u.id === 'envelope';
                  return (
                    <button
                      type="button"
                      class:list={[
                        'unbox-btn relative rounded-xl border p-4 text-center transition-all cursor-pointer',
                        isDefault
                          ? 'border-purple-500 ring-2 ring-purple-500/40 bg-purple-500/15 text-white font-medium shadow-lg shadow-purple-500/10'
                          : 'bg-surface-800/60 border-white/10 text-surface-400 hover:border-white/20 hover:text-surface-200',
                      ]}
                      data-unbox={u.id}
                    >
                      <span class:list={[
                        'unbox-active-check absolute top-2.5 right-2.5 h-4 w-4 items-center justify-center rounded-full bg-purple-500 text-[10px] font-bold text-white shadow-sm shadow-purple-500/50',
                        isDefault ? 'flex' : 'hidden',
                      ]}>✓</span>
                      <span class="text-2xl">{u.emoji}</span>
                      <div class="mt-1 text-xs">{u.label}</div>
                    </button>
                  );
                })}
              </div>
            </div>

            <!-- Ambient Visual Effect -->
            <div>
              <label class="mb-2 block text-sm font-medium text-surface-200">Ambient Visual Effect</label>
              <p class="mb-3 text-xs text-surface-500">A subtle animated background that enhances the mood of your card</p>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="ambient-effect-grid">
                {[
                  { id: 'none', emoji: '✕', label: 'None' },
                  { id: 'petals', emoji: '🌸', label: 'Petals' },
                  { id: 'golden-sparkles', emoji: '✨', label: 'Golden Sparkles' },
                  { id: 'hearts', emoji: '💕', label: 'Hearts' },
                  { id: 'confetti-float', emoji: '🎊', label: 'Confetti Float' },
                  { id: 'starlight', emoji: '🌟', label: 'Starlight' },
                  { id: 'lanterns', emoji: '🏮', label: 'Lanterns' },
                  { id: 'butterflies', emoji: '🦋', label: 'Butterflies' },
                  { id: 'bokeh', emoji: '💡', label: 'Bokeh' },
                  { id: 'sparklers', emoji: '🎇', label: 'Sparklers' },
                ].map((fx) => {
                  const isDefault = fx.id === 'none';
                  return (
                    <button
                      type="button"
                      class:list={[
                        'ambient-btn relative rounded-xl border p-3 text-center transition-all cursor-pointer',
                        isDefault
                          ? 'border-purple-500 ring-2 ring-purple-500/40 bg-purple-500/15 text-white font-medium shadow-lg shadow-purple-500/10'
                          : 'bg-surface-800/60 border-white/10 text-surface-400 hover:border-white/20 hover:text-surface-200',
                      ]}
                      data-ambient={fx.id}
                    >
                      <span class:list={[
                        'ambient-active-check absolute top-2 right-2 h-4 w-4 items-center justify-center rounded-full bg-purple-500 text-[10px] font-bold text-white shadow-sm shadow-purple-500/50',
                        isDefault ? 'flex' : 'hidden',
                      ]}>✓</span>
                      <span class="text-xl">{fx.emoji}</span>
                      <div class="mt-1 text-[11px]">{fx.label}</div>
                    </button>
                  );
                })}
              </div>
            </div>
          </div>
        </div>

        <!-- Step 3: Media Upload -->
        <div id="step-3" class="wizard-step hidden">
          <h2 class="text-xl font-bold text-surface-50">Add Photos</h2>
          <p class="mt-2 text-sm text-surface-400" id="photo-upload-hint">Upload up to 4 photos (auto-compressed to WebP, max 200KB each)</p>

          <div class="mt-6">
            <!-- Drop Zone -->
            <div
              id="drop-zone"
              class="flex min-h-50 cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-white/10 bg-surface-800/50 p-8 transition-all hover:border-primary/30 hover:bg-surface-800"
            >
              <svg class="mb-3 h-10 w-10 text-surface-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25a2.25 2.25 0 00-2.25-2.25H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
              </svg>
              <p class="text-sm font-medium text-surface-300">Drop images here or click to upload</p>
              <p class="mt-1 text-xs text-surface-500">PNG, JPG, WebP — auto-converted to WebP</p>
              <input type="file" id="file-input" accept="image/*" multiple class="hidden" />
            </div>

            <!-- Photo Preview Grid -->
            <div id="photo-grid" class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4 md:grid-cols-5">
              <!-- Populated by JS -->
            </div>

            <!-- Upload Progress -->
            <div id="upload-status" class="mt-4 hidden">
              <div class="flex items-center gap-3">
                <div class="h-2 flex-1 overflow-hidden rounded-full bg-surface-700">
                  <div id="upload-progress" class="h-full rounded-full bg-linear-to-r from-primary to-secondary transition-all duration-300" style="width: 0%"></div>
                </div>
                <span id="upload-text" class="text-xs text-surface-400">Processing...</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 4: Message & Details -->
        <div id="step-4" class="wizard-step hidden">
          <h2 class="text-xl font-bold text-surface-50">Card Details</h2>
          <p class="mt-2 text-sm text-surface-400">Add your personal message and event details</p>

          <div class="mt-6 space-y-5">
            <!-- Standard fields (hidden for wedding) -->
            <div id="standard-recipient-field">
              <label for="recipient-name" class="mb-1.5 block text-sm font-medium text-surface-200">Recipient Name <span class="text-confetti-pink">*</span></label>
              <input type="text" id="recipient-name" placeholder="Who is this card for?" required class="form-input w-full rounded-xl border bg-surface-800/50 px-4 py-2.5 text-sm transition-all focus-ring" />
            </div>

            <div id="standard-sender-field">
              <label for="sender-name" class="mb-1.5 block text-sm font-medium text-surface-200">Your Name</label>
              <input type="text" id="sender-name" placeholder="From..." class="form-input w-full rounded-xl border bg-surface-800/50 px-4 py-2.5 text-sm transition-all focus-ring" />
            </div>

            <div>
              <label for="message" class="mb-1.5 block text-sm font-medium text-surface-200">Your Message <span class="text-confetti-pink">*</span></label>
              <textarea id="message" rows="5" placeholder="Write something heartfelt..." required class="form-input w-full resize-none rounded-xl border bg-surface-800/50 px-4 py-3 text-sm transition-all focus-ring"></textarea>
            </div>

            <div id="standard-event-date-field">
              <label for="event-date" class="mb-1.5 block text-sm font-medium text-surface-200">Event Date</label>
              <input type="date" id="event-date" class="form-input w-full rounded-xl border bg-surface-800/50 px-4 py-2.5 text-sm transition-all focus-ring" />
            </div>

            <!-- ═══ Wedding Detail Fields (conditionally shown) ═══ -->
            <div id="wedding-fields" class="hidden space-y-6">
              <hr class="border-white/5" />
              <div class="flex items-center gap-2 text-sm font-semibold text-surface-100">
                <span class="text-lg">💍</span> Wedding Details
              </div>

              <!-- Opening Greeting / Salam Pembuka -->
              <div class="rounded-2xl border border-white/8 bg-surface-900/40 p-4 space-y-3">
                <div class="text-xs font-semibold uppercase tracking-wider text-violet-400">🙏 Salam Pembuka / Opening Greeting</div>
                <div>
                  <label for="w-greeting-preset" class="mb-1 block text-xs font-medium text-surface-300">Preset Greeting</label>
                  <select id="w-greeting-preset" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring cursor-pointer">
                    <option value="">— Select a greeting preset —</option>
                    <option value="islam">Islam</option>
                    <option value="kristen">Kristen / Katolik</option>
                    <option value="hindu">Hindu</option>
                    <option value="buddha">Buddha</option>
                    <option value="umum">Umum / Netral</option>
                    <option value="custom">Custom (Tulis Sendiri)</option>
                  </select>
                </div>
                <div>
                  <label for="w-greeting-text" class="mb-1 block text-xs font-medium text-surface-300">Greeting Text</label>
                  <textarea id="w-greeting-text" rows="3" placeholder="Greeting text will appear here..." class="form-input w-full resize-none rounded-lg border bg-surface-800/50 px-3 py-2.5 text-sm focus-ring"></textarea>
                </div>
              </div>

              <!-- Bride -->
              <div class="rounded-2xl border border-white/8 bg-surface-900/40 p-4 space-y-3">
                <div class="text-xs font-semibold uppercase tracking-wider text-pink-400">👰 Bride</div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="mb-1 block text-xs font-medium text-surface-300">Full Name <span class="text-confetti-pink">*</span></label>
                    <input type="text" id="w-bride-name" placeholder="Full name" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                  </div>
                  <div>
                    <label class="mb-1 block text-xs font-medium text-surface-300">Nickname</label>
                    <input type="text" id="w-bride-nick" placeholder="Nickname" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                  </div>
                </div>
                <div>
                  <label class="mb-1 block text-xs font-medium text-surface-300">Parents' Names</label>
                  <input type="text" id="w-bride-parents" placeholder="e.g. Bapak Suharto & Ibu Sari" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                </div>
              </div>

              <!-- Groom -->
              <div class="rounded-2xl border border-white/8 bg-surface-900/40 p-4 space-y-3">
                <div class="text-xs font-semibold uppercase tracking-wider text-blue-400">🤵 Groom</div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="mb-1 block text-xs font-medium text-surface-300">Full Name <span class="text-confetti-pink">*</span></label>
                    <input type="text" id="w-groom-name" placeholder="Full name" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                  </div>
                  <div>
                    <label class="mb-1 block text-xs font-medium text-surface-300">Nickname</label>
                    <input type="text" id="w-groom-nick" placeholder="Nickname" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                  </div>
                </div>
                <div>
                  <label class="mb-1 block text-xs font-medium text-surface-300">Parents' Names</label>
                  <input type="text" id="w-groom-parents" placeholder="e.g. Bapak Ahmad & Ibu Dewi" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                </div>
              </div>

              <!-- Akad / Holy Matrimony -->
              <div class="rounded-2xl border border-white/8 bg-surface-900/40 p-4 space-y-3">
                <div class="text-xs font-semibold uppercase tracking-wider text-amber-400">🕌 Akad Nikah / Holy Matrimony</div>
                <div class="grid grid-cols-3 gap-3">
                  <div>
                    <label class="mb-1 block text-xs font-medium text-surface-300">Date <span class="text-confetti-pink">*</span></label>
                    <input type="date" id="w-akad-date" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                  </div>
                  <div>
                    <label class="mb-1 block text-xs font-medium text-surface-300">Start Time</label>
                    <input type="time" id="w-akad-start" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                  </div>
                  <div>
                    <label class="mb-1 block text-xs font-medium text-surface-300">End Time</label>
                    <input type="time" id="w-akad-end" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                  </div>
                </div>
                <div>
                  <label class="mb-1 block text-xs font-medium text-surface-300">Venue Name</label>
                  <input type="text" id="w-akad-venue" placeholder="Masjid Al-Ikhlas" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                </div>
                <div>
                  <label class="mb-1 block text-xs font-medium text-surface-300">Address</label>
                  <input type="text" id="w-akad-address" placeholder="Jl. Raya No. 123, Jakarta" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                </div>
                <div>
                  <label class="mb-1 block text-xs font-medium text-surface-300">Google Maps URL</label>
                  <input type="url" id="w-akad-maps" placeholder="https://maps.google.com/..." class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                </div>
              </div>

              <!-- Resepsi / Reception -->
              <div class="rounded-2xl border border-white/8 bg-surface-900/40 p-4 space-y-3">
                <div class="text-xs font-semibold uppercase tracking-wider text-emerald-400">🎉 Resepsi / Reception</div>
                <div class="grid grid-cols-3 gap-3">
                  <div>
                    <label class="mb-1 block text-xs font-medium text-surface-300">Date</label>
                    <input type="date" id="w-resepsi-date" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                  </div>
                  <div>
                    <label class="mb-1 block text-xs font-medium text-surface-300">Start Time</label>
                    <input type="time" id="w-resepsi-start" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                  </div>
                  <div>
                    <label class="mb-1 block text-xs font-medium text-surface-300">End Time</label>
                    <input type="time" id="w-resepsi-end" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                  </div>
                </div>
                <div>
                  <label class="mb-1 block text-xs font-medium text-surface-300">Venue Name</label>
                  <input type="text" id="w-resepsi-venue" placeholder="Ballroom Grand Hotel" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                </div>
                <div>
                  <label class="mb-1 block text-xs font-medium text-surface-300">Address</label>
                  <input type="text" id="w-resepsi-address" placeholder="Jl. Sudirman No. 456, Jakarta" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                </div>
                <div>
                  <label class="mb-1 block text-xs font-medium text-surface-300">Google Maps URL</label>
                  <input type="url" id="w-resepsi-maps" placeholder="https://maps.google.com/..." class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                </div>
              </div>

              <!-- Unduh Mantu (Opsional) -->
              <div class="rounded-2xl border border-white/8 bg-surface-900/40 p-4 space-y-4">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="text-lg">🏡</span>
                    <div>
                      <div class="text-xs font-semibold uppercase tracking-wider text-teal-400">Unduh Mantu (Opsional)</div>
                      <p class="text-[11px] text-surface-400">Acara syukuran ngunduh mantu pihak keluarga pria</p>
                    </div>
                  </div>
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="w-unduh-mantu-toggle" class="sr-only" />
                    <div class="toggle-switch"></div>
                  </label>
                </div>

                <div id="w-unduh-mantu-fields" class="hidden space-y-3 pt-2 border-t border-white/5">
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                      <label for="w-unduh-mantu-date" class="mb-1 block text-xs font-medium text-surface-300">Tanggal Unduh Mantu</label>
                      <input type="date" id="w-unduh-mantu-date" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                    </div>
                    <div>
                      <label for="w-unduh-mantu-time" class="mb-1 block text-xs font-medium text-surface-300">Waktu</label>
                      <input type="text" id="w-unduh-mantu-time" placeholder="10:00 — 14:00 WIB" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                    </div>
                  </div>
                  <div>
                    <label for="w-unduh-mantu-venue" class="mb-1 block text-xs font-medium text-surface-300">Nama Lokasi / Gedung</label>
                    <input type="text" id="w-unduh-mantu-venue" placeholder="Kediaman Mempelai Pria" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                  </div>
                  <div>
                    <label for="w-unduh-mantu-address" class="mb-1 block text-xs font-medium text-surface-300">Alamat Lengkap</label>
                    <input type="text" id="w-unduh-mantu-address" placeholder="Jl. Mawar No. 10, Solo" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                  </div>
                  <div>
                    <label for="w-unduh-mantu-maps" class="mb-1 block text-xs font-medium text-surface-300">Tautan Google Maps</label>
                    <input type="url" id="w-unduh-mantu-maps" placeholder="https://maps.google.com/..." class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                  </div>
                </div>
              </div>

              <!-- Digital Envelope -->
              <div class="rounded-2xl border border-white/8 bg-surface-900/40 p-4 space-y-3">
                <div class="text-xs font-semibold uppercase tracking-wider text-yellow-400">💰 Digital Envelope (Amplop Digital)</div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="mb-1 block text-xs font-medium text-surface-300">Bank / E-Wallet</label>
                    <input type="text" id="w-bank-name" placeholder="BCA / GoPay / Dana" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                  </div>
                  <div>
                    <label class="mb-1 block text-xs font-medium text-surface-300">Account Holder</label>
                    <input type="text" id="w-bank-holder" placeholder="Account holder name" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                  </div>
                </div>
                <div>
                  <label class="mb-1 block text-xs font-medium text-surface-300">Account Number</label>
                  <input type="text" id="w-bank-number" placeholder="1234567890" class="form-input w-full rounded-lg border bg-surface-800/50 px-3 py-2 text-sm focus-ring" />
                </div>
              </div>

              <!-- Love Story / Quote -->
              <div>
                <label for="w-love-story" class="mb-1.5 block text-sm font-medium text-surface-200">Love Story / Quote (Optional)</label>
                <textarea id="w-love-story" rows="3" placeholder="Share your love story or a meaningful quote..." class="form-input w-full resize-none rounded-xl border bg-surface-800/50 px-4 py-3 text-sm transition-all focus-ring"></textarea>
              </div>
            </div>

            <!-- Audio Selector -->
            <div>
              <label class="mb-2 block text-sm font-medium text-surface-200">Background Music</label>
              <p class="mb-3 text-xs text-surface-500" id="audio-category-hint"></p>
              <div class="space-y-2" id="audio-track-list">
                {AUDIO_TRACKS.map((track) => (
                  <div class="audio-track-item flex items-center gap-2 rounded-xl border border-white/5 bg-surface-800 p-2 transition-all" data-track-row={track.id}>
                    <!-- Preview Play/Pause Button -->
                    <button
                      type="button"
                      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-surface-700 text-surface-300 transition-all hover:bg-primary/20 hover:text-primary cursor-pointer"
                      data-audio-preview={track.id}
                      aria-label={`Preview ${track.name}`}
                    >
                      <svg class="audio-preview-play h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
                      </svg>
                      <svg class="audio-preview-pause hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25v13.5m-7.5-13.5v13.5" />
                      </svg>
                    </button>

                    <!-- Track Info & Select Target -->
                    <button
                      type="button"
                      class="flex flex-1 items-center gap-3 rounded-lg px-2 py-1.5 text-left transition-all hover:bg-white/5 cursor-pointer"
                      data-audio-track={track.id}
                    >
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2">
                          <span class="text-sm font-medium text-surface-200">{track.name}</span>
                          <span class="audio-recommended-badge hidden text-[10px] font-semibold uppercase tracking-wider text-amber-400 bg-amber-500/10 border border-amber-500/20 rounded-full px-2 py-0.5">★ Recommended</span>
                        </div>
                        <div class="text-xs text-surface-500">{track.mood} · {track.duration}s</div>
                      </div>
                      <!-- Selected Checkmark -->
                      <div class="audio-check hidden h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary text-white shadow-glow-sm">
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                      </div>
                    </button>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Step 5: Preview -->
        <div id="step-5" class="wizard-step hidden">
          <h2 class="text-xl font-bold text-surface-50">{isEdit ? "Preview & Save Changes" : "Preview & Publish"}</h2>
          <p class="mt-2 text-sm text-surface-400">{isEdit ? "Review your changes before saving" : "Review your card before sharing it with the world"}</p>

          <!-- Mobile inline preview (visible < 1020px on step 5) -->
          <div id="step5-mobile-preview" class="mt-6 hidden">
            <div class="mb-3 text-xs font-medium text-surface-400">Card Preview</div>
            <div class="mx-auto w-full max-w-sm">
              <div class="overflow-hidden rounded-[2rem] border-4 border-surface-600 bg-surface-900 shadow-elevated">
                <div class="mx-auto h-6 w-28 rounded-b-xl bg-surface-600"></div>
                <div id="step5-preview-screen" class="relative min-h-100 overflow-y-auto p-4" style="max-height: 520px;"></div>
                <div class="flex justify-center py-2">
                  <div class="h-1 w-20 rounded-full bg-surface-600"></div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-6 rounded-2xl border border-white/8 bg-surface-900/60 backdrop-blur-md p-6">
            <div id="preview-summary" class="space-y-4">
              <!-- Populated by JS -->
            </div>

            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
              <button
                type="button"
                id="publish-btn"
                class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-linear-to-r from-violet-600 via-fuchsia-500 to-pink-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-fuchsia-500/20 transition-all hover:opacity-95 hover:shadow-fuchsia-500/30 active:scale-[0.98] cursor-pointer"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={isEdit ? "M5 13l4 4L19 7" : "M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"} />
                </svg>
                {isEdit ? "Save Changes" : "Publish Card"}
              </button>
            </div>
          </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="mt-8 flex items-center justify-between">
          <button
            type="button"
            id="prev-btn"
            class="hidden items-center gap-1.5 rounded-xl border border-white/10 bg-surface-800 px-5 py-2.5 text-sm font-medium text-surface-300 transition-all hover:bg-surface-700 hover:text-white cursor-pointer"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Back
          </button>
          <div class="flex-1"></div>
          <button
            type="button"
            id="next-btn"
            class="inline-flex items-center gap-1.5 rounded-xl bg-linear-to-r from-violet-600 via-fuchsia-500 to-pink-500 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-fuchsia-500/20 transition-all hover:opacity-95 hover:shadow-fuchsia-500/30 active:scale-[0.98] cursor-pointer"
          >
            Next
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Live Preview Panel (2 cols) — hidden on mobile, shown >= 1020px -->
      <div class="desktop-preview-col hidden" id="desktop-preview-panel">
        <div class="sticky top-24">
          <div class="mb-3 flex items-center justify-between">
            <span class="text-xs font-medium text-surface-400">Live Preview</span>
          </div>

          <!-- Device Frame -->
          <div id="device-frame" class="mx-auto w-70">
            <div class="overflow-hidden rounded-[2.5rem] border-4 border-surface-600 bg-surface-900 shadow-elevated">
              <!-- Notch -->
              <div class="mx-auto h-7 w-32 rounded-b-2xl bg-surface-600"></div>

              <!-- Screen -->
              <div id="preview-screen" class="relative min-h-125 overflow-y-auto p-4" style="max-height: 580px;">
                <div class="flex h-full flex-col items-center justify-center text-center">
                  <span class="text-4xl mb-3">✨</span>
                  <p class="text-sm text-surface-400">Your card preview<br/>will appear here</p>
                </div>
              </div>

              <!-- Home indicator -->
              <div class="flex justify-center py-2">
                <div class="h-1 w-24 rounded-full bg-surface-600"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Preview FAB (visible < 1020px, hidden on step 5) -->
  <button
    type="button"
    id="preview-fab"
    class="preview-fab-btn fixed bottom-6 right-6 z-40 hidden items-center gap-2 rounded-full bg-linear-to-r from-violet-600 via-fuchsia-500 to-pink-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-fuchsia-500/20 transition-all hover:opacity-95 hover:shadow-fuchsia-500/30 active:scale-95 cursor-pointer"
    aria-label="Preview card"
  >
    <span class="text-lg">👁️</span>
    Preview
  </button>

  <!-- Mobile Preview Fullscreen Modal -->
  <div
    id="preview-modal"
    class="fixed inset-0 z-1000 hidden flex-col bg-surface-900/95 backdrop-blur-md"
    role="dialog"
    aria-modal="true"
    aria-label="Live Card Preview"
  >
    <!-- Fixed/Sticky Header Bar with prominent close button -->
    <header class="sticky top-0 z-1010 flex items-center justify-between px-4 sm:px-6 py-3 bg-surface-900/90 backdrop-blur-md border-b border-white/10 shrink-0">
      <div class="flex items-center gap-2">
        <span class="inline-flex h-2.5 w-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-xs font-semibold uppercase tracking-wider text-surface-300">Live Preview</span>
      </div>
      <button
        type="button"
        id="preview-modal-close"
        class="bg-surface-900/90 backdrop-blur-md border border-white/10 text-white shadow-xl px-4 py-2 rounded-full inline-flex items-center gap-2 text-xs font-semibold transition-all hover:bg-surface-800 hover:border-white/20 active:scale-95 cursor-pointer"
        aria-label="Kembali ke Editor"
      >
        <span class="flex h-4 w-4 items-center justify-center rounded-full bg-white/10 text-[11px] font-bold leading-none">✕</span>
        <span>Kembali ke Editor</span>
      </button>
    </header>

    <!-- Backdrop & Phone Preview Wrapper -->
    <div
      id="preview-modal-backdrop"
      class="flex-1 overflow-y-auto p-4 sm:p-6 flex items-center justify-center min-h-0 cursor-pointer"
    >
      <div
        id="preview-modal-phone"
        class="w-full max-w-xs sm:max-w-sm my-auto cursor-default pointer-events-auto"
      >
        <!-- Phone Frame Container with comfortable scaling -->
        <div class="max-h-[80vh] flex flex-col overflow-hidden rounded-[2.25rem] border-4 border-surface-600 bg-surface-900 shadow-elevated ring-1 ring-white/10">
          <!-- Top Notch / Speaker -->
          <div class="mx-auto h-5 w-24 rounded-b-xl bg-surface-600 shrink-0 flex items-center justify-center">
            <div class="h-1 w-8 rounded-full bg-surface-700"></div>
          </div>

          <!-- Phone Screen -->
          <div
            id="modal-preview-screen"
            class="relative flex-1 min-h-80 max-h-[calc(80vh-3.5rem)] overflow-y-auto p-4 transition-all duration-300"
          ></div>

          <!-- Bottom Home Indicator -->
          <div class="flex justify-center py-2 bg-surface-900 shrink-0">
            <div class="h-1 w-20 rounded-full bg-surface-600"></div>
          </div>
        </div>

        <p class="mt-3 text-center text-xs text-surface-400 select-none">
          Ketuk area gelap atau tekan <kbd class="px-1.5 py-0.5 rounded bg-surface-800 border border-white/10 text-surface-300 text-[10px]">Esc</kbd> untuk menutup
        </p>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import { startSynth, stopSynth, isPlayingSynth } from '../../lib/synth-audio';
  import { compressImage, uploadToR2 } from '../../lib/image-compress';
  import { CATEGORY_DEFAULTS, RECOMMENDED_TRACKS } from '../../lib/audio-tracks';

  // ═══════════════════════════════════════════════════════
  // Creator Studio — Wizard State Machine
  // ═══════════════════════════════════════════════════════

  interface WeddingDataState {
    bride: { fullName: string; nickname: string; parents: string };
    groom: { fullName: string; nickname: string; parents: string };
    akadEvent: { date: string; timeStart: string; timeEnd: string; venue: string; address: string; mapsUrl: string };
    receptionEvent: { date: string; timeStart: string; timeEnd: string; venue: string; address: string; mapsUrl: string };
    unduhMantu?: {
      enabled: boolean;
      title?: string;
      date?: string;
      time?: string;
      locationName?: string;
      address?: string;
      mapUrl?: string;
    };
    digitalEnvelope: { bankName: string; accountNumber: string; accountHolder: string };
    loveStory: string;
    openingGreeting: string;
  }

  interface CardState {
    category: string;
    themeConfig: {
      primaryColor: string;
      secondaryColor: string;
      backgroundColor: string;
      fontFamily: string;
      backgroundPattern: string;
      unboxStyle: string;
      audioTrackId: string | null;
      externalAudioUrl: string | null;
      ambientEffect: string;
      weddingData?: WeddingDataState;
    };
    photos: Array<{ file?: File; previewUrl: string; publicUrl?: string }>;
    recipientName: string;
    senderName: string;
    message: string;
    eventDate: string;
  }

  function emptyWeddingData(): WeddingDataState {
    return {
      bride: { fullName: '', nickname: '', parents: '' },
      groom: { fullName: '', nickname: '', parents: '' },
      akadEvent: { date: '', timeStart: '', timeEnd: '', venue: '', address: '', mapsUrl: '' },
      receptionEvent: { date: '', timeStart: '', timeEnd: '', venue: '', address: '', mapsUrl: '' },
      unduhMantu: {
        enabled: false,
        title: 'Unduh Mantu',
        date: '',
        time: '',
        locationName: '',
        address: '',
        mapUrl: '',
      },
      digitalEnvelope: { bankName: '', accountNumber: '', accountHolder: '' },
      loveStory: '',
      openingGreeting: '',
    };
  }

  const state: CardState = {
    category: '',
    themeConfig: {
      primaryColor: '#c084fc',
      secondaryColor: '#f472b6',
      backgroundColor: '#1c1c28',
      fontFamily: 'sans',
      backgroundPattern: 'none',
      unboxStyle: 'envelope',
      audioTrackId: null,
      externalAudioUrl: null,
      ambientEffect: 'none',
    },
    photos: [],
    recipientName: '',
    senderName: '',
    message: '',
    eventDate: '',
  };

  let currentStep = 1;
  const totalSteps = 5;

  // ═══════════════════════════════════════════════════════
  // Responsive Preview — breakpoint detection
  // ═══════════════════════════════════════════════════════
  const DESKTOP_BP = 1020;

  function isDesktop(): boolean {
    return window.innerWidth >= DESKTOP_BP;
  }

  function syncResponsiveLayout() {
    const desktopPanel = document.getElementById('desktop-preview-panel');
    const fab = document.getElementById('preview-fab');
    const step5Mobile = document.getElementById('step5-mobile-preview');

    if (isDesktop()) {
      // Desktop: show side preview, hide FAB, dismiss mobile modal if open
      closeModalPreview();
      desktopPanel?.classList.remove('hidden');
      desktopPanel?.classList.add('lg:col-span-2', 'lg:block');
      fab?.classList.add('hidden');
      fab?.classList.remove('inline-flex');
      step5Mobile?.classList.add('hidden');
    } else {
      // Mobile: hide side preview, show FAB (except on step 5)
      desktopPanel?.classList.add('hidden');
      desktopPanel?.classList.remove('lg:col-span-2', 'lg:block');
      if (currentStep === 5) {
        fab?.classList.add('hidden');
        fab?.classList.remove('inline-flex');
        step5Mobile?.classList.remove('hidden');
      } else {
        fab?.classList.remove('hidden');
        fab?.classList.add('inline-flex');
        step5Mobile?.classList.add('hidden');
      }
    }
  }

  window.addEventListener('resize', syncResponsiveLayout);

  // ═══════════════════════════════════════════════════════
  // Step Navigation
  // ═══════════════════════════════════════════════════════
  function goToStep(step: number) {
    if (step < 1 || step > totalSteps) return;

    // Validation
    if (step > currentStep) {
      if (currentStep === 1 && !state.category) {
        (window as any).showToast({ message: 'Please select a category', type: 'warning' });
        return;
      }
      if (currentStep === 4) {
        if (state.category === 'wedding') {
          const wd = state.themeConfig.weddingData;
          if (!wd?.bride.fullName) {
            (window as any).showToast({ message: 'Bride\'s full name is required', type: 'warning' });
            return;
          }
          if (!wd?.groom.fullName) {
            (window as any).showToast({ message: 'Groom\'s full name is required', type: 'warning' });
            return;
          }
          if (!wd?.akadEvent.date) {
            (window as any).showToast({ message: 'Akad/ceremony date is required', type: 'warning' });
            return;
          }
          if (!state.message) {
            (window as any).showToast({ message: 'Please write an invitation message', type: 'warning' });
            return;
          }
        } else {
          if (!state.recipientName) {
            (window as any).showToast({ message: 'Recipient name is required', type: 'warning' });
            return;
          }
          if (!state.message) {
            (window as any).showToast({ message: 'Please write a message', type: 'warning' });
            return;
          }
        }
      }
    }

    currentStep = step;

    // Show/hide steps
    document.querySelectorAll('.wizard-step').forEach((el, i) => {
      el.classList.toggle('hidden', i + 1 !== currentStep);
    });

    // Update step indicators
    for (let i = 1; i <= totalSteps; i++) {
      const dot = document.querySelector(`[data-step-dot="${i}"]`) as HTMLElement;
      const line = document.querySelector(`[data-step-line="${i}"]`) as HTMLElement;
      if (dot) {
        if (i < currentStep) {
          dot.className = 'flex h-9 w-9 items-center justify-center rounded-full text-sm font-semibold bg-primary text-white transition-all duration-300';
        } else if (i === currentStep) {
          dot.className = 'flex h-9 w-9 items-center justify-center rounded-full text-sm font-semibold bg-linear-to-r from-primary to-secondary text-white shadow-lg shadow-primary/25 transition-all duration-300';
        } else {
          dot.className = 'flex h-9 w-9 items-center justify-center rounded-full text-sm font-semibold bg-surface-700 text-surface-400 transition-all duration-300';
        }
      }
      if (line) {
        line.className = i < currentStep
          ? 'mx-2 h-0.5 flex-1 rounded bg-primary transition-all duration-500'
          : 'mx-2 h-0.5 flex-1 rounded bg-surface-700 transition-all duration-500';
      }
    }

    // Show/hide nav buttons
    const prevBtn = document.getElementById('prev-btn') as HTMLElement;
    const nextBtn = document.getElementById('next-btn') as HTMLElement;
    prevBtn.style.display = currentStep > 1 ? 'inline-flex' : 'none';
    nextBtn.style.display = currentStep < totalSteps ? 'inline-flex' : 'none';

    // Update preview on step 5
    if (currentStep === 5) updatePreviewSummary();
    if (currentStep === 2) syncThemeSelectorActiveStates();
    updateLivePreview();
    syncResponsiveLayout();
  }

  // Nav button listeners
  document.getElementById('next-btn')?.addEventListener('click', () => goToStep(currentStep + 1));
  document.getElementById('prev-btn')?.addEventListener('click', () => goToStep(currentStep - 1));

  // ═══════════════════════════════════════════════════════
  // Mobile Preview FAB & Modal
  // ═══════════════════════════════════════════════════════
  const previewFab = document.getElementById('preview-fab');
  const previewModal = document.getElementById('preview-modal');
  const previewModalClose = document.getElementById('preview-modal-close');
  const previewModalBackdrop = document.getElementById('preview-modal-backdrop');
  const previewModalPhone = document.getElementById('preview-modal-phone');

  function openModalPreview() {
    if (!previewModal) return;
    updateModalPreview();
    previewModal.classList.remove('hidden');
    previewModal.classList.add('flex');
    document.body.classList.add('overflow-hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModalPreview() {
    if (!previewModal || previewModal.classList.contains('hidden')) return;
    previewModal.classList.add('hidden');
    previewModal.classList.remove('flex');
    document.body.classList.remove('overflow-hidden');
    document.body.style.overflow = '';
  }

  // Open modal when FAB is tapped
  previewFab?.addEventListener('click', openModalPreview);

  // Dismiss action 1: Close button click
  previewModalClose?.addEventListener('click', closeModalPreview);

  // Dismiss action 2: Click on dark backdrop outside phone frame
  previewModalBackdrop?.addEventListener('click', (e) => {
    if (previewModalPhone && !previewModalPhone.contains(e.target as Node)) {
      closeModalPreview();
    }
  });

  // Dismiss action 3: Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && previewModal && !previewModal.classList.contains('hidden')) {
      closeModalPreview();
    }
  });

  function updateModalPreview() {
    const modalScreen = document.getElementById('modal-preview-screen');
    applyPreviewToScreen(modalScreen, buildPreviewHTML());
  }

  // ═══════════════════════════════════════════════════════
  // Step 1: Category Selection
