                    <div class="flex items-center gap-3 min-w-0">
                      <!-- Mini Preview Play/Pause Button -->
                      <button
                        type="button"
                        id="custom-audio-preview-btn"
                        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-500 text-[#0f0d15] shadow-lg shadow-emerald-500/25 transition-all hover:scale-105 active:scale-95 cursor-pointer"
                        aria-label="Play uploaded audio preview"
                      >
                        <svg id="custom-audio-icon-play" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
                        </svg>
                        <svg id="custom-audio-icon-pause" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25v13.5m-7.5-13.5v13.5" />
                        </svg>
                      </button>

                      <div class="min-w-0">
                        <div class="flex items-center gap-2">
                          <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">Musik Kustom Aktif</span>
                          <span class="rounded-full bg-emerald-500/20 px-2 py-0.5 text-[10px] font-semibold text-emerald-300">R2 Cloud</span>
                        </div>
                        <div id="custom-audio-card-name" class="text-xs font-medium text-surface-200 truncate mt-0.5">custom-music.mp3</div>
                        <div class="text-[10px] text-surface-400">Diputar otomatis saat kartu dibuka</div>
                      </div>
                    </div>

                    <!-- Remove / Replace Button -->
                    <button
                      type="button"
                      id="custom-audio-remove-btn"
                      class="shrink-0 text-xs text-rose-400 hover:text-rose-300 px-3 py-1.5 rounded-lg border border-rose-500/20 hover:bg-rose-500/10 transition-all cursor-pointer"
                    >
                      Hapus / Ganti
                    </button>
                  </div>
                </div>
              </div>

              <!-- Studio Audio Preview Player & Custom Start Offset Control -->
              <div
                id="audio-preview-controller"
                class="mt-4 rounded-2xl border border-white/10 bg-surface-900/80 p-4 sm:p-5 backdrop-blur-md shadow-card space-y-4"
              >
                <!-- Header / Active Track Indicator -->
                <div class="flex items-center justify-between gap-2 border-b border-white/8 pb-3">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-[#f5c563]/15 text-[#f5c563] text-sm shadow-inner">
                      🎧
                    </span>
                    <div class="min-w-0">
                      <div class="text-xs font-semibold text-surface-200 uppercase tracking-wider flex items-center gap-1.5">
                        <span>Audio Preview & Titik Mulai</span>
                      </div>
                      <div id="audio-controller-track-name" class="text-xs text-surface-400 truncate font-medium">Pilih musik untuk preview</div>
                    </div>
                  </div>
                  <span id="audio-start-offset-badge" class="shrink-0 rounded-full border border-amber-500/30 bg-amber-500/10 px-2.5 py-0.5 text-[11px] font-semibold text-amber-300">
                    Mulai: 00:00
                  </span>
                </div>

                <!-- Hidden native audio element for studio preview playback -->
                <audio id="studio-preview-audio" preload="metadata" class="hidden"></audio>

                <!-- Player Controls Bar -->
                <div class="flex items-center gap-3">
                  <!-- Play / Pause Button -->
                  <button
                    type="button"
                    id="studio-player-play-btn"
                    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-linear-to-r from-[#f5c563] to-[#e07a93] text-[#0f0d15] shadow-lg shadow-[#f5c563]/25 transition-all hover:scale-105 active:scale-95 cursor-pointer"
                    aria-label="Play / Pause preview"
                    title="Play / Pause"
                  >
                    <svg id="studio-player-icon-play" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
                    </svg>
                    <svg id="studio-player-icon-pause" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25v13.5m-7.5-13.5v13.5" />
                    </svg>
                  </button>

                  <!-- Timeline Slider & Time Display -->
                  <div class="flex-1 space-y-1.5">
                    <div class="relative flex items-center">
                      <input
                        type="range"
                        id="studio-player-seek-slider"
                        min="0"
