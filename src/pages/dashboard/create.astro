                        class="w-full h-2 rounded-lg appearance-none bg-surface-700 accent-[#f5c563] cursor-pointer focus:outline-none"
                      />
                    </div>
                    <div class="flex items-center justify-between text-xs font-mono text-surface-400">
                      <span id="studio-player-time-current">00:00</span>
                      <span id="studio-player-time-duration">00:00</span>
                    </div>
                  </div>
                </div>

                <!-- Start Time Offset Control Section -->
                <div class="rounded-xl border border-white/5 bg-surface-800/60 p-3 sm:p-4 space-y-3">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div>
                      <label class="block text-xs font-semibold text-surface-200">
                        ⏱️ Titik Mulai Musik (Chorus / Reff Start)
                      </label>
                      <p class="text-[11px] text-surface-400 leading-tight mt-0.5">
                        Musik akan otomatis diputar dari detik ini saat penerima membuka kartu.
                      </p>
                    </div>

                    <!-- Manual Input & Action Buttons -->
                    <div class="flex items-center gap-2 shrink-0">
                      <div class="flex items-center gap-1.5 rounded-lg border border-white/10 bg-surface-900/90 px-2.5 py-1.5">
                        <span class="text-xs text-surface-400">Waktu:</span>
                        <input
                          type="text"
                          id="audio-start-time-input"
                          placeholder="00:00"
                          value="00:00"
                          maxlength="5"
                          class="w-14 text-center font-mono text-xs font-bold text-[#f5c563] bg-transparent focus:outline-none"
                          title="Format MM:SS (contoh 00:24) atau angka detik"
                        />
                      </div>

                      <button
                        type="button"
                        id="audio-preview-from-start-btn"
                        class="inline-flex items-center gap-1 rounded-lg border border-amber-500/30 bg-amber-500/15 px-3 py-1.5 text-xs font-medium text-amber-300 hover:bg-amber-500/25 transition-all cursor-pointer active:scale-95"
                        title="Tes putar audio dari titik mulai yang dipilih"
                      >
                        <span>▶ Tes</span>
                      </button>

                      <button
                        type="button"
                        id="audio-reset-start-btn"
                        class="rounded-lg border border-white/10 bg-surface-800 px-2.5 py-1.5 text-xs text-surface-400 hover:text-surface-200 transition-all cursor-pointer"
                        title="Reset titik mulai ke 00:00 (awal lagu)"
