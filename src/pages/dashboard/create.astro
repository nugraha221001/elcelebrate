  let previewingTrackId: string | null = null;

  function updateTrackSelectionUI() {
    document.querySelectorAll('[data-track-row]').forEach((row) => {
      const rowId = (row as HTMLElement).dataset.trackRow;
      const isSelected = state.themeConfig.audioTrackId === rowId;
      const isPreviewing = previewingTrackId === rowId;
      const check = row.querySelector('.audio-check');
      const playIcon = row.querySelector('.audio-preview-play');
      const pauseIcon = row.querySelector('.audio-preview-pause');

      // Selection active state
      if (isSelected) {
        row.classList.add('ring-2', 'ring-primary', 'border-primary', 'bg-primary/10');
        row.classList.remove('border-white/5', 'bg-surface-800');
        check?.classList.remove('hidden');
        check?.classList.add('flex');
      } else {
        row.classList.remove('ring-2', 'ring-primary', 'border-primary', 'bg-primary/10');
        row.classList.add('border-white/5', 'bg-surface-800');
        check?.classList.add('hidden');
        check?.classList.remove('flex');
      }

      // Preview play/pause icon
      if (isPreviewing) {
        playIcon?.classList.add('hidden');
        pauseIcon?.classList.remove('hidden');
      } else {
        playIcon?.classList.remove('hidden');
        pauseIcon?.classList.add('hidden');
      }
    });
  }

  // Select a track (does NOT start/stop preview)
  document.querySelectorAll('[data-audio-track]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const trackId = (btn as HTMLElement).dataset.audioTrack || null;
      state.themeConfig.audioTrackId = state.themeConfig.audioTrackId === trackId ? null : trackId;
      if (state.themeConfig.audioTrackId) {
        state.themeConfig.customAudioUrl = null;
        resetCustomAudioUploadUI();
      }
      updateTrackSelectionUI();
    });
  });

  // Preview a track (play/pause toggle, does NOT change selection)
  document.querySelectorAll('[data-audio-preview]').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation(); // Don't bubble to track-row
      const trackId = (btn as HTMLElement).dataset.audioPreview || '';

      stopCustomAudioPreview();

      if (previewingTrackId === trackId && isPlayingSynth()) {
        // Pause current preview
        stopSynth();
        previewingTrackId = null;
        updateTrackSelectionUI();
        return;
      }

      // Stop any running preview first
      if (isPlayingSynth()) stopSynth();

      // Start new preview
      previewingTrackId = trackId;
      updateTrackSelectionUI();
      const started = await startSynth(trackId, 0.3);
      if (!started) {
        previewingTrackId = null;
        updateTrackSelectionUI();
      }
    });
  });

  // ── Recommended Track Sorting & Badges ─────────────────
  function sortAndBadgeAudioTracks() {
    const category = state.category;
    const recommended = (RECOMMENDED_TRACKS as Record<string, string[]>)[category] || [];
    const list = document.getElementById('audio-track-list');
    const hint = document.getElementById('audio-category-hint');
    if (!list) return;

    // Show/hide recommended badges
    list.querySelectorAll('[data-track-row]').forEach((row) => {
      const id = (row as HTMLElement).dataset.trackRow || '';
      const badge = row.querySelector('.audio-recommended-badge');
      if (recommended.includes(id)) {
        badge?.classList.remove('hidden');
      } else {
        badge?.classList.add('hidden');
      }
    });

    // Sort: recommended first, then rest
    const rows = Array.from(list.querySelectorAll('[data-track-row]')) as HTMLElement[];
    rows.sort((a, b) => {
      const aRec = recommended.indexOf(a.dataset.trackRow || '');
      const bRec = recommended.indexOf(b.dataset.trackRow || '');
      if (aRec >= 0 && bRec >= 0) return aRec - bRec;
      if (aRec >= 0) return -1;
      if (bRec >= 0) return 1;
      return 0;
    });
    rows.forEach((r) => list.appendChild(r));

    // Update hint text
    const catLabels: Record<string, string> = { wedding: 'Wedding', birthday: 'Birthday', graduation: 'Graduation', anniversary: 'Anniversary', invitation: 'Invitation', love: 'Love & Confession', greetings: 'Greetings' };
    if (hint && catLabels[category]) {
      hint.textContent = `★ Tracks recommended for ${catLabels[category]} are shown first`;
    } else if (hint) {
      hint.textContent = '';
    }
  }

