                      <input type="text" id="w-timeline-title-1" placeholder="Judul (e.g. Hari Lamaran)" class="sm:col-span-2 form-input rounded-xl border border-white/10 bg-surface-800/80 px-3 py-2 text-xs text-white focus:ring-1 focus:ring-[#f5c563]" />
