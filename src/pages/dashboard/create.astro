    triggerBtn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();

      try {
        const confetti = (await import('canvas-confetti')).default;
        confetti({ particleCount: 45, spread: 70, origin: { y: 0.55 } });
      } catch {}

      const coverGateLeft = screen.querySelector<HTMLElement>('.preview-gate-left');
      const coverGateRight = screen.querySelector<HTMLElement>('.preview-gate-right');
      const curtain = screen.querySelector<HTMLElement>('.preview-curtain');
      const waxMedallion = screen.querySelector<HTMLElement>('.wax-seal-medallion');
      const coverContent = screen.querySelector<HTMLElement>('.preview-cover-content');
      const seamGlow = screen.querySelector<HTMLElement>('.preview-seam-glow');
      const envelopeFlap = screen.querySelector<HTMLElement>('.preview-envelope-flap');
      const giftboxLid = screen.querySelector<HTMLElement>('.preview-giftbox-lid');
      const ribbonBand = screen.querySelector<HTMLElement>('.preview-ribbon-band');

      if (coverGateLeft && coverGateRight) {
        coverGateLeft.style.transition = 'transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s';
        coverGateRight.style.transition = 'transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s';
        coverGateLeft.style.transform = 'translateX(-105%)';
        coverGateRight.style.transform = 'translateX(105%)';
        coverGateLeft.style.opacity = '0';
        coverGateRight.style.opacity = '0';
        if (seamGlow) seamGlow.style.opacity = '0';
        if (coverContent) {
          coverContent.style.transition = 'transform 0.6s ease, opacity 0.6s ease';
          coverContent.style.transform = 'scale(1.08)';
          coverContent.style.opacity = '0';
        }
      } else if (curtain) {
        curtain.style.transition = 'transform 0.85s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.85s';
        curtain.style.transform = 'translateY(-105%)';
        curtain.style.opacity = '0';
      } else if (waxMedallion) {
        waxMedallion.style.transition = 'transform 0.4s ease';
        waxMedallion.style.transform = 'scale(0.85) rotate(12deg)';
        setTimeout(() => {
          const cover = screen.querySelector<HTMLElement>('.preview-cover-container');
          if (cover) {
            cover.style.transition = 'opacity 0.7s ease, transform 0.7s ease';
            cover.style.opacity = '0';
            cover.style.transform = 'scale(1.05)';
          }
        }, 350);
      } else if (envelopeFlap) {
        envelopeFlap.style.transition = 'transform 0.6s ease';
        envelopeFlap.style.transform = 'rotateX(180deg)';
        setTimeout(() => {
          const cover = screen.querySelector<HTMLElement>('.preview-cover-container');
          if (cover) {
            cover.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            cover.style.opacity = '0';
            cover.style.transform = 'scale(0.95)';
          }
        }, 400);
      } else if (giftboxLid) {
        giftboxLid.style.transition = 'transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1)';
        giftboxLid.style.transform = 'translateY(-30px) rotate(-10deg)';
        setTimeout(() => {
          const cover = screen.querySelector<HTMLElement>('.preview-cover-container');
          if (cover) {
            cover.style.transition = 'opacity 0.6s ease';
            cover.style.opacity = '0';
          }
        }, 350);
      } else if (ribbonBand) {
        ribbonBand.style.transition = 'transform 0.5s ease, opacity 0.5s ease';
        ribbonBand.style.transform = 'scaleX(0)';
        ribbonBand.style.opacity = '0';
        setTimeout(() => {
          const cover = screen.querySelector<HTMLElement>('.preview-cover-container');
          if (cover) {
            cover.style.transition = 'opacity 0.6s ease';
            cover.style.opacity = '0';
          }
        }, 300);
      }

      setTimeout(() => {
        const cover = screen.querySelector<HTMLElement>('.preview-cover-container');
        const content = screen.querySelector<HTMLElement>('.preview-content-container');
        if (cover) cover.style.display = 'none';
        if (content) {
          content.classList.remove('hidden');
          content.style.opacity = '0';
          content.style.transition = 'opacity 0.5s ease';
          requestAnimationFrame(() => {
            content.style.opacity = '1';
          });
        }
      }, 750);
    });
  }

  function initCopyAccountInteractivity(screen: HTMLElement) {
    const copyBtn = screen.querySelector<HTMLElement>('.preview-copy-btn');
    if (!copyBtn) return;
    copyBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const val = copyBtn.dataset.copyVal || '';
      if (!val) return;
      navigator.clipboard?.writeText(val).then(() => {
        const textSpan = copyBtn.querySelector<HTMLElement>('.preview-copy-text');
        if (textSpan) {
          const orig = textSpan.textContent;
          textSpan.textContent = '✓ Tersalin!';
          setTimeout(() => { textSpan.textContent = orig; }, 2000);
        }
      }).catch(() => {});
    });
  }

  function initTestWishInteractivity(screen: HTMLElement) {
    const form = screen.querySelector<HTMLFormElement>('.preview-wish-form');
    const wishesList = screen.querySelector<HTMLElement>('.preview-wishes-list');
    if (!form || !wishesList) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const nameInput = form.querySelector<HTMLInputElement>('.preview-wish-sender');
      const msgInput = form.querySelector<HTMLTextAreaElement>('.preview-wish-msg');
      const attRadio = form.querySelector<HTMLInputElement>('input[name="preview-attendance"]:checked');

      const name = nameInput?.value.trim() || 'Tamu Undangan';
      const msg = msgInput?.value.trim() || 'Selamat berbahagia!';
      const att = attRadio?.value || 'hadir';

      const wishItem = document.createElement('div');
      wishItem.className = 'rounded-xl p-2.5 border border-white/10 bg-white/5 text-left transition-all animate-fade-in-up';
      wishItem.innerHTML = `
        <div class="flex items-center justify-between text-xs font-semibold text-white">
          <span class="truncate">${name}</span>
          <span class="text-[9px] text-surface-400 shrink-0">Baru saja</span>
        </div>
        <div class="mt-0.5">
          <span class="text-[9px] px-1.5 py-0.2 rounded-full font-medium ${att === 'hadir' ? 'bg-emerald-500/20 text-emerald-300' : 'bg-amber-500/20 text-amber-300'}">
            ${att === 'hadir' ? '✅ Hadir' : '🙏 Berhalangan'}
          </span>
        </div>
        <p class="text-[11px] text-slate-200 mt-1 leading-relaxed whitespace-pre-wrap">${msg}</p>
      `;

      wishesList.prepend(wishItem);
      form.reset();

      const toast = document.createElement('div');
      toast.className = 'text-center text-[10px] text-emerald-400 font-medium py-1 transition-all';
      toast.textContent = '✨ Ucapan berhasil disimulasikan!';
      form.parentNode?.insertBefore(toast, form.nextSibling);
      setTimeout(() => { toast.remove(); }, 2500);
    });
  }

  function initBottomDockInteractivity(screen: HTMLElement) {
    const dockBtns = screen.querySelectorAll<HTMLElement>('.preview-dock-btn');
    dockBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const targetSelector = btn.dataset.target;
        if (!targetSelector) return;
        const targetEl = screen.querySelector<HTMLElement>(targetSelector);
        if (targetEl) {
          const top = targetEl.offsetTop;
          screen.scrollTo({ top: Math.max(0, top - 8), behavior: 'smooth' });
        }
      });
    });
  }

  function initPinPadInteractivity(screen: HTMLElement) {
    const pinGate = screen.querySelector<HTMLElement>('.preview-pin-gate');
    const unlockBtn = screen.querySelector<HTMLElement>('.preview-pin-unlock-btn');
    const pinDots = screen.querySelectorAll<HTMLElement>('.preview-pin-dot');
    if (!pinGate) return;

    const unlock = async () => {
      pinDots.forEach((d) => { d.classList.add('bg-pink-500'); });
      try {
        const confetti = (await import('canvas-confetti')).default;
        confetti({ particleCount: 35, spread: 50, origin: { y: 0.5 } });
      } catch {}
      setTimeout(() => {
        pinGate.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
        pinGate.style.opacity = '0';
        pinGate.style.transform = 'scale(0.95)';
        setTimeout(() => {
          pinGate.style.display = 'none';
          const content = screen.querySelector<HTMLElement>('.preview-content-container');
          if (content) content.classList.remove('hidden');
        }, 500);
      }, 400);
    };

    unlockBtn?.addEventListener('click', unlock);
    screen.querySelectorAll<HTMLElement>('.preview-keypad-num').forEach((numBtn) => {
      numBtn.addEventListener('click', () => {
        const emptyDot = Array.from(pinDots).find((d) => !d.classList.contains('bg-pink-500'));
        if (emptyDot) {
          emptyDot.classList.add('bg-pink-500');
          const allFilled = Array.from(pinDots).every((d) => d.classList.contains('bg-pink-500'));
          if (allFilled) unlock();
        }
      });
    });
  }

  function applyPreviewToScreen(screen: HTMLElement | null, previewData: PreviewThemeData) {
    if (!screen) return;
    if ((screen as any)._countdownInterval) {
      clearInterval((screen as any)._countdownInterval);
      (screen as any)._countdownInterval = null;
    }

    screen.style.backgroundColor = previewData.bgColor;
    screen.style.backgroundImage = previewData.bgImage;
    screen.style.backgroundSize = previewData.bgSize;
    screen.style.backgroundRepeat = 'repeat';
    screen.style.fontFamily = previewData.font;
    screen.innerHTML = previewData.html;

    startCountdownTimer(screen);
    initConfessionInteractivity(screen);
    initBirthdayCakeInteractivity(screen);
    initInvitationRsvpPreview(screen);
    initUnboxTriggerInteractivity(screen);
    initCopyAccountInteractivity(screen);
    initTestWishInteractivity(screen);
    initBottomDockInteractivity(screen);
    initPinPadInteractivity(screen);
  }

