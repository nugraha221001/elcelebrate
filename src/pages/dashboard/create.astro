  function startCountdownTimer(screen: HTMLElement) {
    const boxes = screen.querySelectorAll<HTMLElement>('.countdown-box[data-countdown]');
    if (!boxes.length) return;

    const targetDateStr = screen.querySelector<HTMLElement>('[data-target-date]')?.dataset.targetDate;
    let targetTime: number;

    if (targetDateStr) {
      const d = new Date(targetDateStr + (targetDateStr.includes('T') ? '' : 'T00:00:00'));
      if (!isNaN(d.getTime()) && d.getTime() > Date.now()) {
        targetTime = d.getTime();
      } else {
        targetTime = Date.now() + (28 * 24 * 3600 + 14 * 3600 + 35 * 60 + 40) * 1000;
      }
    } else {
      targetTime = Date.now() + (28 * 24 * 3600 + 14 * 3600 + 35 * 60 + 40) * 1000;
    }

    function update() {
      const now = Date.now();
      let diff = Math.max(0, targetTime - now);
      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      diff -= days * 1000 * 60 * 60 * 24;
      const hours = Math.floor(diff / (1000 * 60 * 60));
      diff -= hours * 1000 * 60 * 60;
      const minutes = Math.floor(diff / (1000 * 60));
      diff -= minutes * 1000 * 60;
      const seconds = Math.floor(diff / 1000);

      boxes.forEach((box) => {
        const unit = box.dataset.countdown;
        if (unit === 'days') box.textContent = String(days).padStart(2, '0');
        else if (unit === 'hours') box.textContent = String(hours).padStart(2, '0');
        else if (unit === 'minutes') box.textContent = String(minutes).padStart(2, '0');
        else if (unit === 'seconds') box.textContent = String(seconds).padStart(2, '0');
      });
    }

    update();
    const timerId = window.setInterval(update, 1000);
    (screen as any)._countdownInterval = timerId;
  }

  function initConfessionInteractivity(screen: HTMLElement) {
    const noBtn = screen.querySelector<HTMLElement>('#preview-confession-no-btn');
    const yesBtn = screen.querySelector<HTMLElement>('#preview-confession-yes-btn');
    const container = screen.querySelector<HTMLElement>('#preview-confession-container');
    const qState = screen.querySelector<HTMLElement>('#preview-confession-question-state');
    const cState = screen.querySelector<HTMLElement>('#preview-confession-celebration-state');

    if (!noBtn || !container) return;

    let runawayCount = 0;
    const runaway = (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
      runawayCount++;

      const cRect = container.getBoundingClientRect();
      const bRect = noBtn.getBoundingClientRect();
      const maxX = Math.max(15, (cRect.width - bRect.width) / 2);
      const maxY = Math.max(10, (cRect.height - bRect.height) / 2);

      const rx = (Math.random() - 0.5) * 2 * maxX;
      const ry = (Math.random() - 0.5) * 2 * maxY;
      const scale = Math.max(0.7, 1 - runawayCount * 0.05);

      noBtn.style.transition = 'transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1)';
      noBtn.style.transform = `translate(${rx}px, ${ry}px) scale(${scale})`;

      if (yesBtn) {
        const yesScale = Math.min(1.3, 1 + runawayCount * 0.06);
        yesBtn.style.transition = 'transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1)';
        yesBtn.style.transform = `scale(${yesScale})`;
      }
    };

    noBtn.addEventListener('pointerover', runaway);
    noBtn.addEventListener('mouseenter', runaway);
    noBtn.addEventListener('touchstart', runaway, { passive: false });

    if (yesBtn && qState && cState) {
      yesBtn.addEventListener('click', async () => {
        qState.style.display = 'none';
        cState.classList.remove('hidden');
        try {
          const confetti = (await import('canvas-confetti')).default;
          confetti({ particleCount: 50, spread: 60, origin: { y: 0.6 } });
        } catch {}
      });
    }
  }

  function initBirthdayCakeInteractivity(screen: HTMLElement) {
    const cakeTrigger = screen.querySelector<HTMLElement>('.preview-birthday-cake-container');
    if (!cakeTrigger) return;

    let isExtinguished = false;
    cakeTrigger.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();

      const flame = cakeTrigger.querySelector<HTMLElement>('.preview-candle-flame');
      const smoke = cakeTrigger.querySelector<HTMLElement>('.preview-candle-smoke');
      const hint = cakeTrigger.querySelector<HTMLElement>('.preview-candle-hint');
      const banner = cakeTrigger.querySelector<HTMLElement>('.preview-candle-wish-banner');

      if (!isExtinguished) {
        // Extinguish flame with smoke puff and celebratory banner
        isExtinguished = true;
        if (flame) flame.classList.add('hidden');
        if (smoke) {
          smoke.classList.remove('hidden');
          smoke.style.opacity = '1';
          setTimeout(() => { smoke.style.opacity = '0'; }, 1000);
        }
        if (hint) hint.classList.add('hidden');
        if (banner) banner.classList.remove('hidden');
        try {
          const confetti = (await import('canvas-confetti')).default;
          confetti({ particleCount: 40, spread: 60, origin: { y: 0.55 } });
        } catch {}
      } else {
        // Relight candle on next tap
        isExtinguished = false;
        if (flame) flame.classList.remove('hidden');
        if (smoke) smoke.classList.add('hidden');
        if (hint) hint.classList.remove('hidden');
        if (banner) banner.classList.add('hidden');
      }
    });
  }

