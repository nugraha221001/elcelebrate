  function renderGreetingsPresets() {
    const listEl = document.getElementById('greetings-presets-list');
    if (!listEl) return;
    const occasion = (state.themeConfig as any).occasion || 'idul-fitri';
    const presets = GREETINGS_PRESETS[occasion] || GREETINGS_PRESETS['general'];

    listEl.innerHTML = presets.map((p, idx) => `
      <button
        type="button"
        class="greetings-preset-item text-left p-3 rounded-xl border border-amber-500/20 bg-surface-900/60 hover:border-amber-400 hover:bg-amber-500/10 transition-all cursor-pointer"
        data-greeting-index="${idx}"
      >
        <div class="text-xs font-semibold text-amber-300">${p.title}</div>
        <div class="text-[11px] text-surface-400 mt-1 line-clamp-2">${p.text}</div>
      </button>
    `).join('');

    listEl.querySelectorAll('.greetings-preset-item').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt((btn as HTMLElement).dataset.greetingIndex || '0', 10);
        const selected = presets[idx];
        if (selected) {
          state.message = selected.text;
          const msgEl = document.getElementById('message') as HTMLTextAreaElement | null;
          if (msgEl) msgEl.value = selected.text;
          (window as any).showToast?.({ message: 'Greeting template applied!', type: 'success' });
          updateLivePreview();
        }
      });
    });
  }

