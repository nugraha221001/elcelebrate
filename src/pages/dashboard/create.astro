  /* Floating Mortarboard Toss Animation */
  :global(.animate-toss-1) { animation: mortarboard-toss-1 5s cubic-bezier(0.2, 0.8, 0.4, 1) infinite; }
  :global(.animate-toss-2) { animation: mortarboard-toss-2 6s 1.2s cubic-bezier(0.2, 0.8, 0.4, 1) infinite; }
  :global(.animate-toss-3) { animation: mortarboard-toss-3 5.5s 0.6s cubic-bezier(0.2, 0.8, 0.4, 1) infinite; }
</style>
