        btn.classList.add(...ACTIVE_THEME_CLASSES);
        if (check) {
          check.classList.remove('hidden');
          check.classList.add('flex');
        }
      } else {
        btn.classList.remove(...ACTIVE_THEME_CLASSES);
        btn.classList.add(...INACTIVE_THEME_CLASSES);
        if (check) {
          check.classList.add('hidden');
          check.classList.remove('flex');
