              </div>
            </div>
            <div class="mx-auto w-full max-w-sm min-w-0 overflow-x-hidden">
              <div class="w-full max-w-full min-w-0 overflow-x-hidden rounded-[2.25rem] border-4 border-surface-600 bg-surface-900 shadow-elevated ring-1 ring-white/10">
                <div class="mx-auto h-5 w-24 rounded-b-xl bg-surface-600 flex items-center justify-center">
                  <div class="h-1 w-8 rounded-full bg-surface-700"></div>
                </div>
                <div class="relative overflow-hidden">
                  <div id="step5-preview-corner-frame" class="preview-corner-frame absolute inset-0 pointer-events-none z-20 overflow-hidden"></div>
