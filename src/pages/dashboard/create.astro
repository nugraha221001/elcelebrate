    const photoOrRings = coverPhotoUrl
      ? `<div class="relative mx-auto mb-3 h-28 w-22 sm:h-32 sm:w-26 overflow-hidden rounded-t-full border border-amber-300/40 shadow-xl bg-black/20">
           <img src="${coverPhotoUrl}" alt="Mempelai" class="h-full w-full object-cover" />
           <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>
         </div>`
      : `<div class="text-4xl mb-3 animate-bounce" style="animation-duration: 3s;">💍</div>`;

    const commonCenter = `
      <div class="preview-cover-content text-center px-4 relative z-25 max-w-full">
        ${photoOrRings}
        <p class="text-[10px] uppercase tracking-[0.25em] text-[#e07a93] font-medium mb-1" style="font-family: ${font}">${headerTitle}</p>
        <h3 class="text-xl font-bold font-serif text-white tracking-wide" style="font-family: ${font}">
          <span style="color: ${primaryColor}">${brideName}</span>
          <span class="text-sm font-light text-surface-300 mx-1">&</span>
          <span style="color: ${secondaryColor}">${groomName}</span>
        </h3>
        <div class="my-3 px-3 py-1.5 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs max-w-xs mx-auto">
          <p class="text-[9px] text-surface-400">Kepada Yth. Bapak/Ibu/Saudara/i:</p>
          <p class="text-xs font-semibold text-white truncate">${guestName}</p>
        </div>
        ${akadDate ? `<p class="text-[10px] text-surface-300 mb-3">${akadDate}</p>` : ''}
        ${unboxingStyle === 'wax-seal' ? `
          <div class="mt-2 flex flex-col items-center">
            <button
              type="button"
              class="preview-unbox-trigger wax-seal-medallion wax-seal-pulse relative flex h-14 w-14 items-center justify-center rounded-full shadow-2xl cursor-pointer transition-transform duration-300 hover:scale-105 active:scale-95"
              title="Ketuk Segel untuk Membuka"
            >
              <div class="absolute inset-1 rounded-full border border-amber-200/50"></div>
              <span class="text-xl select-none">👑</span>
            </button>
            <span class="mt-1.5 text-[9px] font-semibold tracking-widest uppercase text-amber-200/90 drop-shadow-xs">Ketuk Segel untuk Membuka</span>
          </div>
        ` : `
          <button
            type="button"
            class="preview-unbox-trigger group inline-flex items-center gap-2 rounded-full px-5 py-2 text-xs font-semibold text-white shadow-xl transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer"
            style="background: linear-gradient(135deg, ${primaryColor}, ${secondaryColor}); box-shadow: 0 4px 16px ${primaryColor}40;"
          >
            <span>Buka Undangan</span>
            <span class="text-sm">${unboxingStyle === 'curtain-lift' ? '✨' : '🏛️'}</span>
          </button>
        `}
      </div>
    `;

    if (unboxingStyle === 'gate-split') {
      return `
        <div class="preview-cover-gate preview-gate-left absolute inset-y-0 left-0 w-1/2 overflow-hidden pointer-events-none border-r border-[#f5c563]/40 z-20" style="background: linear-gradient(135deg, #181522, ${primaryColor}25, #181522);"></div>
        <div class="preview-cover-gate preview-gate-right absolute inset-y-0 right-0 w-1/2 overflow-hidden pointer-events-none border-l border-[#f5c563]/40 z-20" style="background: linear-gradient(225deg, #181522, ${secondaryColor}25, #181522);"></div>
        <div class="preview-seam-glow pointer-events-none absolute inset-y-0 left-1/2 -translate-x-1/2 z-22 w-0.5 bg-gradient-to-b from-transparent via-[#f5c563]/60 to-transparent"></div>
        ${commonCenter}
      `;
    }

    if (unboxingStyle === 'curtain-lift') {
      return `
        <div class="preview-curtain absolute inset-0 z-20 flex flex-col items-center justify-center p-4 text-center overflow-hidden" style="background: linear-gradient(180deg, ${primaryColor}30, #181522 40%, ${secondaryColor}30);">
          ${commonCenter}
        </div>
      `;
    }

    return `
      <div class="wax-envelope-perspective absolute top-0 inset-x-0 h-16 pointer-events-none z-15 flex justify-center">
        <svg class="w-full h-full drop-shadow-md preview-envelope-flap" viewBox="0 0 400 80" preserveAspectRatio="none">
          <polygon points="0,0 400,0 200,75" fill="#181522" stroke="${primaryColor}" stroke-opacity="0.4" stroke-width="1.2" />
        </svg>
      </div>
      ${commonCenter}
    `;
  }

  function buildPreviewStandardCover(
    primaryColor: string,
    secondaryColor: string,
    _font: string,
    unboxStyle: string,
    _emoji: string,
    recipientName: string,
    senderName: string,
    hasPasscode: boolean
  ): string {
    if (state.category === 'love' && hasPasscode) {
      return `
        <div class="preview-pin-gate relative z-25 text-center p-4 max-w-xs mx-auto">
          <div class="mx-auto mb-2 flex h-12 w-12 items-center justify-center rounded-2xl bg-pink-500/10 border border-pink-500/20 text-2xl animate-bounce" style="animation-duration: 3s;">
            🔐
          </div>
          <h4 class="text-sm font-bold text-white mb-0.5" style="color: ${primaryColor}">Surat Cinta Terkunci</h4>
          <p class="text-[10px] text-surface-300 mb-3">Masukkan 4 digit PIN untuk membuka 💕</p>
          <div class="flex justify-center gap-2 mb-3">
            <div class="preview-pin-dot flex h-10 w-9 items-center justify-center rounded-xl border border-white/20 bg-surface-800 text-lg font-bold text-white shadow-inner"></div>
            <div class="preview-pin-dot flex h-10 w-9 items-center justify-center rounded-xl border border-white/20 bg-surface-800 text-lg font-bold text-white shadow-inner"></div>
            <div class="preview-pin-dot flex h-10 w-9 items-center justify-center rounded-xl border border-white/20 bg-surface-800 text-lg font-bold text-white shadow-inner"></div>
            <div class="preview-pin-dot flex h-10 w-9 items-center justify-center rounded-xl border border-white/20 bg-surface-800 text-lg font-bold text-white shadow-inner"></div>
          </div>
          <div class="grid grid-cols-3 gap-1.5 max-w-[180px] mx-auto mb-3">
            ${[1, 2, 3, 4, 5, 6, 7, 8, 9].map(n => `
              <button type="button" class="preview-keypad-num py-1.5 rounded-lg bg-surface-800/80 border border-white/10 text-xs font-semibold text-white hover:bg-surface-700 active:scale-95 cursor-pointer">${n}</button>
            `).join('')}
            <div></div>
            <button type="button" class="preview-keypad-num py-1.5 rounded-lg bg-surface-800/80 border border-white/10 text-xs font-semibold text-white hover:bg-surface-700 active:scale-95 cursor-pointer">0</button>
            <div></div>
          </div>
          <button type="button" class="preview-pin-unlock-btn w-full py-2 rounded-xl text-xs font-bold text-white shadow-md cursor-pointer transition-transform active:scale-95" style="background: linear-gradient(135deg, ${primaryColor}, ${secondaryColor});">
            Buka Kunci (Simulasi PIN) ✨
          </button>
        </div>
      `;
    }

    if (unboxStyle === 'envelope') {
      return `
        <div class="preview-cover-content text-center p-4 relative z-25 max-w-xs mx-auto">
          <div class="relative mx-auto mb-3 h-28 w-44 rounded-2xl border-2 border-white/15 bg-surface-800/90 shadow-2xl p-3 flex flex-col justify-between overflow-hidden">
            <div class="preview-envelope-flap absolute top-0 inset-x-0 h-14 bg-surface-700/80 border-b border-amber-300/30 flex items-center justify-center" style="clip-path: polygon(0 0, 100% 0, 50% 100%);">
              <span class="text-xs">✉️</span>
            </div>
            <div class="pt-6 text-center">
              <p class="text-[9px] text-surface-400">Untuk seseorang yang spesial:</p>
              <p class="text-xs font-bold text-white truncate">${recipientName || 'Dear Someone'}</p>
            </div>
            <div class="text-[9px] text-amber-300/80 italic text-right">${senderName ? `Dari: ${senderName}` : '✨'}</div>
          </div>
          <button type="button" class="preview-unbox-trigger group inline-flex items-center gap-2 rounded-full px-5 py-2 text-xs font-semibold text-white shadow-xl transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer" style="background: linear-gradient(135deg, ${primaryColor}, ${secondaryColor}); box-shadow: 0 4px 16px ${primaryColor}40;">
            <span>Buka Amplop</span>
            <span>✉️</span>
          </button>
        </div>
      `;
    }

    if (unboxStyle === 'giftbox') {
      return `
        <div class="preview-cover-content text-center p-4 relative z-25 max-w-xs mx-auto">
          <div class="relative mx-auto mb-3 h-28 w-28 rounded-2xl border-2 border-white/15 bg-surface-800/90 shadow-2xl flex items-center justify-center">
            <div class="preview-giftbox-lid absolute -top-1.5 inset-x-0 h-7 rounded-t-xl bg-surface-700 border-b-2 border-amber-400/40 flex items-center justify-center">
              <span class="text-xs select-none">🎀</span>
            </div>
            <div class="text-3xl select-none mt-2">🎁</div>
          </div>
          <p class="text-xs font-bold text-white mb-2">Spesial untuk ${recipientName || 'Kamu'}!</p>
          <button type="button" class="preview-unbox-trigger group inline-flex items-center gap-2 rounded-full px-5 py-2 text-xs font-semibold text-white shadow-xl transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer" style="background: linear-gradient(135deg, ${primaryColor}, ${secondaryColor}); box-shadow: 0 4px 16px ${primaryColor}40;">
            <span>Buka Hadiah</span>
            <span>🎁</span>
          </button>
        </div>
      `;
    }

    return `
      <div class="preview-cover-content text-center p-4 relative z-25 max-w-xs mx-auto">
        <div class="relative mx-auto mb-3 h-28 w-44 rounded-2xl border border-white/10 bg-surface-800/80 shadow-2xl p-4 flex flex-col justify-center items-center overflow-hidden">
          <div class="preview-ribbon-band absolute inset-x-0 top-1/2 -translate-y-1/2 h-8 bg-pink-500/25 border-y border-pink-400/40 flex items-center justify-center">
            <span class="text-sm select-none">🎀</span>
          </div>
          <p class="text-xs font-bold text-white relative z-10">${recipientName || 'Someone Special'}</p>
        </div>
        <button type="button" class="preview-unbox-trigger group inline-flex items-center gap-2 rounded-full px-5 py-2 text-xs font-semibold text-white shadow-xl transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer" style="background: linear-gradient(135deg, ${primaryColor}, ${secondaryColor}); box-shadow: 0 4px 16px ${primaryColor}40;">
          <span>Lepaskan Pita</span>
          <span>🎀</span>
        </button>
      </div>
    `;
  }

  function buildPreviewWeddingContent(
    primaryColor: string,
    secondaryColor: string,
    _font: string,
    wd: WeddingDataState,
    brideName: string,
    groomName: string,
    coverPhotoUrl: string,
    brideImg: string,
    groomImg: string
  ): string {
    const headerTitle = state.themeConfig.weddingHeaderTitle || "Walimatul 'Urs";

    const heroBannerHtml = coverPhotoUrl ? `
      <div class="preview-sec-hero pt-4 pb-2 px-3 text-center">
        <div class="relative mx-auto max-w-[270px] overflow-hidden rounded-t-[80px] rounded-b-2xl border-2 border-amber-300/40 shadow-xl bg-white/5 ring-2 ring-white/10">
          <div class="aspect-4/5 w-full overflow-hidden">
            <img src="${coverPhotoUrl}" alt="Mempelai" class="hero-couple-photo ken-burns-active w-full h-full object-cover will-change-transform" />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent pointer-events-none"></div>
          <div class="absolute bottom-2.5 inset-x-0 text-center px-2 pointer-events-none">
            <p class="text-[9px] uppercase tracking-[0.25em] text-amber-200/90 font-medium mb-0.5">${headerTitle}</p>
            <h3 class="text-base font-serif font-bold text-white tracking-wide truncate">${brideName} & ${groomName}</h3>
          </div>
        </div>
      </div>
    ` : `
      <div class="preview-sec-hero pt-6 pb-2 px-4 text-center">
        <div class="text-3xl mb-1.5 animate-bounce" style="animation-duration: 3s;">💍</div>
        <p class="text-[9px] uppercase tracking-[0.25em] text-amber-200/90 font-medium mb-0.5">${headerTitle}</p>
        <h3 class="text-lg font-serif font-bold text-white tracking-wide">${brideName} & ${groomName}</h3>
      </div>
    `;

    const openingGreetingHtml = wd.openingGreeting ? `
      <div class="text-center mb-4 px-3">
        <p class="text-slate-100 text-[11px] italic leading-relaxed whitespace-pre-line">${wd.openingGreeting}</p>
        <div class="champagne-divider"></div>
      </div>
    ` : `
      <div class="text-center mb-4 px-3">
        <p class="text-[10px] font-semibold tracking-[0.2em] text-slate-300 uppercase">Bismillahirrahmanirrahim</p>
        <div class="champagne-divider"></div>
      </div>
    `;

    const mempelaiHtml = `
      <section id="preview-sec-mempelai" class="py-4 px-3 max-w-full">
        ${openingGreetingHtml}
        <div class="flex flex-col items-center gap-3">
          <!-- Bride -->
          <div class="text-center flex flex-col items-center w-full">
            <div class="h-20 w-20 rounded-full overflow-hidden border-2 shadow-lg ring-2 ring-amber-300/30 mb-1.5" style="border-color: ${primaryColor}60;">
              <img src="${brideImg}" alt="${wd.bride.fullName || 'Bride'}" class="h-full w-full object-cover" />
            </div>
            <h4 class="text-sm font-bold font-serif" style="color: ${primaryColor}">${wd.bride.fullName || 'Fatimah Az-Zahra'}</h4>
            ${wd.bride.nickname ? `<p class="text-[10px] text-surface-300">(${wd.bride.nickname})</p>` : ''}
            ${wd.bride.parents ? `<p class="text-[10px] text-slate-300 mt-0.5">Putri dari ${wd.bride.parents}</p>` : ''}
          </div>

          <!-- Separator -->
          <div class="text-xl font-light text-slate-400 my-0.5" style="color: ${secondaryColor}70">&</div>

          <!-- Groom -->
          <div class="text-center flex flex-col items-center w-full">
            <div class="h-20 w-20 rounded-full overflow-hidden border-2 shadow-lg ring-2 ring-amber-300/30 mb-1.5" style="border-color: ${secondaryColor}60;">
              <img src="${groomImg}" alt="${wd.groom.fullName || 'Groom'}" class="h-full w-full object-cover" />
            </div>
            <h4 class="text-sm font-bold font-serif" style="color: ${secondaryColor}">${wd.groom.fullName || 'Ali bin Abi Thalib'}</h4>
            ${wd.groom.nickname ? `<p class="text-[10px] text-surface-300">(${wd.groom.nickname})</p>` : ''}
            ${wd.groom.parents ? `<p class="text-[10px] text-slate-300 mt-0.5">Putra dari ${wd.groom.parents}</p>` : ''}
          </div>
        </div>
      </section>
    `;

    const sacredQuoteHtml = (wd.sacredQuote?.quote && wd.sacredQuote?.enabled !== false) ? `
      <section class="py-2.5 px-3 text-center">
        <div class="rounded-xl p-3 border border-amber-300/20 bg-amber-500/5">
          <p class="text-[11px] italic text-slate-100 leading-relaxed whitespace-pre-line font-serif">"${wd.sacredQuote.quote}"</p>
          <div class="champagne-divider my-2"></div>
          ${wd.sacredQuote.source ? `<p class="text-[9px] font-semibold text-amber-200 tracking-wider uppercase">— ${wd.sacredQuote.source}</p>` : ''}
        </div>
      </section>
    ` : '';

    const messageHtml = state.message ? `
      <section class="py-2 px-3">
        <div class="rounded-xl p-3 text-center text-xs leading-relaxed text-slate-200 border" style="background: ${primaryColor}0d; border-color: ${primaryColor}20;">
          <p class="whitespace-pre-wrap">${state.message}</p>
        </div>
      </section>
    ` : '';

    const loveStoryHtml = wd.loveStory ? `
      <section class="py-3 px-3 text-center">
        <div class="text-xl leading-none text-amber-300/40 mb-1">❝</div>
        <p class="text-[11px] italic text-slate-200 leading-relaxed px-2 whitespace-pre-wrap">${wd.loveStory}</p>
        <div class="text-xl leading-none text-amber-300/40 mt-1">❞</div>
      </section>
    ` : '';

    const hasTimeline = Array.isArray(wd.loveStoryTimeline) && wd.loveStoryTimeline.some(t => t && (t.year || t.title || t.story));
    const timelineHtml = hasTimeline ? `
      <section class="py-4 px-3">
        <div class="text-center mb-3">
          <p class="text-[9px] uppercase tracking-[0.25em] font-semibold text-pink-300 mb-0.5">OUR JOURNEY</p>
          <h4 class="text-sm font-serif font-bold text-white">Kisah Cinta & Perjalanan</h4>
          <div class="champagne-divider mb-3"></div>
        </div>
        <div class="relative border-l-2 border-amber-300/30 ml-4 space-y-4 my-2">
          ${wd.loveStoryTimeline!.map((item) => {
            if (!item || (!item.year && !item.title && !item.story)) return '';
            return `
              <div class="relative pl-5">
                <div class="absolute -left-[9px] top-1 h-4 w-4 rounded-full bg-amber-400 border-2 border-surface-900 shadow-md flex items-center justify-center text-[8px]">✨</div>
                ${item.year ? `<span class="inline-block px-1.5 py-0.5 rounded-md bg-amber-400/20 text-amber-200 text-[9px] font-bold tracking-wider mb-0.5">${item.year}</span>` : ''}
                ${item.title ? `<h5 class="text-xs font-bold text-white font-serif">${item.title}</h5>` : ''}
                ${item.story ? `<p class="text-[10px] text-slate-300 leading-relaxed mt-0.5 whitespace-pre-line">${item.story}</p>` : ''}
              </div>
            `;
          }).join('')}
        </div>
      </section>
    ` : '';

    const targetDate = wd.akadEvent.date || state.eventDate || '';
    const countdownHtml = `
      <section id="preview-sec-countdown" class="py-4 px-3 text-center">
        <h4 class="text-[10px] font-semibold tracking-[0.2em] text-slate-300 uppercase mb-1">Menghitung Hari</h4>
        <div class="champagne-divider mb-3"></div>
        <div class="countdown-timer flex justify-center gap-2" data-target-date="${targetDate}">
          ${['Hari', 'Jam', 'Mnt', 'Dtk'].map((unit, idx) => `
            <div class="flex flex-col items-center">
              <div
                class="countdown-box flex h-11 w-11 items-center justify-center rounded-lg text-sm font-bold text-white shadow-md border border-white/10"
                style="background: linear-gradient(135deg, ${primaryColor}35, ${secondaryColor}25);"
                data-countdown="${['days', 'hours', 'minutes', 'seconds'][idx]}"
              >--</div>
              <span class="mt-1 text-[9px] text-slate-300 font-medium">${unit}</span>
            </div>
          `).join('')}
        </div>
      </section>
    `;

    const akadDateFormatted = wd.akadEvent.date ? new Date(wd.akadEvent.date + 'T00:00:00').toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) : '';
    const receptionDateFormatted = wd.receptionEvent.date ? new Date(wd.receptionEvent.date + 'T00:00:00').toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) : '';

    const formatGCalUrl = (title: string, date?: string, timeStart?: string, timeEnd?: string, venue?: string, address?: string) => {
      if (!date) return '#';
      const rawDate = date.replace(/-/g, '');
      let startStr = rawDate;
      let endStr = rawDate;
      if (timeStart) {
        const sTime = timeStart.replace(/:/g, '').padEnd(4, '0') + '00';
        startStr = `${rawDate}T${sTime}`;
        if (timeEnd) {
          const eTime = timeEnd.replace(/:/g, '').padEnd(4, '0') + '00';
          endStr = `${rawDate}T${eTime}`;
        } else {
          const [sh, sm] = timeStart.split(':').map(Number);
          const eh = String(((sh || 0) + 2) % 24).padStart(2, '0');
          const em = String(sm || 0).padStart(2, '0');
          endStr = `${rawDate}T${eh}${em}00`;
        }
      }
      const location = [venue, address].filter(Boolean).join(', ');
      const q = new URLSearchParams({
        action: 'TEMPLATE',
        text: title,
        dates: `${startStr}/${endStr}`,
        ...(location ? { location } : {}),
      });
      return `https://calendar.google.com/calendar/render?${q.toString()}`;
    };

    const eventsHtml = `
      <section id="preview-sec-acara" class="py-4 px-3">
        <div class="text-center mb-3">
          <h4 class="text-[10px] font-semibold tracking-[0.2em] text-slate-300 uppercase mb-1">Jadwal Acara</h4>
          <div class="champagne-divider"></div>
        </div>
        <div class="space-y-3">
          <!-- Akad -->
          <div class="rounded-xl p-3 border" style="background: ${primaryColor}0a; border-color: ${primaryColor}20;">
            <div class="flex items-center gap-1.5 mb-1.5">
              <span class="text-sm">🕌</span>
              <h5 class="text-xs font-semibold" style="color: ${primaryColor}">Akad Nikah</h5>
            </div>
            <div class="space-y-0.5 text-[11px] text-slate-200">
              ${akadDateFormatted ? `<p class="font-medium">📅 ${akadDateFormatted}</p>` : ''}
              ${(wd.akadEvent.timeStart || wd.akadEvent.timeEnd) ? `<p>🕐 ${wd.akadEvent.timeStart || '--:--'} — ${wd.akadEvent.timeEnd || 'Selesai'}</p>` : ''}
              ${wd.akadEvent.venue ? `<p class="font-semibold text-white">📍 ${wd.akadEvent.venue}</p>` : ''}
              ${wd.akadEvent.address ? `<p class="text-[10px] text-slate-400">${wd.akadEvent.address}</p>` : ''}
            </div>
            <div class="mt-2.5 flex flex-wrap gap-1.5">
              ${wd.akadEvent.mapsUrl ? `
                <a href="${wd.akadEvent.mapsUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-[10px] font-medium text-white shadow-xs" style="background: ${primaryColor};">
                  <span>📍</span> Maps
                </a>
              ` : ''}
              ${wd.akadEvent.date ? `
                <a href="${formatGCalUrl(`Akad Nikah: ${brideName} & ${groomName}`, wd.akadEvent.date, wd.akadEvent.timeStart, wd.akadEvent.timeEnd, wd.akadEvent.venue, wd.akadEvent.address)}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-[10px] font-medium border border-white/20 bg-surface-800/80 text-surface-200 hover:text-white transition-all shadow-xs">
                  <span>🗓️</span> Google Cal
                </a>
              ` : ''}
            </div>
          </div>

          <!-- Resepsi -->
          ${(wd.receptionEvent.date || wd.receptionEvent.venue) ? `
            <div class="rounded-xl p-3 border" style="background: ${secondaryColor}0a; border-color: ${secondaryColor}20;">
              <div class="flex items-center gap-1.5 mb-1.5">
                <span class="text-sm">🎉</span>
                <h5 class="text-xs font-semibold" style="color: ${secondaryColor}">Resepsi</h5>
              </div>
