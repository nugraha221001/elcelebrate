---
import DashboardLayout from '../../components/layout/DashboardLayout.astro';
import Toast from '../../components/ui/Toast.astro';
import { CATEGORY_META } from '../../lib/types';
import { AUDIO_TRACKS } from '../../lib/audio-tracks';

export const prerender = false;

// Auth guard — must run before any HTML is emitted
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

const editId = Astro.url.searchParams.get('edit');
const isEdit = Boolean(editId);
---

<DashboardLayout title={isEdit ? "Edit Card" : "Create Card"} description={isEdit ? "Update your digital greeting card" : "Design a beautiful digital greeting card"}>
  <Toast />

  <div class="mx-auto max-w-5xl">
    <!-- Step Indicator -->
    <div class="mb-10" id="step-indicator">
      <div class="flex items-center justify-between">
        {['Category', 'Theme', 'Media', 'Message', 'Preview'].map((label, i) => (
          <div class="flex flex-1 items-center">
            <div class="flex flex-col items-center gap-1.5">
              <div
                class="flex h-9 w-9 items-center justify-center rounded-full text-sm font-semibold transition-all duration-300"
                data-step-dot={i + 1}
              >
                {i + 1}
              </div>
              <span class="hidden text-xs font-medium text-surface-400 sm:block" data-step-label={i + 1}>
                {label}
              </span>
            </div>
            {i < 4 && (
              <div class="mx-2 h-0.5 flex-1 rounded bg-surface-700 transition-all duration-500" data-step-line={i + 1}></div>
            )}
          </div>
        ))}
      </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-5">
      <!-- Wizard Panel (3 cols) -->
      <div class="lg:col-span-3">
        <!-- Step 1: Category -->
        <div id="step-1" class="wizard-step">
          <div class="mb-4">
            <a
              href="/dashboard"
              class="inline-flex items-center gap-1.5 text-xs font-medium text-surface-400 transition-colors hover:text-[#f5c563]"
            >
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
              </svg>
              ← Back to Dashboard
            </a>
          </div>
          <h2 class="text-xl font-bold text-surface-50">Choose a Category</h2>
          <p class="mt-2 text-sm text-surface-400">What are we celebrating?</p>

          <div class="mt-6 grid grid-cols-2 gap-4">
            {Object.entries(CATEGORY_META).map(([key, meta]) => (
              <button
                type="button"
                class="group relative overflow-hidden rounded-2xl border border-white/8 hover:border-[#f5c563]/40 transition-all duration-300 bg-surface-900/60 backdrop-blur-md p-5 text-left hover:shadow-glow-sm cursor-pointer"
                data-category={key}
              >
                <div class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-110">
                  {meta.emoji}
                </div>
                <div class="text-base font-semibold text-surface-100">{meta.label}</div>
                <div class="mt-1 text-xs text-surface-400">{meta.description}</div>
                <!-- Selected indicator -->
                <div class="absolute right-3 top-3 hidden h-6 w-6 items-center justify-center rounded-full bg-[#f5c563] text-[#0f0d15]" data-check>
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                </div>
              </button>
            ))}
          </div>
        </div>

        <!-- Step 2: Theme Customizer -->
        <div id="step-2" class="wizard-step hidden">
          <h2 class="text-xl font-bold text-surface-50">Customize Theme</h2>
          <p class="mt-2 text-sm text-surface-400">Set the visual mood for your card</p>

          <div class="mt-6 space-y-6">
            <!-- Greetings Occasion Selector (Step 2) -->
            <div id="greetings-occasion-panel" class="hidden rounded-2xl border border-amber-500/20 bg-surface-900/60 p-4 space-y-3">
              <div class="flex items-center justify-between">
                <label class="block text-sm font-semibold text-surface-200">✨ Select Occasion / Perayaan</label>
                <span class="text-xs text-amber-400 bg-amber-500/10 border border-amber-500/20 px-2.5 py-0.5 rounded-full font-medium">Holiday & Greetings</span>
              </div>
              <p class="text-xs text-surface-400">Choose the occasion to tailor ambient effects and holiday presets:</p>
              <div class="grid grid-cols-2 gap-2.5" id="occasion-grid">
                {[
                  { id: 'idul-fitri', emoji: '🌙', label: 'Idul Fitri', effect: 'lanterns' },
                  { id: 'natal-tahun-baru', emoji: '🎄', label: 'Natal & Tahun Baru', effect: 'snowfall' },
                  { id: 'hari-ibu-ayah', emoji: '💐', label: 'Hari Ibu / Ayah', effect: 'petals' },
                  { id: 'general', emoji: '✨', label: 'General / Lainnya', effect: 'golden-sparkles' },
                ].map((occ, idx) => (
                  <button
                    type="button"
                    class:list={[
                      'occasion-btn relative flex items-center gap-3 rounded-xl border p-3 text-left transition-all cursor-pointer',
                      idx === 0
                        ? 'border-[#f5c563] ring-2 ring-[#f5c563]/40 bg-[#f5c563]/15 text-white font-medium shadow-lg shadow-[#f5c563]/10'
                        : 'border-white/10 bg-surface-800/60 text-surface-400 hover:border-white/20 hover:text-surface-200',
                    ]}
                    data-occasion={occ.id}
                    data-effect={occ.effect}
                  >
                    <span class="text-2xl">{occ.emoji}</span>
                    <div class="min-w-0 flex-1">
                      <div class="text-xs font-semibold text-surface-200 truncate">{occ.label}</div>
                      <div class="text-[10px] text-surface-400">Ambience: {occ.effect}</div>
                    </div>
                    <span class:list={[
                      'occasion-active-check absolute top-2 right-2 h-4 w-4 items-center justify-center rounded-full bg-[#f5c563] text-[10px] font-bold text-[#0f0d15]',
                      idx === 0 ? 'flex' : 'hidden',
                    ]}>✓</span>
                  </button>
                ))}
              </div>
            </div>

            <!-- Colors -->
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="mb-1.5 block text-sm font-medium text-surface-200">Primary Color</label>
                <div class="flex items-center gap-3">
                  <input type="color" id="theme-primary" value="#f5c563" class="h-10 w-14 cursor-pointer rounded-lg border border-white/10 bg-transparent" />
                  <span class="text-xs text-surface-400" id="theme-primary-hex">#f5c563</span>
                </div>
              </div>
              <div>
                <label class="mb-1.5 block text-sm font-medium text-surface-200">Secondary Color</label>
                <div class="flex items-center gap-3">
                  <input type="color" id="theme-secondary" value="#e07a93" class="h-10 w-14 cursor-pointer rounded-lg border border-white/10 bg-transparent" />
                  <span class="text-xs text-surface-400" id="theme-secondary-hex">#e07a93</span>
                </div>
              </div>
            </div>

            <!-- Quick Palettes -->
            <div>
              <div class="mb-2 flex items-center justify-between">
                <label class="block text-xs font-semibold uppercase tracking-wider text-surface-300">
                  🎨 Quick Palettes
                </label>
                <span class="text-[11px] text-surface-400">Curated color pairings</span>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2" id="palette-swatches-grid">
                {[
                  { name: 'Midnight Gold', primary: '#f5c563', secondary: '#e07a93' },
                  { name: 'Romantic Rose', primary: '#e07a93', secondary: '#f4a261' },
                  { name: 'Emerald Luxury', primary: '#2a9d8f', secondary: '#e76f51' },
                  { name: 'Ocean Twilight', primary: '#4a90e2', secondary: '#9b51e0' },
                  { name: 'Classic Gold', primary: '#d4af37', secondary: '#2b2523' },
                ].map((palette) => (
                  <button
                    type="button"
                    class="palette-swatch-btn group relative flex flex-col gap-1.5 rounded-xl border border-white/10 bg-surface-800/60 p-2.5 text-left transition-all duration-200 hover:border-white/30 hover:bg-surface-800 hover:shadow-md cursor-pointer active:scale-95"
                    data-primary={palette.primary}
                    data-secondary={palette.secondary}
                    title={`${palette.name} (${palette.primary} / ${palette.secondary})`}
                  >
                    <!-- Dual Color Pill Preview Chip -->
                    <div class="flex h-5 w-full overflow-hidden rounded-lg border border-white/10 shadow-inner">
                      <span class="w-1/2 h-full" style={`background-color: ${palette.primary};`}></span>
                      <span class="w-1/2 h-full" style={`background-color: ${palette.secondary};`}></span>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-medium text-surface-200 truncate group-hover:text-white">
                        {palette.name}
                      </span>
                    </div>
                  </button>
                ))}
              </div>
            </div>

            <!-- Background Pattern -->
            <div>
              <label class="mb-2 block text-sm font-medium text-surface-200">Background Pattern</label>
              <div class="flex flex-wrap gap-2">
                {[
                  { id: 'none', label: '✕ None' },
                  { id: 'confetti', label: '🎊 Confetti' },
                  { id: 'hearts', label: '💕 Hearts' },
                  { id: 'stars', label: '⭐ Stars' },
                  { id: 'dots', label: '● Dots' },
                  { id: 'waves', label: '🌊 Waves' },
                ].map((p) => {
                  const isDefault = p.id === 'none';
                  return (
                    <button
                      type="button"
                      class:list={[
                        'pattern-btn rounded-lg border px-3 py-1.5 text-xs transition-all cursor-pointer',
                        isDefault
                          ? 'border-[#f5c563] ring-2 ring-[#f5c563]/40 bg-[#f5c563]/15 text-white font-medium shadow-lg shadow-[#f5c563]/10'
                          : 'bg-surface-800/60 border-white/10 text-surface-400 hover:border-white/20 hover:text-surface-200',
                      ]}
                      data-pattern={p.id}
                    >
                      {p.label}
                    </button>
                  );
                })}
              </div>
            </div>

            <!-- Font Family -->
            <div>
              <label class="mb-2 block text-sm font-medium text-surface-200">Font Style</label>
              <div class="grid grid-cols-2 gap-3">
                {[
                  { id: 'sans', label: 'Modern Sans', sample: 'Aa', font: 'Inter' },
                  { id: 'serif', label: 'Classic Serif', sample: 'Aa', font: 'Georgia' },
                  { id: 'handwritten', label: 'Handwritten', sample: 'Aa', font: 'cursive' },
                  { id: 'display', label: 'Display', sample: 'Aa', font: 'Outfit' },
                ].map((f) => {
                  const isDefault = f.id === 'sans';
                  return (
                    <button
                      type="button"
                      class:list={[
                        'font-btn relative rounded-xl border p-3 text-left transition-all cursor-pointer',
                        isDefault
                          ? 'border-[#f5c563] ring-2 ring-[#f5c563]/40 bg-[#f5c563]/15 text-white font-medium shadow-lg shadow-[#f5c563]/10'
                          : 'bg-surface-800/60 border-white/10 text-surface-400 hover:border-white/20 hover:text-surface-200',
                      ]}
                      data-font={f.id}
                    >
                      <span class:list={[
                        'font-active-check absolute top-2.5 right-2.5 h-4 w-4 items-center justify-center rounded-full bg-[#f5c563] text-[10px] font-bold text-[#0f0d15] shadow-sm shadow-[#f5c563]/50',
                        isDefault ? 'flex' : 'hidden',
                      ]}>✓</span>
                      <span class="text-2xl text-surface-200" style={`font-family: ${f.font}`}>{f.sample}</span>
                      <div class="mt-1 text-xs">{f.label}</div>
                    </button>
                  );
                })}
              </div>
            </div>

            <!-- Unbox Style -->
            <div>
              <label class="mb-2 block text-sm font-medium text-surface-200">Unboxing Animation</label>
              <div class="grid grid-cols-3 gap-3">
                {[
                  { id: 'envelope', emoji: '✉️', label: 'Envelope Flip' },
                  { id: 'giftbox', emoji: '🎁', label: 'Gift Box' },
                  { id: 'ribbon', emoji: '🎀', label: 'Ribbon Untie' },
                ].map((u) => {
                  const isDefault = u.id === 'envelope';
                  return (
                    <button
                      type="button"
                      class:list={[
                        'unbox-btn relative rounded-xl border p-4 text-center transition-all cursor-pointer',
                        isDefault
                          ? 'border-[#f5c563] ring-2 ring-[#f5c563]/40 bg-[#f5c563]/15 text-white font-medium shadow-lg shadow-[#f5c563]/10'
                          : 'bg-surface-800/60 border-white/10 text-surface-400 hover:border-white/20 hover:text-surface-200',
                      ]}
                      data-unbox={u.id}
                    >
                      <span class:list={[
                        'unbox-active-check absolute top-2.5 right-2.5 h-4 w-4 items-center justify-center rounded-full bg-[#f5c563] text-[10px] font-bold text-[#0f0d15] shadow-sm shadow-[#f5c563]/50',
                        isDefault ? 'flex' : 'hidden',
                      ]}>✓</span>
                      <span class="text-2xl">{u.emoji}</span>
                      <div class="mt-1 text-xs">{u.label}</div>
                    </button>
                  );
                })}
              </div>
            </div>

            <!-- Ambient Visual Effect -->
            <div>
              <label class="mb-2 block text-sm font-medium text-surface-200">Ambient Visual Effect</label>
              <p class="mb-3 text-xs text-surface-500">A subtle animated background that enhances the mood of your card</p>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="ambient-effect-grid">
                {[
                  { id: 'none', emoji: '✕', label: 'None' },
                  { id: 'petals', emoji: '🌸', label: 'Petals' },
                  { id: 'golden-sparkles', emoji: '✨', label: 'Golden Sparkles' },
                  { id: 'hearts', emoji: '💕', label: 'Hearts' },
                  { id: 'confetti-float', emoji: '🎊', label: 'Confetti Float' },
                  { id: 'starlight', emoji: '🌟', label: 'Starlight' },
                  { id: 'lanterns', emoji: '🏮', label: 'Lanterns' },
                  { id: 'butterflies', emoji: '🦋', label: 'Butterflies' },
                  { id: 'bokeh', emoji: '💡', label: 'Bokeh' },
                  { id: 'sparklers', emoji: '🎇', label: 'Sparklers' },
                  { id: 'snowfall', emoji: '❄️', label: 'Snowfall' },
                  { id: 'hearts-petals', emoji: '💖', label: 'Hearts & Petals' },
                ].map((fx) => {
                  const isDefault = fx.id === 'none';
                  return (
                    <button
                      type="button"
                      class:list={[
                        'ambient-btn relative rounded-xl border p-3 text-center transition-all cursor-pointer',
                        isDefault
                          ? 'border-[#f5c563] ring-2 ring-[#f5c563]/40 bg-[#f5c563]/15 text-white font-medium shadow-lg shadow-[#f5c563]/10'
                          : 'bg-surface-800/60 border-white/10 text-surface-400 hover:border-white/20 hover:text-surface-200',
                      ]}
                      data-ambient={fx.id}
                    >
                      <span class:list={[
                        'ambient-active-check absolute top-2 right-2 h-4 w-4 items-center justify-center rounded-full bg-[#f5c563] text-[10px] font-bold text-[#0f0d15] shadow-sm shadow-[#f5c563]/50',
                        isDefault ? 'flex' : 'hidden',
                      ]}>✓</span>
                      <span class="text-xl">{fx.emoji}</span>
                      <div class="mt-1 text-[11px]">{fx.label}</div>
                    </button>
                  );
                })}
              </div>
            </div>
          </div>
        </div>

        <!-- Step 3: Media Upload -->
        <div id="step-3" class="wizard-step hidden">
          <h2 class="text-xl font-bold text-surface-50">Add Photos</h2>
          <p class="mt-2 text-sm text-surface-400" id="photo-upload-hint">Upload up to 4 photos (auto-compressed to WebP, max 200KB each)</p>

          <div class="mt-6">
            <!-- Drop Zone -->
            <div
              id="drop-zone"
              class="flex min-h-50 cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-white/10 bg-surface-800/50 p-8 transition-all hover:border-primary/30 hover:bg-surface-800"
            >
              <svg class="mb-3 h-10 w-10 text-surface-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25a2.25 2.25 0 00-2.25-2.25H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
              </svg>
              <p class="text-sm font-medium text-surface-300">Drop images here or click to upload</p>
              <p class="mt-1 text-xs text-surface-500">PNG, JPG, WebP — auto-converted to WebP</p>
              <input type="file" id="file-input" accept="image/*" multiple class="hidden" />
            </div>

            <!-- Photo Preview Grid -->
            <div id="photo-grid" class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4 md:grid-cols-5">
              <!-- Populated by JS -->
            </div>

            <!-- Upload Progress -->
            <div id="upload-status" class="mt-4 hidden">
              <div class="flex items-center gap-3">
                <div class="h-2 flex-1 overflow-hidden rounded-full bg-surface-700">
                  <div id="upload-progress" class="h-full rounded-full bg-linear-to-r from-primary to-secondary transition-all duration-300" style="width: 0%"></div>
                </div>
                <span id="upload-text" class="text-xs text-surface-400">Processing...</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 4: Message & Details -->
        <div id="step-4" class="wizard-step hidden">
          <h2 class="text-xl font-bold text-surface-50">Card Details</h2>
          <p class="mt-2 text-sm text-surface-400">Add your personal message and event details</p>

          <div class="mt-6 space-y-5">
            <!-- Standard fields (hidden for wedding) -->
            <div id="standard-recipient-field">
              <label for="recipient-name" class="mb-1.5 block text-sm font-medium text-surface-200">Recipient Name <span class="text-confetti-pink">*</span></label>
              <input type="text" id="recipient-name" placeholder="Who is this card for?" required class="form-input w-full rounded-xl border bg-surface-800/50 px-4 py-2.5 text-sm transition-all focus-ring" />
            </div>

            <div id="standard-sender-field">
              <label for="sender-name" class="mb-1.5 block text-sm font-medium text-surface-200">Your Name</label>
              <input type="text" id="sender-name" placeholder="From..." class="form-input w-full rounded-xl border bg-surface-800/50 px-4 py-2.5 text-sm transition-all focus-ring" />
            </div>

            <!-- Birthday Details (conditionally shown for birthday) -->
            <div id="birthday-fields-panel" class="hidden rounded-2xl border border-pink-500/20 bg-pink-500/5 p-4 space-y-3">
              <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-pink-400">
                <span>🎂</span> Birthday Milestone
              </div>
              <div>
                <label for="birthday-age" class="mb-1 block text-xs font-medium text-surface-300">
                  Age / Milestone <span class="text-xs font-normal text-surface-500">(Optional)</span>
                </label>
                <input
                  type="text"
                  id="birthday-age"
                  placeholder="e.g. Sweet 17 / 21st / 30 Tahun"
                  class="form-input w-full rounded-xl border bg-surface-800/50 px-4 py-2 text-sm transition-all focus-ring"
                />
                <p class="mt-1 text-[11px] text-surface-500">Tampilkan usia atau momen spesial yang dirayakan pada kartu</p>
              </div>
            </div>

            <!-- Anniversary Details (conditionally shown for anniversary) -->
            <div id="anniversary-fields-panel" class="hidden rounded-2xl border border-rose-500/20 bg-rose-500/5 p-4 space-y-3">
              <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-rose-400">
                <span>💍</span> Anniversary Milestone
              </div>
              <div>
                <label for="anniversary-duration" class="mb-1 block text-xs font-medium text-surface-300">
                  Duration / Milestone <span class="text-xs font-normal text-surface-500">(Optional)</span>
                </label>
                <input
                  type="text"
                  id="anniversary-duration"
                  placeholder="e.g. 1st Anniversary / 5 Tahun Bersama / Perak (25th)"
                  class="form-input w-full rounded-xl border bg-surface-800/50 px-4 py-2 text-sm transition-all focus-ring"
                />
                <p class="mt-1 text-[11px] text-surface-500">Durasi atau tahun perayaan perjalanan cinta bersama</p>
              </div>
            </div>

            <!-- Graduation Details (conditionally shown for graduation) -->
            <div id="graduation-fields-panel" class="hidden rounded-2xl border border-blue-500/20 bg-blue-500/5 p-4 space-y-3">
              <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-blue-400">
                <span>🎓</span> Graduation Details
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="graduation-degree" class="mb-1 block text-xs font-medium text-surface-300">
                    Degree / Major <span class="text-xs font-normal text-surface-500">(Optional)</span>
                  </label>
                  <input
                    type="text"
                    id="graduation-degree"
                    placeholder="e.g. S.Kom / B.Sc in Computer Science"
                    class="form-input w-full rounded-xl border bg-surface-800/50 px-4 py-2 text-sm transition-all focus-ring"
                  />
                </div>
                <div>
                  <label for="graduation-school" class="mb-1 block text-xs font-medium text-surface-300">
                    School / Campus <span class="text-xs font-normal text-surface-500">(Optional)</span>
                  </label>
                  <input
                    type="text"
                    id="graduation-school"
                    placeholder="e.g. Universitas Indonesia / ITB"
                    class="form-input w-full rounded-xl border bg-surface-800/50 px-4 py-2 text-sm transition-all focus-ring"
                  />
                </div>
              </div>
            </div>

            <!-- Invitation Details (conditionally shown for invitation) -->
            <div id="invitation-fields-panel" class="hidden rounded-2xl border border-emerald-500/20 bg-emerald-500/5 p-4 space-y-3">
              <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-emerald-400">
                <span>✉️</span> Event Invitation Details
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="invitation-event-type" class="mb-1 block text-xs font-medium text-surface-300">
                    Event Type <span class="text-xs font-normal text-surface-500">(Optional)</span>
                  </label>
                  <input
                    type="text"
                    id="invitation-event-type"
                    placeholder="e.g. Birthday Party / Housewarming / Syukuran"
                    class="form-input w-full rounded-xl border bg-surface-800/50 px-4 py-2 text-sm transition-all focus-ring"
                  />
                </div>
                <div>
                  <label for="invitation-time" class="mb-1 block text-xs font-medium text-surface-300">
                    Time / Schedule <span class="text-xs font-normal text-surface-500">(Optional)</span>
                  </label>
                  <input
                    type="text"
                    id="invitation-time"
                    placeholder="e.g. 18:30 WIB — Selesai"
                    class="form-input w-full rounded-xl border bg-surface-800/50 px-4 py-2 text-sm transition-all focus-ring"
                  />
                </div>
              </div>
              <div>
