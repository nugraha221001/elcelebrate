          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Back
          </button>
          <div class="flex-1"></div>
          <button
            type="button"
            id="next-btn"
            class="inline-flex items-center gap-1.5 rounded-xl bg-[#f5c563] text-[#0f0d15] px-5 py-2.5 text-sm font-medium shadow-lg shadow-[#f5c563]/20 transition-all hover:brightness-110 active:scale-[0.98] cursor-pointer"
          >
            Next
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Live Preview Panel (2 cols) — hidden on mobile, shown >= 1020px -->
      <div class="desktop-preview-col hidden" id="desktop-preview-panel">
        <div class="sticky top-24">
          <div class="mb-3 flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="text-xs font-semibold uppercase tracking-wider text-surface-300">Live Preview</span>
              </div>
              <span class="text-[10px] text-surface-400 font-medium">1:1 WYSIWYG</span>
            </div>

            <!-- Top Preview Toolbar -->
            <div class="preview-toolbar flex items-center p-1 rounded-xl bg-surface-800/80 border border-white/10 backdrop-blur-xs text-xs font-medium shadow-sm">
              <button
                type="button"
                class="preview-mode-btn preview-toggle-unbox flex-1 py-1.5 px-2 rounded-lg text-center transition-all flex items-center justify-center gap-1.5 cursor-pointer text-surface-400 hover:text-white"
                data-preview-mode="unbox"
                title="Test Unboxing Animation"
              >
                <span>🔒</span>
                <span class="truncate">Test Unbox Cover</span>
              </button>
              <button
                type="button"
                class="preview-mode-btn preview-toggle-content flex-1 py-1.5 px-2 rounded-lg text-center transition-all flex items-center justify-center gap-1.5 cursor-pointer bg-[#f5c563] text-[#0f0d15] font-semibold shadow-xs"
                data-preview-mode="content"
                title="View Full Card Content"
              >
                <span>📜</span>
                <span class="truncate">Full Card Content</span>
              </button>
            </div>
          </div>

          <!-- Device Frame -->
          <div id="device-frame" class="mx-auto w-full max-w-85">
            <div class="relative overflow-hidden rounded-[2.5rem] border-4 border-surface-600 bg-surface-900 shadow-elevated ring-1 ring-white/10">
              <!-- Notch -->
              <div class="mx-auto h-6 w-28 rounded-b-xl bg-surface-600 flex items-center justify-center">
                <div class="h-1 w-8 rounded-full bg-surface-700"></div>
              </div>

              <!-- Screen Container with stationary overlay sibling -->
              <div class="relative overflow-hidden">
                <div id="preview-corner-frame" class="preview-corner-frame absolute inset-0 pointer-events-none z-20 overflow-hidden"></div>
                <!-- Screen -->
                <div
                  id="preview-screen"
                  class="preview-phone-screen relative min-h-125 overflow-y-auto overscroll-contain max-h-160 scrollbar-thin scrollbar-thumb-white/10 text-white"
                  style="max-height: 640px;"
                >
                  <div class="flex h-full flex-col items-center justify-center text-center p-6">
                    <span class="text-4xl mb-3">✨</span>
                    <p class="text-sm text-surface-400">Your card preview<br/>will appear here</p>
                  </div>
                </div>
              </div>

              <!-- Home indicator -->
              <div class="flex justify-center py-2 bg-surface-900">
                <div class="h-1 w-24 rounded-full bg-surface-600"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Preview FAB (visible < 1020px, hidden on step 5) -->
  <button
    type="button"
    id="preview-fab"
    class="preview-fab-btn fixed bottom-6 right-6 z-40 hidden items-center gap-2 rounded-full bg-[#f5c563] text-[#0f0d15] px-5 py-3 text-sm font-semibold shadow-lg shadow-[#f5c563]/20 transition-all hover:brightness-110 active:scale-95 cursor-pointer"
    aria-label="Preview card"
  >
    <span class="text-lg">👁️</span>
    Preview
  </button>

  <!-- Mobile Preview Fullscreen Modal -->
  <div
    id="preview-modal"
    class="fixed inset-0 z-1000 hidden flex-col bg-surface-900/95 backdrop-blur-md"
    role="dialog"
    aria-modal="true"
    aria-label="Live Card Preview"
  >
    <!-- Fixed/Sticky Header Bar with prominent close button and mode toggle -->
    <header class="sticky top-0 z-1010 flex items-center justify-between px-4 sm:px-6 py-3 bg-surface-900/90 backdrop-blur-md border-b border-white/10 shrink-0">
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-1.5">
          <span class="inline-flex h-2.5 w-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-xs font-semibold uppercase tracking-wider text-surface-300">Live Preview</span>
        </div>
        <div class="preview-toolbar flex items-center p-0.5 rounded-lg bg-surface-800/90 border border-white/10 text-xs font-medium">
          <button
            type="button"
            class="preview-mode-btn preview-toggle-unbox py-1 px-2.5 rounded-md transition-all cursor-pointer text-surface-400 hover:text-white"
            data-preview-mode="unbox"
            title="Test Unbox Cover"
          >
            🔒 Unbox
          </button>
          <button
            type="button"
            class="preview-mode-btn preview-toggle-content py-1 px-2.5 rounded-md transition-all cursor-pointer bg-[#f5c563] text-[#0f0d15] font-semibold shadow-xs"
            data-preview-mode="content"
            title="Full Card Content"
          >
            📜 Content
          </button>
        </div>
      </div>
      <button
        type="button"
        id="preview-modal-close"
        class="bg-surface-900/90 backdrop-blur-md border border-white/10 text-white shadow-xl px-4 py-2 rounded-full inline-flex items-center gap-2 text-xs font-semibold transition-all hover:bg-surface-800 hover:border-white/20 active:scale-95 cursor-pointer"
        aria-label="Kembali ke Editor"
      >
        <span class="flex h-4 w-4 items-center justify-center rounded-full bg-white/10 text-[11px] font-bold leading-none">✕</span>
        <span>Kembali ke Editor</span>
      </button>
    </header>

    <!-- Backdrop & Phone Preview Wrapper -->
    <div
      id="preview-modal-backdrop"
      class="flex-1 overflow-y-auto p-4 sm:p-6 flex items-center justify-center min-h-0 cursor-pointer"
    >
      <div
        id="preview-modal-phone"
        class="w-full max-w-xs sm:max-w-sm my-auto cursor-default pointer-events-auto"
      >
        <!-- Phone Frame Container with comfortable scaling -->
        <div class="max-h-[80vh] flex flex-col overflow-hidden rounded-[2.25rem] border-4 border-surface-600 bg-surface-900 shadow-elevated ring-1 ring-white/10">
          <!-- Top Notch / Speaker -->
          <div class="mx-auto h-5 w-24 rounded-b-xl bg-surface-600 shrink-0 flex items-center justify-center">
            <div class="h-1 w-8 rounded-full bg-surface-700"></div>
          </div>

          <!-- Phone Screen Container with stationary overlay sibling -->
          <div class="relative flex-1 min-h-0 overflow-hidden flex flex-col">
            <div id="modal-preview-corner-frame" class="preview-corner-frame absolute inset-0 pointer-events-none z-20 overflow-hidden"></div>
            <!-- Phone Screen -->
            <div
              id="modal-preview-screen"
              class="preview-phone-screen relative flex-1 min-h-80 max-h-[calc(80vh-3.5rem)] overflow-y-auto overscroll-contain scrollbar-thin scrollbar-thumb-white/10 transition-all duration-300 text-white"
            ></div>
          </div>

          <!-- Bottom Home Indicator -->
          <div class="flex justify-center py-2 bg-surface-900 shrink-0">
            <div class="h-1 w-20 rounded-full bg-surface-600"></div>
          </div>
        </div>

        <p class="mt-3 text-center text-xs text-surface-400 select-none">
          Ketuk area gelap atau tekan <kbd class="px-1.5 py-0.5 rounded bg-surface-800 border border-white/10 text-surface-300 text-[10px]">Esc</kbd> untuk menutup
        </p>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import { startSynth, stopSynth, isPlayingSynth } from '../../lib/synth-audio';
  import { compressImage, uploadToR2 } from '../../lib/image-compress';
  import { CATEGORY_DEFAULTS, RECOMMENDED_TRACKS, AUDIO_TRACKS, LEGACY_TRACK_MAP } from '../../lib/audio-tracks';
  import { getCornerOrnamentSvgContent } from '../../lib/corner-ornaments';

  // ═══════════════════════════════════════════════════════
  // Creator Studio — Wizard State Machine
  // ═══════════════════════════════════════════════════════

  interface WeddingDataState {
    bride: { fullName: string; nickname: string; parents: string };
    groom: { fullName: string; nickname: string; parents: string };
    akadEvent: { date: string; timeStart: string; timeEnd: string; venue: string; address: string; mapsUrl: string };
    receptionEvent: { date: string; timeStart: string; timeEnd: string; venue: string; address: string; mapsUrl: string };
    unduhMantu?: {
      enabled: boolean;
      title?: string;
      date?: string;
      time?: string;
      locationName?: string;
      address?: string;
      mapUrl?: string;
    };
    digitalEnvelope: { bankName: string; accountNumber: string; accountHolder: string };
    loveStory: string;
    openingGreeting: string;
    sacredQuote?: {
      enabled?: boolean;
      quote?: string;
      source?: string;
    };
    loveStoryTimeline?: Array<{
      year?: string;
      title?: string;
      story?: string;
    }>;
    dresscode?: {
      enabled?: boolean;
      colors?: string[];
      note?: string;
    };
    turutMengundang?: string;
  }

  interface CardState {
    category: string;
    themeConfig: {
      primaryColor: string;
      secondaryColor: string;
      backgroundColor: string;
      fontFamily: string;
      backgroundPattern: string;
      unboxStyle: string;
      audioTrackId: string | null;
      externalAudioUrl: string | null;
      customAudioUrl?: string | null;
      audioStartTime?: number;
      ambientEffect: string;
      cornerOrnament?: string;
      weddingData?: WeddingDataState;
      passcode?: string;
      interactiveConfession?: {
        enabled: boolean;
        prompt?: string;
        yesText?: string;
        noText?: string;
      };
      occasion?: string;
      signature?: string;
      ageMilestone?: string;
      anniversaryMilestone?: string;
      degreeMajor?: string;
      schoolCampus?: string;
      invitationEventType?: string;
      invitationTime?: string;
      invitationVenue?: string;
      unboxingStyle?: string;
      weddingHeaderTitle?: string;
    };
    photos: Array<{ file?: File; previewUrl: string; publicUrl?: string }>;
    recipientName: string;
    senderName: string;
    message: string;
    eventDate: string;
  }

  interface WeddingPhotoSlot {
    file?: File;
    previewUrl: string;
    publicUrl?: string;
  }

  interface WeddingSlotsState {
    cover: WeddingPhotoSlot | null;
    bride: WeddingPhotoSlot | null;
    groom: WeddingPhotoSlot | null;
    gallery: WeddingPhotoSlot[];
  }

  const weddingSlots: WeddingSlotsState = {
    cover: null,
    bride: null,
    groom: null,
    gallery: [],
  };

  function emptyWeddingData(): WeddingDataState {
    return {
      bride: { fullName: '', nickname: '', parents: '' },
      groom: { fullName: '', nickname: '', parents: '' },
      akadEvent: { date: '', timeStart: '', timeEnd: '', venue: '', address: '', mapsUrl: '' },
      receptionEvent: { date: '', timeStart: '', timeEnd: '', venue: '', address: '', mapsUrl: '' },
      unduhMantu: {
        enabled: false,
        title: 'Unduh Mantu',
        date: '',
        time: '',
        locationName: '',
        address: '',
        mapUrl: '',
      },
      digitalEnvelope: { bankName: '', accountNumber: '', accountHolder: '' },
      loveStory: '',
      openingGreeting: '',
      sacredQuote: { enabled: true, quote: '', source: '' },
      loveStoryTimeline: [
        { year: '', title: '', story: '' },
        { year: '', title: '', story: '' },
        { year: '', title: '', story: '' },
      ],
      dresscode: { enabled: false, colors: ['#84a98c', '#52b788', '#cad2c5'], note: '' },
      turutMengundang: '',
    };
  }

  const state: CardState = {
    category: '',
    themeConfig: {
      primaryColor: '#f5c563',
      secondaryColor: '#e07a93',
      backgroundColor: '#181522',
      fontFamily: 'sans',
      backgroundPattern: 'none',
      unboxStyle: 'envelope',
      unboxingStyle: 'gate-split',
      weddingHeaderTitle: "Walimatul 'Urs",
      audioTrackId: null,
      externalAudioUrl: null,
      customAudioUrl: null,
      audioStartTime: 0,
      ambientEffect: 'none',
      cornerOrnament: 'none',
      passcode: '',
      interactiveConfession: {
        enabled: false,
        prompt: 'Maukah kamu jadi pacarku? 💕',
        yesText: 'Iya, aku mau! 💖',
        noText: 'Nggak mau 😜',
      },
      occasion: 'idul-fitri',
      signature: '',
      ageMilestone: '',
      anniversaryMilestone: '',
      degreeMajor: '',
      schoolCampus: '',
      invitationEventType: '',
      invitationTime: '',
      invitationVenue: '',
    },
    photos: [],
    recipientName: '',
    senderName: '',
    message: '',
    eventDate: '',
  };

  let currentStep = 1;
  const totalSteps = 5;

  // ═══════════════════════════════════════════════════════
  // Responsive Preview — breakpoint detection
  // ═══════════════════════════════════════════════════════
  const DESKTOP_BP = 1020;

  function isDesktop(): boolean {
    return window.innerWidth >= DESKTOP_BP;
  }

  function syncResponsiveLayout() {
    const desktopPanel = document.getElementById('desktop-preview-panel');
    const fab = document.getElementById('preview-fab');
    const step5Mobile = document.getElementById('step5-mobile-preview');

    if (isDesktop()) {
      // Desktop: show side preview, hide FAB, dismiss mobile modal if open
      closeModalPreview();
      desktopPanel?.classList.remove('hidden');
      desktopPanel?.classList.add('lg:col-span-2', 'lg:block');
      fab?.classList.add('hidden');
      fab?.classList.remove('inline-flex');
      step5Mobile?.classList.add('hidden');
    } else {
      // Mobile: hide side preview, show FAB (except on step 5)
      desktopPanel?.classList.add('hidden');
      desktopPanel?.classList.remove('lg:col-span-2', 'lg:block');
      if (currentStep === 5) {
        fab?.classList.add('hidden');
        fab?.classList.remove('inline-flex');
        step5Mobile?.classList.remove('hidden');
      } else {
        fab?.classList.remove('hidden');
        fab?.classList.add('inline-flex');
        step5Mobile?.classList.add('hidden');
      }
    }
  }

  window.addEventListener('resize', syncResponsiveLayout);

  // ═══════════════════════════════════════════════════════
  // Step Navigation
  // ═══════════════════════════════════════════════════════
  function goToStep(step: number) {
    if (step < 1 || step > totalSteps) return;

    // Stop in-studio audio previews on navigation
    stopCatalogAudioPreview();
    stopCustomAudioPreview();

    // Validation
    if (step > currentStep) {
      if (currentStep === 1 && !state.category) {
        (window as any).showToast({ message: 'Please select a category', type: 'warning' });
        return;
      }
      if (currentStep === 4) {
        if (state.category === 'wedding') {
          syncWeddingRecipientName();
          const wd = state.themeConfig.weddingData;
          if (!wd?.bride.fullName) {
            (window as any).showToast({ message: 'Bride\'s full name is required', type: 'warning' });
            return;
          }
          if (!wd?.groom.fullName) {
            (window as any).showToast({ message: 'Groom\'s full name is required', type: 'warning' });
            return;
          }
          if (!wd?.akadEvent.date) {
            (window as any).showToast({ message: 'Akad/ceremony date is required', type: 'warning' });
            return;
          }
          if (!state.message) {
            (window as any).showToast({ message: 'Please write an invitation message', type: 'warning' });
            return;
          }
        } else {
          if (!state.recipientName) {
            (window as any).showToast({ message: 'Recipient name is required', type: 'warning' });
            return;
          }
          if (!state.message) {
            (window as any).showToast({ message: 'Please write a message', type: 'warning' });
            return;
          }
        }
      }
    }

    currentStep = step;

    // Stop running previews when switching steps
    stopCatalogAudioPreview();
    stopCustomAudioPreview();
    stopStudioAudioPreview();

    // Show/hide steps
    document.querySelectorAll('.wizard-step').forEach((el, i) => {
      el.classList.toggle('hidden', i + 1 !== currentStep);
    });

    // Update step indicators
    for (let i = 1; i <= totalSteps; i++) {
      const dot = document.querySelector(`[data-step-dot="${i}"]`) as HTMLElement;
      const line = document.querySelector(`[data-step-line="${i}"]`) as HTMLElement;
      const label = document.querySelector(`[data-step-label="${i}"]`) as HTMLElement;
      if (dot) {
        if (i < currentStep) {
          dot.className = 'flex h-9 w-9 items-center justify-center rounded-full text-sm font-semibold bg-[#f5c563] text-[#0f0d15] transition-all duration-300';
        } else if (i === currentStep) {
          dot.className = 'flex h-9 w-9 items-center justify-center rounded-full text-sm font-semibold bg-[#f5c563] text-[#0f0d15] shadow-lg shadow-[#f5c563]/25 ring-2 ring-[#f5c563]/40 ring-offset-2 ring-offset-[#0f0d15] transition-all duration-300';
        } else {
          dot.className = 'flex h-9 w-9 items-center justify-center rounded-full text-sm font-semibold bg-surface-700 text-surface-400 transition-all duration-300';
        }
      }
      if (label) {
        if (i === currentStep) {
          label.className = 'hidden text-xs font-semibold text-[#f5c563] sm:block';
        } else if (i < currentStep) {
          label.className = 'hidden text-xs font-medium text-[#f7f6f9] sm:block';
        } else {
          label.className = 'hidden text-xs font-medium text-surface-400 sm:block';
        }
      }
      if (line) {
        line.className = i < currentStep
          ? 'mx-2 h-0.5 flex-1 rounded bg-[#f5c563] transition-all duration-500'
          : 'mx-2 h-0.5 flex-1 rounded bg-surface-700 transition-all duration-500';
      }
    }

    // Show/hide nav buttons
    const prevBtn = document.getElementById('prev-btn') as HTMLElement;
    const nextBtn = document.getElementById('next-btn') as HTMLElement;
    const step1CancelLink = document.getElementById('step1-cancel-link') as HTMLElement;
    if (step1CancelLink) step1CancelLink.style.display = currentStep === 1 ? 'inline-flex' : 'none';
    prevBtn.style.display = currentStep > 1 ? 'inline-flex' : 'none';
    nextBtn.style.display = currentStep < totalSteps ? 'inline-flex' : 'none';

    // Update preview on step 5
    if (currentStep === 5) updatePreviewSummary();
    if (currentStep === 2) {
      syncThemeSelectorActiveStates();
      syncColorSwatchActiveStates();
    }
    updateLivePreview();
    syncResponsiveLayout();
  }

  // Nav button listeners
  document.getElementById('next-btn')?.addEventListener('click', () => goToStep(currentStep + 1));
  document.getElementById('prev-btn')?.addEventListener('click', () => goToStep(currentStep - 1));

  // ═══════════════════════════════════════════════════════
  // Mobile Preview FAB & Modal
  // ═══════════════════════════════════════════════════════
  const previewFab = document.getElementById('preview-fab');
  const previewModal = document.getElementById('preview-modal');
  const previewModalClose = document.getElementById('preview-modal-close');
  const previewModalBackdrop = document.getElementById('preview-modal-backdrop');
  const previewModalPhone = document.getElementById('preview-modal-phone');

  function openModalPreview() {
    if (!previewModal) return;
    updateModalPreview();
    previewModal.classList.remove('hidden');
    previewModal.classList.add('flex');
    document.body.classList.add('overflow-hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModalPreview() {
    if (!previewModal || previewModal.classList.contains('hidden')) return;
    previewModal.classList.add('hidden');
    previewModal.classList.remove('flex');
    document.body.classList.remove('overflow-hidden');
    document.body.style.overflow = '';
  }

  // Open modal when FAB is tapped
  previewFab?.addEventListener('click', openModalPreview);

  // Dismiss action 1: Close button click
  previewModalClose?.addEventListener('click', closeModalPreview);

  // Dismiss action 2: Click on dark backdrop outside phone frame
  previewModalBackdrop?.addEventListener('click', (e) => {
    if (previewModalPhone && !previewModalPhone.contains(e.target as Node)) {
      closeModalPreview();
    }
  });

  // Dismiss action 3: Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && previewModal && !previewModal.classList.contains('hidden')) {
      closeModalPreview();
    }
  });

  function updateModalPreview() {
    const modalScreen = document.getElementById('modal-preview-screen');
    applyPreviewToScreen(modalScreen, buildPreviewHTML());
    updatePreviewCornerFrames();
    syncPreviewAmbientLoop();
  }

  // ═══════════════════════════════════════════════════════
  // Studio Preview Mode: Content vs Unbox Cover Simulation
  // ═══════════════════════════════════════════════════════
  let activePreviewMode: 'content' | 'unbox' = 'content';

  function syncPreviewModeToolbars() {
    document.querySelectorAll<HTMLElement>('.preview-toolbar').forEach((bar) => {
      const unboxBtn = bar.querySelector<HTMLElement>('.preview-toggle-unbox');
      const contentBtn = bar.querySelector<HTMLElement>('.preview-toggle-content');
      if (!unboxBtn || !contentBtn) return;
      if (activePreviewMode === 'unbox') {
        unboxBtn.className = 'preview-mode-btn preview-toggle-unbox flex-1 py-1 px-2.5 rounded-md transition-all cursor-pointer bg-[#f5c563] text-[#0f0d15] font-semibold shadow-xs';
        contentBtn.className = 'preview-mode-btn preview-toggle-content flex-1 py-1 px-2.5 rounded-md transition-all cursor-pointer text-surface-400 hover:text-white';
      } else {
