    const svgContent = getCornerOrnamentSvgContent(motif);
    if (!svgContent) return '';

    const goldAccent = '#f5c563';
    const primaryAccent = primaryColor || goldAccent;
    const secondaryAccent = secondaryColor || '#e07a93';

    return `
      <!-- Shared SVG Gradient Defs -->
      <svg class="absolute w-0 h-0 pointer-events-none" aria-hidden="true" style="position: absolute; width: 0; height: 0; overflow: hidden;">
        <defs>
          <linearGradient id="preview-corner-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#fef08a" stop-opacity="0.9" />
            <stop offset="50%" stop-color="${goldAccent}" stop-opacity="0.8" />
            <stop offset="100%" stop-color="${secondaryAccent}" stop-opacity="0.65" />
          </linearGradient>
          <linearGradient id="preview-corner-fill" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="${primaryAccent}" stop-opacity="0.22" />
            <stop offset="100%" stop-color="${goldAccent}" stop-opacity="0.06" />
          </linearGradient>
          <linearGradient id="corner-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#fef08a" stop-opacity="0.9" />
            <stop offset="50%" stop-color="${goldAccent}" stop-opacity="0.8" />
            <stop offset="100%" stop-color="${secondaryAccent}" stop-opacity="0.65" />
          </linearGradient>
          <linearGradient id="corner-fill" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="${primaryAccent}" stop-opacity="0.22" />
            <stop offset="100%" stop-color="${goldAccent}" stop-opacity="0.06" />
          </linearGradient>
        </defs>
      </svg>

      <!-- Top-Left -->
      <div class="absolute top-1.5 left-1.5 pointer-events-none">
        <div class="animate-corner-sway w-10 h-10 sm:w-14 sm:h-14">
          <svg class="w-full h-full pointer-events-none" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
            ${svgContent}
          </svg>
        </div>
      </div>

      <!-- Top-Right -->
      <div class="absolute top-1.5 right-1.5 pointer-events-none [transform:scaleX(-1)]" style="transform: scaleX(-1);">
        <div class="animate-corner-sway w-10 h-10 sm:w-14 sm:h-14 origin-top-left">
          <svg class="w-full h-full pointer-events-none" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
            ${svgContent}
          </svg>
        </div>
      </div>

      <!-- Bottom-Left -->
      <div class="absolute bottom-1.5 left-1.5 pointer-events-none [transform:scaleY(-1)]" style="transform: scaleY(-1);">
        <div class="animate-corner-sway w-10 h-10 sm:w-14 sm:h-14 origin-top-left">
          <svg class="w-full h-full pointer-events-none" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
            ${svgContent}
          </svg>
        </div>
      </div>

      <!-- Bottom-Right -->
      <div class="absolute bottom-1.5 right-1.5 pointer-events-none [transform:scale(-1,-1)]" style="transform: scale(-1, -1);">
        <div class="animate-corner-sway w-10 h-10 sm:w-14 sm:h-14 origin-top-left">
          <svg class="w-full h-full pointer-events-none" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
            ${svgContent}
          </svg>
        </div>
      </div>
    `.trim();
  }

  function updatePreviewCornerFrames() {
    const activeMotif = state.themeConfig.cornerOrnament || (state.category === 'wedding' ? 'botanical' : 'none');
    const cornerHtml = activeMotif !== 'none'
      ? buildCornerFrameHtml(activeMotif, state.themeConfig.primaryColor, state.themeConfig.secondaryColor)
      : '';

    const frames = [
      document.getElementById('preview-corner-frame'),
      document.getElementById('modal-preview-corner-frame'),
      document.getElementById('step5-preview-corner-frame'),
    ];

    frames.forEach((frame) => {
      if (!frame) return;
      if (activeMotif === 'none' || !cornerHtml) {
        frame.innerHTML = '';
      } else {
        frame.innerHTML = cornerHtml;
      }
    });
  }

  function updateLivePreview() {
    const previewData = buildPreviewHTML();

    // Desktop preview
    applyPreviewToScreen(document.getElementById('preview-screen'), previewData);

    // Step 5 mobile inline preview
    if (currentStep === 5) {
      applyPreviewToScreen(document.getElementById('step5-preview-screen'), previewData);
    }

    // Modal preview (if open)
    const modalScreen = document.getElementById('modal-preview-screen');
    const modal = document.getElementById('preview-modal');
    if (modalScreen && modal && !modal.classList.contains('hidden')) {
      applyPreviewToScreen(modalScreen, previewData);
    }

    // Synchronize stationary corner frames
    updatePreviewCornerFrames();

    // Synchronize phone preview ambient canvas
    syncPreviewAmbientLoop();
  }

  // ═══════════════════════════════════════════════════════
  // Phone Mock Ambient Canvas Animation Engine
  // ═══════════════════════════════════════════════════════
  let previewAmbientAnimId = 0;
  let previewAmbientFrame = 0;

  function renderPreviewAuroraMist(ctx: CanvasRenderingContext2D, w: number, h: number, t: number) {
    if (w <= 0 || h <= 0) return;
    const layers = [
      {
        // Vibrant Emerald Glow
        baseY: h * 0.10,
        height: h * 0.36,
        amp: 14,
        freq: 0.008,
        speed: 0.0032,
        colorPeak: 'rgba(46, 213, 115, 0.28)',
        colorFade: 'rgba(46, 213, 115, 0)',
      },
      {
        // Luminous Cyan Teal
        baseY: h * 0.20,
        height: h * 0.40,
        amp: 16,
        freq: 0.007,
        speed: -0.0028,
        colorPeak: 'rgba(0, 210, 211, 0.25)',
        colorFade: 'rgba(0, 210, 211, 0)',
      },
      {
        // Violet Twilight
        baseY: h * 0.28,
        height: h * 0.34,
        amp: 12,
        freq: 0.009,
        speed: 0.0036,
        colorPeak: 'rgba(165, 94, 234, 0.22)',
        colorFade: 'rgba(165, 94, 234, 0)',
      },
      {
        // Champagne Shimmer
        baseY: h * 0.16,
        height: h * 0.38,
        amp: 15,
        freq: 0.0075,
        speed: -0.0022,
        colorPeak: 'rgba(245, 197, 99, 0.20)',
        colorFade: 'rgba(245, 197, 99, 0)',
      },
    ];

    ctx.save();
    ctx.globalCompositeOperation = 'screen';

    layers.forEach((layer, idx) => {
      const undulation = Math.sin(t * 0.02 + idx * 1.5) * 10;
      const step = Math.max(10, Math.floor(w / 20));
      const topPts: { x: number; y: number }[] = [];
      const btmPts: { x: number; y: number }[] = [];

      let minY = Infinity;
      let maxY = -Infinity;

      for (let x = -step; x <= w + step * 2; x += step) {
        const yTop = layer.baseY + undulation + Math.sin(x * layer.freq + t * layer.speed + idx) * layer.amp;
        const yBtm = yTop + layer.height + Math.cos(x * layer.freq * 1.2 - t * layer.speed) * (layer.amp * 0.4);

        topPts.push({ x, y: yTop });
        btmPts.push({ x, y: yBtm });

        if (yTop < minY) minY = yTop;
        if (yBtm > maxY) maxY = yBtm;
      }

      if (maxY > minY) {
        const grad = ctx.createLinearGradient(0, minY, 0, maxY);
        grad.addColorStop(0, layer.colorFade);
        grad.addColorStop(0.28, layer.colorPeak);
        grad.addColorStop(0.65, layer.colorPeak);
        grad.addColorStop(1, layer.colorFade);

        ctx.beginPath();
        ctx.moveTo(topPts[0].x, topPts[0].y);
        for (let i = 1; i < topPts.length; i++) {
          const midX = (topPts[i - 1].x + topPts[i].x) / 2;
          const midY = (topPts[i - 1].y + topPts[i].y) / 2;
          ctx.quadraticCurveTo(topPts[i - 1].x, topPts[i - 1].y, midX, midY);
        }
        ctx.lineTo(topPts[topPts.length - 1].x, topPts[topPts.length - 1].y);
        ctx.lineTo(btmPts[btmPts.length - 1].x, btmPts[btmPts.length - 1].y);
        for (let i = btmPts.length - 2; i >= 0; i--) {
          const midX = (btmPts[i + 1].x + btmPts[i].x) / 2;
          const midY = (btmPts[i + 1].y + btmPts[i].y) / 2;
          ctx.quadraticCurveTo(btmPts[i + 1].x, btmPts[i + 1].y, midX, midY);
        }
        ctx.lineTo(btmPts[0].x, btmPts[0].y);
        ctx.closePath();
        ctx.fillStyle = grad;
        ctx.fill();
      }
    });

    ctx.restore();
  }

  function syncPreviewAmbientLoop() {
    if (previewAmbientAnimId) {
      cancelAnimationFrame(previewAmbientAnimId);
      previewAmbientAnimId = 0;
    }

    const activeAmbient = (state.themeConfig as any).ambientEffect || 'none';
    if (activeAmbient === 'none') return;

    const canvases = Array.from(document.querySelectorAll<HTMLCanvasElement>('.phone-ambient-canvas'));
    if (!canvases.length) return;

    canvases.forEach((cvs) => {
      const parent = cvs.parentElement;
      if (!parent) return;
      const rect = parent.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const targetW = Math.round((rect.width || 280) * dpr);
      const targetH = Math.round((rect.height || 520) * dpr);
      if (cvs.width !== targetW || cvs.height !== targetH) {
        cvs.width = targetW;
        cvs.height = targetH;
      }
    });

    function loop() {
      previewAmbientAnimId = requestAnimationFrame(loop);
      previewAmbientFrame++;

      canvases.forEach((cvs) => {
        if (cvs.offsetParent === null && cvs.offsetWidth === 0 && cvs.offsetHeight === 0) return;

        const ctx = cvs.getContext('2d');
        if (!ctx) return;
        const w = cvs.width;
        const h = cvs.height;
        ctx.clearRect(0, 0, w, h);

        switch (activeAmbient) {
          case 'aurora-mist': {
            renderPreviewAuroraMist(ctx, w, h, previewAmbientFrame);
            break;
          }
          case 'petals':
          case 'hearts-petals':
          case 'sakura-drift': {
            ctx.save();
            for (let i = 0; i < 8; i++) {
              const py = (previewAmbientFrame * (0.6 + i * 0.1) + i * (h / 8)) % (h + 20) - 10;
              const px = (w * 0.15) + (i * (w * 0.1)) + Math.sin(previewAmbientFrame * 0.02 + i) * 16;
              ctx.fillStyle = i % 2 === 0 ? 'rgba(244, 114, 182, 0.45)' : 'rgba(251, 113, 133, 0.35)';
              ctx.beginPath();
              ctx.ellipse(px, py, 4, 2.5, previewAmbientFrame * 0.02 + i, 0, Math.PI * 2);
              ctx.fill();
            }
            ctx.restore();
            break;
          }
          case 'golden-sparkles':
          case 'starlight':
          case 'champagne-dust': {
            ctx.save();
            for (let i = 0; i < 10; i++) {
              const px = (w * (0.1 + (i * 0.08))) + Math.sin(previewAmbientFrame * 0.015 + i) * 10;
              const py = (h * (0.1 + ((i * 0.09) % 0.8))) + Math.cos(previewAmbientFrame * 0.015 + i) * 10;
              const pulse = (Math.sin(previewAmbientFrame * 0.05 + i * 2) + 1) / 2;
              ctx.fillStyle = `rgba(245, 197, 99, ${0.2 + pulse * 0.5})`;
              ctx.beginPath();
              ctx.arc(px, py, 1.5 + pulse * 1.5, 0, Math.PI * 2);
              ctx.fill();
            }
            ctx.restore();
            break;
          }
          case 'hearts': {
            ctx.save();
            for (let i = 0; i < 7; i++) {
              const py = h - ((previewAmbientFrame * (0.5 + i * 0.08) + i * (h / 7)) % (h + 20));
              const px = (w * 0.15) + (i * (w * 0.11)) + Math.sin(previewAmbientFrame * 0.02 + i) * 12;
              const pulse = (Math.sin(previewAmbientFrame * 0.03 + i) + 1) / 2;
              ctx.fillStyle = `rgba(244, 63, 94, ${0.3 + pulse * 0.4})`;
              ctx.font = '10px sans-serif';
              ctx.fillText('💖', px, py);
            }
            ctx.restore();
            break;
          }
          default:
            break;
        }
      });
    }

    loop();
  }

