  };

  async function handleSingleSlotFile(file: File, slot: 'cover' | 'bride' | 'groom') {
    const statusEl = document.getElementById('w-upload-status');
    const progressEl = document.getElementById('w-upload-progress');
    const textEl = document.getElementById('w-upload-text');
    if (statusEl) statusEl.classList.remove('hidden');
    if (textEl) textEl.textContent = 'Memproses foto...';
    if (progressEl) progressEl.style.width = '50%';

    weddingSlotsLoading[slot] = true;
    renderWeddingSlots();

    try {
      const result = await compressImage(file);
      // Resilient output validation: eliminate blank thumbnails & enforce <= 200KB
      if (!result || !result.file || result.file.size <= 0) {
        throw new Error('Hasil kompresi foto kosong (0 bytes).');
      }
      if (result.file.size > 200 * 1024) {
        throw new Error(`Ukuran foto (${Math.round(result.file.size / 1024)}KB) melebihi batas 200KB.`);
      }

      if (weddingSlots[slot]?.previewUrl.startsWith('blob:')) {
        URL.revokeObjectURL(weddingSlots[slot]!.previewUrl);
      }
      weddingSlots[slot] = { file: result.file, previewUrl: result.previewUrl };
      if (progressEl) progressEl.style.width = '100%';
    } catch (err: any) {
      (window as any).showToast?.({ message: err.message || 'Kompresi foto gagal', type: 'error' });
    } finally {
      weddingSlotsLoading[slot] = false;
      if (statusEl) statusEl.classList.add('hidden');
      renderWeddingSlots();
      updateLivePreview();
    }
  }

  async function handleWeddingGalleryFiles(files: FileList) {
    const remaining = 8 - weddingSlots.gallery.length;
    if (remaining <= 0) {
      (window as any).showToast?.({ message: 'Maksimal 8 foto untuk galeri prewedding', type: 'warning' });
      return;
    }
    const toProcess = Array.from(files).slice(0, remaining);
    const statusEl = document.getElementById('w-upload-status');
    const progressEl = document.getElementById('w-upload-progress');
    const textEl = document.getElementById('w-upload-text');
    if (statusEl) statusEl.classList.remove('hidden');

    weddingSlotsLoading.galleryCount = toProcess.length;
    renderWeddingSlots();

    for (let i = 0; i < toProcess.length; i++) {
      if (textEl) textEl.textContent = `Memproses galeri ${i + 1}/${toProcess.length}...`;
      if (progressEl) progressEl.style.width = `${((i + 1) / toProcess.length) * 100}%`;
      try {
        const result = await compressImage(toProcess[i]);
        // Output validation: size > 0 and <= 200KB
        if (!result || !result.file || result.file.size <= 0) {
          throw new Error('Hasil kompresi foto kosong.');
        }
        if (result.file.size > 200 * 1024) {
          throw new Error(`Ukuran foto (${Math.round(result.file.size / 1024)}KB) melebihi batas 200KB.`);
        }
        weddingSlots.gallery.push({ file: result.file, previewUrl: result.previewUrl });
      } catch (err: any) {
        (window as any).showToast?.({ message: err.message || 'Kompresi foto gagal', type: 'error' });
      } finally {
        weddingSlotsLoading.galleryCount = Math.max(0, weddingSlotsLoading.galleryCount - 1);
        renderWeddingSlots();
      }
    }
    if (statusEl) statusEl.classList.add('hidden');
    weddingSlotsLoading.galleryCount = 0;
    renderWeddingSlots();
    updateLivePreview();
  }

