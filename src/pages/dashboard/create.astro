  // ═══════════════════════════════════════════════════════
  // Publish / Save Card
  // ═══════════════════════════════════════════════════════
  document.getElementById('publish-btn')?.addEventListener('click', async () => {
    // Stop any running audio preview before publishing
    if (isPlayingSynth()) stopSynth();
    previewingTrackId = null;
    updateTrackSelectionUI();

    const urlParams = new URLSearchParams(window.location.search);
    const editId = urlParams.get('edit');
    const isEditMode = Boolean(editId);

    const btn = document.getElementById('publish-btn') as HTMLButtonElement;
    btn.disabled = true;
    btn.innerHTML = isEditMode
      ? '<span class="animate-spin">⏳</span> Saving...'
      : '<span class="animate-spin">⏳</span> Publishing...';

    try {
      // 1. Upload photos to R2 (if any new files)
      const mediaUrls: string[] = [];
      for (const photo of state.photos) {
        if (photo.publicUrl) {
          mediaUrls.push(photo.publicUrl);
          continue;
        }
        if (photo.file) {
          // Get presigned URL
          const presignRes = await fetch('/api/storage/presigned-url', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              filename: photo.file.name,
              contentType: 'image/webp',
            }),
          });

          if (!presignRes.ok) {
            const errData = await presignRes.json().catch(() => ({ error: 'Failed to get upload URL' }));
            throw new Error(errData.error || `Failed to get upload authorization (${presignRes.status})`);
          }
          const { uploadUrl, publicUrl } = await presignRes.json();

          // Upload directly to R2
          await uploadToR2(uploadUrl, photo.file);
          mediaUrls.push(publicUrl);
        }
      }

      // 2. Validate & format fields
      // For wedding cards, auto-set recipient_name to couple names if empty
      let recipientName = state.recipientName;
      if (state.category === 'wedding' && !recipientName && state.themeConfig.weddingData) {
        const wd = state.themeConfig.weddingData;
        const bName = wd.bride.nickname || wd.bride.fullName;
        const gName = wd.groom.nickname || wd.groom.fullName;
        recipientName = `${bName} & ${gName}`;
      }

      // For wedding, sync eventDate from akad date
      let eventDate = state.eventDate || null;
      if (state.category === 'wedding' && state.themeConfig.weddingData?.akadEvent.date) {
        eventDate = state.themeConfig.weddingData.akadEvent.date;
      }

      const payload = {
        category: state.category,
        recipient_name: recipientName,
        sender_name: state.senderName,
        message: state.message,
        event_date: eventDate,
        theme_config: state.themeConfig,
        media_urls: mediaUrls,
      };

      if (isEditMode) {
        // Dispatch PATCH /api/cards/${editId} with the updated payload
        const res = await fetch(`/api/cards/${editId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({ error: 'Failed to update card' }));
          throw new Error(err.error || 'Failed to update card');
        }

        const updatedCard = await res.json();
        (window as any).showToast({ message: 'Card updated successfully!', type: 'success' });

        // Redirect to dashboard (or view /c/[slug])
        setTimeout(() => {
          window.location.href = updatedCard.slug ? `/c/${updatedCard.slug}` : '/dashboard';
        }, 1500);
      } else {
        // Normal POST /api/cards flow
        const res = await fetch('/api/cards', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({ error: 'Failed to create card' }));
          throw new Error(err.error || 'Failed to create card');
        }

        const card = await res.json();
        (window as any).showToast({ message: '🎉 Card published successfully!', type: 'success' });

        // Redirect to the card
        setTimeout(() => {
          window.location.href = `/c/${card.slug}`;
        }, 1500);
      }
    } catch (err: any) {
      (window as any).showToast({ message: err.message || (isEditMode ? 'Failed to update' : 'Failed to publish'), type: 'error' });
      btn.disabled = false;
      btn.innerHTML = isEditMode
        ? '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg> Save Changes'
        : '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" /></svg> Publish Card';
    }
  });

  // ═══════════════════════════════════════════════════════
  // Check & Load Edit Mode
  // ═══════════════════════════════════════════════════════
  async function checkAndLoadEditMode() {
    const urlParams = new URLSearchParams(window.location.search);
    const editId = urlParams.get('edit');
    if (!editId) return;

    try {
      const res = await fetch(`/api/cards/${editId}`);
      if (!res.ok) throw new Error('Failed to load card');
      const card = await res.json();

      state.category = card.category || '';
      state.recipientName = card.recipient_name || '';
      state.senderName = card.sender_name || '';
      state.message = card.message || '';
      state.eventDate = card.event_date ? card.event_date.split('T')[0] : '';

      if (card.theme_config) {
        state.themeConfig = {
          ...state.themeConfig,
          ...card.theme_config,
        };
      }

      if (Array.isArray(card.media_urls)) {
        state.photos = card.media_urls.map((url: string) => ({
          previewUrl: url,
          publicUrl: url,
        }));
      }

      // Update Category Selection UI
      if (state.category) {
        document.querySelectorAll('[data-category]').forEach((btn) => {
          const b = btn as HTMLElement;
          const check = b.querySelector('[data-check]');
          if (b.dataset.category === state.category) {
            b.classList.add('border-primary/50', 'bg-primary/5');
            check?.classList.remove('hidden');
            check?.classList.add('flex');
          } else {
            b.classList.remove('border-primary/50', 'bg-primary/5');
            check?.classList.add('hidden');
            check?.classList.remove('flex');
            // Lock non-selected categories in edit mode
            b.classList.add('pointer-events-none', 'opacity-50');
          }
        });
        toggleWeddingFields();

        // Add "Category locked" badge below the category grid
        const step1 = document.getElementById('step-1');
        if (step1) {
          const lockBadge = document.createElement('div');
          lockBadge.className = 'mt-4 flex items-center gap-2 rounded-xl border border-amber-500/20 bg-amber-500/10 px-4 py-2.5 text-xs font-medium text-amber-300';
          lockBadge.innerHTML = `
            <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
            <span>Category locked in edit mode</span>
          `;
          step1.appendChild(lockBadge);
        }
      }

      // Update Theme Colors
      const primaryEl = document.getElementById('theme-primary') as HTMLInputElement | null;
      const secondaryEl = document.getElementById('theme-secondary') as HTMLInputElement | null;
      if (primaryEl && state.themeConfig.primaryColor) {
        primaryEl.value = state.themeConfig.primaryColor;
        const hex = document.getElementById('theme-primary-hex');
        if (hex) hex.textContent = state.themeConfig.primaryColor;
      }
      if (secondaryEl && state.themeConfig.secondaryColor) {
        secondaryEl.value = state.themeConfig.secondaryColor;
        const hex = document.getElementById('theme-secondary-hex');
        if (hex) hex.textContent = state.themeConfig.secondaryColor;
      }

      // Update Step 4 Message Inputs
      const recInput = document.getElementById('recipient-name') as HTMLInputElement | null;
      if (recInput) recInput.value = state.recipientName;
      const senderInput = document.getElementById('sender-name') as HTMLInputElement | null;
      if (senderInput) senderInput.value = state.senderName;
      const msgInput = document.getElementById('message') as HTMLTextAreaElement | null;
      if (msgInput) msgInput.value = state.message;
      const dateInput = document.getElementById('event-date') as HTMLInputElement | null;
      if (dateInput) dateInput.value = state.eventDate;

      // Update Wedding Inputs if applicable
      if (state.category === 'wedding' && state.themeConfig.weddingData) {
        const wd = state.themeConfig.weddingData;
        const setVal = (id: string, val: string | undefined) => {
          const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
          if (el && val !== undefined) el.value = val;
        };
        setVal('w-bride-name', wd.bride?.fullName);
        setVal('w-bride-nick', wd.bride?.nickname);
        setVal('w-bride-parents', wd.bride?.parents);
        setVal('w-groom-name', wd.groom?.fullName);
        setVal('w-groom-nick', wd.groom?.nickname);
        setVal('w-groom-parents', wd.groom?.parents);
        setVal('w-akad-date', wd.akadEvent?.date);
        setVal('w-akad-start', wd.akadEvent?.timeStart);
        setVal('w-akad-end', wd.akadEvent?.timeEnd);
        setVal('w-akad-venue', wd.akadEvent?.venue);
        setVal('w-akad-address', wd.akadEvent?.address);
        setVal('w-akad-maps', wd.akadEvent?.mapsUrl);
        setVal('w-resepsi-date', wd.receptionEvent?.date);
        setVal('w-resepsi-start', wd.receptionEvent?.timeStart);
        setVal('w-resepsi-end', wd.receptionEvent?.timeEnd);
        setVal('w-resepsi-venue', wd.receptionEvent?.venue);
        setVal('w-resepsi-address', wd.receptionEvent?.address);
        setVal('w-resepsi-maps', wd.receptionEvent?.mapsUrl);

        // Restore Unduh Mantu
        if (wd.unduhMantu) {
          if (unduhMantuToggle) {
            unduhMantuToggle.checked = Boolean(wd.unduhMantu.enabled);
          }
          if (unduhMantuFields) {
            if (wd.unduhMantu.enabled) {
              unduhMantuFields.classList.remove('hidden');
            } else {
              unduhMantuFields.classList.add('hidden');
            }
          }
          setVal('w-unduh-mantu-date', wd.unduhMantu.date);
          setVal('w-unduh-mantu-time', wd.unduhMantu.time);
          setVal('w-unduh-mantu-venue', wd.unduhMantu.locationName);
          setVal('w-unduh-mantu-address', wd.unduhMantu.address);
          setVal('w-unduh-mantu-maps', wd.unduhMantu.mapUrl);
        }

        setVal('w-bank-name', wd.digitalEnvelope?.bankName);
        setVal('w-bank-number', wd.digitalEnvelope?.accountNumber);
        setVal('w-bank-holder', wd.digitalEnvelope?.accountHolder);
        setVal('w-love-story', wd.loveStory);

        // Restore opening greeting
        if (wd.openingGreeting) {
          const greetingTextEl = document.getElementById('w-greeting-text') as HTMLTextAreaElement | null;
          const greetingSelectEl = document.getElementById('w-greeting-preset') as HTMLSelectElement | null;
          if (greetingTextEl) greetingTextEl.value = wd.openingGreeting;
          // Try to match to a preset key
          if (greetingSelectEl) {
            const matchedKey = Object.entries(GREETING_PRESETS).find(([_, v]) => v === wd.openingGreeting)?.[0];
            greetingSelectEl.value = matchedKey || 'custom';
          }
        }
      }

      updatePhotoLimitUI();
      renderPhotoGrid();
      syncThemeSelectorActiveStates();
      updateTrackSelectionUI();
      sortAndBadgeAudioTracks();
      updateLivePreview();

      // Update Publish button label and header in edit mode
      const pubBtn = document.getElementById('publish-btn');
      if (pubBtn) {
        pubBtn.innerHTML = `
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          Save Changes
        `;
      }
    } catch (err) {
      console.error('Failed to load card for editing:', err);
      (window as any).showToast?.({ message: 'Could not load card details for editing', type: 'error' });
    }
  }

  // Initialize
  goToStep(1);
  syncThemeSelectorActiveStates();
  checkAndLoadEditMode();
</script>

