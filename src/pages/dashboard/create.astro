  async function handleCustomAudioFile(file: File) {
    const MAX_AUDIO_SIZE = 3 * 1024 * 1024; // 3MB
    const ALLOWED_AUDIO_EXTENSIONS = ['.mp3', '.ogg', '.opus'];

    // 1. Client-side Size Validation
    if (file.size > MAX_AUDIO_SIZE) {
      (window as any).showToast?.({
        message: 'File audio terlalu besar. Maksimal ukuran file 3MB.',
        type: 'warning',
      });
      if (customAudioInput) customAudioInput.value = '';
      return;
    }

    // 2. Client-side Format Validation
    const fileNameLower = file.name.toLowerCase();
    const hasValidExt = ALLOWED_AUDIO_EXTENSIONS.some((ext) => fileNameLower.endsWith(ext));
    if (!hasValidExt) {
      (window as any).showToast?.({
        message: 'Format file tidak didukung. Harap upload .mp3, .opus, atau .ogg.',
        type: 'warning',
      });
      if (customAudioInput) customAudioInput.value = '';
      return;
    }

    // UI: Show uploading progress
    const dropzone = document.getElementById('custom-audio-dropzone');
    const progressContainer = document.getElementById('custom-audio-progress-container');
    const filenameEl = document.getElementById('custom-audio-filename');
    const pctEl = document.getElementById('custom-audio-pct');
    const barEl = document.getElementById('custom-audio-bar');

    dropzone?.classList.add('hidden');
    progressContainer?.classList.remove('hidden');
    if (filenameEl) filenameEl.textContent = file.name;
    if (pctEl) pctEl.textContent = '0%';
    if (barEl) barEl.style.width = '0%';

    try {
      let contentType = file.type;
      if (!contentType || contentType === 'application/octet-stream') {
        if (fileNameLower.endsWith('.mp3')) contentType = 'audio/mpeg';
        else if (fileNameLower.endsWith('.opus')) contentType = 'audio/opus';
        else if (fileNameLower.endsWith('.ogg')) contentType = 'audio/ogg';
      }

      // 3. Get Presigned Upload URL
      const presignRes = await fetch('/api/storage/presigned-url', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          filename: file.name,
          contentType,
          folder: 'audio',
        }),
      });

      if (!presignRes.ok) {
        const err = await presignRes.json().catch(() => ({ error: 'Gagal mendapatkan izin upload' }));
        throw new Error(err.error || `Upload gagal (${presignRes.status})`);
      }

      const { uploadUrl, publicUrl } = await presignRes.json();

      // 4. Upload direct to R2 with progress
      await uploadToR2(uploadUrl, file, (pct) => {
        if (pctEl) pctEl.textContent = `${pct}%`;
        if (barEl) barEl.style.width = `${pct}%`;
      }, contentType);

      // 5. Store in state
      state.themeConfig.customAudioUrl = publicUrl;
      state.themeConfig.audioTrackId = null; // Prioritize custom audio over catalog
      updateTrackSelectionUI();

      showCustomAudioActiveCard(publicUrl, file.name);
      (window as any).showToast?.({ message: '🎵 Musik kustom berhasil diupload!', type: 'success' });
    } catch (err: any) {
      console.error('Custom audio upload error:', err);
      (window as any).showToast?.({ message: err.message || 'Gagal mengupload musik kustom', type: 'error' });
      resetCustomAudioUploadUI();
    }
  }

  // Preview Play/Pause Button for Uploaded Audio
  const customAudioPreviewBtn = document.getElementById('custom-audio-preview-btn');
  customAudioPreviewBtn?.addEventListener('click', () => {
    if (!state.themeConfig.customAudioUrl) return;

    if (isCustomAudioPlaying) {
      stopCustomAudioPreview();
      return;
    }

    // Stop catalog synth preview
    if (isPlayingSynth()) {
      stopSynth();
      previewingTrackId = null;
      updateTrackSelectionUI();
    }

    if (!customAudioPlayer || customAudioPlayer.src !== state.themeConfig.customAudioUrl) {
      customAudioPlayer = new Audio(state.themeConfig.customAudioUrl);
      customAudioPlayer.onended = () => {
        isCustomAudioPlaying = false;
        updateCustomAudioPreviewUI();
      };
      customAudioPlayer.onerror = () => {
        isCustomAudioPlaying = false;
        updateCustomAudioPreviewUI();
        (window as any).showToast?.({ message: 'Tidak dapat memutar audio preview', type: 'warning' });
      };
    }

    customAudioPlayer.play()
      .then(() => {
        isCustomAudioPlaying = true;
        updateCustomAudioPreviewUI();
      })
      .catch((err) => {
        console.error('Custom audio playback error:', err);
        isCustomAudioPlaying = false;
        updateCustomAudioPreviewUI();
      });
  });

  // Remove / Replace Custom Audio
  const customAudioRemoveBtn = document.getElementById('custom-audio-remove-btn');
  customAudioRemoveBtn?.addEventListener('click', () => {
    state.themeConfig.customAudioUrl = null;
    resetCustomAudioUploadUI();
    (window as any).showToast?.({ message: 'Musik kustom dihapus', type: 'info' });
  });

  // ═══════════════════════════════════════════════════════
  // ═══════════════════════════════════════════════════════
  // Live Preview Updates
  // ═══════════════════════════════════════════════════════
  interface PreviewThemeData {
    html: string;
    bgImage: string;
    bgSize: string;
    bgColor: string;
    font: string;
  }

  function buildPreviewHTML(): PreviewThemeData {
    const categoryEmojis: Record<string, string> = { birthday: '🎂', anniversary: '💍', graduation: '🎓', invitation: '✉️', wedding: '💍', love: '💌', greetings: '🌙' };
    const emoji = categoryEmojis[state.category] || '✨';
    const fontMap: Record<string, string> = {
      sans: "'Inter', sans-serif",
      serif: "'Georgia', serif",
      handwritten: "'Caveat', 'Pacifico', cursive",
      display: "'Outfit', sans-serif",
    };
    const font = fontMap[state.themeConfig.fontFamily] || fontMap.sans;

    const primaryHex = (state.themeConfig.primaryColor || '#f5c563').replace('#', '');
    const secondaryHex = (state.themeConfig.secondaryColor || '#e07a93').replace('#', '');

    const patternMap: Record<string, { image: string; size: string }> = {
      none: { image: 'none', size: 'auto' },
      confetti: {
        image: `url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23${primaryHex}' fill-opacity='0.18'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E")`,
        size: '60px 60px',
      },
      hearts: {
        image: `url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23${secondaryHex}' fill-opacity='0.18'%3E%3Cpath d='M20 10c2-4 7-5 10-2s3 8 0 12L20 30 10 20c-3-4-3-9 0-12s8-2 10 2z'/%3E%3C/svg%3E")`,
        size: '40px 40px',
      },
      stars: {
        image: `url("data:image/svg+xml,%3Csvg width='50' height='50' viewBox='0 0 50 50' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23${primaryHex}' fill-opacity='0.18'%3E%3Cpath d='M25 5l3 9h9l-7 5 3 9-8-6-8 6 3-9-7-5h9z'/%3E%3C/g%3E%3C/svg%3E")`,
        size: '50px 50px',
      },
      dots: {
        image: `radial-gradient(circle, ${state.themeConfig.primaryColor || '#f5c563'}35 1.5px, transparent 1.5px)`,
        size: '18px 18px',
      },
      waves: {
        image: `url("data:image/svg+xml,%3Csvg width='100' height='20' viewBox='0 0 100 20' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M21.184 20c.357-.13.72-.264.888-.14 1.652-1.249 2.747-2.98 3.227-4.908.48-1.929.384-3.96-.287-5.84C20.124 7.232 15.89 6.4 12.084 7.315 8.28 8.23 4.86 10.811 2.63 14.48L0 19.84V20h21.184z' fill='%23${primaryHex}' fill-opacity='0.15'/%3E%3C/svg%3E")`,
        size: '100px 20px',
      },
    };

    const pattern = patternMap[state.themeConfig.backgroundPattern] || patternMap.none;
    const gradient = `linear-gradient(135deg, ${state.themeConfig.primaryColor || '#f5c563'}22, ${state.themeConfig.secondaryColor || '#e07a93'}15, #181522)`;
    const bgImage = pattern.image !== 'none' ? `${pattern.image}, ${gradient}` : gradient;
    const bgSize = pattern.image !== 'none' ? `${pattern.size}, auto` : 'auto';
    const bgColor = '#181522';

    const unboxInfo: Record<string, { icon: string; label: string }> = {
      envelope: { icon: '✉️', label: 'Envelope Flip' },
      giftbox: { icon: '🎁', label: 'Gift Box' },
      ribbon: { icon: '🎀', label: 'Ribbon Untie' },
    };
    const currentUnbox = unboxInfo[state.themeConfig.unboxStyle] || unboxInfo.envelope;

    let html = `<div class="text-center space-y-3" style="font-family: ${font}">`;

    // ── Wedding-specific preview ──
    if (state.category === 'wedding' && state.themeConfig.weddingData) {
      const wd = state.themeConfig.weddingData;
      const brideName = wd.bride.nickname || wd.bride.fullName || 'Bride';
      const groomName = wd.groom.nickname || wd.groom.fullName || 'Groom';

      html += `<div class="text-3xl mb-1">💍</div>`;
      html += `<p class="text-[10px] uppercase tracking-widest text-[#e07a93]" style="font-family: ${font}">The Wedding of</p>`;
      html += `<h3 class="text-lg font-bold" style="color: ${state.themeConfig.primaryColor || '#f5c563'}; font-family: ${font}">${brideName} & ${groomName}</h3>`;

      if (wd.openingGreeting) {
        html += `<p class="text-[10px] leading-relaxed text-surface-300/80 mt-2 italic whitespace-pre-line" style="font-family: ${font}">${wd.openingGreeting.slice(0, 120)}${wd.openingGreeting.length > 120 ? '...' : ''}</p>`;
      }

      if (state.message) {
        html += `<p class="text-xs leading-relaxed text-surface-300 mt-2" style="font-family: ${font}">${state.message.slice(0, 100)}${state.message.length > 100 ? '...' : ''}</p>`;
      }

      if (wd.akadEvent.date) {
        html += `<div class="mt-3 rounded-lg p-2 text-xs" style="background: ${state.themeConfig.primaryColor}15; border: 1px solid ${state.themeConfig.primaryColor}20;">`;
        html += `<div class="font-semibold text-surface-200">🕌 Akad</div>`;
        html += `<div class="text-surface-400">${new Date(wd.akadEvent.date + 'T00:00:00').toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</div>`;
        if (wd.akadEvent.venue) html += `<div class="text-surface-500">${wd.akadEvent.venue}</div>`;
        html += `</div>`;
      }

      if (wd.receptionEvent.date) {
        html += `<div class="mt-1.5 rounded-lg p-2 text-xs" style="background: ${state.themeConfig.secondaryColor}15; border: 1px solid ${state.themeConfig.secondaryColor}20;">`;
        html += `<div class="font-semibold text-surface-200">🎉 Resepsi</div>`;
        html += `<div class="text-surface-400">${new Date(wd.receptionEvent.date + 'T00:00:00').toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</div>`;
        if (wd.receptionEvent.venue) html += `<div class="text-surface-500">${wd.receptionEvent.venue}</div>`;
        html += `</div>`;
      }

      if (wd.digitalEnvelope.bankName) {
        html += `<div class="mt-2 text-[10px] text-surface-500">💰 ${wd.digitalEnvelope.bankName} — ${wd.digitalEnvelope.accountHolder || '...'}</div>`;
      }
    } else {
      // ── Standard card preview ──
      // Unbox simulation badge inside preview
      html += `
        <div class="flex justify-center mb-1">
          <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[11px] font-medium border border-white/10 bg-surface-800/90 text-surface-200 shadow-sm backdrop-blur-sm transition-all duration-300">
            <span class="text-sm">${currentUnbox.icon}</span>
            <span class="text-surface-400">Unboxing:</span>
            <span class="font-semibold text-[#f5c563]">${currentUnbox.label}</span>
          </span>
        </div>
      `;

      html += `<div class="text-5xl mb-2">${emoji}</div>`;

      if (state.recipientName) {
        html += `<h3 class="text-lg font-bold" style="color: ${state.themeConfig.primaryColor || '#f5c563'}; font-family: ${font}">Happy ${state.category || 'celebration'}!</h3>`;
        html += `<p class="text-sm text-surface-200" style="font-family: ${font}">Dear ${state.recipientName},</p>`;
      } else {
        html += `<h3 class="text-lg font-bold" style="color: ${state.themeConfig.primaryColor || '#f5c563'}; font-family: ${font}">Happy ${state.category || 'Celebration'}!</h3>`;
        html += `<p class="text-sm text-surface-400" style="font-family: ${font}">Dear Someone Special,</p>`;
      }

      if (state.message) {
        html += `<p class="text-xs leading-relaxed text-surface-300 mt-2" style="font-family: ${font}">${state.message.slice(0, 150)}${state.message.length > 150 ? '...' : ''}</p>`;
      } else {
        html += `<p class="text-xs leading-relaxed text-surface-400 mt-2 italic" style="font-family: ${font}">Your message will appear here...</p>`;
      }

      if (state.category === 'love' && state.themeConfig.passcode) {
        html += `<div class="mt-2 inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-pink-500/15 border border-pink-500/30 text-[10px] font-semibold text-pink-300">🔒 PIN Protected (${state.themeConfig.passcode.length}-digit)</div>`;
      }

      if (state.category === 'birthday' && state.themeConfig.ageMilestone) {
        html += `<div class="mt-2 inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-pink-500/15 border border-pink-500/30 text-[10px] font-semibold text-pink-300">🎂 Milestone: ${state.themeConfig.ageMilestone}</div>`;
      }

      if (state.category === 'anniversary' && state.themeConfig.anniversaryMilestone) {
        html += `<div class="mt-2 inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-500/15 border border-rose-500/30 text-[10px] font-semibold text-rose-300">💍 ${state.themeConfig.anniversaryMilestone}</div>`;
      }

      if (state.category === 'graduation' && (state.themeConfig.degreeMajor || state.themeConfig.schoolCampus)) {
        html += `<div class="mt-2 space-y-0.5">`;
        if (state.themeConfig.degreeMajor) {
          html += `<div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-blue-500/15 border border-blue-500/30 text-[10px] font-semibold text-blue-300">🎓 ${state.themeConfig.degreeMajor}</div>`;
        }
        if (state.themeConfig.schoolCampus) {
          html += `<div class="text-[10px] text-surface-400">🏛️ ${state.themeConfig.schoolCampus}</div>`;
        }
        html += `</div>`;
      }

      if (state.category === 'invitation' && (state.themeConfig.invitationEventType || state.themeConfig.invitationTime || state.themeConfig.invitationVenue)) {
        html += `<div class="mt-2.5 rounded-xl p-2.5 text-left text-xs bg-emerald-500/10 border border-emerald-500/20 space-y-1">`;
        if (state.themeConfig.invitationEventType) html += `<div class="font-bold text-emerald-300 text-[11px]">✉️ ${state.themeConfig.invitationEventType}</div>`;
        if (state.themeConfig.invitationTime) html += `<div class="text-[10px] text-surface-300">⏰ ${state.themeConfig.invitationTime}</div>`;
        if (state.themeConfig.invitationVenue) html += `<div class="text-[10px] text-surface-400">📍 ${state.themeConfig.invitationVenue}</div>`;
        html += `</div>`;
      }

      if (state.category === 'love' && state.themeConfig.interactiveConfession?.enabled) {
        html += `<div class="mt-3 p-3 rounded-xl bg-pink-500/10 border border-pink-500/20 text-center">`;
        html += `<div class="text-[11px] font-bold text-pink-300 mb-1">💘 ${state.themeConfig.interactiveConfession.prompt || 'Maukah kamu jadi pacarku? 💕'}</div>`;
        html += `<div class="flex justify-center gap-2 mt-2">`;
        html += `<span class="px-3 py-1 rounded-full bg-pink-500 text-white text-[10px] font-bold">Yes! 🥰</span>`;
        html += `<span class="px-2.5 py-1 rounded-full bg-surface-700 text-surface-400 text-[10px]">No (Runaway) 🏃</span>`;
        html += `</div></div>`;
      }

      if (state.category === 'greetings' && state.themeConfig.signature) {
        html += `<div class="mt-3 pt-2 border-t border-white/10 text-right text-[11px] text-surface-400">Salam hangat: <span class="font-medium text-[#f5c563]">${state.themeConfig.signature}</span></div>`;
      }

      if (state.senderName) {
        html += `<p class="text-xs text-surface-400 mt-3 italic" style="font-family: ${font}">— ${state.senderName}</p>`;
      }
    }

    if (state.photos.length > 0) {
      const previewLimit = state.category === 'wedding' ? 6 : 4;
      html += `<div class="grid grid-cols-2 gap-1.5 mt-3">`;
      state.photos.slice(0, previewLimit).forEach((p) => {
        html += `<div class="aspect-square overflow-hidden rounded-lg"><img src="${p.previewUrl}" class="h-full w-full object-cover" /></div>`;
      });
      html += `</div>`;
    }

    html += `</div>`;
    return { html, bgImage, bgSize, bgColor, font };
  }

  function applyPreviewToScreen(screen: HTMLElement | null, previewData: PreviewThemeData) {
    if (!screen) return;
    screen.style.backgroundColor = previewData.bgColor;
    screen.style.backgroundImage = previewData.bgImage;
    screen.style.backgroundSize = previewData.bgSize;
    screen.style.backgroundRepeat = 'repeat';
    screen.style.fontFamily = previewData.font;
    screen.innerHTML = previewData.html;
  }

  function updateLivePreview() {
    const previewData = buildPreviewHTML();

    // Desktop preview
    applyPreviewToScreen(document.getElementById('preview-screen'), previewData);

    // Step 5 mobile inline preview
    if (currentStep === 5) {
      applyPreviewToScreen(document.getElementById('step5-preview-screen'), previewData);
    }

    // Modal preview (if open)
    const modalScreen = document.getElementById('modal-preview-screen');
    const modal = document.getElementById('preview-modal');
    if (modalScreen && modal && !modal.classList.contains('hidden')) {
      applyPreviewToScreen(modalScreen, previewData);
    }
  }

