          <span class="text-sm text-surface-400 shrink-0">Degree / Major</span>
          <span class="text-sm font-medium text-blue-300 break-words break-all [overflow-wrap:anywhere] sm:text-right">${state.themeConfig.degreeMajor}</span>
        </div>` : ''}
        ${state.category === 'graduation' && state.themeConfig.schoolCampus ? `
        <div class="flex flex-col sm:flex-row sm:justify-between items-start gap-1 sm:gap-2 min-w-0">
          <span class="text-sm text-surface-400 shrink-0">School / Campus</span>
          <span class="text-sm font-medium text-surface-200 break-words break-all [overflow-wrap:anywhere] sm:text-right">${state.themeConfig.schoolCampus}</span>
        </div>` : ''}
        ${state.category === 'invitation' && state.themeConfig.invitationEventType ? `
