  // Custom Audio File Selection & Upload
  const customAudioInput = document.getElementById('custom-audio-input') as HTMLInputElement | null;
  const customAudioDropzone = document.getElementById('custom-audio-dropzone');
  const customAudioBrowseBtn = document.getElementById('custom-audio-browse-btn');

  customAudioDropzone?.addEventListener('click', (e) => {
    if (e.target !== customAudioInput) {
      customAudioInput?.click();
    }
  });

  customAudioBrowseBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    customAudioInput?.click();
  });

  customAudioDropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    customAudioDropzone.classList.add('border-[#f5c563]', 'bg-[#f5c563]/5');
  });

  customAudioDropzone?.addEventListener('dragleave', () => {
    customAudioDropzone.classList.remove('border-[#f5c563]', 'bg-[#f5c563]/5');
  });

  customAudioDropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    customAudioDropzone.classList.remove('border-[#f5c563]', 'bg-[#f5c563]/5');
    if (e.dataTransfer?.files?.[0]) {
      handleCustomAudioFile(e.dataTransfer.files[0]);
    }
  });

  customAudioInput?.addEventListener('change', () => {
    if (customAudioInput.files?.[0]) {
      handleCustomAudioFile(customAudioInput.files[0]);
    }
  });

  async function handleCustomAudioFile(file: File) {
    const MAX_AUDIO_SIZE = 3 * 1024 * 1024; // 3MB
    const ALLOWED_AUDIO_EXTENSIONS = ['.mp3', '.ogg', '.opus'];

    // 1. Client-side Size Validation
    if (file.size > MAX_AUDIO_SIZE) {
      (window as any).showToast?.({
        message: 'File audio terlalu besar. Maksimal ukuran file 3MB.',
        type: 'warning',
      });
      if (customAudioInput) customAudioInput.value = '';
      return;
    }

    // 2. Client-side Format Validation
    const fileNameLower = file.name.toLowerCase();
    const hasValidExt = ALLOWED_AUDIO_EXTENSIONS.some((ext) => fileNameLower.endsWith(ext));
    if (!hasValidExt) {
      (window as any).showToast?.({
        message: 'Format file tidak didukung. Harap upload .mp3, .opus, atau .ogg.',
        type: 'warning',
      });
      if (customAudioInput) customAudioInput.value = '';
      return;
    }

    // UI: Show uploading progress
    const dropzone = document.getElementById('custom-audio-dropzone');
    const progressContainer = document.getElementById('custom-audio-progress-container');
    const filenameEl = document.getElementById('custom-audio-filename');
    const pctEl = document.getElementById('custom-audio-pct');
    const barEl = document.getElementById('custom-audio-bar');

    dropzone?.classList.add('hidden');
    progressContainer?.classList.remove('hidden');
    if (filenameEl) filenameEl.textContent = file.name;
    if (pctEl) pctEl.textContent = '0%';
    if (barEl) barEl.style.width = '0%';

    try {
      let contentType = file.type;
      if (!contentType || contentType === 'application/octet-stream') {
        if (fileNameLower.endsWith('.mp3')) contentType = 'audio/mpeg';
        else if (fileNameLower.endsWith('.opus')) contentType = 'audio/opus';
        else if (fileNameLower.endsWith('.ogg')) contentType = 'audio/ogg';
      }

      // 3. Get Presigned Upload URL
      const presignRes = await fetch('/api/storage/presigned-url', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          filename: file.name,
          contentType,
          folder: 'audio',
        }),
      });

      if (!presignRes.ok) {
        const err = await presignRes.json().catch(() => ({ error: 'Gagal mendapatkan izin upload' }));
        throw new Error(err.error || `Upload gagal (${presignRes.status})`);
      }

      const { uploadUrl, publicUrl } = await presignRes.json();

      // 4. Upload direct to R2 with progress
      await uploadToR2(uploadUrl, file, (pct) => {
        if (pctEl) pctEl.textContent = `${pct}%`;
        if (barEl) barEl.style.width = `${pct}%`;
      }, contentType);

      // 5. Store in state
      state.themeConfig.customAudioUrl = publicUrl;
      state.themeConfig.audioTrackId = null; // Prioritize custom audio over catalog
      updateTrackSelectionUI();

      showCustomAudioActiveCard(publicUrl, file.name);
      syncStudioAudioSource(false);
      (window as any).showToast?.({ message: '🎵 Musik kustom berhasil diupload!', type: 'success' });
    } catch (err: any) {
      console.error('Custom audio upload error:', err);
      (window as any).showToast?.({ message: err.message || 'Gagal mengupload musik kustom', type: 'error' });
      resetCustomAudioUploadUI();
    }
  }

  // Preview Play/Pause Button for Uploaded Audio
  const customAudioPreviewBtn = document.getElementById('custom-audio-preview-btn');
  customAudioPreviewBtn?.addEventListener('click', () => {
    if (!state.themeConfig.customAudioUrl) return;

    if (isCustomAudioPlaying) {
      stopCustomAudioPreview();
      return;
    }

    // Stop catalog audio/synth preview & studio preview
    stopCatalogAudioPreview();
    stopStudioAudioPreview();

    if (!customAudioPlayer || customAudioPlayer.src !== state.themeConfig.customAudioUrl) {
      customAudioPlayer = new Audio(state.themeConfig.customAudioUrl);
      customAudioPlayer.onended = () => {
        isCustomAudioPlaying = false;
        updateCustomAudioPreviewUI();
      };
      customAudioPlayer.onerror = () => {
        isCustomAudioPlaying = false;
        updateCustomAudioPreviewUI();
        (window as any).showToast?.({ message: 'Tidak dapat memutar audio preview', type: 'warning' });
      };
    }

    customAudioPlayer.play()
      .then(() => {
        isCustomAudioPlaying = true;
        updateCustomAudioPreviewUI();
      })
      .catch((err) => {
        console.error('Custom audio playback error:', err);
        isCustomAudioPlaying = false;
        updateCustomAudioPreviewUI();
      });
  });

  // Remove / Replace Custom Audio
  const customAudioRemoveBtn = document.getElementById('custom-audio-remove-btn');
  customAudioRemoveBtn?.addEventListener('click', () => {
    state.themeConfig.customAudioUrl = null;
    resetCustomAudioUploadUI();
    syncStudioAudioSource(false);
    (window as any).showToast?.({ message: 'Musik kustom dihapus', type: 'info' });
  });

  // ═══════════════════════════════════════════════════════
  // Studio Audio Preview & Start Offset Controller
  // ═══════════════════════════════════════════════════════
  const studioAudio = document.getElementById('studio-preview-audio') as HTMLAudioElement | null;
  const studioPlayBtn = document.getElementById('studio-player-play-btn');
  const studioPlayIcon = document.getElementById('studio-player-icon-play');
  const studioPauseIcon = document.getElementById('studio-player-icon-pause');
  const studioSeekSlider = document.getElementById('studio-player-seek-slider') as HTMLInputElement | null;
  const studioTimeCurrent = document.getElementById('studio-player-time-current');
  const studioTimeDuration = document.getElementById('studio-player-time-duration');
  const studioTrackName = document.getElementById('audio-controller-track-name');
  const studioStartOffsetBadge = document.getElementById('audio-start-offset-badge');
  const audioStartTimeInput = document.getElementById('audio-start-time-input') as HTMLInputElement | null;
  const audioSetCurrentStartBtn = document.getElementById('audio-set-current-start-btn');
  const audioPreviewFromStartBtn = document.getElementById('audio-preview-from-start-btn');
  const audioResetStartBtn = document.getElementById('audio-reset-start-btn');
  const audioStartStatusText = document.getElementById('audio-start-status-text');

  let isStudioSeeking = false;

  function formatTime(seconds: number): string {
    if (isNaN(seconds) || seconds < 0 || !isFinite(seconds)) return '00:00';
    const totalSecs = Math.floor(seconds);
    const mins = Math.floor(totalSecs / 60);
    const secs = totalSecs % 60;
    return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  }

  function parseTimeToSeconds(input: string): number {
    if (!input) return 0;
    const trimmed = input.trim();
    if (trimmed.includes(':')) {
      const parts = trimmed.split(':');
      const mins = parseInt(parts[0], 10) || 0;
      const secs = parseFloat(parts[1]) || 0;
      return Math.max(0, Math.round(mins * 60 + secs));
    }
    const val = parseFloat(trimmed);
    return isNaN(val) || val < 0 ? 0 : Math.round(val);
  }

  function updateAudioStartTimeUI(seconds: number) {
    const rounded = Math.max(0, Math.round(seconds));
    state.themeConfig.audioStartTime = rounded;

    const formatted = formatTime(rounded);
    if (audioStartTimeInput) {
      audioStartTimeInput.value = formatted;
    }
    if (studioStartOffsetBadge) {
      studioStartOffsetBadge.textContent = `Mulai: ${formatted}`;
    }
    if (audioStartStatusText) {
      if (rounded === 0) {
        audioStartStatusText.textContent = 'Default: Mulai dari awal (00:00)';
      } else {
        audioStartStatusText.textContent = `Aktif: Mulai dari detik ke-${rounded} (${formatted})`;
      }
    }
  }

  function stopStudioAudioPreview() {
    if (studioAudio && !studioAudio.paused) {
      studioAudio.pause();
    }
    studioPlayIcon?.classList.remove('hidden');
    studioPauseIcon?.classList.add('hidden');
  }

  function getActiveAudioDetails(): { url: string | null; name: string } {
    if (state.themeConfig.customAudioUrl) {
      const customCardName = document.getElementById('custom-audio-card-name')?.textContent?.trim();
      return {
        url: state.themeConfig.customAudioUrl,
        name: customCardName ? `Musik Kustom: ${customCardName}` : 'Musik Kustom',
      };
    }
    if (state.themeConfig.audioTrackId) {
      const trackRow = document.querySelector(`[data-track-row="${state.themeConfig.audioTrackId}"]`);
      const trackTitle = trackRow?.querySelector('.text-surface-200')?.textContent?.trim() || state.themeConfig.audioTrackId;
      const previewBtn = trackRow?.querySelector('[data-audio-preview]') as HTMLElement | null;
      const trackUrl = previewBtn?.dataset.audioUrl || `/audio/${state.themeConfig.audioTrackId}.opus`;
      return {
        url: trackUrl,
        name: trackTitle,
      };
    }
    return {
      url: null,
      name: 'Belum ada musik yang dipilih',
    };
  }

  function syncStudioAudioSource(autoPlay = false) {
    if (!studioAudio) return;
    const active = getActiveAudioDetails();

    if (studioTrackName) {
      studioTrackName.textContent = active.name;
    }

    if (!active.url) {
      stopStudioAudioPreview();
      studioAudio.removeAttribute('src');
      studioAudio.load();
      if (studioSeekSlider) {
        studioSeekSlider.value = '0';
        studioSeekSlider.max = '100';
      }
      if (studioTimeCurrent) studioTimeCurrent.textContent = '00:00';
      if (studioTimeDuration) studioTimeDuration.textContent = '00:00';
      return;
    }

    const currentSrc = studioAudio.currentSrc || studioAudio.src;
    const isSameSrc = currentSrc && (currentSrc.endsWith(active.url) || currentSrc === active.url);

    if (!isSameSrc) {
      const wasPlaying = !studioAudio.paused;
      stopStudioAudioPreview();
      studioAudio.src = active.url;
      studioAudio.load();
      if (studioSeekSlider) studioSeekSlider.value = '0';
      if (studioTimeCurrent) studioTimeCurrent.textContent = '00:00';

      if (autoPlay || wasPlaying) {
        const startTime = state.themeConfig.audioStartTime || 0;
        const onCanPlay = () => {
          studioAudio.removeEventListener('canplay', onCanPlay);
          if (startTime > 0 && studioAudio.duration && startTime < studioAudio.duration) {
            try { studioAudio.currentTime = startTime; } catch {}
          }
          studioAudio.play().catch(() => {});
        };
        studioAudio.addEventListener('canplay', onCanPlay);
      }
    }
  }

  // Native audio event listeners
  studioAudio?.addEventListener('loadedmetadata', () => {
    if (!studioAudio) return;
    const duration = studioAudio.duration;
    if (studioTimeDuration) studioTimeDuration.textContent = formatTime(duration);
    if (studioSeekSlider && !isNaN(duration) && duration > 0) {
      studioSeekSlider.max = duration.toString();
    }
  });

  studioAudio?.addEventListener('timeupdate', () => {
    if (!studioAudio || isStudioSeeking) return;
    const curr = studioAudio.currentTime;
    if (studioSeekSlider) {
      studioSeekSlider.value = curr.toString();
    }
    if (studioTimeCurrent) {
      studioTimeCurrent.textContent = formatTime(curr);
    }
  });

  studioAudio?.addEventListener('play', () => {
    studioPlayIcon?.classList.add('hidden');
    studioPauseIcon?.classList.remove('hidden');
  });

  studioAudio?.addEventListener('pause', () => {
    studioPlayIcon?.classList.remove('hidden');
    studioPauseIcon?.classList.add('hidden');
  });

  studioAudio?.addEventListener('ended', () => {
    studioPlayIcon?.classList.remove('hidden');
    studioPauseIcon?.classList.add('hidden');
    if (studioAudio) {
      const start = state.themeConfig.audioStartTime || 0;
      studioAudio.currentTime = start;
    }
  });

  // Slider Scrubbing
  studioSeekSlider?.addEventListener('input', () => {
    isStudioSeeking = true;
    if (!studioSeekSlider) return;
    const val = parseFloat(studioSeekSlider.value);
    if (studioTimeCurrent) studioTimeCurrent.textContent = formatTime(val);
  });

  studioSeekSlider?.addEventListener('change', () => {
    if (!studioAudio || !studioSeekSlider) return;
    const val = parseFloat(studioSeekSlider.value);
    try {
      studioAudio.currentTime = val;
    } catch {}
    isStudioSeeking = false;
  });

  // Play / Pause toggle
  studioPlayBtn?.addEventListener('click', () => {
    if (!studioAudio) return;
    const active = getActiveAudioDetails();
    if (!active.url) {
      (window as any).showToast?.({ message: 'Pilih musik dari katalog atau upload musik sendiri terlebih dahulu', type: 'info' });
      return;
    }

    // Stop catalog & custom previews first
    stopCatalogAudioPreview();
    stopCustomAudioPreview();

    if (studioAudio.paused) {
      if (studioAudio.currentTime === 0 && (state.themeConfig.audioStartTime || 0) > 0) {
        try {
          studioAudio.currentTime = state.themeConfig.audioStartTime!;
        } catch {}
      }
      studioAudio.play().catch((err) => {
        console.warn('Studio audio playback failed:', err);
      });
    } else {
      studioAudio.pause();
    }
  });

  // "Jadikan Detik Saat Ini sebagai Titik Mulai"
  audioSetCurrentStartBtn?.addEventListener('click', () => {
    let currentSec = 0;
    if (studioAudio && studioAudio.duration) {
      currentSec = Math.floor(studioAudio.currentTime);
    } else if (studioSeekSlider) {
      currentSec = Math.floor(parseFloat(studioSeekSlider.value) || 0);
    }
    updateAudioStartTimeUI(currentSec);
    (window as any).showToast?.({
      message: `Titik mulai diset ke detik ${currentSec} (${formatTime(currentSec)})`,
      type: 'success',
    });
  });

  // Manual input MM:SS or seconds
  audioStartTimeInput?.addEventListener('change', () => {
    if (!audioStartTimeInput) return;
    const seconds = parseTimeToSeconds(audioStartTimeInput.value);
    const maxDuration = studioAudio?.duration && !isNaN(studioAudio.duration) ? Math.floor(studioAudio.duration) : 3600;
    const clamped = Math.min(seconds, maxDuration);
    updateAudioStartTimeUI(clamped);
    if (studioAudio && studioAudio.duration) {
      try {
        studioAudio.currentTime = clamped;
      } catch {}
      if (studioSeekSlider) {
        studioSeekSlider.value = clamped.toString();
      }
      if (studioTimeCurrent) {
        studioTimeCurrent.textContent = formatTime(clamped);
      }
    }
  });

  // "▶ Tes" button
  audioPreviewFromStartBtn?.addEventListener('click', () => {
    if (!studioAudio) return;
    const active = getActiveAudioDetails();
    if (!active.url) {
      (window as any).showToast?.({ message: 'Pilih musik terlebih dahulu untuk mencoba playback', type: 'info' });
      return;
    }

    stopCatalogAudioPreview();
    stopCustomAudioPreview();

    const startSec = state.themeConfig.audioStartTime || 0;
    const seekAndPlay = () => {
      try {
        if (studioAudio.duration && startSec < studioAudio.duration) {
          studioAudio.currentTime = startSec;
        } else {
          studioAudio.currentTime = 0;
        }
      } catch {}
      studioAudio.play().catch(() => {});
    };

    if (studioAudio.readyState >= 1) {
      seekAndPlay();
    } else {
      studioAudio.addEventListener('canplay', seekAndPlay, { once: true });
      studioAudio.load();
    }
  });

  // Reset button
  audioResetStartBtn?.addEventListener('click', () => {
    updateAudioStartTimeUI(0);
    if (studioAudio) {
      try {
        studioAudio.currentTime = 0;
      } catch {}
      if (studioSeekSlider) {
        studioSeekSlider.value = '0';
      }
      if (studioTimeCurrent) {
        studioTimeCurrent.textContent = '00:00';
      }
    }
    (window as any).showToast?.({ message: 'Titik mulai direset ke 00:00', type: 'info' });
  });

