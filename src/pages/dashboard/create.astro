  function getWD(): WeddingDataState {
    if (!state.themeConfig.weddingData) {
      state.themeConfig.weddingData = emptyWeddingData();
    }
    return state.themeConfig.weddingData;
  }

  function syncWeddingRecipientName() {
    if (state.category !== 'wedding') return;
    const wd = getWD();
    const groomName = (wd.groom.nickname || wd.groom.fullName || '').trim();
    const brideName = (wd.bride.nickname || wd.bride.fullName || '').trim();
    if (groomName && brideName) {
      state.recipientName = `${groomName} & ${brideName}`;
    } else if (groomName || brideName) {
      state.recipientName = groomName || brideName;
    }
  }

  function wInput(id: string, cb: (val: string) => void) {
    document.getElementById(id)?.addEventListener('input', (e) => {
      cb((e.target as HTMLInputElement).value);
      updateLivePreview();
    });
  }

