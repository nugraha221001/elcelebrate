---
import DashboardLayout from '../../components/layout/DashboardLayout.astro';
import Button from '../../components/ui/Button.astro';
import Modal from '../../components/ui/Modal.astro';
import Toast from '../../components/ui/Toast.astro';
import { CATEGORY_META, ROOT_OWNER_EMAIL, isSuperAdmin, type UserRole } from '../../lib/types';
import type { Card } from '../../lib/types';
import { Cake, Sparkles, Gift, Eye, Share2, Plus, Sparkle, ArrowRight, ShieldCheck } from 'lucide-astro';
import { SHOWCASE_WEDDING_CARD } from '../../lib/showcase-wedding';
import { cleanupExpiredCards } from '../../lib/cleanup-expired';
import { createSupabaseAdminClient } from '../../lib/supabase';
import { DURATION_TIERS, formatRupiah } from '../../lib/pricing';

export const prerender = false;

// Auth check — allow guest mode showcase preview without hard redirect
const user = Astro.locals.user;
const isGuest = !user;

let userRole: UserRole = 'user';
let cards: Card[] = [];

if (user) {
  const supabase = Astro.locals.supabase;

  // Fetch user role
  const { data: profile } = await supabase
    .from('profiles')
    .select('role')
    .eq('id', user.id)
    .single();
  const isRoot = user.email?.trim().toLowerCase() === ROOT_OWNER_EMAIL.toLowerCase();
  userRole = isRoot ? 'super_admin' : (profile?.role as UserRole) || 'user';

  // Fetch user's cards
  const { data } = await supabase
    .from('cards')
    .select('*')
    .eq('user_id', user.id)
    .order('created_at', { ascending: false });
  cards = data || [];

  // Non-blocking background garbage collector for expired cards & unpaid drafts
  try {
    const adminClient = createSupabaseAdminClient();
    const cleanupPromise = cleanupExpiredCards(adminClient);
    const runtime = (Astro.locals as any).runtime;
    if (runtime?.ctx?.waitUntil) {
      runtime.ctx.waitUntil(cleanupPromise);
    } else {
      cleanupPromise.catch((err) => console.error('[Dashboard cleanup] Error:', err));
    }
  } catch (e) {
    // Non-critical background task
  }
}

const isSuperAdminUser = isSuperAdmin(userRole, user?.email);
---

<DashboardLayout title={isGuest ? "Pratinjau Dashboard" : "Kartu Saya"}>
  <Toast />

  {isGuest && (
    <div class="mb-8 rounded-2xl border border-[#f5c563]/30 bg-[#f5c563]/10 p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 backdrop-blur-md shadow-lg">
      <div class="flex items-start sm:items-center gap-3">
        <div class="w-10 h-10 rounded-xl border border-[#f5c563]/30 bg-[#f5c563]/15 text-[#f5c563] flex items-center justify-center shrink-0">
          <Sparkles class="w-5 h-5" stroke-width={1.5} />
        </div>
        <div>
          <h2 class="text-sm font-semibold text-white">Mode Pratinjau Tamu (Guest Showcase)</h2>
          <p class="text-xs text-surface-300 mt-0.5">Anda sedang melihat Pratinjau Dashboard. Masuk untuk menyimpan dan mengelola undangan Anda sendiri.</p>
        </div>
      </div>
      <div class="flex items-center gap-2.5 shrink-0">
        <a
          href="/signin"
          class="rounded-xl bg-[#f5c563] text-[#0f0d15] px-4 py-2 text-xs font-semibold shadow-md shadow-[#f5c563]/20 hover:brightness-110 active:scale-95 transition-all"
        >
          Masuk ke Akun
        </a>
        <a
          href="/signup"
          class="rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 text-white px-3.5 py-2 text-xs font-medium transition-all"
        >
          Daftar Gratis
        </a>
      </div>
    </div>
  )}

  <!-- Delete Card Confirmation Modal -->
  <Modal id="delete-card-modal" title="Hapus Kartu Ini?" size="sm">
    <div class="space-y-4">
      <p class="text-sm text-surface-300 leading-relaxed">
        Apakah Anda yakin ingin menghapus kartu untuk <strong id="delete-card-recipient-name" class="text-white"></strong>? Tindakan ini permanen dan akan menghapus semua foto terkait.
      </p>
      <div class="flex items-center justify-end gap-3 pt-2">
        <button
          type="button"
          data-modal-close="delete-card-modal"
          class="rounded-xl px-4 py-2 text-xs font-medium text-surface-300 hover:bg-white/5 hover:text-white transition-colors cursor-pointer"
        >
          Batal
        </button>
        <button
          type="button"
          id="confirm-delete-btn"
          class="inline-flex items-center gap-2 rounded-xl bg-error px-4 py-2 text-xs font-semibold text-white shadow-lg shadow-error/25 hover:brightness-110 active:scale-[0.97] transition-all cursor-pointer"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
          </svg>
          <span id="delete-btn-text">Ya, Hapus</span>
        </button>
      </div>
    </div>
  </Modal>

  <!-- Share / WhatsApp Modal -->
  <Modal id="share-card-modal" title="Bagikan Kartu" size="md">
    <div class="space-y-4">
      <div>
        <label id="share-recipient-label" class="block text-xs font-medium text-surface-400 mb-1.5">Nama Tamu</label>
        <input
          type="text"
          id="share-guest-name"
          placeholder="Budi Santoso"
          class="form-input w-full rounded-xl bg-white/5 px-4 py-2.5 text-sm focus-ring"
        />
      </div>
      <div id="share-salutation-container">
        <label class="block text-xs font-medium text-surface-400 mb-1.5">Sapaan</label>
        <select
          id="share-salutation"
          class="form-input w-full rounded-xl bg-white/5 px-4 py-2.5 text-sm focus-ring appearance-none"
        >
          <option value="Bapak">Bapak</option>
          <option value="Ibu">Ibu</option>
          <option value="Saudara/i" selected>Saudara/i</option>
          <option value="Teman">Teman</option>
        </select>
      </div>

      <!-- Preview Link -->
      <div>
        <label id="share-link-label" class="block text-xs font-medium text-surface-400 mb-1.5">Tautan Undangan</label>
        <div class="flex items-center gap-2 rounded-xl bg-white/5 border border-white/10 px-3 py-2.5">
          <svg class="h-4 w-4 text-surface-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m9.86-4.122a4.5 4.5 0 00-1.242-7.244l-4.5-4.5a4.5 4.5 0 10-6.364 6.364l1.757 1.757" />
          </svg>
          <span id="share-preview-link" class="text-xs text-surface-200 truncate select-all">—</span>
        </div>
      </div>

      <!-- WhatsApp Message Preview -->
      <div>
        <label class="block text-xs font-medium text-surface-400 mb-1.5">Pesan WhatsApp</label>
        <div class="rounded-xl bg-white/5 border border-white/10 px-3 py-2.5">
          <p id="share-wa-preview" class="text-xs text-surface-300 leading-relaxed whitespace-pre-wrap">—</p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3 pt-2">
        <button
          type="button"
          id="share-copy-link-btn"
          class="flex-1 inline-flex items-center justify-center gap-2 rounded-xl bg-surface-700 px-4 py-2.5 text-xs font-semibold text-surface-200 transition-all hover:bg-surface-600 hover:text-white cursor-pointer"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
          </svg>
          <span id="share-copy-text">Salin Tautan</span>
        </button>
        <a
          id="share-wa-btn"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 inline-flex items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-xs font-semibold text-white transition-all hover:brightness-110 cursor-pointer"
          style="background: #25D366;"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          <span>Kirim via WhatsApp</span>
        </a>
      </div>
    </div>
  </Modal>

  <!-- QRIS Payment & Activation Modal -->
  <Modal id="qris-modal" title="Aktivasi & Perpanjang Durasi Kartu" size="md">
    <div class="space-y-3 pb-2">
      <div class="p-3 rounded-xl bg-surface-800/60 border border-white/10 flex items-center justify-between">
        <div class="min-w-0 pr-2">
          <p class="text-xs text-surface-400">Undangan:</p>
          <h4 id="qris-card-title" class="text-sm font-bold text-white truncate">—</h4>
        </div>
        <span id="qris-tier-badge" class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-400/20 text-amber-300 border border-amber-400/30 shrink-0">
          Paket 7 Hari
        </span>
      </div>

      <!-- Duration Selector in Modal -->
      <div>
        <label class="block text-xs font-medium text-surface-300 mb-2">Pilih Durasi Masa Aktif:</label>
        <div class="grid grid-cols-3 gap-2 [&_.modal-duration-tier-btn]:py-2! [&_.modal-duration-tier-btn]:px-2.5! [&_.modal-duration-tier-btn]:text-xs!" id="qris-modal-tier-picker">
          {DURATION_TIERS.map((tier) => (
            <button
              type="button"
              class={`modal-duration-tier-btn py-2 px-2.5 text-xs rounded-xl border text-left transition-all cursor-pointer ${
                tier.days === 7
                  ? 'border-amber-400/60 bg-amber-500/10 ring-1 ring-amber-400/30'
                  : 'border-white/10 bg-surface-800/40 hover:border-white/20'
              }`}
              data-days={tier.days}
              data-price={tier.price}
              data-name={tier.name}
            >
              <div class="text-[11px] font-semibold text-surface-300">{tier.days} Hari</div>
              <div class="text-xs font-bold text-amber-300">{formatRupiah(tier.price)}</div>
            </button>
          ))}
        </div>
      </div>

      <!-- QR Code Display Box -->
      <div class="rounded-2xl border border-amber-500/25 bg-slate-950 p-3 sm:p-4 text-center shadow-inner">
        <div class="flex items-center justify-between text-xs text-surface-400 mb-2 px-1">
          <span class="flex items-center gap-1 font-mono text-[11px]">
            <span class="text-amber-400">#</span>
            <span id="qris-order-id">ELC-...</span>
          </span>
          <span class="flex items-center gap-1 font-semibold text-amber-300">
            <span>⏳</span>
            <span id="qris-countdown">15:00</span>
          </span>
        </div>

        <div
          id="qris-qr-container"
          class="w-full max-w-52.5 sm:max-w-57.5 mx-auto p-3 rounded-2xl bg-white shadow-xl border-2 border-amber-400/30 my-2 text-slate-900 flex flex-col items-center justify-center min-h-52.5 sm:[&_.w-48]:w-40! [&_.h-48]:h-36! sm:[&_.h-48]:h-40! sm:[&_svg]:w-40! sm:[&_svg]:h-40!"
        >
          <!-- Injected SVG QR -->
          <div class="animate-pulse text-xs text-slate-500 font-medium py-10">Membuat Kode QRIS...</div>
        </div>

        <div class="flex items-center justify-between text-xs pt-1 px-1">
          <span class="text-surface-400">Total Pembayaran:</span>
          <span id="qris-amount-display" class="text-base font-extrabold text-amber-300">Rp10.000</span>
        </div>
      </div>

      <!-- Status indicator -->
      <div id="qris-status-box" class="flex items-center justify-center gap-2 py-2 px-3 rounded-xl bg-surface-800/80 border border-white/10 text-xs text-surface-300">
        <span class="inline-flex h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span id="qris-status-text">Menunggu pembayaran via aplikasi perbankan / e-wallet...</span>
      </div>

      <!-- Simulation mode button (Test mode) -->
      <div id="qris-sim-container" class="pt-1 pb-2">
        <button
          type="button"
          id="qris-simulate-btn"
          class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl font-bold text-xs bg-amber-400/20 text-amber-300 border border-amber-400/40 hover:bg-amber-400/30 hover:brightness-110 active:scale-[0.98] transition-all cursor-pointer shadow-sm"
        >
          <span>⚡</span>
          <span>Simulasikan Pembayaran Berhasil (Test Mode)</span>
        </button>
      </div>
    </div>
  </Modal>

  <!-- Multi-Admin Management Modal (Super Admin Only) -->
  {isSuperAdminUser && (
    <Modal id="admin-roles-modal" title="Kelola Akses Admin (RBAC)" size="lg">
      <div class="space-y-5">
        <!-- Promote/Demote Form -->
        <div class="p-4 rounded-2xl bg-surface-800/60 border border-white/10">
          <h4 class="text-xs font-bold uppercase tracking-wider text-amber-300 mb-3">Ubah Peran Pengguna</h4>
          <div class="flex flex-col sm:flex-row gap-2.5">
            <input
              type="email"
              id="admin-role-email"
              placeholder="email.pengguna@example.com"
              class="form-input flex-1 rounded-xl bg-white/5 border border-white/10 px-3.5 py-2 text-xs focus-ring text-white"
            />
            <select
              id="admin-role-select"
              class="rounded-xl bg-surface-800 border border-white/10 px-3 py-2 text-xs text-white focus-ring cursor-pointer"
            >
              <option value="admin">Admin Mitra 👑</option>
              <option value="user">Pengguna Biasa</option>
              <option value="super_admin">Super Admin ⭐</option>
            </select>
            <button
              type="button"
              id="admin-role-submit-btn"
              class="rounded-xl bg-[#f5c563] text-[#0f0d15] px-4 py-2 text-xs font-semibold shadow-md shadow-[#f5c563]/20 hover:brightness-110 transition-all cursor-pointer whitespace-nowrap"
            >
              Simpan Peran
            </button>
          </div>
        </div>

        <!-- Users List -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <h4 class="text-xs font-bold uppercase tracking-wider text-surface-400">Daftar Pengguna Terdaftar</h4>
            <button type="button" id="admin-refresh-users-btn" class="text-xs text-amber-300 hover:underline cursor-pointer">
              Segarkan
            </button>
          </div>
          <div class="max-h-60 overflow-y-auto rounded-xl border border-white/10 bg-surface-900/60">
            <div id="admin-users-list" class="divide-y divide-white/5">
              <div class="p-4 text-center text-xs text-surface-400">Memuat data pengguna...</div>
            </div>
          </div>
        </div>
      </div>
    </Modal>
  )}

  <!-- Header -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-surface-50">{isGuest ? "Pratinjau Dashboard" : "Kartu Saya"}</h1>
      <p class="mt-1 text-sm text-surface-400" id="card-count-label">
        {isGuest
          ? "Menampilkan contoh kartu resmi & alur kerja ElCelebrate"
          : cards.length === 0
            ? "Belum ada kartu buatan sendiri"
            : `${cards.length} kartu telah dibuat`}
      </p>
    </div>
    <div class="flex items-center gap-2.5">
      {isSuperAdminUser && (
        <button
          type="button"
          id="admin-manage-btn"
          class="inline-flex items-center gap-2 rounded-xl border border-amber-400/40 bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 px-3.5 py-2 text-xs font-semibold shadow-sm transition-all cursor-pointer"
        >
          <span>👑</span>
          <span>Kelola Admin</span>
        </button>
      )}
      <Button href={isGuest ? "/signin" : "/dashboard/create"} variant="primary" size="md" id="dashboard-create-btn">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        {isGuest ? "Masuk untuk Membuat" : "Buat Kartu"}
      </Button>
    </div>
  </div>

  <!-- ── Master Showcase Card: Raden & Arum ── -->
  <div class="mb-10">
    <div class="flex items-center justify-between mb-3.5">
      <div class="flex items-center gap-2">
        <Sparkle class="w-4 h-4 text-[#f5c563]" stroke-width={2} />
        <h2 class="text-xs font-semibold tracking-wider uppercase text-[#f5c563]">
          {isGuest ? "Contoh Undangan Studio: Raden & Arum (Wedding Invitation)" : "Contoh Resmi Studio: Raden & Arum (Wedding)"}
        </h2>
      </div>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-[#f5c563]/10 text-[#f5c563] border border-[#f5c563]/25">
        <ShieldCheck class="w-3.5 h-3.5" stroke-width={1.5} />
        <span>Boutique Master Template</span>
      </span>
    </div>

    <!-- Luxury Showcase Banner Card -->
    <div class="relative overflow-hidden rounded-2xl border border-[#f5c563]/30 bg-linear-to-br from-[#1b1728] via-[#15121e] to-[#0f0d15] p-5 sm:p-6 shadow-2xl backdrop-blur-md">
      <!-- Decorative Inset Hairline -->
      <div class="pointer-events-none absolute inset-2 rounded-xl border border-[#f5c563]/15"></div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-center gap-4 min-w-0">
          <div class="relative w-20 h-20 sm:w-22 sm:h-22 rounded-2xl overflow-hidden border border-[#f5c563]/40 shadow-lg shrink-0">
            <img
              src={SHOWCASE_WEDDING_CARD.media_urls[0]}
              alt="Raden & Arum"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent"></div>
            <span class="absolute bottom-1.5 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded-full text-[9px] font-semibold bg-[#f5c563] text-[#0f0d15] shadow-xs">
              Wedding
            </span>
          </div>

          <div class="min-w-0 flex-1">
            <div class="inline-flex items-center gap-2 text-xs font-serif italic text-[#f5c563]">
              <span>Walimatul &apos;Ursy • Signature Atelier</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-white font-serif tracking-tight mt-0.5 truncate">
              Raden & Arum
            </h3>
            <p class="text-xs text-surface-300 mt-0.5 truncate">
              Sabtu, 24 Oktober 2026 • Grand Ballroom The Dharmawangsa, Jakarta
            </p>
            <div class="mt-2 flex flex-wrap items-center gap-2 text-[11px] text-surface-400">
              <span class="inline-flex items-center gap-1 text-emerald-400 font-medium">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Wax Seal Unbox</span>
              </span>
              <span>•</span>
              <span>Opus Audio</span>
              <span>•</span>
              <span>Filigree Divider</span>
              <span>•</span>
              <span>11 Prewedding Photos</span>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-2.5 shrink-0 pt-2 md:pt-0">
          {isGuest ? (
            <>
              <a
                href="/c/demo-wedding"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-xl bg-[#f5c563] text-[#0f0d15] px-4 py-2.5 text-xs font-semibold shadow-md shadow-[#f5c563]/20 hover:brightness-110 active:scale-95 transition-all"
              >
                <Eye class="w-4 h-4" stroke-width={2} />
                <span>Lihat Undangan Utuh</span>
              </a>
              <a
                href="/c/demo-wedding"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 text-white px-3.5 py-2.5 text-xs font-medium transition-all"
              >
                <span>Simulasi Studio</span>
                <ArrowRight class="w-3.5 h-3.5 text-surface-400" />
              </a>
              <a
                href="/signin"
                class="inline-flex items-center gap-1.5 rounded-xl border border-[#f5c563]/30 bg-[#f5c563]/10 hover:bg-[#f5c563]/20 text-[#f5c563] px-3.5 py-2.5 text-xs font-semibold transition-all"
              >
                <Sparkles class="w-3.5 h-3.5" />
                <span>Gunakan Konsep Ini</span>
              </a>
            </>
          ) : (
            <>
              <a
                href="/c/demo-wedding"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-xl bg-surface-700 text-surface-100 hover:bg-surface-600 hover:text-white px-3.5 py-2 text-xs font-medium transition-all"
              >
                <Eye class="w-3.5 h-3.5 text-surface-400" />
                <span>Lihat Demo Utuh</span>
              </a>
              <button
                type="button"
                class="share-card-trigger inline-flex items-center gap-1.5 rounded-xl px-3.5 py-2 text-xs font-medium text-white transition-all hover:brightness-110 cursor-pointer"
                style="background: #25D366;"
                data-card-slug="demo-wedding"
                data-card-recipient="Raden & Arum"
                data-card-category="wedding"
                data-card-id="showcase-wedding-card-001"
              >
                <Share2 class="w-3.5 h-3.5" />
                <span>Uji Bagikan WA</span>
              </button>
              <a
                href="/dashboard/create?category=wedding"
                class="inline-flex items-center gap-2 rounded-xl bg-[#f5c563] text-[#0f0d15] px-4 py-2 text-xs font-semibold shadow-md shadow-[#f5c563]/20 hover:brightness-110 active:scale-95 transition-all"
              >
                <Plus class="w-3.5 h-3.5" stroke-width={2.5} />
                <span>Buat Seperti Ini</span>
              </a>
            </>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- User Cards Section -->
  {!isGuest && (
    <div>
      {cards.length > 0 ? (
        <div class="mb-4">
          <h2 class="text-sm font-semibold tracking-wide uppercase text-surface-400">
            Kartu Undangan & Ucapan Anda ({cards.length})
          </h2>
        </div>
      ) : (
        <div id="empty-state" class="mt-8 mb-12 flex flex-col items-center justify-center text-center p-8 rounded-2xl border border-white/8 bg-surface-900/40">
          <div class="mb-4 flex gap-3 items-center justify-center">
            <div class="w-12 h-12 rounded-2xl border border-[#f5c563]/25 bg-[#f5c563]/5 text-[#f5c563] flex items-center justify-center shadow-lg shadow-[#f5c563]/5">
              <Cake class="w-6 h-6" stroke-width={1.5} />
            </div>
            <div class="w-14 h-14 rounded-2xl border border-[#f5c563]/40 bg-[#f5c563]/10 text-[#f5c563] flex items-center justify-center shadow-xl shadow-[#f5c563]/10">
              <Sparkles class="w-7 h-7" stroke-width={1.5} />
            </div>
            <div class="w-12 h-12 rounded-2xl border border-[#f5c563]/25 bg-[#f5c563]/5 text-[#f5c563] flex items-center justify-center shadow-lg shadow-[#f5c563]/5">
              <Gift class="w-6 h-6" stroke-width={1.5} />
            </div>
          </div>
          <h3 class="text-lg font-semibold text-surface-200">Belum Ada Kartu Buatan Sendiri</h3>
          <p class="mt-1.5 max-w-sm text-sm text-surface-400">
            Mulai rancang undangan pernikahan, ulang tahun, atau kartu selebrasi pertama Anda dengan alur kreasi intuitif.
          </p>
          <div class="mt-6">
            <Button href="/dashboard/create" variant="primary" size="md" id="empty-state-cta">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
              Buat Kartu Pertama
            </Button>
          </div>
        </div>
      )}
    </div>
  )}

  <!-- Card Grid -->
  {cards.length > 0 && (
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="cards-grid">
      {cards.map((card, i) => {
        const meta = CATEGORY_META[card.category as keyof typeof CATEGORY_META];
        const cardUrl = `/c/${card.slug}`;
        const isPublished = Boolean(card.is_published);
        const isUnpaid = card.payment_status === 'unpaid';
        const isAdminFree = card.payment_status === 'admin_free';
        const isPaid = card.payment_status === 'paid';
        const nowMs = Date.now();

        let statusBadge = {
          label: 'Draf Belum Aktif',
          color: 'bg-amber-500/15 text-amber-300 border-amber-500/30',
          dot: 'bg-amber-400',
        };

        if (isAdminFree) {
          statusBadge = {
            label: 'VIP Permanen 👑',
            color: 'bg-amber-500/20 text-amber-200 border-amber-400/40',
            dot: 'bg-amber-300 animate-pulse',
          };
        } else if (isPaid && card.expires_at) {
          const expiresMs = new Date(card.expires_at).getTime();
          if (expiresMs > nowMs) {
            const daysLeft = Math.ceil((expiresMs - nowMs) / (24 * 60 * 60 * 1000));
            statusBadge = {
              label: `Aktif • Sisa ${daysLeft} hari`,
              color: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30',
              dot: 'bg-emerald-400 animate-pulse',
            };
          } else if (card.grace_until && new Date(card.grace_until).getTime() > nowMs) {
            const graceMs = new Date(card.grace_until).getTime();
            const hoursLeft = Math.max(1, Math.ceil((graceMs - nowMs) / (60 * 60 * 1000)));
            statusBadge = {
              label: `Masa Tenggang • ${hoursLeft}j`,
              color: 'bg-rose-500/15 text-rose-300 border-rose-500/30',
              dot: 'bg-rose-400 animate-ping',
            };
          } else {
            statusBadge = {
              label: 'Kedaluwarsa',
              color: 'bg-surface-800 text-surface-400 border-white/10',
              dot: 'bg-surface-500',
            };
          }
        }

        return (
          <div
            id={`card-item-${card.id}`}
            class="group relative overflow-hidden rounded-2xl bg-surface-900/60 backdrop-blur-md border border-white/8 transition-all duration-300 hover:shadow-elevated hover:-translate-y-1 hover:border-purple-500/30"
            style={`animation: fade-in-up 0.5s var(--ease-smooth) forwards; animation-delay: ${i * 80}ms; opacity: 0;`}
          >
            <!-- Card header with gradient -->
            <div
              class="h-28 bg-linear-to-br p-4 relative"
              style={`background: linear-gradient(135deg, ${card.theme_config.primaryColor || '#c084fc'}40, ${card.theme_config.secondaryColor || '#f472b6'}30);`}
            >
              <div class="flex items-start justify-between">
                <span class="text-3xl">{meta?.emoji || '🎉'}</span>

                <!-- Status Badge -->
                <div class="flex items-center gap-2">
                  <span
                    class:list={[
                      'inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold border shadow-xs select-none',
                      statusBadge.color
                    ]}
                  >
                    <span class:list={['h-1.5 w-1.5 rounded-full', statusBadge.dot]}></span>
                    <span>{statusBadge.label}</span>
                  </span>
                </div>
              </div>
            </div>

            <div class="p-5">
              <h3 class="text-base font-semibold text-surface-100 truncate">
                {card.category === 'wedding' ? card.recipient_name : `Untuk ${card.recipient_name}`}
              </h3>
              <p class="mt-1 text-sm text-surface-400">
                {meta?.label || card.category}
                {card.event_date && (
                  <span> · {new Date(card.event_date).toLocaleDateString()}</span>
                )}
              </p>

              <!-- Actions Toolbar -->
              <div class="mt-5 flex flex-wrap items-center gap-1.5 pt-3 border-t border-white/5">
                <!-- QRIS Activate / Extend Button -->
                {!isAdminFree && (
                  <button
                    type="button"
                    class="qris-pay-trigger inline-flex items-center gap-1.5 rounded-lg bg-amber-400/15 text-amber-300 border border-amber-400/30 hover:bg-amber-400/25 px-2.5 py-1.5 text-xs font-semibold transition-all cursor-pointer shadow-xs active:scale-95"
                    data-card-id={card.id}
                    data-card-title={card.category === 'wedding' ? card.recipient_name : `Untuk ${card.recipient_name}`}
                    data-duration-days={card.duration_days || 7}
                    title="Aktifkan atau perpanjang masa aktif kartu via QRIS"
                  >
                    <span>⚡</span>
                    <span>{isUnpaid ? 'Aktifkan' : 'Perpanjang'}</span>
                  </button>
                )}

                <!-- View Button -->
                <a
                  href={cardUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[
                    'card-view-link inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors',
                    isPublished && !isUnpaid
                      ? 'bg-surface-700 text-surface-200 hover:bg-surface-600 hover:text-white'
                      : 'bg-surface-800 text-surface-400 hover:bg-surface-700'
                  ]}
                  data-card-id={card.id}
                  title="Lihat"
                >
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                  </svg>
                  Lihat
                </a>

                <!-- Edit Button -->
                <a
                  href={`/dashboard/create?edit=${card.id}`}
                  class="inline-flex items-center gap-1 rounded-lg bg-surface-700 px-2.5 py-1.5 text-xs font-medium text-surface-200 transition-colors hover:bg-surface-600 hover:text-white"
                  title="Edit"
                >
                  <svg class="h-3.5 w-3.5 text-surface-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                  </svg>
                  Edit
                </a>

                <!-- Wishes CSV Export Button -->
                <a
                  href={`/api/cards/${card.id}/wishes-export`}
                  download={`ucapan-${card.slug}.csv`}
                  class="inline-flex items-center gap-1 rounded-lg bg-surface-700 px-2.5 py-1.5 text-xs font-medium text-amber-200 transition-colors hover:bg-surface-600 hover:text-white"
                  title="Unduh rekapan ucapan dan doa restu (CSV/Excel)"
                >
                  <svg class="h-3.5 w-3.5 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                  </svg>
                  <span>CSV</span>
                </a>

                <!-- Copy Link Button -->
                <button
                  type="button"
                  class="card-copy-btn inline-flex items-center gap-1 rounded-lg bg-surface-700 px-2.5 py-1.5 text-xs font-medium text-surface-200 transition-colors hover:bg-surface-600 hover:text-white cursor-pointer"
                  data-copy-url={`${Astro.url.origin}${cardUrl}`}
                  data-card-id={card.id}
                  title="Salin Tautan"
                >
                  <svg class="h-3.5 w-3.5 text-surface-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
                  </svg>
                  Salin
                </button>

                <!-- Delete Button -->
                <button
                  type="button"
                  class="delete-card-trigger inline-flex items-center gap-1 rounded-lg bg-surface-700/60 px-2 py-1.5 text-xs font-medium text-surface-400 transition-colors hover:bg-error/15 hover:text-error cursor-pointer ml-auto"
                  data-card-id={card.id}
                  data-recipient={card.recipient_name}
                  title="Hapus"
                >
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                  </svg>
                </button>

                <!-- Share Button (all categories) -->
                <button
                  type="button"
                  class:list={[
                    'share-card-trigger inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors cursor-pointer',
                    isPublished && !isUnpaid
                      ? 'bg-surface-700 text-surface-200 hover:bg-emerald-500/15 hover:text-emerald-400'
                      : 'bg-surface-800 text-surface-500 pointer-events-none opacity-50'
                  ]}
                  data-card-slug={card.slug}
                  data-card-recipient={card.recipient_name}
                  data-card-category={card.category}
                  data-card-id={card.id}
                  title="Bagikan"
                >
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
                  </svg>
                  Bagikan
                </button>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  )}
</DashboardLayout>

<script>
  // ── Copy Link ──────────────────────────────────────────
  document.querySelectorAll('[data-copy-url]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = (btn as HTMLElement).dataset.copyUrl;
      if (url) {
        await navigator.clipboard.writeText(url);
        (window as any).showToast({ message: 'Tautan Berhasil Disalin!', type: 'success', duration: 2000 });
      }
    });
  });

  // ── Status Toggle (Publish vs. Draft) ──────────────────
  document.querySelectorAll('.status-toggle-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const cardId = (btn as HTMLElement).dataset.cardId;
      const currentPublished = (btn as HTMLElement).dataset.published === 'true';
      const newPublished = !currentPublished;

      // Optimistic UI update
      applyStatusUI(btn as HTMLElement, newPublished);

      try {
        const res = await fetch(`/api/cards/${cardId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ is_published: newPublished }),
        });

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.error || 'Failed to update status');
        }

        const msg = newPublished ? '🎉 Kartu berhasil diterbitkan! Siapa pun yang memiliki tautan dapat melihat.' : 'Kartu disimpan sebagai draf.';
        (window as any).showToast({ message: msg, type: newPublished ? 'success' : 'info', duration: 2500 });
      } catch (err: any) {
        // Revert on error
        applyStatusUI(btn as HTMLElement, currentPublished);
        (window as any).showToast({ message: err.message || 'Gagal memperbarui status', type: 'error' });
      }
    });
  });

  function applyStatusUI(btn: HTMLElement, isPublished: boolean) {
    btn.dataset.published = isPublished ? 'true' : 'false';
    const dot = btn.querySelector('.status-dot');
    const text = btn.querySelector('.status-text');
    const cardId = btn.dataset.cardId;
    const viewLink = document.querySelector(`.card-view-link[data-card-id="${cardId}"]`) as HTMLAnchorElement | null;
    const shareBtn = document.querySelector(`.share-card-trigger[data-card-id="${cardId}"]`) as HTMLButtonElement | null;

    if (isPublished) {
      btn.className = 'status-toggle-btn inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold transition-all hover:scale-105 cursor-pointer border shadow-xs bg-success/20 text-emerald-300 border-success/30 hover:bg-success/30';
      if (dot) dot.className = 'status-dot h-1.5 w-1.5 rounded-full transition-colors bg-emerald-400 animate-pulse';
      if (text) text.textContent = 'Diterbitkan';

      if (viewLink) {
        viewLink.className = 'card-view-link inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors bg-surface-700 text-surface-200 hover:bg-surface-600 hover:text-white';
        viewLink.title = 'Lihat';
      }
      if (shareBtn) {
        shareBtn.className = 'share-card-trigger inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors cursor-pointer bg-surface-700 text-surface-200 hover:bg-emerald-500/15 hover:text-emerald-400';
        shareBtn.title = 'Bagikan';
      }
    } else {
      btn.className = 'status-toggle-btn inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold transition-all hover:scale-105 cursor-pointer border shadow-xs bg-surface-700/80 text-surface-400 border-white/10 hover:bg-surface-700';
      if (dot) dot.className = 'status-dot h-1.5 w-1.5 rounded-full transition-colors bg-surface-400';
      if (text) text.textContent = 'Draf';

      if (viewLink) {
        viewLink.className = 'card-view-link inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors bg-surface-800 text-surface-500 pointer-events-none opacity-50';
        viewLink.title = 'Lihat';
      }
      if (shareBtn) {
        shareBtn.className = 'share-card-trigger inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors cursor-pointer bg-surface-800 text-surface-500 pointer-events-none opacity-50';
        shareBtn.title = 'Bagikan';
      }
    }
  }

  // ── Delete Card with Modal Confirmation ────────────────
  const deleteModal = document.getElementById('delete-card-modal');
  const recipientNameEl = document.getElementById('delete-card-recipient-name');
  const confirmDeleteBtn = document.getElementById('confirm-delete-btn') as HTMLButtonElement | null;
  const deleteBtnText = document.getElementById('delete-btn-text');

  let activeCardIdToDelete: string | null = null;

  document.querySelectorAll('.delete-card-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cardId = (btn as HTMLElement).dataset.cardId || '';
      const recipient = (btn as HTMLElement).dataset.recipient || 'recipient';

      activeCardIdToDelete = cardId;
      if (recipientNameEl) recipientNameEl.textContent = recipient;

      if (deleteModal) {
        deleteModal.classList.remove('hidden');
        deleteModal.classList.add('flex');
      }
    });
  });

  confirmDeleteBtn?.addEventListener('click', async () => {
    if (!activeCardIdToDelete) return;

    confirmDeleteBtn.disabled = true;
    if (deleteBtnText) deleteBtnText.textContent = 'Menghapus...';

    try {
      const res = await fetch(`/api/cards/${activeCardIdToDelete}`, {
        method: 'DELETE',
      });

      if (!res.ok) {
        const errData = await res.json().catch(() => ({}));
        throw new Error(errData.error || 'Gagal menghapus kartu');
      }

      // Close modal
      if (deleteModal) {
        deleteModal.classList.add('hidden');
        deleteModal.classList.remove('flex');
      }

      // Remove card element from DOM with smooth animation
      const cardEl = document.getElementById(`card-item-${activeCardIdToDelete}`);
      if (cardEl) {
        cardEl.style.transition = 'all 0.3s ease-out';
        cardEl.style.opacity = '0';
        cardEl.style.transform = 'scale(0.95)';
        setTimeout(() => {
          cardEl.remove();

          // Check if grid is now empty
          const remainingCards = document.querySelectorAll('#cards-grid > div');
          const countLabel = document.getElementById('card-count-label');
          if (remainingCards.length === 0) {
            const grid = document.getElementById('cards-grid');
            if (grid) grid.remove();
            const emptyState = document.getElementById('empty-state');
            if (emptyState) emptyState.classList.remove('hidden');
            if (countLabel) countLabel.textContent = "Belum ada kartu yang dibuat";
          } else {
            if (countLabel) countLabel.textContent = `${remainingCards.length} kartu telah dibuat`;
          }
        }, 300);
      }

      (window as any).showToast({
        message: '🗑️ Kartu dan semua foto berhasil dihapus permanen.',
        type: 'success',
        duration: 3000,
      });
    } catch (err: any) {
      (window as any).showToast({ message: err.message || 'Gagal menghapus kartu', type: 'error' });
    } finally {
      confirmDeleteBtn.disabled = false;
      if (deleteBtnText) deleteBtnText.textContent = 'Ya, Hapus';
      activeCardIdToDelete = null;
    }
  });

  // ── Share Card Modal Logic ─────────────────────────────
  const shareModal = document.getElementById('share-card-modal');
  const shareModalTitle = document.getElementById('share-card-modal-title');
  const shareRecipientLabel = document.getElementById('share-recipient-label');
  const shareSalutationContainer = document.getElementById('share-salutation-container');
  const shareLinkLabel = document.getElementById('share-link-label');
  const shareGuestName = document.getElementById('share-guest-name') as HTMLInputElement | null;
  const shareSalutation = document.getElementById('share-salutation') as HTMLSelectElement | null;
  const sharePreviewLink = document.getElementById('share-preview-link');
  const shareWaPreview = document.getElementById('share-wa-preview');
  const shareCopyBtn = document.getElementById('share-copy-link-btn');
  const shareCopyText = document.getElementById('share-copy-text');
  const shareWaBtn = document.getElementById('share-wa-btn') as HTMLAnchorElement | null;

  let activeShareSlug = '';
  let activeShareCategory = '';

  function getShareUrl() {
    const name = shareGuestName?.value?.trim() || '';
    const base = `${window.location.origin}/c/${activeShareSlug}`;
    return name ? `${base}?to=${encodeURIComponent(name)}` : base;
  }

  function getWhatsAppMessage() {
    const name = shareGuestName?.value?.trim() || '';
    const salutation = shareSalutation?.value || 'Saudara/i';
    const url = getShareUrl();

    switch (activeShareCategory) {
      case 'wedding':
        if (name) {
          return `Kepada Yth. ${salutation} ${name},\n\nTanpa mengurangi rasa hormat, perkenankan kami mengundang Anda untuk hadir dan memberikan doa restu pada hari bahagia pernikahan kami.\n\nBuka Undangan Digital:\n${url}\n\nMerupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir. Terima kasih.`;
        }
        return `Tanpa mengurangi rasa hormat, perkenankan kami mengundang Anda untuk hadir dan memberikan doa restu pada hari bahagia pernikahan kami.\n\nBuka Undangan Digital:\n${url}\n\nTerima kasih.`;

      case 'invitation':
        if (name) {
          return `Kepada Yth. ${name},\n\nKami mengundang Anda untuk hadir dan memeriahkan acara kami.\n\nBuka Undangan:\n${url}\n\nTerima kasih dan sampai jumpa!`;
        }
        return `Kami mengundang Anda untuk hadir dan memeriahkan acara kami.\n\nBuka Undangan:\n${url}\n\nTerima kasih!`;

      case 'birthday':
        if (name) {
          return `Selamat Ulang Tahun, ${name}! 🎉✨\nAda kartu ucapan dan kejutan spesial yang telah disiapkan untukmu:\n${url}`;
        }
        return `Selamat Ulang Tahun! 🎉✨\nAda kartu ucapan dan kejutan spesial yang telah disiapkan untukmu:\n${url}`;

      case 'anniversary':
        if (name) {
          return `Happy Anniversary, ${name}! ❤️✨\nSebuah kartu kenangan dan ungkapan kasih spesial telah disiapkan untukmu:\n${url}`;
        }
        return `Happy Anniversary! ❤️✨\nSebuah kartu kenangan dan ungkapan kasih spesial telah disiapkan untukmu:\n${url}`;

      case 'graduation':
        if (name) {
          return `Selamat atas kelulusanmu, ${name}! 🎓🌟\nSemoga langkah ke depan senantiasa sukses. Buka kartu ucapan apresiasi di sini:\n${url}`;
        }
        return `Selamat atas kelulusanmu! 🎓🌟\nSemoga sukses selalu. Buka kartu ucapan apresiasi di sini:\n${url}`;

      case 'love':
        if (name) {
          return `Hai ${name}, ada pesan dan ungkapan tulus khusus untukmu 💌\nBuka di sini:\n${url}`;
        }
        return `Hai, ada pesan dan ungkapan tulus khusus untukmu 💌\nBuka di sini:\n${url}`;

      case 'greetings':
        if (name) {
          return `Salam hangat dan doa terbaik untuk ${name} beserta keluarga tercinta.\nBuka kartu ucapan di sini:\n${url}`;
        }
        return `Salam hangat dan doa terbaik untuk keluarga tercinta.\nBuka kartu ucapan di sini:\n${url}`;

      default:
        if (name) {
          return `Halo ${name}, ada kartu ucapan spesial untukmu:\n${url}`;
        }
        return `Ada kartu ucapan spesial untukmu:\n${url}`;
    }
  }

  function updateSharePreview() {
    const url = getShareUrl();
    const waMsg = getWhatsAppMessage();
    if (sharePreviewLink) sharePreviewLink.textContent = url;
    if (shareWaPreview) shareWaPreview.textContent = waMsg;
    if (shareWaBtn) {
      shareWaBtn.href = `https://api.whatsapp.com/send?text=${encodeURIComponent(waMsg)}`;
    }
  }

  // Open share modal
  document.querySelectorAll('.share-card-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetBtn = btn as HTMLElement;
      activeShareSlug = targetBtn.dataset.cardSlug || '';
      activeShareCategory = targetBtn.dataset.cardCategory || '';
      const cardRecipient = targetBtn.dataset.cardRecipient || '';

      const isInvitationCategory = activeShareCategory === 'wedding' || activeShareCategory === 'invitation';

      // Update Modal Title
      if (shareModalTitle) {
        shareModalTitle.textContent = isInvitationCategory ? 'Bagikan Undangan' : 'Bagikan Kartu Ucapan';
      }

      // Update Recipient Input Label & Salutation Visibility
      if (shareRecipientLabel) {
        shareRecipientLabel.textContent = isInvitationCategory ? 'Nama Tamu' : 'Nama Penerima';
      }

      if (shareSalutationContainer) {
        if (isInvitationCategory) {
          shareSalutationContainer.classList.remove('hidden');
        } else {
          shareSalutationContainer.classList.add('hidden');
        }
      }

      if (shareLinkLabel) {
        shareLinkLabel.textContent = isInvitationCategory ? 'Tautan Undangan' : 'Tautan Kartu';
      }

      // Input placeholder & prefill
      if (shareGuestName) {
        if (isInvitationCategory) {
          shareGuestName.placeholder = 'Budi Santoso';
          shareGuestName.value = '';
        } else {
          shareGuestName.placeholder = 'Nama penerima...';
          shareGuestName.value = cardRecipient;
        }
      }

      updateSharePreview();

      if (shareModal) {
        shareModal.classList.remove('hidden');
        shareModal.classList.add('flex');
      }
    });
  });

  // Update preview on input change
  shareGuestName?.addEventListener('input', updateSharePreview);
  shareSalutation?.addEventListener('change', updateSharePreview);

  // Copy link button
  shareCopyBtn?.addEventListener('click', async () => {
    const url = getShareUrl();
    try {
      await navigator.clipboard.writeText(url);
      if (shareCopyText) {
        shareCopyText.textContent = 'Tersalin! ✅';
        setTimeout(() => { if (shareCopyText) shareCopyText.textContent = 'Salin Tautan'; }, 2000);
      }
      (window as any).showToast({ message: 'Tautan Berhasil Disalin!', type: 'success', duration: 2000 });
    } catch {
      (window as any).showToast({ message: 'Gagal menyalin tautan', type: 'error' });
    }
  });

  // ── QRIS Checkout & Modal Flow ─────────────────────────
  const qrisModal = document.getElementById('qris-modal');
  const qrisCardTitle = document.getElementById('qris-card-title');
  const qrisTierBadge = document.getElementById('qris-tier-badge');
  const qrisOrderId = document.getElementById('qris-order-id');
  const qrisCountdown = document.getElementById('qris-countdown');
  const qrisQrContainer = document.getElementById('qris-qr-container');
  const qrisAmountDisplay = document.getElementById('qris-amount-display');
  const qrisStatusText = document.getElementById('qris-status-text');
  const qrisSimulateBtn = document.getElementById('qris-simulate-btn');
  const qrisSimContainer = document.getElementById('qris-sim-container');

  let activeQrisCardId: string | null = null;
  let activeQrisTitle = '';
  let currentOrderId: string | null = null;
  let qrisPollInterval: any = null;
  let qrisTimerInterval: any = null;

  async function startQrisCheckout(cardId: string, cardTitle: string, durationDays: number) {
    activeQrisCardId = cardId;
    activeQrisTitle = cardTitle;

    if (qrisCardTitle) qrisCardTitle.textContent = cardTitle;
    if (qrisTierBadge) qrisTierBadge.textContent = `Paket ${durationDays} Hari`;
    if (qrisQrContainer) {
      qrisQrContainer.innerHTML = '<div class="animate-pulse text-xs text-slate-500 font-medium py-16">Membuat Kode QRIS...</div>';
    }
    if (qrisStatusText) qrisStatusText.textContent = 'Menyiapkan transaksi QRIS...';

    // Highlight selected tier button in modal
    document.querySelectorAll('.modal-duration-tier-btn').forEach((btn) => {
      const b = btn as HTMLElement;
      const days = Number(b.dataset.days);
      if (days === durationDays) {
        b.className = 'modal-duration-tier-btn p-2 rounded-xl border text-left transition-all cursor-pointer border-amber-400/60 bg-amber-500/10 ring-1 ring-amber-400/30';
      } else {
        b.className = 'modal-duration-tier-btn p-2 rounded-xl border text-left transition-all cursor-pointer border-white/10 bg-surface-800/40 hover:border-white/20';
      }
    });

    if (qrisModal) {
      qrisModal.classList.remove('hidden');
      qrisModal.classList.add('flex');
    }

    try {
      const res = await fetch('/api/payments/create-qris', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ cardId, durationDays }),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({ error: 'Gagal membuat QRIS' }));
        throw new Error(err.error || 'Gagal membuat QRIS');
      }

      const data = await res.json();
      currentOrderId = data.orderId;

      if (qrisOrderId) qrisOrderId.textContent = data.orderId;
      if (qrisAmountDisplay) {
        qrisAmountDisplay.textContent = new Intl.NumberFormat('id-ID', {
          style: 'currency',
          currency: 'IDR',
          minimumFractionDigits: 0,
        }).format(data.amount);
      }
      if (qrisTierBadge) qrisTierBadge.textContent = data.tierName || `Paket ${durationDays} Hari`;
      if (qrisQrContainer && data.qrSvg) {
        qrisQrContainer.innerHTML = `
          <div class="w-full flex flex-col items-center select-none text-slate-900">
            <!-- Header with QRIS Badge and Merchant Name -->
            <div class="w-full flex items-center justify-between pb-1.5 border-b border-slate-200">
              <span class="inline-block bg-[#D32F2F] text-white font-black text-[11px] tracking-wider px-2 py-0.5 rounded shadow-xs">
                QRIS
              </span>
              <span class="text-[10px] font-bold text-slate-800 tracking-tight text-right uppercase">
                ELCELEBRATE DIGITAL
              </span>
            </div>
            <!-- Matrix SVG -->
            <div class="w-48 h-48 my-1 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full">
              ${data.qrSvg}
            </div>
            <!-- Footer with NMID and Payment Partner Labels -->
            <div class="w-full pt-1.5 border-t border-dashed border-slate-200 text-center flex flex-col gap-0.5">
              <div class="font-mono text-[9px] font-bold text-slate-600 tracking-wider">
                NMID: ID1020021000001
              </div>
              <div class="text-[8px] text-slate-500 font-medium leading-tight">
                SATU QRIS UNTUK SEMUA PEMBAYARAN
              </div>
              <div class="text-[8px] text-slate-400 font-normal">
                BCA • Mandiri • BRI • BNI • GoPay • OVO • DANA • ShopeePay
              </div>
            </div>
          </div>
        `;
      }
      if (qrisStatusText) {
        qrisStatusText.textContent = 'Menunggu pembayaran via aplikasi perbankan / e-wallet...';
      }

      if (qrisSimContainer) {
        if (data.isSimulation) {
          qrisSimContainer.classList.remove('hidden');
        } else {
          qrisSimContainer.classList.add('hidden');
        }
      }

      // Start 15-minute countdown
      clearInterval(qrisTimerInterval);
      let timeLeft = 15 * 60;
      qrisTimerInterval = setInterval(() => {
        timeLeft--;
        if (timeLeft <= 0) {
          clearInterval(qrisTimerInterval);
          if (qrisCountdown) qrisCountdown.textContent = '00:00 (Kedaluwarsa)';
          if (qrisStatusText) qrisStatusText.textContent = 'Waktu pembayaran berakhir. Silakan pilih paket kembali.';
          return;
        }
        const m = String(Math.floor(timeLeft / 60)).padStart(2, '0');
        const s = String(timeLeft % 60).padStart(2, '0');
        if (qrisCountdown) qrisCountdown.textContent = `${m}:${s}`;
      }, 1000);

      // Start polling for payment settlement
      clearInterval(qrisPollInterval);
      qrisPollInterval = setInterval(async () => {
        if (!currentOrderId) return;
        try {
          const pollRes = await fetch(`/api/payments/status?order_id=${currentOrderId}`);
          if (pollRes.ok) {
            const statusData = await pollRes.json();
            if (statusData.status === 'settled') {
              clearInterval(qrisPollInterval);
              clearInterval(qrisTimerInterval);
              if (qrisStatusText) qrisStatusText.textContent = '✅ Pembayaran Berhasil! Mengaktifkan kartu...';
              (window as any).showToast({ message: '🎉 Pembayaran berhasil diverifikasi!', type: 'success' });
              setTimeout(() => {
                window.location.href = '/dashboard';
              }, 1200);
            }
          }
        } catch {
          // Ignore network poll glitch
        }
      }, 3000);

    } catch (err: any) {
      (window as any).showToast({ message: err.message || 'Gagal memproses QRIS', type: 'error' });
      if (qrisQrContainer) {
        qrisQrContainer.innerHTML = '<div class="text-xs text-rose-500 font-medium text-center px-4 py-16 flex flex-col items-center gap-2"><span>⚠️</span><span>Gagal memuat QRIS. Silakan coba kembali.</span></div>';
      }
    }
  }

  // Duration Tier change in modal
  document.querySelectorAll('.modal-duration-tier-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const days = Number((btn as HTMLElement).dataset.days);
      if (activeQrisCardId && days) {
        startQrisCheckout(activeQrisCardId, activeQrisTitle, days);
      }
    });
  });

  // Open QRIS from card actions
  document.querySelectorAll('.qris-pay-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cardId = (btn as HTMLElement).dataset.cardId || '';
      const cardTitle = (btn as HTMLElement).dataset.cardTitle || 'Undangan Anda';
      const durationDays = Number((btn as HTMLElement).dataset.durationDays) || 7;
      startQrisCheckout(cardId, cardTitle, durationDays);
    });
  });

  // Simulation settlement button (Test mode)
  qrisSimulateBtn?.addEventListener('click', async () => {
    if (!currentOrderId) return;
    qrisSimulateBtn.setAttribute('disabled', 'true');
    qrisSimulateBtn.textContent = 'Memverifikasi Pembayaran...';

    try {
      const res = await fetch('/api/payments/webhook', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ order_id: currentOrderId, simulated: true }),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({ error: 'Gagal simulasi' }));
        throw new Error(err.error || 'Gagal simulasi pembayaran');
      }

      clearInterval(qrisPollInterval);
      clearInterval(qrisTimerInterval);
      (window as any).showToast({ message: '⚡ Pembayaran simulasi berhasil! Kartu telah aktif.', type: 'success' });
      setTimeout(() => {
        window.location.href = '/dashboard';
      }, 1000);
    } catch (err: any) {
      qrisSimulateBtn.removeAttribute('disabled');
      qrisSimulateBtn.textContent = '⚡ Simulasikan Pembayaran Berhasil (Test Mode)';
      (window as any).showToast({ message: err.message || 'Gagal simulasi pembayaran', type: 'error' });
    }
  });

  // Check URL query param ?pay=<cardId> on load
  const urlParams = new URLSearchParams(window.location.search);
  const payCardId = urlParams.get('pay');
  if (payCardId) {
    const cardEl = document.getElementById(`card-item-${payCardId}`);
    const payTrigger = cardEl?.querySelector('.qris-pay-trigger') as HTMLElement | null;
    const cardTitle = payTrigger?.dataset.cardTitle || cardEl?.querySelector('h3')?.textContent || 'Undangan Anda';
    const savedDays = Number(payTrigger?.dataset.durationDays) || 7;
    startQrisCheckout(payCardId, cardTitle, savedDays);
  }

  // ── Multi-Admin RBAC Modal Flow ─────────────────────────
  const adminModal = document.getElementById('admin-roles-modal');
  const adminManageBtn = document.getElementById('admin-manage-btn');
  const adminRefreshBtn = document.getElementById('admin-refresh-users-btn');
  const adminSubmitBtn = document.getElementById('admin-role-submit-btn');
  const adminEmailInput = document.getElementById('admin-role-email') as HTMLInputElement | null;
  const adminRoleSelect = document.getElementById('admin-role-select') as HTMLSelectElement | null;
  const adminUsersList = document.getElementById('admin-users-list');

  async function loadAdminUsers() {
    if (!adminUsersList) return;
    adminUsersList.innerHTML = '<div class="p-4 text-center text-xs text-surface-400 animate-pulse">Memuat data pengguna...</div>';

    try {
      const res = await fetch('/api/admin/roles');
      if (!res.ok) throw new Error('Gagal memuat pengguna');
      const data = await res.json();
      const users: any[] = data.users || [];

      if (adminRoleSelect) {
        const superAdminOption = adminRoleSelect.querySelector('option[value="super_admin"]') as HTMLOptionElement | null;
        if (superAdminOption) {
          superAdminOption.hidden = !data.callerIsRoot;
          superAdminOption.disabled = !data.callerIsRoot;
        }
      }

      if (users.length === 0) {
        adminUsersList.innerHTML = '<div class="p-4 text-center text-xs text-surface-400">Tidak ada pengguna ditemukan.</div>';
        return;
      }

      adminUsersList.innerHTML = users
        .map((u) => {
          let badgeClass = 'bg-surface-800 text-surface-400 border border-white/10';
          let badgeText = 'Pengguna';

          if (u.isRootOwner) {
            badgeClass = 'bg-amber-400/25 text-amber-200 border border-amber-400/50 font-bold';
            badgeText = '👑 Pemilik Utama (Terkunci)';
          } else if (u.role === 'super_admin') {
            badgeClass = 'bg-purple-500/20 text-purple-300 border border-purple-500/30 font-semibold';
            badgeText = '⭐ Super Admin';
          } else if (u.role === 'admin') {
            badgeClass = 'bg-amber-400/20 text-amber-300 border border-amber-400/30 font-semibold';
            badgeText = '👑 Admin Mitra';
          }

          const isClickable = !u.isRootOwner;
          return `
            <div class="p-3 flex items-center justify-between gap-3 text-xs ${isClickable ? 'cursor-pointer hover:bg-white/5 transition-colors' : 'opacity-90'}" ${isClickable ? `onclick="if(document.getElementById('admin-role-email')){document.getElementById('admin-role-email').value='${u.email}'; if(document.getElementById('admin-role-select')){document.getElementById('admin-role-select').value='${u.role}';}}"` : ''}>
              <div class="min-w-0">
                <div class="font-medium text-white truncate flex items-center gap-1.5">
                  <span>${u.full_name || 'Tanpa Nama'}</span>
                  ${u.isRootOwner ? '<span class="text-[10px] text-amber-400" title="Akun Terkunci">🔒</span>' : ''}
                </div>
                <div class="text-[11px] text-surface-400 truncate">${u.email}</div>
              </div>
              <div class="shrink-0 flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] ${badgeClass}">
                  ${badgeText}
                </span>
              </div>
            </div>
          `;
        })
        .join('');
    } catch {
      adminUsersList.innerHTML = '<div class="p-4 text-center text-xs text-rose-400">Gagal memuat data pengguna.</div>';
    }
  }

  adminManageBtn?.addEventListener('click', () => {
    if (adminModal) {
      adminModal.classList.remove('hidden');
      adminModal.classList.add('flex');
      loadAdminUsers();
    }
  });

  adminRefreshBtn?.addEventListener('click', () => {
    loadAdminUsers();
  });

  adminSubmitBtn?.addEventListener('click', async () => {
    const email = adminEmailInput?.value?.trim();
    const role = adminRoleSelect?.value;

    if (!email) {
      (window as any).showToast({ message: 'Masukkan email pengguna', type: 'error' });
      return;
    }

    if (email.toLowerCase() === 'lesynugraha@gmail.com') {
      (window as any).showToast({ message: 'Role Pemilik Utama (lesynugraha@gmail.com) terkunci permanen.', type: 'error' });
      return;
    }

    try {
      const res = await fetch('/api/admin/roles', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, role }),
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || 'Gagal mengubah peran pengguna');
      }

      (window as any).showToast({ message: data.message || 'Peran berhasil diperbarui!', type: 'success' });
      if (adminEmailInput) adminEmailInput.value = '';
      loadAdminUsers();
    } catch (err: any) {
      (window as any).showToast({ message: err.message || 'Gagal mengubah peran', type: 'error' });
    }
  });
</script>

