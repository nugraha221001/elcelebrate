---
import DashboardLayout from '../../components/layout/DashboardLayout.astro';
import Button from '../../components/ui/Button.astro';
import Modal from '../../components/ui/Modal.astro';
import Toast from '../../components/ui/Toast.astro';
import { CATEGORY_META } from '../../lib/types';
import type { Card } from '../../lib/types';

export const prerender = false;

// Auth guard — must run before any HTML is emitted
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

const supabase = Astro.locals.supabase;

// Fetch user's cards
let cards: Card[] = [];
const { data } = await supabase
  .from('cards')
  .select('*')
  .eq('user_id', user.id)
  .order('created_at', { ascending: false });
cards = data || [];
---

<DashboardLayout title="My Cards">
  <Toast />

  <!-- Delete Card Confirmation Modal -->
  <Modal id="delete-card-modal" title="Delete Celebration Card" size="sm">
    <div class="space-y-4">
      <p class="text-sm text-surface-300 leading-relaxed">
        Are you sure you want to delete this card for <strong id="delete-card-recipient-name" class="text-white"></strong>? This will also remove all photos and guestbook wishes permanently.
      </p>
      <div class="flex items-center justify-end gap-3 pt-2">
        <button
          type="button"
          data-modal-close="delete-card-modal"
          class="rounded-xl px-4 py-2 text-xs font-medium text-surface-300 hover:bg-white/5 hover:text-white transition-colors cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="button"
          id="confirm-delete-btn"
          class="inline-flex items-center gap-2 rounded-xl bg-error px-4 py-2 text-xs font-semibold text-white shadow-lg shadow-error/25 hover:brightness-110 active:scale-[0.97] transition-all cursor-pointer"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
          </svg>
          <span id="delete-btn-text">Delete Permanently</span>
        </button>
      </div>
    </div>
  </Modal>

  <!-- Share / WhatsApp Modal -->
  <Modal id="share-card-modal" title="Bagikan Undangan" size="md">
    <div class="space-y-4">
      <div>
        <label class="block text-xs font-medium text-surface-400 mb-1.5">Nama Tamu</label>
        <input
          type="text"
          id="share-guest-name"
          placeholder="Budi Santoso"
          class="form-input w-full rounded-xl bg-white/5 px-4 py-2.5 text-sm focus-ring"
        />
      </div>
      <div>
        <label class="block text-xs font-medium text-surface-400 mb-1.5">Sapaan</label>
        <select
          id="share-salutation"
          class="form-input w-full rounded-xl bg-white/5 px-4 py-2.5 text-sm focus-ring appearance-none"
        >
          <option value="Bapak">Bapak</option>
          <option value="Ibu">Ibu</option>
          <option value="Saudara/i" selected>Saudara/i</option>
          <option value="Teman">Teman</option>
        </select>
      </div>

      <!-- Preview Link -->
      <div>
        <label class="block text-xs font-medium text-surface-400 mb-1.5">Tautan Undangan</label>
        <div class="flex items-center gap-2 rounded-xl bg-white/5 border border-white/10 px-3 py-2.5">
          <svg class="h-4 w-4 text-surface-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m9.86-4.122a4.5 4.5 0 00-1.242-7.244l-4.5-4.5a4.5 4.5 0 10-6.364 6.364l1.757 1.757" />
          </svg>
          <span id="share-preview-link" class="text-xs text-surface-200 truncate select-all">—</span>
        </div>
      </div>

      <!-- WhatsApp Message Preview -->
      <div>
        <label class="block text-xs font-medium text-surface-400 mb-1.5">Pesan WhatsApp</label>
        <div class="rounded-xl bg-white/5 border border-white/10 px-3 py-2.5">
          <p id="share-wa-preview" class="text-xs text-surface-300 leading-relaxed whitespace-pre-wrap">—</p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3 pt-2">
        <button
          type="button"
          id="share-copy-link-btn"
          class="flex-1 inline-flex items-center justify-center gap-2 rounded-xl bg-surface-700 px-4 py-2.5 text-xs font-semibold text-surface-200 transition-all hover:bg-surface-600 hover:text-white cursor-pointer"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
          </svg>
          <span id="share-copy-text">Salin Tautan</span>
        </button>
        <a
          id="share-wa-btn"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 inline-flex items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-xs font-semibold text-white transition-all hover:brightness-110 cursor-pointer"
          style="background: #25D366;"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          <span>Kirim WhatsApp</span>
        </a>
      </div>
    </div>
  </Modal>

  <!-- Header -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-surface-50">My Cards</h1>
      <p class="mt-1 text-sm text-surface-400" id="card-count-label">
        {cards.length === 0
          ? "You haven't created any cards yet"
          : `${cards.length} card${cards.length === 1 ? '' : 's'} created`}
      </p>
    </div>
    <Button href="/dashboard/create" variant="primary" size="md" id="dashboard-create-btn">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      New Card
    </Button>
  </div>

  <!-- Empty State Container -->
  <div id="empty-state" class:list={['mt-16 flex flex-col items-center justify-center text-center', cards.length === 0 ? '' : 'hidden']}>
    <div class="mb-6 flex gap-3">
      <span class="animate-float text-5xl" style="animation-delay: 0s">🎂</span>
      <span class="animate-float text-5xl" style="animation-delay: 0.3s">🎉</span>
      <span class="animate-float text-5xl" style="animation-delay: 0.6s">✨</span>
    </div>
    <h2 class="text-xl font-semibold text-surface-200">Create your first card</h2>
    <p class="mt-2 max-w-sm text-sm text-surface-400">
      Design a beautiful digital greeting card with photos, music, and animations — all for free.
    </p>
    <div class="mt-8">
      <Button href="/dashboard/create" variant="primary" size="lg" id="empty-state-cta">
        Start Creating
      </Button>
    </div>
  </div>

  <!-- Card Grid -->
  {cards.length > 0 && (
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="cards-grid">
      {cards.map((card, i) => {
        const meta = CATEGORY_META[card.category as keyof typeof CATEGORY_META];
        const cardUrl = `/c/${card.slug}`;
        const isPublished = Boolean(card.is_published);
        return (
          <div
            id={`card-item-${card.id}`}
            class="group relative overflow-hidden rounded-2xl bg-surface-900/60 backdrop-blur-md border border-white/8 transition-all duration-300 hover:shadow-elevated hover:-translate-y-1 hover:border-purple-500/30"
            style={`animation: fade-in-up 0.5s var(--ease-smooth) forwards; animation-delay: ${i * 80}ms; opacity: 0;`}
          >
            <!-- Card header with gradient -->
            <div
              class="h-28 bg-linear-to-br p-4 relative"
              style={`background: linear-gradient(135deg, ${card.theme_config.primaryColor || '#c084fc'}40, ${card.theme_config.secondaryColor || '#f472b6'}30);`}
            >
              <div class="flex items-start justify-between">
                <span class="text-3xl">{meta?.emoji || '🎉'}</span>

                <!-- Interactive Status Toggle Badge -->
                <button
                  type="button"
                  class:list={[
                    'status-toggle-btn inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold transition-all hover:scale-105 cursor-pointer border shadow-xs',
                    isPublished
                      ? 'bg-success/20 text-emerald-300 border-success/30 hover:bg-success/30'
                      : 'bg-surface-700/80 text-surface-400 border-white/10 hover:bg-surface-700'
                  ]}
                  data-card-id={card.id}
                  data-published={isPublished ? 'true' : 'false'}
                  title="Click to toggle Published / Draft"
                >
                  <span
                    class:list={[
                      'status-dot h-1.5 w-1.5 rounded-full transition-colors',
                      isPublished ? 'bg-emerald-400 animate-pulse' : 'bg-surface-400'
                    ]}
                  ></span>
                  <span class="status-text">{isPublished ? 'Published' : 'Draft'}</span>
                </button>
              </div>
            </div>

            <div class="p-5">
              <h3 class="text-base font-semibold text-surface-100 truncate">
                For {card.recipient_name}
              </h3>
              <p class="mt-1 text-sm text-surface-400">
                {meta?.label || card.category}
                {card.event_date && (
                  <span> · {new Date(card.event_date).toLocaleDateString()}</span>
                )}
              </p>

              <!-- Actions Toolbar -->
              <div class="mt-5 flex flex-wrap items-center gap-1.5 pt-3 border-t border-white/5">
                <!-- View Button -->
                <a
                  href={cardUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[
                    'card-view-link inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors',
                    isPublished
                      ? 'bg-surface-700 text-surface-200 hover:bg-surface-600 hover:text-white'
                      : 'bg-surface-800 text-surface-500 pointer-events-none opacity-50'
                  ]}
                  data-card-id={card.id}
                  title={isPublished ? 'View public card' : 'Unpublished (Draft)'}
                >
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                  </svg>
                  View
                </a>

                <!-- Edit Button -->
                <a
                  href={`/dashboard/create?edit=${card.id}`}
                  class="inline-flex items-center gap-1 rounded-lg bg-surface-700 px-2.5 py-1.5 text-xs font-medium text-surface-200 transition-colors hover:bg-surface-600 hover:text-white"
                  title="Edit celebration card"
                >
                  <svg class="h-3.5 w-3.5 text-surface-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                  </svg>
                  Edit
                </a>

                <!-- Copy Link Button -->
                <button
                  type="button"
                  class="card-copy-btn inline-flex items-center gap-1 rounded-lg bg-surface-700 px-2.5 py-1.5 text-xs font-medium text-surface-200 transition-colors hover:bg-surface-600 hover:text-white cursor-pointer"
                  data-copy-url={`${Astro.url.origin}${cardUrl}`}
                  data-card-id={card.id}
                  title="Copy card share link"
                >
                  <svg class="h-3.5 w-3.5 text-surface-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
                  </svg>
                  Copy
                </button>

                <!-- Delete Button -->
                <button
                  type="button"
                  class="delete-card-trigger inline-flex items-center gap-1 rounded-lg bg-surface-700/60 px-2 py-1.5 text-xs font-medium text-surface-400 transition-colors hover:bg-error/15 hover:text-error cursor-pointer ml-auto"
                  data-card-id={card.id}
                  data-recipient={card.recipient_name}
                  title="Delete card permanently"
                >
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                  </svg>
                </button>

                <!-- Share Button (wedding cards only) -->
                {card.category === 'wedding' && isPublished && (
                  <button
                    type="button"
                    class="share-card-trigger inline-flex items-center gap-1 rounded-lg bg-surface-700 px-2.5 py-1.5 text-xs font-medium text-surface-200 transition-colors hover:bg-emerald-500/15 hover:text-emerald-400 cursor-pointer"
                    data-card-slug={card.slug}
                    data-card-recipient={card.recipient_name}
                    title="Bagikan undangan"
                  >
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
                    </svg>
                    Share
                  </button>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  )}
</DashboardLayout>

<script>
  // ── Copy Link ──────────────────────────────────────────
  document.querySelectorAll('[data-copy-url]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = (btn as HTMLElement).dataset.copyUrl;
      if (url) {
        await navigator.clipboard.writeText(url);
        (window as any).showToast({ message: 'Link copied to clipboard!', type: 'success', duration: 2000 });
      }
    });
  });

  // ── Status Toggle (Publish vs. Draft) ──────────────────
  document.querySelectorAll('.status-toggle-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const cardId = (btn as HTMLElement).dataset.cardId;
      const currentPublished = (btn as HTMLElement).dataset.published === 'true';
      const newPublished = !currentPublished;

      // Optimistic UI update
      applyStatusUI(btn as HTMLElement, newPublished);

      try {
        const res = await fetch(`/api/cards/${cardId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ is_published: newPublished }),
        });

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.error || 'Failed to update status');
        }

        const msg = newPublished ? '🎉 Card published! Anyone with link can view.' : 'Card saved to drafts (unlisted).';
        (window as any).showToast({ message: msg, type: newPublished ? 'success' : 'info', duration: 2500 });
      } catch (err: any) {
        // Revert on error
        applyStatusUI(btn as HTMLElement, currentPublished);
        (window as any).showToast({ message: err.message || 'Failed to update status', type: 'error' });
      }
    });
  });

  function applyStatusUI(btn: HTMLElement, isPublished: boolean) {
    btn.dataset.published = isPublished ? 'true' : 'false';
    const dot = btn.querySelector('.status-dot');
    const text = btn.querySelector('.status-text');
    const cardId = btn.dataset.cardId;
    const viewLink = document.querySelector(`.card-view-link[data-card-id="${cardId}"]`) as HTMLAnchorElement | null;

    if (isPublished) {
      btn.className = 'status-toggle-btn inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold transition-all hover:scale-105 cursor-pointer border shadow-xs bg-success/20 text-emerald-300 border-success/30 hover:bg-success/30';
      if (dot) dot.className = 'status-dot h-1.5 w-1.5 rounded-full transition-colors bg-emerald-400 animate-pulse';
      if (text) text.textContent = 'Published';

      if (viewLink) {
        viewLink.className = 'card-view-link inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors bg-surface-700 text-surface-200 hover:bg-surface-600 hover:text-white';
        viewLink.title = 'View public card';
      }
    } else {
      btn.className = 'status-toggle-btn inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold transition-all hover:scale-105 cursor-pointer border shadow-xs bg-surface-700/80 text-surface-400 border-white/10 hover:bg-surface-700';
      if (dot) dot.className = 'status-dot h-1.5 w-1.5 rounded-full transition-colors bg-surface-400';
      if (text) text.textContent = 'Draft';

      if (viewLink) {
        viewLink.className = 'card-view-link inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors bg-surface-800 text-surface-500 pointer-events-none opacity-50';
        viewLink.title = 'Unpublished (Draft)';
      }
    }
  }

  // ── Delete Card with Modal Confirmation ────────────────
  const deleteModal = document.getElementById('delete-card-modal');
  const recipientNameEl = document.getElementById('delete-card-recipient-name');
  const confirmDeleteBtn = document.getElementById('confirm-delete-btn') as HTMLButtonElement | null;
  const deleteBtnText = document.getElementById('delete-btn-text');

  let activeCardIdToDelete: string | null = null;

  document.querySelectorAll('.delete-card-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cardId = (btn as HTMLElement).dataset.cardId || '';
      const recipient = (btn as HTMLElement).dataset.recipient || 'recipient';

      activeCardIdToDelete = cardId;
      if (recipientNameEl) recipientNameEl.textContent = recipient;

      if (deleteModal) {
        deleteModal.classList.remove('hidden');
        deleteModal.classList.add('flex');
      }
    });
  });

  confirmDeleteBtn?.addEventListener('click', async () => {
    if (!activeCardIdToDelete) return;

    confirmDeleteBtn.disabled = true;
    if (deleteBtnText) deleteBtnText.textContent = 'Deleting assets...';

    try {
      const res = await fetch(`/api/cards/${activeCardIdToDelete}`, {
        method: 'DELETE',
      });

      if (!res.ok) {
        const errData = await res.json().catch(() => ({}));
        throw new Error(errData.error || 'Failed to delete card');
      }

      // Close modal
      if (deleteModal) {
        deleteModal.classList.add('hidden');
        deleteModal.classList.remove('flex');
      }

      // Remove card element from DOM with smooth animation
      const cardEl = document.getElementById(`card-item-${activeCardIdToDelete}`);
      if (cardEl) {
        cardEl.style.transition = 'all 0.3s ease-out';
        cardEl.style.opacity = '0';
        cardEl.style.transform = 'scale(0.95)';
        setTimeout(() => {
          cardEl.remove();

          // Check if grid is now empty
          const remainingCards = document.querySelectorAll('#cards-grid > div');
          const countLabel = document.getElementById('card-count-label');
          if (remainingCards.length === 0) {
            const grid = document.getElementById('cards-grid');
            if (grid) grid.remove();
            const emptyState = document.getElementById('empty-state');
            if (emptyState) emptyState.classList.remove('hidden');
            if (countLabel) countLabel.textContent = "You haven't created any cards yet";
          } else {
            if (countLabel) countLabel.textContent = `${remainingCards.length} card${remainingCards.length === 1 ? '' : 's'} created`;
          }
        }, 300);
      }

      (window as any).showToast({
        message: '🗑️ Card and all photos deleted permanently.',
        type: 'success',
        duration: 3000,
      });
    } catch (err: any) {
      (window as any).showToast({ message: err.message || 'Failed to delete card', type: 'error' });
    } finally {
      confirmDeleteBtn.disabled = false;
      if (deleteBtnText) deleteBtnText.textContent = 'Delete Permanently';
      activeCardIdToDelete = null;
    }
  });

  // ── Share Card Modal Logic ─────────────────────────────
  const shareModal = document.getElementById('share-card-modal');
  const shareGuestName = document.getElementById('share-guest-name') as HTMLInputElement | null;
  const shareSalutation = document.getElementById('share-salutation') as HTMLSelectElement | null;
  const sharePreviewLink = document.getElementById('share-preview-link');
  const shareWaPreview = document.getElementById('share-wa-preview');
  const shareCopyBtn = document.getElementById('share-copy-link-btn');
  const shareCopyText = document.getElementById('share-copy-text');
  const shareWaBtn = document.getElementById('share-wa-btn') as HTMLAnchorElement | null;

  let activeShareSlug = '';

  function getShareUrl() {
    const name = shareGuestName?.value?.trim() || '';
    const base = `${window.location.origin}/c/${activeShareSlug}`;
    return name ? `${base}?to=${encodeURIComponent(name)}` : base;
  }

  function getWhatsAppMessage() {
    const name = shareGuestName?.value?.trim() || '';
    const salutation = shareSalutation?.value || 'Saudara/i';
    const url = getShareUrl();
    if (name) {
      return `Halo ${salutation} ${name}, kami mengundang Anda ke pernikahan kami. Buka undangan di: ${url}`;
    }
    return `Kami mengundang Anda ke pernikahan kami. Buka undangan di: ${url}`;
  }

  function updateSharePreview() {
    const url = getShareUrl();
    const waMsg = getWhatsAppMessage();
    if (sharePreviewLink) sharePreviewLink.textContent = url;
    if (shareWaPreview) shareWaPreview.textContent = waMsg;
    if (shareWaBtn) shareWaBtn.href = `https://wa.me/?text=${encodeURIComponent(waMsg)}`;
  }

  // Open share modal
  document.querySelectorAll('.share-card-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      activeShareSlug = (btn as HTMLElement).dataset.cardSlug || '';
      if (shareGuestName) shareGuestName.value = '';
      updateSharePreview();
      if (shareModal) {
        shareModal.classList.remove('hidden');
        shareModal.classList.add('flex');
      }
    });
  });

  // Update preview on input change
  shareGuestName?.addEventListener('input', updateSharePreview);
  shareSalutation?.addEventListener('change', updateSharePreview);

  // Copy link button
  shareCopyBtn?.addEventListener('click', async () => {
    const url = getShareUrl();
    try {
      await navigator.clipboard.writeText(url);
      if (shareCopyText) {
        shareCopyText.textContent = 'Tersalin! ✅';
        setTimeout(() => { if (shareCopyText) shareCopyText.textContent = 'Salin Tautan'; }, 2000);
      }
      (window as any).showToast({ message: 'Tautan undangan disalin!', type: 'success', duration: 2000 });
    } catch {
      (window as any).showToast({ message: 'Gagal menyalin tautan', type: 'error' });
    }
  });
</script>

