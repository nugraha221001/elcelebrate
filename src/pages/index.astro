                  <span>Pilih Paket {tier.days} Hari</span>
                  <ArrowRight class="w-3.5 h-3.5" stroke-width="2" />
                </Button>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Footnote trust statement -->
      <div class="mt-12 text-center reveal-on-scroll" data-delay="150">
        <p class="inline-flex items-center justify-center gap-1.5 text-xs text-surface-400">
          <ShieldCheck class="w-4 h-4 text-[#f5c563] shrink-0" stroke-width="2" />
          <span>Semua transaksi diproses aman sesuai standar QRIS Bank Indonesia. Kartu gratis dirancang dan diuji pratinjau sebelum aktivasi publikasi.</span>
        </p>
      </div>

    </div>
  </section>

  <!-- Bottom CTA Section: Restrained Boutique Studio Invitation -->
  <section class="relative w-full overflow-hidden py-24 sm:py-32">
    <div class="relative mx-auto w-full max-w-3xl px-4 text-center sm:px-6 reveal-on-scroll">
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#f5c563]/25 bg-[#f5c563]/5 text-[#f5c563] text-xs font-medium uppercase tracking-wider mb-6">
        <Sparkles class="w-3.5 h-3.5 text-[#f5c563]" stroke-width="1.5" />
        <span>Rancang Selebrasi Anda</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight">
        Siap Merancang Undangan <br class="hidden sm:inline" />
        <span class="font-serif italic font-normal text-[#f5c563]">yang Memikat Hati Tamu Anda?</span>
      </h2>

      <p class="mt-6 text-base sm:text-lg text-surface-300 leading-relaxed max-w-xl mx-auto">
        Buat kartu digital eksklusif Anda dalam hitungan menit. Tanpa instalasi rumit, langsung siap disebarkan ke keluarga dan sahabat tersayang.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button
          href={user ? '/dashboard/create' : '/signup'}
          variant="primary"
          size="lg"
          id="cta-bottom"
          class="shadow-xl shadow-[#f5c563]/15 flex items-center gap-2 px-8"
        >
          <span>Mulai Mendesain Sekarang</span>
          <ArrowRight class="w-4 h-4" stroke-width="2" />
        </Button>
      </div>

      <p class="mt-6 text-xs sm:text-sm text-surface-400">
        Gratis Desain &amp; Pratinjau • Publikasi Mulai Rp5.000 via QRIS • Tampilan Responsif Ponsel
      </p>
    </div>
  </section>

  <Footer />

  <!-- Client-side Interactive Logic for Hero Showcase and Sample Copy Pill -->
  <script is:inline>
    (function () {
      // ── 1. Hero Showcase Frame: Lazy Load Iframe & Audio Bridge ──
      const unboxBtn = document.getElementById('hero-unbox-btn');
      const waxSeal = document.getElementById('hero-wax-seal');
      const resealBtn = document.getElementById('showcase-reseal-top-btn');
      const gateLeft = document.getElementById('hero-gate-left');
      const gateRight = document.getElementById('hero-gate-right');
      const coverText = document.getElementById('hero-cover-text');
      const coverFooter = document.getElementById('hero-cover-footer');
      const topBar = document.getElementById('showcase-top-bar');
      const floatBtn = document.getElementById('showcase-fullscreen-float-btn');
      const audioBtn = document.getElementById('showcase-audio-btn');
      const audioOnIcon = document.getElementById('showcase-audio-on-icon');
      const audioOffIcon = document.getElementById('showcase-audio-off-icon');
      const soundBars = document.getElementById('showcase-sound-bars');
      const showcaseIframe = document.getElementById('showcase-iframe');

      let isUnboxed = false;
      let iframeLoaded = false;

      function loadIframe() {
        if (iframeLoaded || !showcaseIframe) return;
        const dataSrc = showcaseIframe.getAttribute('data-src');
        if (dataSrc) {
          showcaseIframe.src = dataSrc;
          iframeLoaded = true;
        }
      }

      // Preload iframe on idle or on first hover/touch of the preview mockup
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(loadIframe, { timeout: 1500 });
      } else {
        setTimeout(loadIframe, 1000);
      }
      const previewContainer = document.getElementById('studio-preview');
      if (previewContainer) {
        previewContainer.addEventListener('mouseenter', loadIframe, { once: true });
        previewContainer.addEventListener('touchstart', loadIframe, { once: true });
      }

      function sendIframeMessage(msg) {
        if (!showcaseIframe || !showcaseIframe.contentWindow) return;
        try {
          showcaseIframe.contentWindow.postMessage(msg, '*');
        } catch (e) {}
      }

      function setAudioUiState(isPlaying) {
        if (isPlaying) {
          if (audioOnIcon) audioOnIcon.classList.remove('hidden');
          if (audioOffIcon) audioOffIcon.classList.add('hidden');
          if (soundBars) soundBars.classList.remove('opacity-30');
        } else {
          if (audioOnIcon) audioOnIcon.classList.add('hidden');
          if (audioOffIcon) audioOffIcon.classList.remove('hidden');
          if (soundBars) soundBars.classList.add('opacity-30');
        }
      }

      function triggerUnbox() {
        if (isUnboxed) return;
        isUnboxed = true;
        loadIframe();

        if (waxSeal) waxSeal.classList.add('scale-125', 'opacity-0', 'pointer-events-none');
        if (gateLeft) gateLeft.classList.add('-translate-x-full');
        if (gateRight) gateRight.classList.add('translate-x-full');
        if (coverText) coverText.classList.add('opacity-0', 'pointer-events-none');
        if (coverFooter) coverFooter.classList.add('opacity-0', 'pointer-events-none');

        if (topBar) {
          topBar.classList.remove('opacity-0', 'pointer-events-none');
          topBar.classList.add('opacity-100', 'pointer-events-auto');
        }
        if (floatBtn) {
          floatBtn.classList.remove('opacity-0', 'pointer-events-none');
          floatBtn.classList.add('opacity-100', 'pointer-events-auto');
        }

        // Tell the embedded invitation to begin playback
        sendIframeMessage({ type: 'PLAY_AUDIO' });
      }

      function triggerReseal() {
        if (!isUnboxed) return;
        isUnboxed = false;

        if (waxSeal) waxSeal.classList.remove('scale-125', 'opacity-0', 'pointer-events-none');
        if (gateLeft) gateLeft.classList.remove('-translate-x-full');
        if (gateRight) gateRight.classList.remove('translate-x-full');
        if (coverText) coverText.classList.remove('opacity-0', 'pointer-events-none');
        if (coverFooter) coverFooter.classList.remove('opacity-0', 'pointer-events-none');

        if (topBar) {
          topBar.classList.remove('opacity-100', 'pointer-events-auto');
          topBar.classList.add('opacity-0', 'pointer-events-none');
        }
        if (floatBtn) {
          floatBtn.classList.remove('opacity-100', 'pointer-events-auto');
          floatBtn.classList.add('opacity-0', 'pointer-events-none');
        }

        // Send reset signal to iframe
        sendIframeMessage({ type: 'RESET_SEAL' });
        setAudioUiState(false);
      }

      if (unboxBtn) unboxBtn.addEventListener('click', triggerUnbox);
      if (waxSeal) waxSeal.addEventListener('click', triggerUnbox);
      if (resealBtn) resealBtn.addEventListener('click', triggerReseal);

      // Audio Toggle Button on the Phone Frame Toolbar
      if (audioBtn) {
        audioBtn.addEventListener('click', function () {
          sendIframeMessage({ type: 'TOGGLE_MUTE' });
        });
      }

      // Listen for Audio State Sync from embedded iframe
      window.addEventListener('message', function (event) {
        if (!event.data || typeof event.data !== 'object') return;
        if (event.data.type === 'AUDIO_STATE_CHANGED') {
          setAudioUiState(Boolean(event.data.isPlaying));
        }
      });

      // ── 2. Bento 4: Sample Account Copy Button ──
      const copyBtn = document.getElementById('sample-copy-btn');
      const copyLabel = document.getElementById('sample-copy-label');
      const accountNum = document.getElementById('sample-account-number');

      if (copyBtn && copyLabel && accountNum) {
        copyBtn.addEventListener('click', function () {
          const text = accountNum.innerText.replace(/\s+/g, '');
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).catch(function () {});
          }
          copyLabel.textContent = 'Tersalin!';
          copyBtn.classList.remove('bg-[#f5c563]');
          copyBtn.classList.add('bg-emerald-400');

          setTimeout(function () {
            copyLabel.textContent = 'Salin';
            copyBtn.classList.remove('bg-emerald-400');
            copyBtn.classList.add('bg-[#f5c563]');
          }, 2000);
        });
      }

      // ── 3. GPU-Accelerated Scroll Reveal Choreography ──
      const revealElements = document.querySelectorAll('.reveal-on-scroll');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          function (entries, obs) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        revealElements.forEach(function (el) {
          observer.observe(el);
        });
      } else {
        revealElements.forEach(function (el) {
          el.classList.add('is-visible');
        });
      }
    })();
  </script>
</BaseLayout>
