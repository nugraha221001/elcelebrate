  <!-- Client-side Interactive Logic for Hero Showcase and Sample Copy Pill -->
  <script is:inline>
    (function () {
      // 1. Hero Showcase Frame: Unbox & Re-seal Animation
      const unboxBtn = document.getElementById('hero-unbox-btn');
      const waxSeal = document.getElementById('hero-wax-seal');
      const resealBtn = document.getElementById('showcase-reseal-btn');
      const gateLeft = document.getElementById('hero-gate-left');
      const gateRight = document.getElementById('hero-gate-right');
      const coverText = document.getElementById('hero-cover-text');
      const coverFooter = document.getElementById('hero-cover-footer');
      const rsvpBtn = document.getElementById('showcase-rsvp-toggle');
      const rsvpLabel = document.getElementById('showcase-rsvp-label');

      let isUnboxed = false;
      let isRsvpd = false;

      function triggerUnbox() {
        if (isUnboxed) return;
        isUnboxed = true;

        if (waxSeal) {
          waxSeal.classList.add('scale-125', 'opacity-0', 'pointer-events-none');
        }
        if (gateLeft) {
          gateLeft.classList.add('-translate-x-full');
        }
        if (gateRight) {
          gateRight.classList.add('translate-x-full');
        }
        if (coverText) {
          coverText.classList.add('opacity-0', 'pointer-events-none');
        }
        if (coverFooter) {
          coverFooter.classList.add('opacity-0', 'pointer-events-none');
        }
      }

      function triggerReseal() {
        if (!isUnboxed) return;
        isUnboxed = false;

        if (waxSeal) {
          waxSeal.classList.remove('scale-125', 'opacity-0', 'pointer-events-none');
        }
        if (gateLeft) {
          gateLeft.classList.remove('-translate-x-full');
        }
        if (gateRight) {
          gateRight.classList.remove('translate-x-full');
        }
        if (coverText) {
          coverText.classList.remove('opacity-0', 'pointer-events-none');
        }
        if (coverFooter) {
          coverFooter.classList.remove('opacity-0', 'pointer-events-none');
        }
      }

      if (unboxBtn) unboxBtn.addEventListener('click', triggerUnbox);
      if (waxSeal) waxSeal.addEventListener('click', triggerUnbox);
      if (resealBtn) resealBtn.addEventListener('click', triggerReseal);

      // Interactive RSVP Toggle Inside Showcase
      if (rsvpBtn && rsvpLabel) {
        rsvpBtn.addEventListener('click', function () {
          isRsvpd = !isRsvpd;
          if (isRsvpd) {
            rsvpLabel.textContent = '✓ Terkonfirmasi Hadir (2 Tamu)';
            rsvpBtn.classList.remove('text-[#f5c563]', 'border-[#f5c563]/30', 'bg-[#f5c563]/10');
            rsvpBtn.classList.add('text-emerald-400', 'border-emerald-500/40', 'bg-emerald-500/15');
          } else {
            rsvpLabel.textContent = 'Konfirmasi Kehadiran';
            rsvpBtn.classList.add('text-[#f5c563]', 'border-[#f5c563]/30', 'bg-[#f5c563]/10');
            rsvpBtn.classList.remove('text-emerald-400', 'border-emerald-500/40', 'bg-emerald-500/15');
          }
        });
      }

      // 2. Bento 4: Sample Account Copy Button
      const copyBtn = document.getElementById('sample-copy-btn');
      const copyLabel = document.getElementById('sample-copy-label');
      const accountNum = document.getElementById('sample-account-number');

      if (copyBtn && copyLabel && accountNum) {
        copyBtn.addEventListener('click', function () {
          const text = accountNum.innerText.replace(/\s+/g, '');
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).catch(function () {});
          }
          copyLabel.textContent = 'Tersalin!';
          copyBtn.classList.remove('bg-[#f5c563]');
          copyBtn.classList.add('bg-emerald-400');

          setTimeout(function () {
            copyLabel.textContent = 'Salin';
            copyBtn.classList.remove('bg-emerald-400');
            copyBtn.classList.add('bg-[#f5c563]');
          }, 2000);
        });
      }
    })();
  </script>
