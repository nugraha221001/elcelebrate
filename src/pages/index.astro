---
export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';
import {
  Cake,
  Gem,
  GraduationCap,
  MailOpen,
  Heart,
  Sparkles,
  Ticket,
  Music,
  Images,
  MessageSquareHeart,
  ArrowRight,
  Check,
  Copy,
  Disc3,
} from 'lucide-astro';

const user = Astro.locals.user;

interface BoutiqueCategory {
  id: string;
  name: string;
  edition: string;
  desc: string;
  accent: 'wedding' | 'birthday' | 'anniversary' | 'graduation' | 'invitation' | 'love' | 'greetings';
  icon: any;
}

const BOUTIQUE_CATEGORIES: BoutiqueCategory[] = [
  {
    id: 'wedding',
    name: 'Undangan Pernikahan',
    edition: 'Atelier Signature',
    desc: 'Buku tamu digital, konfirmasi RSVP terpadu, alunan musik latar, serta pembukaan gerbang megah nan sakral.',
    accent: 'wedding',
    icon: Gem,
  },
  {
    id: 'birthday',
    name: 'Ulang Tahun & Milad',
    edition: 'Polaroid Keepsake',
    desc: 'Rayakan pertambahan usia dengan animasi kotak kado interaktif, pita satin, serta deretan foto kenangan.',
    accent: 'birthday',
    icon: Cake,
  },
  {
    id: 'anniversary',
    name: 'Perayaan Anniversary',
    edition: 'Velvet Romance',
    desc: 'Bingkai kilas balik kisah cinta abadi dalam kotak perhiasan velvet berhias kilau emas mewah.',
    accent: 'anniversary',
    icon: Heart,
  },
  {
    id: 'graduation',
    name: 'Wisuda & Kelulusan',
    edition: 'Diploma Folio',
    desc: 'Sematkan gulungan ijazah kehormatan dan lembaran ucapan apresiasi atas pencapaian akademis tertinggi.',
    accent: 'graduation',
    icon: GraduationCap,
  },
  {
    id: 'invitation',
    name: 'Undangan Acara & Jamuan',
    edition: 'VIP Perforated',
    desc: 'Format tiket eksklusif dengan perforasi elegan untuk pesta privat, syukuran, gala dinner, atau peluncuran.',
    accent: 'invitation',
    icon: Ticket,
  },
  {
    id: 'love',
    name: 'Surat Cinta & Romansa',
    edition: 'Wax-Sealed Parchment',
    desc: 'Surat lipat berstempel lilin autentik untuk mengungkap isi kalbu terdalam secara intim dan penuh ketulusan.',
    accent: 'love',
    icon: MailOpen,
  },
  {
    id: 'greetings',
    name: 'Ucapan & Hari Raya',
    edition: '3D Gold Bifold',
    desc: 'Kartu lipat tiga dimensi berornamen cahaya emas untuk mengantarkan doa tulus di hari kemenangan dan perayaan.',
    accent: 'greetings',
    icon: Sparkles,
  },
];
---

<BaseLayout
  title="ElCelebrate — Studio Kartu & Undangan Digital Eksklusif"
  description="Studio digital stationery eksklusif: rancang undangan dan kartu ucapan mewah berarsitektur editorial dengan animasi pembuka sinematik, musik latar, serta RSVP terpadu."
>
  <Navbar user={user} />

  <!-- Restrained Warm Spotlight Atmosphere -->
  <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 h-180 w-full max-w-5xl opacity-80"
      style="background: radial-gradient(circle at 50% 0%, rgba(245, 197, 99, 0.07) 0%, rgba(245, 197, 99, 0.02) 40%, transparent 75%);"
    ></div>
  </div>

  <!-- Hero Section: Editorial Split with Live Interactive Card Showcase -->
  <section class="relative w-full overflow-hidden pt-12 pb-20 sm:pt-16 sm:pb-28 lg:pt-20 lg:pb-32 border-b border-white/8">
    <div class="relative mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left Column: Editorial Studio Copywriting & Trust Strip -->
        <div class="lg:col-span-7 text-left">
          <!-- Studio Atelier Tag -->
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-[#f5c563]/25 bg-[#f5c563]/5 text-[#f5c563] text-xs tracking-wider uppercase font-medium mb-6">
            <Sparkles class="w-3.5 h-3.5 text-[#f5c563]" stroke-width="1.5" />
            <span>Digital Stationery & Invitation Studio</span>
          </div>

          <!-- Main Editorial Heading -->
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-bold text-white tracking-tight leading-[1.14]">
            Bukan sekadar pesan singkat, <br class="hidden sm:inline" />
            <span class="font-serif italic font-normal text-[#f5c563]">merancang momen yang layak dikenang.</span>
          </h1>

          <!-- Grounded Indonesian Copywriting -->
          <p class="mt-6 text-base sm:text-lg text-surface-300 leading-relaxed max-w-xl">
            Hadirkan keanggunan seni undangan fisik ke dalam medium digital. Ciptakan kartu ucapan dan undangan interaktif dengan animasi pembuka sinematik, kurasi musik personal, serta tipografi editorial yang bernilai seni abadi.
          </p>

          <!-- Clean CTAs -->
          <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <Button
              href={user ? '/dashboard/create' : '/signup'}
              variant="primary"
              size="lg"
              id="hero-cta"
              class="shadow-xl shadow-[#f5c563]/15 flex items-center justify-center gap-2"
            >
              <span>Mulai Mendesain</span>
              <ArrowRight class="w-4 h-4 ml-0.5" stroke-width="2" />
            </Button>
            <Button href="#categories" variant="secondary" size="lg" class="flex items-center justify-center">
              Jelajahi Koleksi Desain
            </Button>
          </div>

          <!-- Understated Editorial Trust Strip -->
          <div class="mt-12 pt-8 border-t border-white/10 flex flex-wrap items-center gap-y-3 gap-x-6 text-xs sm:text-sm text-surface-300">
            <div class="flex items-center gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#f5c563]"></span>
              <span>Bebas Iklan & Watermark</span>
            </div>
            <div class="h-4 w-px bg-white/15 hidden sm:block"></div>
            <div class="flex items-center gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#f5c563]"></span>
              <span>Ringan & Akses Instan &lt;1 Detik</span>
            </div>
            <div class="h-4 w-px bg-white/15 hidden sm:block"></div>
            <div class="flex items-center gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#f5c563]"></span>
              <span>7 Kategori Eksklusif</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Live Interactive Card Showcase -->
        <div class="lg:col-span-5 flex flex-col items-center justify-center">
          <!-- Subtle Outer Frame Glow -->
          <div class="relative group p-1.5 rounded-[38px] bg-linear-to-b from-[#f5c563]/30 via-white/5 to-[#f5c563]/10 shadow-[0_24px_60px_rgba(0,0,0,0.6)]">
            
            <!-- Live Preview Indicator Pill -->
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 z-40 px-3.5 py-1 rounded-full border border-[#f5c563]/30 bg-[#181522]/95 backdrop-blur-md text-[11px] font-medium text-[#f5c563] inline-flex items-center gap-2 shadow-lg">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Pratinjau Interaktif Studio</span>
            </div>

            <!-- Miniature Card Showcase Frame -->
            <div
              id="hero-showcase-frame"
              class="w-72.5 sm:w-80 aspect-9/16 rounded-[32px] border border-[#f5c563]/30 bg-[#181522] shadow-2xl relative overflow-hidden select-none"
            >
              <!-- ── LAYER 1: Card Interior (Revealed upon unboxing) ── -->
              <div
                id="hero-card-interior"
                class="absolute inset-0 p-5 flex flex-col justify-between text-center transition-all duration-700 bg-linear-to-b from-[#181522] via-[#15121e] to-[#0f0d15]"
              >
                <!-- Architectural Inner Gold Hairline -->
                <div class="absolute inset-3 border border-[#f5c563]/20 rounded-2xl pointer-events-none"></div>

                <!-- Top: Ambient Music Track Pill -->
                <div class="relative z-10 pt-2">
                  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-[10px] text-surface-300">
                    <div class="flex items-end gap-0.5 h-3">
                      <span class="w-0.5 bg-[#f5c563] h-2 animate-[pulse_1s_ease-in-out_infinite]"></span>
                      <span class="w-0.5 bg-[#f5c563] h-3 animate-[pulse_0.7s_ease-in-out_infinite]"></span>
                      <span class="w-0.5 bg-[#f5c563] h-1.5 animate-[pulse_1.2s_ease-in-out_infinite]"></span>
                    </div>
                    <span class="truncate max-w-42.5">Canon in D • Piano Romance</span>
                  </div>
                </div>

                <!-- Center: Couple Typography & Ceremony Details -->
                <div class="relative z-10 my-auto py-2">
                  <span class="text-[9px] uppercase tracking-[0.25em] text-[#f5c563]/90 font-medium">Walimatul &apos;Ursy</span>
                  
                  <h3 class="font-serif italic text-2xl font-normal text-white mt-2 leading-tight">
                    Raden Mas Arya <br />
                    <span class="text-xs font-sans not-italic text-[#f5c563]/80">&</span> <br />
                    Arum Sekar Kinanti
                  </h3>

                  <div class="w-12 h-px bg-[#f5c563]/40 mx-auto my-3"></div>

                  <p class="text-[11px] text-surface-200 font-medium">Sabtu, 24 Oktober 2026</p>
                  <p class="text-[10px] text-surface-400 mt-0.5">Grand Ballroom Dharmawangsa, Jakarta</p>

                  <!-- Interactive RSVP Badge -->
                  <button
                    id="showcase-rsvp-toggle"
                    type="button"
                    class="mt-4 px-3.5 py-1.5 rounded-lg border border-[#f5c563]/30 bg-[#f5c563]/10 hover:bg-[#f5c563]/20 text-[10px] font-semibold text-[#f5c563] transition-all cursor-pointer active:scale-95 inline-flex items-center gap-1.5 shadow-sm"
                  >
                    <Check class="w-3 h-3 text-[#f5c563]" stroke-width="2" />
                    <span id="showcase-rsvp-label">Konfirmasi Kehadiran</span>
                  </button>
                </div>

                <!-- Bottom: Re-seal Action -->
                <div class="relative z-10 pb-2">
                  <button
                    id="showcase-reseal-btn"
                    type="button"
                    class="w-full py-1.5 px-3 rounded-lg border border-white/10 hover:border-[#f5c563]/40 bg-white/5 hover:bg-white/10 text-[10px] text-surface-400 hover:text-white transition-all cursor-pointer flex items-center justify-center gap-1.5"
                  >
                    <span>Tutup Kembali Segel</span>
                  </button>
                </div>
              </div>

              <!-- ── LAYER 2: Gate Split Doors (Left & Right) ── -->
              <!-- Left Gate Door -->
              <div
                id="hero-gate-left"
                class="absolute inset-y-0 left-0 w-1/2 bg-[#1c182a] border-r border-[#f5c563]/30 z-20 transition-transform duration-700 ease-luxury flex flex-col justify-between p-3.5 shadow-xl overflow-hidden"
              >
                <!-- Subtle Gold Filigree Hairline -->
                <div class="absolute inset-2 border-r border-[#f5c563]/15 pointer-events-none"></div>
                <div class="w-4 h-4 border-t border-l border-[#f5c563]/40"></div>
                <div class="w-4 h-4 border-b border-l border-[#f5c563]/40"></div>
              </div>

              <!-- Right Gate Door -->
              <div
                id="hero-gate-right"
                class="absolute inset-y-0 right-0 w-1/2 bg-[#1c182a] border-l border-[#f5c563]/30 z-20 transition-transform duration-700 ease-luxury flex flex-col justify-between p-3.5 shadow-xl overflow-hidden"
              >
                <!-- Subtle Gold Filigree Hairline -->
                <div class="absolute inset-2 border-l border-[#f5c563]/15 pointer-events-none"></div>
                <div class="w-4 h-4 border-t border-r border-[#f5c563]/40 ml-auto"></div>
                <div class="w-4 h-4 border-b border-r border-[#f5c563]/40 ml-auto"></div>
              </div>

              <!-- ── LAYER 3: Cover Typography Overlay (Crosses both doors) ── -->
              <div
                id="hero-cover-text"
                class="absolute inset-x-0 top-12 text-center z-25 transition-all duration-400 pointer-events-none px-4"
              >
                <p class="text-[9px] uppercase tracking-[0.25em] text-[#f5c563]/80 font-medium">The Wedding Celebration Of</p>
                <h3 class="font-serif italic text-xl font-normal text-white mt-1.5">Raden & Arum</h3>
                <p class="text-[10px] text-surface-400 mt-1">24 . 10 . 2026</p>
              </div>

              <!-- ── LAYER 4: Center Wax Seal Medallion ── -->
              <div
                id="hero-wax-seal"
                class="absolute top-[52%] left-1/2 -translate-x-1/2 -translate-y-1/2 z-30 transition-all duration-500 ease-luxury cursor-pointer group"
                title="Klik untuk membuka kartu"
              >
                <div class="w-16 h-16 rounded-full bg-linear-to-br from-[#d9a738] via-[#f5c563] to-[#9e7118] p-1 shadow-[0_8px_25px_rgba(245,197,99,0.45)] border border-[#fae09a]/80 flex items-center justify-center transform group-hover:scale-105 active:scale-95 transition-transform">
                  <div class="w-full h-full rounded-full border border-amber-950/20 bg-linear-to-br from-[#c9952a] via-[#e5b34e] to-[#966b16] flex flex-col items-center justify-center shadow-inner">
                    <span class="font-serif italic font-bold text-amber-950 text-xs tracking-wider">R&A</span>
                  </div>
                </div>
              </div>

              <!-- ── LAYER 5: Cover Footer & Interactive CTA Button ── -->
              <div
                id="hero-cover-footer"
                class="absolute inset-x-4 bottom-5 z-25 transition-all duration-400 text-center"
              >
                <button
                  id="hero-unbox-btn"
                  type="button"
                  class="w-full py-2.5 px-4 rounded-xl bg-linear-to-r from-[#f5c563] to-[#fae09a] text-[#0f0d15] text-xs font-semibold shadow-lg shadow-[#f5c563]/25 hover:brightness-105 active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer"
                >
                  <Sparkles class="w-3.5 h-3.5 text-[#0f0d15]" stroke-width="2" />
                  <span>Buka Segel Undangan</span>
                </button>
                <p class="text-[10px] text-surface-400 mt-2">Klik untuk menyaksikan simulasi langsung</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Categories Section: Luxury Boutique Stationery Samples -->
  <section id="categories" class="relative w-full overflow-hidden py-20 sm:py-28 border-b border-white/8">
    <div class="relative mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="mx-auto max-w-2xl text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#f5c563]/20 bg-[#f5c563]/5 text-[#f5c563] text-xs font-medium uppercase tracking-wider mb-3">
          <Gem class="w-3.5 h-3.5 text-[#f5c563]" stroke-width="1.5" />
          <span>Koleksi Desain Atelier</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
          Sentuhan Fisik untuk Setiap Selebrasi
        </h2>
        <p class="mt-4 text-surface-400 text-base leading-relaxed">
          Setiap format dirancang sebagai sampel stationery fisik yang elegan—menghadirkan tekstur, ornamen, dan karakteristik tersendiri untuk setiap fase istimewa.
        </p>
      </div>

      <!-- 7 Boutique Stationery Cards Grid -->
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {BOUTIQUE_CATEGORIES.map((cat, idx) => {
          const IconComponent = cat.icon;
          return (
            <a
              href="/dashboard/create"
              id={`category-${cat.id}`}
              class="group relative overflow-hidden rounded-2xl bg-[#181522]/80 backdrop-blur-md border border-white/10 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-[#f5c563]/40 hover:shadow-[0_12px_32px_rgba(245,197,99,0.08)] flex flex-col justify-between"
              style={`animation: fade-in-up 0.5s var(--ease-smooth) forwards; animation-delay: ${idx * 60}ms; opacity: 0;`}
            >
              <!-- Micro-Accent: Wedding Corner Hairline -->
              {cat.accent === 'wedding' && (
                <>
                  <div class="w-4 h-4 border-t border-l border-[#f5c563]/40 absolute top-3 left-3 pointer-events-none transition-colors group-hover:border-[#f5c563]"></div>
                  <div class="w-4 h-4 border-b border-r border-[#f5c563]/40 absolute bottom-3 right-3 pointer-events-none transition-colors group-hover:border-[#f5c563]"></div>
                </>
              )}

              <!-- Micro-Accent: Birthday Polaroid Corner Frame -->
              {cat.accent === 'birthday' && (
                <div class="absolute top-0 right-0 w-10 h-10 overflow-hidden pointer-events-none">
                  <div class="w-14 h-14 bg-[#f5c563]/10 rotate-45 transform origin-bottom-left border-b border-[#f5c563]/30"></div>
                </div>
              )}

              <!-- Micro-Accent: Invitation Ticket Perforations -->
              {cat.accent === 'invitation' && (
                <>
                  <div class="absolute -left-2 top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-[#0f0d15] border border-white/10 pointer-events-none"></div>
                  <div class="absolute -right-2 top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-[#0f0d15] border border-white/10 pointer-events-none"></div>
                </>
              )}

              <!-- Micro-Accent: Love Wax Seal Stamp Crease -->
              {cat.accent === 'love' && (
                <div class="absolute -bottom-6 -right-6 w-16 h-16 rounded-full border border-rose-400/20 bg-rose-500/5 pointer-events-none"></div>
              )}

              <!-- Card Header: Medallion + Edition Badge -->
              <div>
                <div class="flex items-center justify-between gap-3 mb-5">
                  <!-- Champagne Gold Glass Medallion -->
                  <div class="w-11 h-11 rounded-xl border border-[#f5c563]/25 bg-[#f5c563]/5 text-[#f5c563] flex items-center justify-center shrink-0 transition-transform duration-300 group-hover:scale-105">
                    <IconComponent class="w-5 h-5" stroke-width="1.5" />
                  </div>
                  <span class="text-[11px] font-medium text-surface-400 uppercase tracking-wider px-2.5 py-1 rounded-md bg-white/5 border border-white/5">
                    {cat.edition}
                  </span>
                </div>

                <h3 class="text-lg font-semibold text-white group-hover:text-[#f5c563] transition-colors">
                  {cat.name}
                </h3>
                <p class="mt-2.5 text-xs text-surface-400 leading-relaxed">
                  {cat.desc}
                </p>
              </div>

              <!-- Card Footer: Refined CTA Link -->
              <div class="mt-6 pt-4 border-t border-white/8 flex items-center justify-between text-xs font-medium text-[#f5c563]">
                <span>Rancang Desain</span>
                <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" stroke-width="2" />
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Features Section: Asymmetric Bento Grid ("Lebih dari Sekadar Kartu") -->
  <section class="relative w-full overflow-hidden py-20 sm:py-28 border-b border-white/8">
    <div class="relative mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="mx-auto max-w-2xl text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#f5c563]/20 bg-[#f5c563]/5 text-[#f5c563] text-xs font-medium uppercase tracking-wider mb-3">
          <Sparkles class="w-3.5 h-3.5 text-[#f5c563]" stroke-width="1.5" />
          <span>Fitur & Pengalaman</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
          Lebih Dari Sekadar Kartu Ucapan
        </h2>
        <p class="mt-4 text-surface-400 text-base leading-relaxed">
          Setiap detail dibangun dengan sentuhan atelier digital—memadukan kemudahan teknologi masa kini dengan kehangatan relasi personal.
        </p>
      </div>

      <!-- Asymmetric Bento Grid (2 cols + 1 col, 1 col + 2 cols) -->
      <div class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-5">
        
        <!-- ── BENTO 1 (md:col-span-2): Animasi Pembuka Sinematik ── -->
        <div class="md:col-span-2 rounded-2xl border border-white/10 bg-[#181522]/80 backdrop-blur-md p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 hover:border-[#f5c563]/30">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div class="w-11 h-11 rounded-xl border border-[#f5c563]/25 bg-[#f5c563]/5 text-[#f5c563] flex items-center justify-center shrink-0">
                <Sparkles class="w-5 h-5" stroke-width="1.5" />
              </div>
              <div>
                <span class="text-[11px] font-medium text-[#f5c563] uppercase tracking-wider">Unboxing Experience</span>
                <h3 class="text-lg sm:text-xl font-bold text-white">Animasi Pembuka Sinematik</h3>
              </div>
            </div>
            <p class="text-sm text-surface-400 leading-relaxed max-w-xl">
              Hadirkan kesan mendalam sejak detik pertama. Pilih ragam gaya pembuka bertema fisik seperti belahan gerbang megah, segel lilin wax seal, atau tumpukan kartu polaroid.
            </p>
          </div>

          <!-- Miniature Previews Strip (Gate Split, Wax Seal, Polaroid Stack) -->
          <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-3.5">
            
            <!-- Miniature 1: Gate Split -->
            <div class="rounded-xl border border-white/10 bg-[#0f0d15]/80 p-3 flex flex-col items-center text-center">
              <div class="w-full h-24 rounded-lg bg-[#181522] border border-[#f5c563]/20 relative flex items-center justify-center overflow-hidden mb-2.5">
                <!-- Left Flap -->
                <div class="absolute inset-y-0 left-0 w-[48%] bg-surface-700 border-r border-[#f5c563]/30 flex items-center justify-end pr-1">
                  <div class="w-1 h-6 bg-[#f5c563]/40 rounded-full"></div>
                </div>
                <!-- Right Flap -->
                <div class="absolute inset-y-0 right-0 w-[48%] bg-surface-700 border-l border-[#f5c563]/30 flex items-center justify-start pl-1">
                  <div class="w-1 h-6 bg-[#f5c563]/40 rounded-full"></div>
                </div>
                <!-- Interior Peek -->
                <span class="text-[10px] font-serif italic text-[#f5c563]">R & A</span>
              </div>
              <span class="text-xs font-semibold text-white">Gate Split</span>
              <span class="text-[10px] text-surface-400 mt-0.5">Pintu Gerbang Belah</span>
            </div>

            <!-- Miniature 2: Wax Seal -->
            <div class="rounded-xl border border-white/10 bg-[#0f0d15]/80 p-3 flex flex-col items-center text-center">
