---
export const prerender = false;

import BaseLayout from '../components/layout/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';
import { CATEGORY_META } from '../lib/types';

const user = Astro.locals.user;
---

<BaseLayout title="ElCelebrate — Platform Perayaan & Undangan Digital Eksklusif" description="Ciptakan kartu ucapan dan undangan digital mewah dengan animasi sinematik, musik latar, serta galeri foto interaktif yang berkesan.">
  <Navbar user={user} />

  <!-- Hero Section -->
  <section class="relative w-full min-h-screen overflow-hidden">
    <!-- Ambient background -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none -z-10">
      <div class="absolute left-1/4 top-0 h-150 w-150 -translate-x-1/2 rounded-full bg-primary/8 blur-[120px]"></div>
      <div class="absolute right-1/4 top-1/3 h-125 w-125 translate-x-1/2 rounded-full bg-secondary/6 blur-[100px]"></div>
      <div class="absolute bottom-0 left-1/2 h-100 w-100 -translate-x-1/2 rounded-full bg-accent/5 blur-[80px]"></div>
    </div>

    <div class="relative mx-auto w-full max-w-7xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8 lg:py-40">
      <div class="mx-auto max-w-3xl text-center">
        <!-- Floating emoji decorations -->
        <div class="mb-8 sm:mb-10 flex justify-center gap-4">
          <span class="animate-float text-4xl" style="animation-delay: 0s">💍</span>
          <span class="animate-float text-4xl" style="animation-delay: 0.5s">🎂</span>
          <span class="animate-float text-4xl" style="animation-delay: 1s">🎓</span>
          <span class="animate-float text-4xl" style="animation-delay: 1.5s">💌</span>
        </div>

        <h1 class="font-display" style="font-size: var(--text-display); font-weight: 800; line-height: 1.1;">
          <span class="bg-linear-to-r from-amber-300 via-pink-400 to-purple-400 bg-clip-text text-transparent">Abadikan & Rayakan</span>
          <br />
          <span class="text-surface-50">Setiap Momen Istimewa</span>
        </h1>

        <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-surface-300" style="font-size: var(--text-subheading);">
          Ciptakan kartu ucapan dan undangan digital mewah dengan animasi sinematik, musik latar, serta galeri foto interaktif yang berkesan.
        </p>

        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <Button href="/dashboard/create" variant="primary" size="lg" id="hero-cta">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Buat Kartu Sekarang
          </Button>
          <Button href="#categories" variant="secondary" size="lg">
            Jelajahi Kategori
          </Button>
        </div>

        <!-- Stats -->
        <div class="mt-16 grid grid-cols-3 gap-6">
          <div class="text-center">
            <div class="text-2xl font-bold text-surface-50 sm:text-3xl">Gratis</div>
            <div class="mt-1 text-xs text-surface-400 sm:text-sm">Mudah & Siap Pakai</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-surface-50 sm:text-3xl">&lt;1 dtk</div>
            <div class="mt-1 text-xs text-surface-400 sm:text-sm">Akses Cepat & Ringan</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-surface-50 sm:text-3xl">7</div>
            <div class="mt-1 text-xs text-surface-400 sm:text-sm">Kategori Acara Lengkap</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section id="categories" class="relative w-full overflow-hidden py-(--space-section)">
    <div class="relative mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-surface-50" style="font-size: var(--text-heading); font-weight: 700;">
          Pilihan Kartu untuk Setiap Selebrasi
        </h2>
        <p class="mt-4 text-surface-400">Pilih kategori acara dan hadirkan pengalaman digital yang tak terlupakan</p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {Object.entries(CATEGORY_META).map(([key, meta], i) => (
          <a
            href="/dashboard/create"
            class="group relative overflow-hidden rounded-2xl bg-surface-900/60 backdrop-blur-md border border-white/8 p-6 transition-all duration-300 hover:shadow-elevated hover:-translate-y-2 hover:border-purple-500/30"
            id={`category-${key}`}
            style={`animation: fade-in-up 0.6s var(--ease-smooth) forwards; animation-delay: ${i * 100}ms; opacity: 0;`}
          >
            <div class="mb-4 text-5xl transition-transform duration-300 group-hover:scale-110">
              {meta.emoji}
            </div>
            <h3 class="text-lg font-semibold text-surface-100">{meta.label}</h3>
            <p class="mt-2 text-sm text-surface-400">{meta.description}</p>
            <div class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-pink-400 opacity-0 transition-all duration-300 group-hover:opacity-100">
              + Buat Kartu
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="relative w-full overflow-hidden border-t border-white/8 py-(--space-section)">
    <div class="relative mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-surface-50" style="font-size: var(--text-heading); font-weight: 700;">
          Lebih Dari Sekadar Kartu Ucapan
        </h2>
        <p class="mt-4 text-surface-400">Setiap kartu dirancang sebagai pengalaman digital interaktif yang menyentuh hati</p>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { icon: '🎁', title: 'Animasi Pembuka Sinematik', desc: 'Buka amplop, belah gerbang megah, atau tarik pita — tentukan cara penerima membuka kejutan kartu' },
          { icon: '🎵', title: 'Musik Latar Eksklusif', desc: 'Hadirkan suasana mendalam dengan instrumen pilihan atau unggah lagu favoritmu' },
          { icon: '📸', title: 'Galeri Foto Interaktif', desc: 'Unggah foto kenangan dengan kompresi otomatis WebP berkecepatan tinggi dan kualitas tajam' },
          { icon: '🎊', title: 'Ledakan Konfeti Meriah', desc: 'Hujan partikel konfeti menyambut momen pembukaan kartu secara spektakuler' },
          { icon: '💬', title: 'Buku Tamu & Ucapan Doa', desc: 'Sahabat dan kerabat dapat memberikan ucapan selamat serta doa secara langsung' },
          { icon: '⏰', title: 'Hitung Mundur Waktu Nyata', desc: 'Bangun antusiasme menuju hari bahagia dengan countdown interaktif' },
        ].map((f, i) => (
          <div
            class="rounded-2xl border border-white/8 hover:border-purple-500/30 transition-all duration-300 bg-surface-900/60 backdrop-blur-md p-6 hover:shadow-glow-sm"
            style={`animation: fade-in-up 0.6s var(--ease-smooth) forwards; animation-delay: ${i * 80}ms; opacity: 0;`}
          >
            <div class="mb-3 text-3xl">{f.icon}</div>
            <h3 class="text-base font-semibold text-surface-100">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-400">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="relative w-full overflow-hidden border-t border-white/8 py-(--space-section)">
    <div class="absolute inset-0 overflow-hidden pointer-events-none -z-10">
      <div class="absolute left-1/2 top-1/2 h-125 w-125 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/5 blur-[100px]"></div>
    </div>
    <div class="relative mx-auto w-full max-w-2xl px-4 text-center sm:px-6">
      <h2 class="font-display text-surface-50" style="font-size: var(--text-heading); font-weight: 700;">
        Siap Merayakan Momen Bahagia Bersama ElCelebrate?
      </h2>
      <p class="mt-4 text-lg text-surface-300">
        Buat kartu digital eksklusif pertamamu dalam hitungan menit. Mudah, cepat, dan berkesan.
      </p>
      <div class="mt-8">
        <Button href={user ? '/dashboard/create' : '/signup'} variant="primary" size="lg" id="cta-bottom">
          Mulai Sekarang
        </Button>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
