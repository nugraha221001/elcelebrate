---
import type { User } from '@supabase/supabase-js';
import { resolveMediaUrl } from '../../lib/r2';
import { Sparkles } from 'lucide-astro';

export interface Props {
  user?: User | null;
}

const user = Astro.props.user || Astro.locals.user;
const currentPath = Astro.url.pathname;

// Resolve user details from metadata or locals
const profile = (Astro.locals as any).profile;
const fullName = profile?.full_name || (user?.user_metadata?.full_name as string) || '';
const email = user?.email || '';
const displayName = fullName || email.split('@')[0] || 'User';
const firstName = displayName.split(' ')[0];
const rawAvatarUrl = profile?.avatar_url || (user?.user_metadata?.avatar_url as string) || null;
const avatarUrl = resolveMediaUrl(rawAvatarUrl) || null;
const initial = (displayName || 'U').charAt(0).toUpperCase();
---

<nav class="sticky top-0 z-(--z-sticky) bg-surface-950/70 backdrop-blur-xl border-b border-white/8 shadow-sm" id="main-nav">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="group flex items-center gap-2.5" id="nav-logo">
      <div class="relative flex h-9 w-9 items-center justify-center rounded-xl bg-linear-to-br from-purple-600/30 to-pink-600/30 border border-purple-500/30 shadow-[0_0_15px_rgba(217,70,239,0.35)] transition-all duration-300 group-hover:scale-105 group-hover:shadow-[0_0_20px_rgba(217,70,239,0.5)]">
        <Sparkles class="h-4.5 w-4.5 text-pink-300 transition-transform duration-300 group-hover:rotate-12" />
      </div>
      <span class="text-xl tracking-tight">
        <span class="bg-linear-to-r from-amber-300 via-pink-400 to-purple-400 bg-clip-text text-transparent font-extrabold tracking-tight">El</span><span class="text-white font-bold tracking-tight">Celebrate</span>
      </span>
    </a>

    <!-- Desktop Nav Links -->
    <div class="hidden items-center gap-1.5 sm:flex">
      {user ? (
        <>
          <a
            href="/dashboard"
            class:list={[
              'rounded-lg px-3.5 py-2 text-sm font-medium transition-all duration-200',
              currentPath === '/dashboard'
                ? 'bg-white/10 text-white'
                : 'text-surface-300 hover:bg-white/5 hover:text-white',
            ]}
            id="nav-dashboard"
          >
            My Cards
          </a>
          <a
            href="/dashboard/create"
            class="ml-1 inline-flex items-center gap-1.5 rounded-xl bg-linear-to-r from-violet-600 via-fuchsia-500 to-pink-500 px-3.5 py-2 text-sm font-semibold text-white shadow-lg shadow-fuchsia-500/20 transition-all duration-200 hover:opacity-95 hover:shadow-fuchsia-500/30 active:scale-[0.98]"
            id="nav-create"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Create Card
          </a>

          <!-- User Menu Dropdown -->
          <div class="relative ml-2" id="user-menu-wrapper">
            <button
              type="button"
              id="user-menu-btn"
              class="flex items-center gap-2 rounded-xl border border-white/10 bg-surface-800/80 py-1.5 pl-2 pr-3 text-sm font-medium text-surface-200 transition-all hover:border-white/20 hover:bg-surface-700/80 hover:text-white focus-ring cursor-pointer"
              aria-expanded="false"
              aria-haspopup="true"
              aria-label="User navigation menu"
            >
              {avatarUrl ? (
                <img
                  src={avatarUrl}
                  alt={displayName}
                  class="h-7 w-7 rounded-full object-cover border border-white/10 ring-1 ring-primary/30"
                />
              ) : (
                <div class="flex h-7 w-7 items-center justify-center rounded-full bg-linear-to-br from-primary to-secondary text-xs font-bold text-white shadow-xs">
                  {initial}
                </div>
              )}
              <span class="max-w-27.5 truncate text-xs font-semibold text-surface-100">{firstName}</span>
              <svg class="h-3.5 w-3.5 text-surface-400 transition-transform duration-200" id="user-menu-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </button>

            <!-- Dropdown Menu Box -->
            <div
              id="user-menu-dropdown"
              class="invisible opacity-0 scale-95 transition-all duration-200 ease-out absolute right-0 mt-2 w-56 origin-top-right rounded-2xl border border-white/10 bg-surface-800/95 backdrop-blur-xl p-1.5 shadow-elevated z-50"
              role="menu"
              aria-orientation="vertical"
              aria-labelledby="user-menu-btn"
            >
              <!-- Header info -->
              <div class="px-3 py-2.5 border-b border-white/5">
                <p class="text-sm font-semibold text-surface-100 truncate">{displayName}</p>
                <p class="text-xs text-surface-400 truncate mt-0.5">{email}</p>
              </div>

              <!-- Menu links -->
              <div class="py-1">
                <a
                  href="/dashboard"
                  class:list={[
                    'flex items-center gap-2.5 rounded-xl px-3 py-2 text-xs font-medium transition-colors',
                    currentPath === '/dashboard' ? 'bg-white/10 text-white' : 'text-surface-300 hover:bg-white/5 hover:text-white'
                  ]}
                  role="menuitem"
                >
                  <svg class="h-4 w-4 text-surface-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                  </svg>
                  Dashboard
                </a>
                <a
                  href="/dashboard/profile"
                  class:list={[
                    'flex items-center gap-2.5 rounded-xl px-3 py-2 text-xs font-medium transition-colors',
                    currentPath === '/dashboard/profile' ? 'bg-white/10 text-white' : 'text-surface-300 hover:bg-white/5 hover:text-white'
                  ]}
                  role="menuitem"
                >
                  <svg class="h-4 w-4 text-surface-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                  </svg>
                  Edit Profile
                </a>
              </div>

              <!-- Sign out action -->
              <div class="border-t border-white/5 pt-1">
                <form method="POST" action="/api/auth/logout" class="w-full">
                  <button
                    type="submit"
                    class="flex w-full items-center gap-2.5 rounded-xl px-3 py-2 text-xs font-medium text-error transition-colors hover:bg-error/10 cursor-pointer"
                    role="menuitem"
                  >
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
                    </svg>
                    Sign Out
                  </button>
                </form>
              </div>
            </div>
          </div>
        </>
      ) : (
        <>
          <a
            href="/login"
            class="rounded-lg px-3.5 py-2 text-sm font-medium text-surface-300 transition-colors hover:text-white"
            id="nav-login"
          >
            Sign In
          </a>
          <a
            href="/signup"
            class="ml-2 rounded-xl bg-linear-to-r from-violet-600 via-fuchsia-500 to-pink-500 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-fuchsia-500/20 transition-all duration-200 hover:opacity-95 hover:shadow-fuchsia-500/30 active:scale-[0.98]"
            id="nav-signup"
          >
            Get Started
          </a>
        </>
      )}
    </div>

    <!-- Mobile Menu Button -->
    <button
      type="button"
      class="rounded-lg p-2 text-surface-400 transition-colors hover:text-white sm:hidden"
      id="mobile-menu-btn"
      aria-label="Toggle menu"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu (hidden by default) -->
  <div class="hidden border-t border-white/5 px-4 py-4 sm:hidden bg-surface-900/95 backdrop-blur-xl" id="mobile-menu">
    {user ? (
      <div class="flex flex-col gap-2.5">
        <!-- User Badge in mobile drawer -->
        <div class="flex items-center gap-3 px-2 py-2 border-b border-white/5 pb-3">
          {avatarUrl ? (
            <img src={avatarUrl} alt={displayName} class="h-10 w-10 rounded-full object-cover border border-white/10 ring-1 ring-primary/30" />
          ) : (
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-linear-to-br from-primary to-secondary text-sm font-bold text-white shadow-xs">
              {initial}
            </div>
          )}
          <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold text-surface-100 truncate">{displayName}</p>
            <p class="text-xs text-surface-400 truncate">{email}</p>
          </div>
        </div>

        <a href="/dashboard" class="rounded-lg px-3 py-2 text-sm font-medium text-surface-200 hover:bg-white/5">
          Dashboard
        </a>
        <a href="/dashboard/create" class="rounded-lg px-3 py-2 text-sm font-medium text-surface-200 hover:bg-white/5">
          Create Card
        </a>
        <a href="/dashboard/profile" class="rounded-lg px-3 py-2 text-sm font-medium text-surface-200 hover:bg-white/5">
          Edit Profile
        </a>
        <form method="POST" action="/api/auth/logout" class="pt-2 border-t border-white/5">
          <button type="submit" class="w-full rounded-lg px-3 py-2 text-left text-sm font-medium text-error hover:bg-error/10 cursor-pointer">
            Sign Out
          </button>
        </form>
      </div>
    ) : (
      <div class="flex flex-col gap-2">
        <a href="/login" class="rounded-xl px-3 py-2.5 text-sm font-medium text-surface-200 hover:bg-white/5">Sign In</a>
        <a href="/signup" class="rounded-xl bg-linear-to-r from-violet-600 via-fuchsia-500 to-pink-500 px-3 py-2.5 text-center text-sm font-semibold text-white shadow-lg shadow-fuchsia-500/20 active:scale-[0.98]">Get Started</a>
      </div>
    )}
  </div>
</nav>

<script>
  function initNavbar() {
    // Mobile menu toggle
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    mobileBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      mobileMenu?.classList.toggle('hidden');
    });

    // User menu dropdown toggle
    const userMenuWrapper = document.getElementById('user-menu-wrapper');
    const userMenuBtn = document.getElementById('user-menu-btn');
    const userMenuDropdown = document.getElementById('user-menu-dropdown');
    const chevron = document.getElementById('user-menu-chevron');

    if (userMenuBtn && userMenuDropdown) {
      function openDropdown() {
        if (!userMenuDropdown) return;
        userMenuDropdown.classList.remove('invisible', 'opacity-0', 'scale-95');
        userMenuDropdown.classList.add('opacity-100', 'scale-100');
        userMenuBtn?.setAttribute('aria-expanded', 'true');
        chevron?.classList.add('rotate-180');
      }

      function closeDropdown() {
        if (!userMenuDropdown) return;
        userMenuDropdown.classList.remove('opacity-100', 'scale-100');
        userMenuDropdown.classList.add('invisible', 'opacity-0', 'scale-95');
        userMenuBtn?.setAttribute('aria-expanded', 'false');
        chevron?.classList.remove('rotate-180');
      }

      userMenuBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isExpanded = userMenuBtn.getAttribute('aria-expanded') === 'true';
        if (isExpanded) {
          closeDropdown();
        } else {
          openDropdown();
        }
      });

      // Click outside dismiss
      document.addEventListener('click', (e) => {
        if (userMenuWrapper && !userMenuWrapper.contains(e.target as Node)) {
          closeDropdown();
        }
      });

      // Escape key dismiss
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeDropdown();
        }
      });
    }
  }

  // Direct initialization on normal DOM load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavbar);
  } else {
    initNavbar();
  }
</script>

