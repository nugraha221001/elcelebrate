---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-[#0f0d15]/80 backdrop-blur-xl">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="group inline-flex items-center gap-2.5">
          <div class="relative flex h-8 w-8 items-center justify-center rounded-xl bg-linear-to-br from-purple-600/30 to-pink-600/30 border border-purple-500/30 shadow-[0_0_12px_rgba(217,70,239,0.3)] transition-all duration-300 group-hover:scale-105 group-hover:rotate-12">
            <img src="/logo-icon.png" alt="ElCelebrate" class="w-full h-full object-contain p-1" />
          </div>
          <span class="text-lg tracking-tight">
            <span class="bg-linear-to-r from-amber-300 via-pink-400 to-purple-400 bg-clip-text text-transparent font-extrabold tracking-tight">El</span><span class="text-white font-bold tracking-tight">Celebrate</span>
          </span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-surface-400">
          Platform kartu ucapan dan undangan digital eksklusif untuk setiap momen berharga. Cepat, elegan, dan berkesan.
        </p>
      </div>

      <!-- Product -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-surface-300">Produk</h3>
        <ul class="mt-4 space-y-2.5">
          <li><a href="/dashboard/create" class="text-sm text-surface-400 transition-colors hover:text-white">Buat Kartu</a></li>
          <li><a href="/dashboard" class="text-sm text-surface-400 transition-colors hover:text-white">Kartu Saya</a></li>
        </ul>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-surface-300">Kategori</h3>
        <ul class="mt-4 space-y-2">
          <li><a href="/#categories" class="text-xs text-surface-400 hover:text-white transition-colors">Undangan Pernikahan</a></li>
          <li><a href="/#categories" class="text-xs text-surface-400 hover:text-white transition-colors">Ulang Tahun & Milad</a></li>
          <li><a href="/#categories" class="text-xs text-surface-400 hover:text-white transition-colors">Perayaan Anniversary</a></li>
          <li><a href="/#categories" class="text-xs text-surface-400 hover:text-white transition-colors">Wisuda & Kelulusan</a></li>
          <li><a href="/#categories" class="text-xs text-surface-400 hover:text-white transition-colors">Undangan Acara</a></li>
          <li><a href="/#categories" class="text-xs text-surface-400 hover:text-white transition-colors">Surat Cinta & Romansa</a></li>
          <li><a href="/#categories" class="text-xs text-surface-400 hover:text-white transition-colors">Ucapan & Hari Raya</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-surface-300">Informasi</h3>
        <ul class="mt-4 space-y-2.5">
          <li><a href="/privacy" class="text-sm text-surface-400 transition-colors hover:text-white">Kebijakan Privasi</a></li>
          <li><a href="/terms" class="text-sm text-surface-400 transition-colors hover:text-white">Syarat & Ketentuan</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/8 pt-8 sm:flex-row">
      <p class="text-sm text-surface-500">© {year} ElCelebrate. Hak cipta dilindungi.</p>
      <p class="text-sm text-surface-500">
        Studio desain digital untuk setiap perayaan dan momen berharga
      </p>
    </div>
  </div>
</footer>
