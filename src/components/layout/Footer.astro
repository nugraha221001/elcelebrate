---
const year = new Date().getFullYear();

/* ── Social & Contact Links ──────────────────────────────────────
   Update `href` here once the official accounts are live.
   - href: '#'          → placeholder: click is prevented, tooltip "Segera Hadir"
   - href: 'https://…'  → opens in a new tab (target="_blank" rel="noopener noreferrer")
   - href: 'mailto:…'   → opens the mail client in the same tab
   ─────────────────────────────────────────────────────────────── */
type SocialIcon = 'instagram' | 'facebook' | 'threads' | 'x' | 'tiktok' | 'email';

interface SocialLink {
  name: string;
  icon: SocialIcon;
  href: string;
  ariaLabel: string;
}

const SOCIAL_LINKS: SocialLink[] = [
  { name: 'Instagram', icon: 'instagram', href: '#', ariaLabel: 'Instagram ElCelebrate' },
  { name: 'Facebook', icon: 'facebook', href: '#', ariaLabel: 'Facebook ElCelebrate' },
  { name: 'Threads', icon: 'threads', href: '#', ariaLabel: 'Threads ElCelebrate' },
  { name: 'X (Twitter)', icon: 'x', href: '#', ariaLabel: 'X ElCelebrate' },
  { name: 'TikTok', icon: 'tiktok', href: '#', ariaLabel: 'TikTok ElCelebrate' },
  { name: 'Email', icon: 'email', href: 'mailto:halo@elcelebrate.my.id', ariaLabel: 'Email ElCelebrate' },
];

/* Inline 24×24 vectors. Brand marks are solid fills; Instagram & Email use
   outline strokes (matching their official line-based glyphs). */
const SOCIAL_ICONS: Record<SocialIcon, { mode: 'fill' | 'stroke'; paths: string[] }> = {
  instagram: {
    mode: 'stroke',
    paths: [
      'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5z',
      'M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z',
      'M17.5 6.5h.01',
    ],
  },
  facebook: {
    mode: 'fill',
    paths: [
      'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
    ],
  },
  threads: {
    mode: 'fill',
    paths: [
      'M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.321.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65zm1.003-11.69c-.242 0-.487.007-.739.021-1.836.103-2.98.946-2.916 2.143.067 1.256 1.452 1.839 2.784 1.767 1.224-.065 2.818-.543 3.086-3.71a10.5 10.5 0 0 0-2.215-.221z',
    ],
  },
  x: {
    mode: 'fill',
    paths: [
      'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932zM17.61 20.644h2.039L6.486 3.24H4.298z',
    ],
  },
  tiktok: {
    mode: 'fill',
    paths: [
      'M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z',
    ],
  },
  email: {
    mode: 'stroke',
    paths: [
      'M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z',
      'm22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7',
    ],
  },
};
---

<footer class="border-t border-white/10 bg-[#0f0d15]/80 backdrop-blur-xl">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="group inline-flex items-center gap-2.5">
          <div class="relative flex h-8 w-8 items-center justify-center rounded-xl bg-linear-to-br from-purple-600/30 to-pink-600/30 border border-purple-500/30 shadow-[0_0_12px_rgba(217,70,239,0.3)] transition-all duration-300 group-hover:scale-105 group-hover:rotate-12">
            <img src="/logo-icon.png" alt="ElCelebrate" class="w-full h-full object-contain p-1" />
          </div>
          <span class="text-lg tracking-tight">
            <span class="bg-linear-to-r from-amber-300 via-pink-400 to-purple-400 bg-clip-text text-transparent font-extrabold tracking-tight">El</span><span class="text-white font-bold tracking-tight">Celebrate</span>
          </span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-surface-400">
          Platform kartu ucapan dan undangan digital eksklusif untuk setiap momen berharga. Cepat, elegan, dan berkesan.
        </p>

        <!-- Social & Contact Icons -->
        <div class="mt-5 flex flex-wrap items-center gap-2.5">
          {SOCIAL_LINKS.map((item) => {
            const isPlaceholder = item.href === '#';
            const isExternal = /^https?:\/\//i.test(item.href);
            const icon = SOCIAL_ICONS[item.icon];
            return (
              <a
                href={item.href}
                aria-label={item.ariaLabel}
                title={isPlaceholder ? 'Segera Hadir' : item.name}
                aria-disabled={isPlaceholder ? 'true' : undefined}
                onclick={isPlaceholder ? 'event.preventDefault()' : undefined}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
                class="w-9 h-9 rounded-xl bg-white/3 border border-white/10 text-[#a59fad] flex items-center justify-center transition-all duration-300 hover:border-[#f5c563]/40 hover:bg-[#f5c563]/10 hover:text-[#f5c563] hover:-translate-y-0.5"
              >
                {icon.mode === 'fill' ? (
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    {icon.paths.map((d) => <path d={d} />)}
                  </svg>
                ) : (
                  <svg
                    class="w-4 h-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    {icon.paths.map((d) => <path d={d} />)}
                  </svg>
                )}
              </a>
            );
          })}
        </div>
      </div>

      <!-- Product -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-surface-300">Produk</h3>
        <ul class="mt-4 space-y-2.5">
          <li><a href="/dashboard/create" class="text-sm text-surface-400 transition-colors hover:text-white">Buat Kartu</a></li>
          <li><a href="/dashboard" class="text-sm text-surface-400 transition-colors hover:text-white">Kartu Saya</a></li>
        </ul>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-surface-300">Kategori</h3>
        <ul class="mt-4 space-y-2">
          <li><a href="/#categories" class="text-xs text-surface-400 hover:text-white transition-colors">Undangan Pernikahan</a></li>
          <li><a href="/#categories" class="text-xs text-surface-400 hover:text-white transition-colors">Ulang Tahun & Milad</a></li>
          <li><a href="/#categories" class="text-xs text-surface-400 hover:text-white transition-colors">Perayaan Anniversary</a></li>
          <li><a href="/#categories" class="text-xs text-surface-400 hover:text-white transition-colors">Wisuda & Kelulusan</a></li>
          <li><a href="/#categories" class="text-xs text-surface-400 hover:text-white transition-colors">Undangan Acara</a></li>
          <li><a href="/#categories" class="text-xs text-surface-400 hover:text-white transition-colors">Surat Cinta & Romansa</a></li>
          <li><a href="/#categories" class="text-xs text-surface-400 hover:text-white transition-colors">Ucapan & Hari Raya</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-surface-300">Informasi</h3>
        <ul class="mt-4 space-y-2.5">
          <li><a href="/privacy" class="text-sm text-surface-400 transition-colors hover:text-white">Kebijakan Privasi</a></li>
          <li><a href="/terms" class="text-sm text-surface-400 transition-colors hover:text-white">Syarat & Ketentuan</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/8 pt-8 sm:flex-row">
      <p class="text-sm text-surface-500">© {year} ElCelebrate. Hak cipta dilindungi.</p>
      <p class="text-sm text-surface-500">
        Studio desain digital untuk setiap perayaan dan momen berharga
      </p>
    </div>
  </div>
</footer>
