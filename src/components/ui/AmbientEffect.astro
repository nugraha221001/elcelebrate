---
import type { AmbientEffectType } from '../../lib/types';

export interface Props {
  effect: AmbientEffectType;
}

const { effect } = Astro.props;
---

{effect && effect !== 'none' && (
  <canvas
    id="ambient-canvas"
    data-effect={effect}
    class="pointer-events-none fixed inset-0 z-0"
    style="width:100%;height:100%;"
  ></canvas>
)}

<script>
  function initAmbientEffect() {
    const canvas = document.getElementById('ambient-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const effect = canvas.dataset.effect || 'none';
    if (!effect || effect === 'none') return;

    const ctx = canvas.getContext('2d')!;

    let animId = 0;
    let paused = false;

    function resize() {
      if (!canvas) return;
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    // Battery-saving: pause when tab is hidden
    document.addEventListener('visibilitychange', () => {
      paused = document.hidden;
      if (!paused && animId === 0) loop();
    });

    // ── Particle system ─────────────────────────────────

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      opacity: number;
      rotation: number;
      rotSpeed: number;
      life: number;
      maxLife: number;
      hue: number;
      phase: number;
    }

    const W = () => canvas.width;
    const H = () => canvas.height;

    function rand(min: number, max: number) { return Math.random() * (max - min) + min; }

    const particles: Particle[] = [];
    // Light particle count: max 20-30 particles for 60 FPS performance
    const MAX = effect === 'starlight' || effect === 'bokeh' ? 30 : 20;

    function spawn(): Particle {
      const base: Particle = {
        x: rand(0, W()), y: 0,
        vx: 0, vy: 0,
        size: 4, opacity: 1,
        rotation: rand(0, Math.PI * 2),
        rotSpeed: rand(-0.02, 0.02),
        life: 0,
        maxLife: rand(200, 400),
        hue: 0,
        phase: rand(0, Math.PI * 2),
      };

      switch (effect) {
        case 'petals':
          base.y = -10;
          base.x = rand(0, W());
          base.vy = rand(0.3, 1.0);
          base.vx = rand(-0.3, 0.3);
          base.size = rand(6, 12);
          base.hue = rand(330, 350);
          base.opacity = rand(0.4, 0.7);
          base.maxLife = rand(300, 600);
          break;
        case 'golden-sparkles':
          base.x = rand(0, W());
          base.y = rand(0, H());
          base.vy = rand(-0.5, -0.15);
          base.vx = rand(-0.2, 0.2);
          base.size = rand(1.5, 3.5);
          base.hue = rand(40, 55);
          base.opacity = 0;
          base.maxLife = rand(120, 280);
          break;
        case 'hearts':
          base.y = -10;
          base.x = rand(0, W());
          base.vy = rand(0.3, 0.8);
          base.vx = rand(-0.2, 0.2);
          base.size = rand(6, 11);
          base.hue = rand(340, 360);
          base.opacity = rand(0.3, 0.6);
          base.maxLife = rand(300, 550);
          break;
        case 'confetti-float':
          base.y = -10;
          base.x = rand(0, W());
          base.vy = rand(0.4, 1.2);
          base.vx = rand(-0.5, 0.5);
          base.size = rand(4, 8);
          base.hue = rand(0, 360);
          base.opacity = rand(0.5, 0.8);
          base.rotSpeed = rand(-0.05, 0.05);
          base.maxLife = rand(250, 500);
          break;
        case 'starlight':
          base.x = rand(0, W());
          base.y = rand(0, H());
          base.vy = 0;
          base.vx = 0;
          base.size = rand(1, 3);
          base.hue = rand(40, 60);
          base.opacity = 0;
          base.maxLife = rand(100, 300);
          break;
        case 'lanterns':
          base.x = rand(0, W());
          base.y = H() + 10;
          base.vy = rand(-0.4, -0.15);
          base.vx = rand(-0.1, 0.1);
          base.size = rand(8, 16);
          base.hue = rand(20, 45);
          base.opacity = rand(0.2, 0.5);
          base.maxLife = rand(400, 700);
          break;
        case 'butterflies':
          base.y = rand(0, H());
          base.x = -10;
          base.vy = rand(-0.2, 0.2);
          base.vx = rand(0.3, 0.8);
          base.size = rand(6, 10);
          base.hue = rand(260, 320);
          base.opacity = rand(0.3, 0.6);
          base.maxLife = rand(400, 700);
          break;
        case 'bokeh':
          base.x = rand(0, W());
          base.y = rand(0, H());
          base.vy = rand(-0.1, 0.1);
          base.vx = rand(-0.1, 0.1);
          base.size = rand(10, 35);
          base.hue = rand(0, 360);
          base.opacity = 0;
          base.maxLife = rand(200, 500);
          break;
        case 'sparklers':
          base.x = rand(0, W());
          base.y = rand(0, H());
          base.vy = rand(-0.3, 0.3);
          base.vx = rand(-0.3, 0.3);
          base.size = rand(1.5, 3);
          base.hue = rand(40, 60);
          base.opacity = 0;
          base.maxLife = rand(60, 150);
          break;
      }
      return base;
    }

    // Pre-populate
    for (let i = 0; i < MAX; i++) {
      const p = spawn();
      p.life = rand(0, p.maxLife * 0.7);
      particles.push(p);
    }

    // ── Draw helpers ─────────────────────────────────

    function drawPetal(p: Particle) {
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rotation);
      ctx.globalAlpha = p.opacity;
      ctx.fillStyle = `hsl(${p.hue}, 70%, 75%)`;
      ctx.beginPath();
      ctx.ellipse(0, 0, p.size * 0.4, p.size, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function drawHeart(p: Particle) {
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rotation);
      ctx.globalAlpha = p.opacity;
      ctx.fillStyle = `hsl(${p.hue}, 75%, 65%)`;
      const s = p.size * 0.15;
      ctx.beginPath();
      ctx.moveTo(0, s * 3);
      ctx.bezierCurveTo(-s * 5, -s * 2, -s * 2, -s * 6, 0, -s * 2);
      ctx.bezierCurveTo(s * 2, -s * 6, s * 5, -s * 2, 0, s * 3);
      ctx.fill();
      ctx.restore();
    }

    function drawConfettiPiece(p: Particle) {
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rotation);
      ctx.globalAlpha = p.opacity;
      ctx.fillStyle = `hsl(${p.hue}, 80%, 65%)`;
      ctx.fillRect(-p.size * 0.5, -p.size * 0.25, p.size, p.size * 0.5);
      ctx.restore();
    }


    function drawBokeh(p: Particle) {
      ctx.globalAlpha = p.opacity * 0.15;
      const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.size);
      g.addColorStop(0, `hsla(${p.hue}, 60%, 75%, 0.4)`);
      g.addColorStop(0.5, `hsla(${p.hue}, 60%, 70%, 0.15)`);
      g.addColorStop(1, `hsla(${p.hue}, 60%, 70%, 0)`);
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fill();
    }

    function drawLantern(p: Particle) {
      ctx.globalAlpha = p.opacity;
      const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.size);
      g.addColorStop(0, `hsla(${p.hue}, 90%, 65%, 0.6)`);
      g.addColorStop(0.6, `hsla(${p.hue}, 80%, 55%, 0.2)`);
      g.addColorStop(1, `hsla(${p.hue}, 80%, 50%, 0)`);
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fill();
    }

    function drawButterfly(p: Particle) {
      ctx.save();
      ctx.translate(p.x, p.y);
      const wingFlap = Math.sin(p.life * 0.08 + p.phase) * 0.4;
      ctx.globalAlpha = p.opacity;
      ctx.fillStyle = `hsl(${p.hue}, 60%, 70%)`;
      // Left wing
      ctx.save();
      ctx.scale(1 + wingFlap, 1);
      ctx.beginPath();
      ctx.ellipse(-p.size * 0.4, 0, p.size * 0.5, p.size * 0.35, -0.3, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
      // Right wing
      ctx.save();
      ctx.scale(1 - wingFlap, 1);
      ctx.beginPath();
      ctx.ellipse(p.size * 0.4, 0, p.size * 0.5, p.size * 0.35, 0.3, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
      // Body
      ctx.fillStyle = `hsl(${p.hue}, 40%, 40%)`;
      ctx.fillRect(-1, -p.size * 0.25, 2, p.size * 0.5);
      ctx.restore();
    }

    function drawSparkle(p: Particle) {
      ctx.globalAlpha = p.opacity;
      ctx.fillStyle = `hsl(${p.hue}, 90%, 85%)`;
      ctx.shadowColor = `hsl(${p.hue}, 90%, 80%)`;
      ctx.shadowBlur = 6;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fill();
      ctx.shadowBlur = 0;
    }

    // ── Animation loop ─────────────────────────────────

    function loop() {
      if (paused) { animId = 0; return; }
      animId = requestAnimationFrame(loop);
      ctx.clearRect(0, 0, W(), H());

      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.life++;
        p.x += p.vx;
        p.y += p.vy;
        p.rotation += p.rotSpeed;

        // Lifecycle opacity envelope
        const progress = p.life / p.maxLife;
        if (effect === 'golden-sparkles' || effect === 'starlight' || effect === 'sparklers' || effect === 'bokeh') {
          // Fade in, hold, fade out
          if (progress < 0.2) {
            p.opacity = (progress / 0.2) * 0.7;
          } else if (progress > 0.75) {
            p.opacity = ((1 - progress) / 0.25) * 0.7;
          }
        } else {
          // Fade out in last 25%
          if (progress > 0.75) {
            p.opacity *= 0.98;
          }
        }

        // Effect-specific movement modifiers
        switch (effect) {
          case 'petals':
            p.vx = Math.sin(p.life * 0.015 + p.phase) * 0.5;
            drawPetal(p);
            break;
          case 'golden-sparkles':
            p.vx += rand(-0.02, 0.02);
            drawSparkle(p);
            break;
          case 'hearts':
            p.vx = Math.sin(p.life * 0.02 + p.phase) * 0.3;
            drawHeart(p);
            break;
          case 'confetti-float':
            p.vx = Math.sin(p.life * 0.02 + p.phase) * 0.6;
            drawConfettiPiece(p);
            break;
          case 'starlight':
            // Twinkle in place
            p.opacity = Math.abs(Math.sin(p.life * 0.04 + p.phase)) * 0.6;
            drawSparkle(p);
            break;
          case 'lanterns':
            p.vx = Math.sin(p.life * 0.008 + p.phase) * 0.2;
            drawLantern(p);
            break;
          case 'butterflies':
            p.vy = Math.sin(p.life * 0.03 + p.phase) * 0.4;
            drawButterfly(p);
            break;
          case 'bokeh':
            drawBokeh(p);
            break;
          case 'sparklers':
            p.vx += rand(-0.05, 0.05);
            p.vy += rand(-0.05, 0.05);
            drawSparkle(p);
            break;
        }

        // Recycle dead particles
        if (p.life >= p.maxLife || p.y > H() + 20 || p.y < -20 || p.x > W() + 20 || p.x < -20) {
          particles[i] = spawn();
        }
      }
    }

    loop();
  }

  // Direct initialization on normal DOM load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAmbientEffect);
  } else {
    initAmbientEffect();
  }
</script>
