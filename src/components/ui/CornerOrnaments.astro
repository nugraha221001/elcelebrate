---
import type { CornerOrnamentType } from '../../lib/types';
import { getCornerOrnamentSvgContent } from '../../lib/corner-ornaments';

export interface Props {
  ornament?: CornerOrnamentType | string;
  primaryColor?: string;
  secondaryColor?: string;
}

const {
  ornament = 'none',
  primaryColor = '#f5c563',
  secondaryColor = '#e07a93',
} = Astro.props;

const isEnabled = ornament && ornament !== 'none';
const svgContent = isEnabled ? getCornerOrnamentSvgContent(ornament) : '';
const goldAccent = '#f5c563';
const primaryAccent = primaryColor || goldAccent;
const secondaryAccent = secondaryColor || '#e07a93';
---

{isEnabled && svgContent && (
  <div class="pointer-events-none fixed inset-0 z-10 overflow-hidden" aria-hidden="true" data-corner-ornament={ornament}>
    <!-- Shared SVG Gradient Defs -->
    <svg class="absolute w-0 h-0 pointer-events-none" aria-hidden="true" style="position: absolute; width: 0; height: 0; overflow: hidden;">
      <defs>
        <linearGradient id="corner-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#fef08a" stop-opacity="0.9" />
          <stop offset="50%" stop-color={goldAccent} stop-opacity="0.8" />
          <stop offset="100%" stop-color={secondaryAccent} stop-opacity="0.65" />
        </linearGradient>
        <linearGradient id="corner-fill" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color={primaryAccent} stop-opacity="0.22" />
          <stop offset="100%" stop-color={goldAccent} stop-opacity="0.06" />
        </linearGradient>
      </defs>
    </svg>

    <!-- Top Left -->
    <svg class="corner-ornament corner-ornament-tl fixed top-0 left-0 pointer-events-none z-10" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg" set:html={svgContent}>
    </svg>

    <!-- Top Right (Mirrored Horizontally) -->
    <svg class="corner-ornament corner-ornament-tr fixed top-0 right-0 pointer-events-none z-10" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
      <g transform="translate(120, 0) scale(-1, 1)" set:html={svgContent}></g>
    </svg>

    <!-- Bottom Left (Mirrored Vertically) -->
    <svg class="corner-ornament corner-ornament-bl fixed bottom-0 left-0 pointer-events-none z-10" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
      <g transform="translate(0, 120) scale(1, -1)" set:html={svgContent}></g>
    </svg>

    <!-- Bottom Right (Mirrored Both Axes) -->
    <svg class="corner-ornament corner-ornament-br fixed bottom-0 right-0 pointer-events-none z-10" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
      <g transform="translate(120, 120) scale(-1, -1)" set:html={svgContent}></g>
    </svg>
  </div>
)}
