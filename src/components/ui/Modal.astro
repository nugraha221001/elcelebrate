---
export interface Props {
  id: string;
  title?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { id, title, size = 'md' } = Astro.props;

const sizeClasses: Record<string, string> = {
  sm: 'max-w-sm',
  md: 'max-w-lg',
  lg: 'max-w-2xl',
};
---

<!-- Backdrop -->
<div
  id={id}
  class="fixed inset-0 z-(--z-modal) hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby={`${id}-title`}
>
  <!-- Modal Panel -->
  <div
    class:list={[
      'glass w-full rounded-2xl p-6 shadow-elevated animate-fade-in-scale',
      sizeClasses[size],
    ]}
  >
    {title && (
      <div class="mb-4 flex items-center justify-between">
        <h2 id={`${id}-title`} class="text-lg font-semibold text-surface-100">
          {title}
        </h2>
        <button
          type="button"
          class="rounded-lg p-1.5 text-surface-400 transition-colors hover:bg-white/10 hover:text-white"
          data-modal-close={id}
          aria-label="Close"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    )}
    <slot />
  </div>
</div>

<script>
  // Setup all modals on page
  document.querySelectorAll('[role="dialog"]').forEach((modal) => {
    // Close on backdrop click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    });

    // Close on button click
    const modalId = modal.id;
    document.querySelectorAll(`[data-modal-close="${modalId}"]`).forEach((btn) => {
      btn.addEventListener('click', () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      });
    });
  });
</script>
