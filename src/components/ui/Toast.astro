<!-- Toast container — positioned fixed, renders toast notifications dynamically -->
<div
  id="toast-container"
  class="pointer-events-none fixed right-4 top-4 z-(--z-toast) flex flex-col gap-2"
  aria-live="polite"
>
</div>

<script>
  interface ToastOptions {
    message: string;
    type?: 'success' | 'error' | 'info' | 'warning';
    duration?: number;
  }

  const icons: Record<string, string> = {
    success: '✓',
    error: '✕',
    info: 'ℹ',
    warning: '⚠',
  };

  const colors: Record<string, string> = {
    success: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-300',
    error: 'border-red-400/30 bg-red-400/10 text-red-300',
    info: 'border-sky-400/30 bg-sky-400/10 text-sky-300',
    warning: 'border-amber-400/30 bg-amber-400/10 text-amber-300',
  };

  (window as any).showToast = ({ message, type = 'info', duration = 4000 }: ToastOptions) => {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = `pointer-events-auto flex items-center gap-2.5 rounded-xl border px-4 py-3 text-sm font-medium shadow-lg backdrop-blur-md animate-fade-in-up ${colors[type]}`;
    toast.innerHTML = `
      <span class="flex-shrink-0 text-base">${icons[type]}</span>
      <span>${message}</span>
    `;

    container.appendChild(toast);

    setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transform = 'translateY(-8px)';
      toast.style.transition = 'all 300ms ease';
      setTimeout(() => toast.remove(), 300);
    }, duration);
  };
</script>
